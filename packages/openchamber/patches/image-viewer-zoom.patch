index 000000000..bb422390a
--- /dev/null
+++ b/packages/ui/src/components/chat/message/imageViewerZoom.ts
@@ -0,0 +1,90 @@
+/**
+ * A zoom the chat image viewer applies to the picture it shows. `scale` is in
+ * the picture's own pixels, the files preview's unit: 1 draws one image pixel
+ * per screen pixel, so a percentage means the same in both viewers. `x` and `y`
+ * offset the drawn picture from the middle of its box.
+ */
+export type ImageZoom = { scale: number; x: number; y: number };
+
+type ImageZoomSize = { width: number; height: number };
+export type ImageZoomPoint = { x: number; y: number };
+
+/** The part of the viewer a picture may use, in pixels from its edges. */
+type ImageZoomInsets = { top: number; bottom: number };
+
+/** The files preview's ceiling: sixteen times the picture's own pixels. */
+export const IMAGE_ZOOM_MAX_SCALE = 16;
+
+/**
+ * Keeps a zoom inside the files preview's range. Fit is the floor: a picture
+ * smaller than its box fits above 100%, so the ceiling follows it, and one
+ * whose fit already sits under 100% stops at fit instead of shrinking past the
+ * box it fills.
+ */
+export const clampImageZoomScale = (scale: number, fitScale: number): number => (
+    Math.min(Math.max(IMAGE_ZOOM_MAX_SCALE, fitScale), Math.max(fitScale, scale))
+);
+
+/**
+ * The zoom after moving from `from` to `nextScale`, with the image point under
+ * `point` staying there. `center` is the middle of the image on screen and
+ * `fitScale` the scale fit draws it at.
+ */
+export const zoomImageAt = (
+    from: ImageZoom,
+    nextScale: number,
+    point: ImageZoomPoint,
+    center: ImageZoomPoint,
+    fitScale: number,
+): ImageZoom => {
+    const scale = clampImageZoomScale(nextScale, fitScale);
+    const ratio = scale / from.scale;
+    return {
+        scale,
+        x: point.x - center.x - ratio * (point.x - center.x - from.x),
+        y: point.y - center.y - ratio * (point.y - center.y - from.y),
+    };
+};
+
+/**
+ * Keeps a zoomed picture inside the part of the viewer it may use: a picture
+ * drawn larger than that part covers it, a smaller one stays inside it.
+ * `drawnScale` is how much bigger than its box the picture is drawn, so at or
+ * below 1 there is nothing to pan and any offset a pinch left behind is
+ * dropped. `centerOffset` is the image's middle measured from the viewer's
+ * middle. `insets` keeps a picture clear of the controls drawn over the
+ * viewer, so panning can bring its top edge under them instead of leaving it
+ * hidden behind them.
+ */
+export const clampImageZoomOffset = (
+    zoom: ImageZoom,
+    drawnScale: number,
+    image: ImageZoomSize,
+    viewport: ImageZoomSize,
+    centerOffset: ImageZoomPoint,
+    insets: ImageZoomInsets = { top: 0, bottom: 0 },
+): ImageZoom => {
+    if (drawnScale <= 1) return { scale: zoom.scale, x: 0, y: 0 };
+
+    const clampAxis = (
+        offset: number,
+        scaledLength: number,
+        viewportLength: number,
+        center: number,
+        insetStart: number,
+        insetEnd: number,
+    ): number => {
+        // One edge of the picture on the usable area's start, the other on its
+        // end; which one bounds a pan follows from whether the picture is
+        // larger than the area or smaller.
+        const startEdge = insetStart + scaledLength / 2 - viewportLength / 2 - center;
+        const endEdge = viewportLength - insetEnd - scaledLength / 2 - viewportLength / 2 - center;
+        return Math.min(Math.max(startEdge, endEdge), Math.max(Math.min(startEdge, endEdge), offset));
+    };
+
+    return {
+        scale: zoom.scale,
+        x: clampAxis(zoom.x, image.width * drawnScale, viewport.width, centerOffset.x, 0, 0),
+        y: clampAxis(zoom.y, image.height * drawnScale, viewport.height, centerOffset.y, insets.top, insets.bottom),
+    };
+};
