+/**
+ * A zoom the chat image viewer applies to the picture it shows. `scale` is in
+ * the picture's own pixels, the files preview's unit: 1 draws one image pixel
+ * per screen pixel, so a percentage means the same in both viewers. `x` and `y`
+ * offset the drawn picture from the middle of its box.
+ */
+export type ImageZoom = { scale: number; x: number; y: number };
+
+type ImageZoomSize = { width: number; height: number };
+export type ImageZoomPoint = { x: number; y: number };
+
+/** The files preview's ceiling: sixteen times the picture's own pixels. */
+export const IMAGE_ZOOM_MAX_SCALE = 16;
+
+/**
+ * Keeps a zoom inside the files preview's range. Fit is the floor: a picture
+ * smaller than its box fits above 100%, so the ceiling follows it, and one
+ * whose fit already sits under 100% stops at fit instead of shrinking past the
+ * box it fills.
+ */
+export const clampImageZoomScale = (scale: number, fitScale: number): number => (
+    Math.min(Math.max(IMAGE_ZOOM_MAX_SCALE, fitScale), Math.max(fitScale, scale))
+);
