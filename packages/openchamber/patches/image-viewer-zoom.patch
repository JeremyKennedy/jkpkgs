+/**
+ * A zoom the chat image viewer applies to the picture it shows. `scale` is in
+ * the picture's own pixels, the files preview's unit: 1 draws one image pixel
+ * per screen pixel, so a percentage means the same in both viewers. `x` and `y`
+ * offset the drawn picture from the middle of its box.
+ */
+export type ImageZoom = { scale: number; x: number; y: number };
+
+type ImageZoomSize = { width: number; height: number };
+export type ImageZoomPoint = { x: number; y: number };
+
+/** The files preview's range: a tenth of the picture's own pixels to sixteen times it. */
+export const IMAGE_ZOOM_MIN_SCALE = 0.1;
+export const IMAGE_ZOOM_MAX_SCALE = 16;
+
+/**
+ * Keeps a zoom inside the files preview's range. Fit is always drawable: a
+ * picture smaller than its box fits above 100%, so the ceiling follows it, and
+ * one whose fit already sits under the floor stops at fit instead of shrinking
+ * past the box it fills.
+ */
+export const clampImageZoomScale = (scale: number, fitScale: number): number => (
+    Math.min(Math.max(IMAGE_ZOOM_MAX_SCALE, fitScale), Math.max(Math.min(IMAGE_ZOOM_MIN_SCALE, fitScale), scale))
+);
+
+/**
+ * The zoom after moving from `from` to `nextScale`, with the image point under
+ * `point` staying there. `center` is the middle of the image on screen and
+ * `fitScale` the scale fit draws it at.
+ */
+export const zoomImageAt = (
+    from: ImageZoom,
+    nextScale: number,
+    point: ImageZoomPoint,
+    center: ImageZoomPoint,
+    fitScale: number,
+): ImageZoom => {
+    const scale = clampImageZoomScale(nextScale, fitScale);
+    const ratio = scale / from.scale;
+    return {
+        scale,
