index 000000000..8ede5b181
--- /dev/null
+++ b/packages/ui/src/components/chat/message/imageViewerZoom.ts
@@ -0,0 +1,57 @@
+/** A zoom the chat image viewer applies to the picture it shows. */
+export type ImageZoom = { scale: number; x: number; y: number };
+
+type ImageZoomSize = { width: number; height: number };
+export type ImageZoomPoint = { x: number; y: number };
+
+/** Fit is scale 1: the viewer's picture already sits inside the screen. */
+export const FIT_IMAGE_ZOOM: ImageZoom = { scale: 1, x: 0, y: 0 };
+
+const MAX_ZOOM_SCALE = 8;
+
+/** Keeps a pinch or wheel zoom between fit and the largest scale the viewer draws. */
+export const clampImageZoomScale = (scale: number): number => Math.min(MAX_ZOOM_SCALE, Math.max(1, scale));
+
+/**
+ * The zoom after moving from `from` to `nextScale`, with the image point under
+ * `point` staying there. `center` is the middle of the image on screen.
+ */
+export const zoomImageAt = (
+    from: ImageZoom,
+    nextScale: number,
+    point: ImageZoomPoint,
+    center: ImageZoomPoint,
+): ImageZoom => {
+    const scale = clampImageZoomScale(nextScale);
+    const ratio = scale / from.scale;
+    return {
+        scale,
+        x: point.x - center.x - ratio * (point.x - center.x - from.x),
+        y: point.y - center.y - ratio * (point.y - center.y - from.y),
+    };
+};
+
+/**
+ * Keeps a zoomed picture on screen: a picture larger than the viewer covers
+ * it, a smaller one stays inside it. `centerOffset` is the image's middle
+ * measured from the viewer's middle.
+ */
+export const clampImageZoomOffset = (
+    zoom: ImageZoom,
+    image: ImageZoomSize,
+    viewport: ImageZoomSize,
+    centerOffset: ImageZoomPoint,
+): ImageZoom => {
+    if (zoom.scale <= 1) return FIT_IMAGE_ZOOM;
+
+    const clampAxis = (offset: number, scaledLength: number, viewportLength: number, center: number): number => {
+        const limit = Math.abs(scaledLength / 2 - viewportLength / 2);
+        return Math.min(limit - center, Math.max(-limit - center, offset));
+    };
+
+    return {
+        scale: zoom.scale,
+        x: clampAxis(zoom.x, image.width * zoom.scale, viewport.width, centerOffset.x),
+        y: clampAxis(zoom.y, image.height * zoom.scale, viewport.height, centerOffset.y),
+    };
+};
