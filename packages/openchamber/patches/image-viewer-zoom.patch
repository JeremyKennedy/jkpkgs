@@ -0,0 +1,78 @@
+import React from 'react';
+
+import { Icon } from '@/components/icon/Icon';
+import { Button } from '@/components/ui/button';
+import { ButtonTooltip } from '@/components/ui/action-toolbar';
+import { useI18n } from '@/lib/i18n';
+
+/**
+ * The − / percentage / + / Fit cluster above an image: the files preview's
+ * zoom bar, shared with the chat's image viewer so both read and step the same
+ * way. Callers keep their own zoom model and pass the percentage the picture is
+ * drawn at, 100% being one image pixel per screen pixel.
+ */
+export const ImageZoomControls: React.FC<{
+  /** What the picture is drawn at now, in percent of its own size. */
+  percent: number;
+  /** Fit is what the viewer shows now, so the chip reads as pressed. */
+  atFit: boolean;
+  /** The picture's real size is not known yet, so there is nothing to step. */
+  disabled?: boolean;
+  onZoomOut: () => void;
+  onZoomIn: () => void;
+  /** Draw the picture one pixel per screen pixel. */
+  onActualSize: () => void;
+  onFit: () => void;
+}> = ({ percent, atFit, disabled = false, onZoomOut, onZoomIn, onActualSize, onFit }) => {
+  const { t } = useI18n();
+  return (
+    <>
+      <ButtonTooltip side="bottom" label={t('filesView.artifact.image.zoomOut')}>
+        <Button
+          variant="ghost"
+          size="xs"
+          aria-label={t('filesView.artifact.image.zoomOut')}
+          disabled={disabled}
+          onClick={onZoomOut}
+        >
+          <Icon name="subtract" className="size-3.5" />
+        </Button>
+      </ButtonTooltip>
+      <ButtonTooltip side="bottom" label={t('filesView.artifact.image.actualTitle')}>
+        <Button
+          variant="ghost"
+          size="xs"
+          className="min-w-11 tabular-nums"
+          aria-label={t('filesView.artifact.image.actualTitle')}
+          disabled={disabled}
+          onClick={onActualSize}
+        >
+          {`${Math.round(percent)}%`}
+        </Button>
+      </ButtonTooltip>
+      <ButtonTooltip side="bottom" label={t('filesView.artifact.image.zoomIn')}>
+        <Button
+          variant="ghost"
+          size="xs"
+          aria-label={t('filesView.artifact.image.zoomIn')}
+          disabled={disabled}
+          onClick={onZoomIn}
+        >
+          <Icon name="add" className="size-3.5" />
+        </Button>
+      </ButtonTooltip>
+      {/* Fit works at any scale, so unlike the steps it never disables. */}
+      <ButtonTooltip side="bottom" label={t('filesView.artifact.image.fitTitle')}>
+        <Button
+          variant="chip"
+          size="xs"
+          aria-pressed={atFit}
+          aria-label={t('filesView.artifact.image.fitTitle')}
+          onClick={onFit}
+        >
+          {t('filesView.artifact.image.fit')}
+        </Button>
+      </ButtonTooltip>
+    </>
+  );
+};
