+import { describe, expect, test } from 'bun:test';
+
+import {
+    IMAGE_ZOOM_MAX_SCALE,
+    clampImageZoomOffset,
+    clampImageZoomScale,
+    zoomImageAt,
+} from './imageViewerZoom';
+
+describe('clampImageZoomScale', () => {
+    test('a zoom stays inside the files preview range', () => {
+        expect(clampImageZoomScale(0.04, 0.48)).toBe(0.48);
+        expect(clampImageZoomScale(3, 0.48)).toBe(3);
+        expect(clampImageZoomScale(40, 0.48)).toBe(IMAGE_ZOOM_MAX_SCALE);
+    });
+
+    test('fit stays drawable below the floor and above the ceiling', () => {
+        // A huge picture fits under a tenth of its own pixels; fit is the floor.
+        expect(clampImageZoomScale(0.0759, 0.0759)).toBe(0.0759);
+        // A small picture is drawn upscaled at fit, past sixteen times its pixels.
+        expect(clampImageZoomScale(42, 42)).toBe(42);
+    });
+});
+
+describe('zoomImageAt', () => {
+    test('zooming keeps the picture point under the pointer', () => {
+        const center = { x: 400, y: 300 };
+        const point = { x: 500, y: 350 };
+        const from = { scale: 0.5, x: 0, y: 0 };
+        const zoom = zoomImageAt(from, 1, point, center, 0.5);
+
+        expect(zoom).toEqual({ scale: 1, x: -100, y: -50 });
+        // The picture point under the pointer still lands under it.
+        const pictureX = (point.x - center.x - from.x) / from.scale;
+        const pictureY = (point.y - center.y - from.y) / from.scale;
+        expect(center.x + pictureX * zoom.scale + zoom.x).toBe(point.x);
+        expect(center.y + pictureY * zoom.scale + zoom.y).toBe(point.y);
+    });
+
+    test('zooming from a panned picture keeps its point under the pointer', () => {
+        const center = { x: 400, y: 300 };
+        const point = { x: 500, y: 350 };
+        const from = { scale: 1, x: -100, y: -50 };
+        const zoom = zoomImageAt(from, 1.5, point, center, 0.5);
+
+        const pictureX = (point.x - center.x - from.x) / from.scale;
+        const pictureY = (point.y - center.y - from.y) / from.scale;
+        expect(center.x + pictureX * zoom.scale + zoom.x).toBe(point.x);
+        expect(center.y + pictureY * zoom.scale + zoom.y).toBe(point.y);
+    });
+});
+
+describe('clampImageZoomOffset', () => {
+    test('a picture drawn under its box sits centred and drops an offset', () => {
+        expect(clampImageZoomOffset(
+            { scale: 0.5, x: 40, y: -20 },
+            0.5,
+            { width: 200, height: 100 },
+            { width: 800, height: 600 },
+            { x: 0, y: 40 },
+        )).toEqual({ scale: 0.5, x: 0, y: 0 });
+    });
+
+    test('fit ignores an offset a pinch left behind', () => {
+        expect(clampImageZoomOffset(
+            { scale: 1, x: 80, y: -40 },
+            1,
+            { width: 200, height: 100 },
+            { width: 800, height: 600 },
+            { x: 0, y: 40 },
+        )).toEqual({ scale: 1, x: 0, y: 0 });
+    });
+
+    test('a picture smaller than the viewer stays inside it', () => {
+        const zoom = clampImageZoomOffset(
+            { scale: 2, x: 900, y: -900 },
+            2,
+            { width: 200, height: 100 },
+            { width: 800, height: 600 },
+            { x: 0, y: 40 },
+        );
+
+        expect(zoom).toEqual({ scale: 2, x: 200, y: -240 });
+    });
+
+    test('a picture larger than the viewer keeps it covered', () => {
+        const zoom = clampImageZoomOffset(
+            { scale: 8, x: 5000, y: -5000 },
+            8,
+            { width: 200, height: 100 },
+            { width: 800, height: 600 },
+            { x: 0, y: 40 },
+        );
+
+        expect(zoom).toEqual({ scale: 8, x: 400, y: -140 });
+    });
+
+    test('with the controls visible, a zoomed picture pans until its top edge sits under them', () => {
+        const zoom = clampImageZoomOffset(
+            { scale: 8, x: 5000, y: 5000 },
+            8,
+            { width: 200, height: 100 },
+            { width: 800, height: 600 },
+            { x: 0, y: 0 },
+            { top: 53, bottom: 0 },
+        );
+
+        expect(zoom).toEqual({ scale: 8, x: 400, y: 153 });
+        // The top edge is at the controls' bottom, not above the viewport.
+        expect(300 + zoom.y - (100 * 8) / 2).toBe(53);
+    });
+
+    test('with the controls hidden, the picture reaches the viewport edge', () => {
+        const zoom = clampImageZoomOffset(
+            { scale: 8, x: 5000, y: 5000 },
+            8,
+            { width: 200, height: 100 },
+            { width: 800, height: 600 },
+            { x: 0, y: 0 },
+        );
+
+        expect(zoom).toEqual({ scale: 8, x: 400, y: 100 });
+        expect(300 + zoom.y - (100 * 8) / 2).toBe(0);
+    });
+});
