@@ -0,0 +1,59 @@
+import { describe, expect, test } from 'vitest';
+
+import { FIT_IMAGE_ZOOM, clampImageZoomOffset, clampImageZoomScale, zoomImageAt } from './imageViewerZoom';
+
+describe('imageViewerZoom', () => {
+    test('a zoom stays between fit and the largest scale', () => {
+        expect(clampImageZoomScale(0.4)).toBe(1);
+        expect(clampImageZoomScale(3)).toBe(3);
+        expect(clampImageZoomScale(40)).toBe(8);
+    });
+
+    test('zooming keeps the picture point under the pointer', () => {
+        const center = { x: 400, y: 300 };
+        const point = { x: 500, y: 350 };
+        const zoom = zoomImageAt(FIT_IMAGE_ZOOM, 2, point, center);
+
+        expect(zoom).toEqual({ scale: 2, x: -100, y: -50 });
+        // The point moved with the picture: center + 2 * (point - center) + offset.
+        expect(center.x + 2 * (point.x - center.x) + zoom.x).toBe(point.x);
+        expect(center.y + 2 * (point.y - center.y) + zoom.y).toBe(point.y);
+    });
+
+    test('zooming from a panned picture keeps its point under the pointer', () => {
+        const center = { x: 400, y: 300 };
+        const point = { x: 500, y: 350 };
+        const from = { scale: 2, x: -100, y: -50 };
+        const zoom = zoomImageAt(from, 3, point, center);
+
+        expect(center.x + 3 * (point.x - center.x) + zoom.x).toBe(point.x);
+        expect(center.y + 3 * (point.y - center.y) + zoom.y).toBe(point.y);
+    });
+
+    test('fit ignores an offset a pinch left behind', () => {
+        expect(clampImageZoomOffset({ scale: 1, x: 80, y: -40 }, { width: 200, height: 100 }, { width: 800, height: 600 }, { x: 0, y: 40 }))
+            .toEqual(FIT_IMAGE_ZOOM);
+    });
+
+    test('a picture smaller than the viewer stays inside it', () => {
+        const zoom = clampImageZoomOffset(
+            { scale: 2, x: 900, y: -900 },
+            { width: 200, height: 100 },
+            { width: 800, height: 600 },
+            { x: 0, y: 40 },
+        );
+
+        expect(zoom).toEqual({ scale: 2, x: 200, y: -240 });
+    });
+
+    test('a picture larger than the viewer keeps it covered', () => {
+        const zoom = clampImageZoomOffset(
+            { scale: 8, x: 5000, y: -5000 },
+            { width: 200, height: 100 },
+            { width: 800, height: 600 },
+            { x: 0, y: 40 },
+        );
+
+        expect(zoom).toEqual({ scale: 8, x: 400, y: -140 });
+    });
+});
