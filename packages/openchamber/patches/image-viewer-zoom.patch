+    zoom: ImageZoom,
+    drawnScale: number,
+    image: ImageZoomSize,
+    viewport: ImageZoomSize,
+    centerOffset: ImageZoomPoint,
+): ImageZoom => {
+    if (drawnScale <= 1) return { scale: zoom.scale, x: 0, y: 0 };
+
+    const clampAxis = (offset: number, scaledLength: number, viewportLength: number, center: number): number => {
+        const limit = Math.abs(scaledLength / 2 - viewportLength / 2);
+        return Math.min(limit - center, Math.max(-limit - center, offset));
+    };
+
+    return {
+        scale: zoom.scale,
+        x: clampAxis(zoom.x, image.width * drawnScale, viewport.width, centerOffset.x),
+        y: clampAxis(zoom.y, image.height * drawnScale, viewport.height, centerOffset.y),
+    };
+};
