--- /dev/null
+++ b/packages/ui/src/components/sections/openchamber/SessionWorkSettings.test.tsx
@@ -0,0 +1,140 @@
+import React, { act } from 'react';
+import type { Root } from 'react-dom/client';
+import { afterEach, beforeEach, describe, expect, mock, spyOn, test } from 'bun:test';
+import { Window } from 'happy-dom';
+
+import { DEFAULT_WORK_PAGE_SIZE } from '@/lib/workPageSize';
+
+/**
+ * The In work page-size row is the only control this section shows behind a
+ * toggle, and its reset is the number the setting documents. Both are user
+ * behaviour the row model's tests cannot see.
+ */
+
+const state = {
+  sessionWorkEnabled: true,
+  showChatsSection: true,
+  workPageSize: DEFAULT_WORK_PAGE_SIZE,
+  setShowChatsSection: (_show: boolean) => undefined,
+  setWorkPageSize: (_size: number) => undefined,
+};
+
+const settingsWrites: Array<{ sidebarWorkPageSize: number }> = [];
+
+mock.module('@/stores/useUIStore', () => ({
+  useUIStore: <T,>(selector: (value: { sessionWorkEnabled: boolean; setSessionWorkEnabled: () => void }) => T): T => (
+    selector({ sessionWorkEnabled: state.sessionWorkEnabled, setSessionWorkEnabled: () => undefined })
+  ),
+}));
+mock.module('@/stores/useSessionDisplayStore', () => ({
+  useSessionDisplayStore: <T,>(selector: (value: typeof state) => T): T => selector(state),
+}));
+mock.module('@/lib/persistence', () => ({
+  updateDesktopSettings: async (changes: { sidebarWorkPageSize: number }) => {
+    settingsWrites.push(changes);
+  },
+}));
+mock.module('@/components/sections/shared/SettingsSection', () => ({
+  SettingsSection: ({ children }: { children: React.ReactNode }) => <section>{children}</section>,
+  SettingsFieldRow: ({ settingsItem, children }: { settingsItem?: string; children: React.ReactNode }) => (
+    <div data-settings-item={settingsItem}>{children}</div>
+  ),
+  SettingsCheckboxRow: ({ settingsItem, checked }: { settingsItem?: string; checked: boolean }) => (
+    <i data-settings-item={settingsItem} data-checked={checked ? 'true' : 'false'} />
+  ),
+  SETTINGS_ICON_BUTTON_CLASS: '',
+  SETTINGS_NUMBER_INPUT_CLASS: '',
+  SETTINGS_NUMBER_STEPPER_ROW_CLASS: '',
+  SETTINGS_OPTION_STACK_CLASS: '',
+}));
+
+const browser = new Window({ url: 'http://localhost/' });
+Object.assign(globalThis, {
+  window: browser,
+  document: browser.document,
+  navigator: browser.navigator,
+  localStorage: browser.localStorage,
+  sessionStorage: browser.sessionStorage,
+  Node: browser.Node,
+  Element: browser.Element,
+  HTMLElement: browser.HTMLElement,
+  HTMLInputElement: browser.HTMLInputElement,
+  HTMLButtonElement: browser.HTMLButtonElement,
+  SVGElement: browser.SVGElement,
+  Event: browser.Event,
+  MouseEvent: browser.MouseEvent,
+  FocusEvent: browser.FocusEvent,
+  CustomEvent: browser.CustomEvent,
+  MutationObserver: browser.MutationObserver,
+  ResizeObserver: browser.ResizeObserver,
+  getComputedStyle: browser.getComputedStyle.bind(browser),
+  requestAnimationFrame: browser.requestAnimationFrame.bind(browser),
+  cancelAnimationFrame: browser.cancelAnimationFrame.bind(browser),
+  IS_REACT_ACT_ENVIRONMENT: true,
+});
+spyOn(globalThis, 'fetch').mockImplementation(() => new Promise<Response>(() => undefined));
+
+const { createRoot } = await import('react-dom/client');
+const { I18nProvider } = await import('@/lib/i18n');
+const { SessionWorkSettings } = await import('./SessionWorkSettings');
+
+const ROW = '[data-settings-item="sessions.work-page-size"]';
+let root: Root;
+let container: HTMLDivElement;
+
+const render = async (): Promise<void> => {
+  await act(async () => {
+    root.render(<I18nProvider><SessionWorkSettings /></I18nProvider>);
+  });
+};
+
+beforeEach(async () => {
+  state.sessionWorkEnabled = true;
+  state.showChatsSection = true;
+  state.workPageSize = DEFAULT_WORK_PAGE_SIZE;
+  state.setWorkPageSize = (size: number) => {
+    state.workPageSize = size;
+  };
+  settingsWrites.length = 0;
+  container = document.createElement('div');
+  document.body.appendChild(container);
+  root = createRoot(container);
+});
+
+afterEach(async () => {
+  await act(async () => root.unmount());
+  container.remove();
+});
+
+const resetButton = (): HTMLButtonElement => {
+  const button = [...container.querySelectorAll('button')].find((entry) => (entry.getAttribute('aria-label') ?? '').startsWith('Reset'));
+  if (!button) throw new Error('the row has no reset button');
+  return button;
+};
+
+describe('In work page size row', () => {
+  test('renders only while sessions in work are on', async () => {
+    await render();
+    expect(container.querySelector(ROW)).not.toBeNull();
+
+    state.sessionWorkEnabled = false;
+    await render();
+    expect(container.querySelector(ROW)).toBeNull();
+  });
+
+  test('resets the page size to the shared default and stores it', async () => {
+    state.workPageSize = 20;
+    await render();
+    expect(resetButton().disabled).toBe(false);
+
+    await act(async () => resetButton().click());
+
+    expect(state.workPageSize).toBe(DEFAULT_WORK_PAGE_SIZE);
+    expect(settingsWrites).toEqual([{ sidebarWorkPageSize: DEFAULT_WORK_PAGE_SIZE }]);
+  });
+
+  test('disables the reset while the page size is the default', async () => {
+    await render();
+    expect(resetButton().disabled).toBe(true);
+  });
+});
