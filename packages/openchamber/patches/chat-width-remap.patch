+++ b/packages/ui/src/lib/chatWidth.ts
@@ -0,0 +1,28 @@
+import type { ChatWidth } from '@/stores/useUIStore';
+
+const CHAT_WIDTHS: ReadonlySet<string> = new Set<ChatWidth>(['default', 'wider', 'full']);
+
+/**
+ * Levels an earlier local build stored, each mapped to the nearest level here:
+ * Compact (48rem) is the reading column, Standard (64rem) and Wide (80rem) the
+ * wider column, and Full Width (the transcript across the chat) is Full.
+ */
+const LEGACY_CHAT_WIDTHS: Readonly<Record<string, ChatWidth>> = {
+  compact: 'default',
+  standard: 'wider',
+  wide: 'wider',
+  'full-width': 'full',
+};
+
+export const isChatWidth = (value: unknown): value is ChatWidth =>
+  typeof value === 'string' && CHAT_WIDTHS.has(value);
+
+/**
+ * A stored chat width as a level this build knows: a current level as is, a
+ * legacy level mapped, anything else `undefined` so the caller picks the fallback.
+ */
+export const readChatWidth = (value: unknown): ChatWidth | undefined => {
+  if (isChatWidth(value)) return value;
+  if (typeof value !== 'string') return undefined;
+  return Object.hasOwn(LEGACY_CHAT_WIDTHS, value) ? LEGACY_CHAT_WIDTHS[value] : undefined;
+};
