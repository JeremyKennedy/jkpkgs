+import { afterEach, beforeEach, describe, expect, test } from 'bun:test';
+import { Window } from 'happy-dom';
+import React, { act } from 'react';
+import { createRoot, type Root } from 'react-dom/client';
+
+import { useUIStore, type ChatWidth } from '@/stores/useUIStore';
+import { useChatWidthAttribute } from './useChatWidthAttribute';
+
+const Probe = () => {
+  useChatWidthAttribute();
+  return null;
+};
+
+describe('useChatWidthAttribute', () => {
+  let windowInstance: Window;
+  let root: Root;
+  const originalChatWidth = useUIStore.getState().chatWidth;
+
+  // A level that bypassed the store's typed setter, as a stale store could hold.
+  const renderWith = async (chatWidth: string) => {
+    // SAFETY: the test writes a level the type does not allow on purpose.
+    useUIStore.setState({ chatWidth: chatWidth as ChatWidth });
+    await act(async () => root.render(<Probe />));
+    return document.documentElement.getAttribute('data-chat-width');
+  };
+
+  beforeEach(() => {
+    windowInstance = new Window();
+    Object.assign(globalThis, {
+      window: windowInstance,
+      document: windowInstance.document,
+      navigator: windowInstance.navigator,
+      HTMLElement: windowInstance.HTMLElement,
+      Element: windowInstance.Element,
+      Node: windowInstance.Node,
+      IS_REACT_ACT_ENVIRONMENT: true,
+    });
+    const host = document.createElement('div');
+    document.body.append(host);
+    root = createRoot(host);
+  });
+
+  afterEach(async () => {
+    await act(async () => root.unmount());
+    useUIStore.setState({ chatWidth: originalChatWidth });
+    windowInstance.close();
+  });
+
+  const cases: Array<[stored: string, attribute: string | null]> = [
+    ['default', null],
+    ['wider', 'wider'],
+    ['full', 'full'],
+    ['compact', null],
+    ['standard', 'wider'],
+    ['wide', 'wider'],
+    ['full-width', 'full'],
+    ['huge', null],
+  ];
+  for (const [stored, attribute] of cases) {
+    test(`${stored} sets data-chat-width to ${String(attribute)}`, async () => {
+      expect(await renderWith(stored)).toBe(attribute);
+    });
+  }
+});
