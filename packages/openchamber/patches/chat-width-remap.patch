+
+// An earlier local build stored five levels under the same store version 30.
+type LegacyStoredUIState = Omit<StoredUIState, 'chatWidth'> & { chatWidth?: string };
+const hydrateLegacy = (version: number, chatWidth: string) =>
+  // SAFETY: the stored document deliberately carries a level the type does not allow.
+  hydrate(version, { chatWidth } as LegacyStoredUIState as StoredUIState);
+
+describe('legacy local chat width levels', () => {
+  const cases: Array<[stored: string, level: string]> = [
+    ['compact', 'default'],
+    ['standard', 'wider'],
+    ['wide', 'wider'],
+    ['full-width', 'full'],
+    ['full', 'full'],
+  ];
+  for (const [stored, level] of cases) {
+    test(`a v30 store with ${stored} reads as ${level}`, async () => {
+      expect((await hydrateLegacy(30, stored)).chatWidth).toBe(level);
+    });
+  }
+
+  test('an unknown level at v30 reads as Default', async () => {
+    expect((await hydrateLegacy(30, 'huge')).chatWidth).toBe('default');
+  });
+
+  test('an unknown level from a later store version is clamped on every hydration', async () => {
+    expect((await hydrateLegacy(31, 'huge')).chatWidth).toBe('default');
+    expect((await hydrateLegacy(31, 'wider')).chatWidth).toBe('wider');
+  });
+});
