diff --git a/packages/ui/src/sync/recoverable-questions.ts b/packages/ui/src/sync/recoverable-questions.ts
--- a/packages/ui/src/sync/recoverable-questions.ts
+++ b/packages/ui/src/sync/recoverable-questions.ts
@@ -103,8 +103,16 @@
 // Unknown wording fails closed. Shutdown keeps OpenCode's turn resumable.
 export function classifyQuestionToolError(error: string, errorType: string | undefined, local: boolean): QuestionAskOutcome {
   if (local) return error === "Interrupted" ? "turn-death" : "unresolved"
-  if (errorType !== undefined && errorType !== "aborted") return "dismissed"
+  // "unknown" is the wrapper type OpenCode puts on an error it did not
+  // classify, and the app's own interrupt arrives that way. Treating it as a
+  // typed error made every interrupted question read as the reader dismissing
+  // it, so the unknown case falls through to the wording below like an untyped
+  // error does.
+  if (errorType !== undefined && errorType !== "aborted" && errorType !== "unknown") return "dismissed"
   if (error === "Tool execution interrupted") return "turn-death"
+  // An interrupt that reaches the turn as this message ended the run, not the
+  // reader's answer.
+  if (error === "All fibers interrupted without error") return "turn-death"
   if (error === "Interaction cancelled because the location shut down") return "shutdown"
   return "unresolved"
 }
