+
+const guest = (id: string, overrides: Partial<InstalledGuest> = {}): InstalledGuest => ({
+  id,
+  name: id,
+  icon: 'apps',
+  capabilities: { requested: [], granted: [] },
+  ...overrides,
+});
+
+describe('guestPanelGuests', () => {
+  test('offers a panel tab for an active guest with a page or a shared surface only', () => {
+    const guests = [
+      guest('paused', { entry: 'panel/index.html', enabled: false }),
+      guest('unapproved', { entry: 'panel/index.html', capabilities: { requested: ['files'], granted: [] } }),
+      guest('page-only', { pageEntry: 'panel/page.html' }),
+      guest('surface-only', { service: sharedSurface }),
+      guest('background-only', { backgroundEntry: 'background/index.html' }),
+      guest('panel-one', { entry: 'panel/index.html' }),
+      guest('surface-and-panel', { entry: 'panel/index.html', service: sharedSurface }),
