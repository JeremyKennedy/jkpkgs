@@ -0,0 +1,96 @@
+import { beforeEach, describe, expect, mock, test } from 'bun:test';
+import type { PushNotificationSchema } from '@capacitor/push-notifications';
+
+let platform: 'ios' | 'android' | 'web' = 'web';
+let delivered: PushNotificationSchema[] = [];
+let removed: PushNotificationSchema[][] = [];
+let readFailure: Error | null = null;
+
+mock.module('@/lib/platform', () => ({ getClientPlatform: () => platform }));
+mock.module('@capacitor/push-notifications', () => ({
+  PushNotifications: {
+    getDeliveredNotifications: async () => {
+      if (readFailure) throw readFailure;
+      return { notifications: delivered };
+    },
+    removeDeliveredNotifications: async ({ notifications }: { notifications: PushNotificationSchema[] }) => {
+      removed.push(notifications);
+    },
+  },
+}));
+
+const { clearNativeSessionNotifications } = await import('./nativeNotifications');
+
+// SAFETY: the clear path reads only id and data, which the fixture sets.
+const banner = (id: string, sessionId?: string): PushNotificationSchema => ({
+  id,
+  title: 'Agent response is ready',
+  body: '',
+  data: sessionId ? { sessionId } : { type: 'pull-request' },
+} as PushNotificationSchema);
+
+describe('clearing native session notifications', () => {
+  beforeEach(() => {
+    platform = 'android';
+    delivered = [];
+    removed = [];
+    readFailure = null;
+  });
+
+  test('removes only the banners of the sessions the user saw', async () => {
+    delivered = [
+      banner('a', 'ses_seen'),
+      banner('b', 'ses_other'),
+      banner('c', 'ses_seen'),
+      banner('d'),
+    ];
+
+    await clearNativeSessionNotifications(['ses_seen']);
+
+    expect(removed).toEqual([[delivered[0], delivered[2]]]);
+  });
+
+  test('removes banners for every session marked seen', async () => {
+    delivered = [banner('a', 'ses_one'), banner('b', 'ses_two'), banner('c', 'ses_other')];
+
+    await clearNativeSessionNotifications(['ses_one', 'ses_two']);
+
+    expect(removed).toEqual([[delivered[0], delivered[1]]]);
+  });
+
+  test('does nothing when no banner belongs to the session', async () => {
+    delivered = [banner('a', 'ses_other')];
+
+    await clearNativeSessionNotifications(['ses_seen']);
+
+    expect(removed).toEqual([]);
+  });
+
+  test('marking everything seen removes every banner of the known sessions and leaves pull requests', async () => {
+    delivered = [banner('a', 'ses_one'), banner('b', 'ses_two'), banner('c')];
+
+    await clearNativeSessionNotifications(['ses_one', 'ses_two']);
+
+    expect(removed).toEqual([[delivered[0], delivered[1]]]);
+  });
+
+  test('runs on iOS and stays quiet elsewhere', async () => {
+    delivered = [banner('a', 'ses_seen')];
+
+    platform = 'web';
+    await clearNativeSessionNotifications(['ses_seen']);
+    expect(removed).toEqual([]);
+
+    platform = 'ios';
+    await clearNativeSessionNotifications(['ses_seen']);
+    expect(removed).toEqual([[delivered[0]]]);
+  });
+
+  test('survives a list read that fails before registration completes', async () => {
+    readFailure = new Error('registration not called');
+
+    await clearNativeSessionNotifications(['ses_seen']);
+
+    expect(removed).toEqual([]);
+  });
+});
diff --git a/packages/ui/src/lib/nativeNotifications.ts b/packages/ui/src/lib/nativeNotifications.ts
new file mode 100644
index 000000000..5cf8048c7
--- /dev/null
+++ b/packages/ui/src/lib/nativeNotifications.ts
@@ -0,0 +1,50 @@
+// Removes the native app's delivered notifications for sessions the user has
+// seen. Desktop clears its own through the Electron IPC command in
+// `desktop.ts`; a browser has no delivered-notification list to clear.
+//
+// The Capacitor push plugin owns the delivered-notification list on both
+// platforms, so no app-local native plugin is needed: `getDeliveredNotifications`
+// returns each banner with its `data`, which carries `sessionId` from the push
+// (Android's `SealedPushMessagingService` copies it into the notification's
+// extras, iOS keeps it in the request's userInfo). Matching on that id, never on
+// the banner tag, keeps a session's banners apart from pull-request alerts,
+// which name no session.
+
+import type { PushNotificationSchema } from '@capacitor/push-notifications';
+
+import { getClientPlatform } from '@/lib/platform';
+
+// The plugin types `data` as `any`. This app's push sender puts a string
+// `sessionId` there, so that is the shape read at this boundary; a banner from
+// another sender, such as a pull-request alert, has none and does not match.
+type SessionPushData = { sessionId?: string };
+
+const sessionIdOf = (notification: PushNotificationSchema): string | undefined => {
+  const data: SessionPushData | undefined = notification.data;
+  return data?.sessionId;
+};
+
+const removeDelivered = async (matches: (notification: PushNotificationSchema) => boolean): Promise<void> => {
+  const platform = getClientPlatform();
+  if (platform !== 'ios' && platform !== 'android') return;
+
+  try {
+    const { PushNotifications } = await import('@capacitor/push-notifications');
+    const delivered = await PushNotifications.getDeliveredNotifications();
+    const matching = delivered.notifications.filter(matches);
+    if (matching.length === 0) return;
+    await PushNotifications.removeDeliveredNotifications({ notifications: matching });
+  } catch {
+    // The plugin rejects the list read before its registration completes, and
+    // the next view clears what this one missed.
+  }
+};
+
+export const clearNativeSessionNotifications = async (sessionIds: readonly string[]): Promise<void> => {
+  if (sessionIds.length === 0) return;
+  const wanted = new Set(sessionIds);
+  await removeDelivered((notification) => {
+    const sessionId = sessionIdOf(notification);
+    return sessionId !== undefined && wanted.has(sessionId);
+  });
+};
