@@ -0,0 +1,77 @@
+import React, { act } from 'react';
+import { afterEach, beforeEach, describe, expect, test } from 'bun:test';
+import { Window } from 'happy-dom';
+
+describe('draft project picker request', () => {
+  let dom: Window;
+
+  beforeEach(() => {
+    dom = new Window({ url: 'http://localhost/' });
+    Object.assign(globalThis, {
+      window: dom,
+      document: dom.document,
+      navigator: dom.navigator,
+      IS_REACT_ACT_ENVIRONMENT: true,
+    });
+  });
+
+  afterEach(() => {
+    dom.close();
+  });
+
+  test('answers one open per request, never on mount', async () => {
+    const { createRoot } = await import('react-dom/client');
+    const { requestDraftProjectPicker, useDraftProjectPickerRequest } = await import('../draftProjectPickerRequest');
+
+    const opened: number[] = [];
+    const Harness = () => {
+      useDraftProjectPickerRequest(() => opened.push(opened.length + 1));
+      return null;
+    };
+    const container = document.createElement('div');
+    const root = createRoot(container);
+
+    await act(async () => root.render(<Harness />));
+    expect(opened).toEqual([]);
+
+    await act(async () => requestDraftProjectPicker());
+    expect(opened).toEqual([1]);
+
+    await act(async () => requestDraftProjectPicker());
+    expect(opened).toEqual([1, 2]);
+
+    await act(async () => root.unmount());
+    // A request after unmount reaches nobody.
+    await act(async () => requestDraftProjectPicker());
+    expect(opened).toEqual([1, 2]);
+  });
+
+  test('the heading name is a button only where a picker exists', async () => {
+    const { createRoot } = await import('react-dom/client');
+    const { DraftProjectName } = await import('../../../DraftProjectName');
+    const { setDraftProjectPickerOpen } = await import('../draftProjectPickerRequest');
+
+    const container = document.createElement('div');
+    const root = createRoot(container);
+
+    await act(async () => root.render(<DraftProjectName label="acme" />));
+    expect(container.querySelector('button')).toBeNull();
+    expect(container.textContent).toBe('acme');
+
+    let clicks = 0;
+    await act(async () => root.render(<DraftProjectName label="acme" onOpenPicker={() => { clicks += 1; }} />));
+    const button = container.querySelector('button');
+    expect(button?.getAttribute('aria-haspopup')).toBe('dialog');
+    expect(button?.getAttribute('aria-expanded')).toBe('false');
+    await act(async () => button?.click());
+    expect(clicks).toBe(1);
+
+    await act(async () => setDraftProjectPickerOpen(true));
+    expect(container.querySelector('button')?.getAttribute('aria-expanded')).toBe('true');
+
+    await act(async () => setDraftProjectPickerOpen(false));
+    expect(container.querySelector('button')?.getAttribute('aria-expanded')).toBe('false');
+
+    await act(async () => root.unmount());
+  });
+});
diff --git a/packages/ui/src/components/chat/composer/state/draftProjectPickerRequest.ts b/packages/ui/src/components/chat/composer/state/draftProjectPickerRequest.ts
new file mode 100644
index 000000000..2b61e6745
--- /dev/null
+++ b/packages/ui/src/components/chat/composer/state/draftProjectPickerRequest.ts
@@ -0,0 +1,42 @@
+import React from 'react';
+import { create } from 'zustand';
+
+// The project name inside a new-session heading is a second, larger way into
+// the project picker the composer shows beside it. The heading only asks; the
+// composer owns the popup and the mobile sheet, so it answers and reports
+// whether the picker is open back for the heading's `aria-expanded`. The
+// heading lives in a different component from the picker on some layouts (the
+// compact draft welcome), which is why the request travels through a store
+// instead of a callback prop.
+//
+// A counter rather than a flag: a tap while the picker is already open still
+// counts as a request, and no request outlives the tap that made it.
+const useRequest = create<{ nonce: number; open: boolean }>(() => ({ nonce: 0, open: false }));
+
+/** Asks the composer showing the draft to open its project picker. */
+export function requestDraftProjectPicker(): void {
+    useRequest.setState((state) => ({ nonce: state.nonce + 1 }));
+}
+
+/** Reports the picker's open state; the surface that owns it writes this. */
+export function setDraftProjectPickerOpen(open: boolean): void {
+    useRequest.setState({ open });
+}
+
+export function useDraftProjectPickerOpen(): boolean {
+    return useRequest((state) => state.open);
+}
+
+/**
+ * Runs `open` once for every request made after this hook mounted. Delivered
+ * from the store subscription rather than an effect: the tap must commit the
+ * picker's state in the same batch as the click, because the mobile shell
+ * reads it to decide whether to fold the composer as the keyboard hides.
+ */
+export function useDraftProjectPickerRequest(open: () => void): void {
+    const openRef = React.useRef(open);
+    openRef.current = open;
+    React.useEffect(() => useRequest.subscribe((state, previous) => {
+        if (state.nonce !== previous.nonce) openRef.current();
+    }), []);
+}
