+  const trustAsked = new Promise<void>((resolve) => { trustRequested = resolve; });
+  let releaseTrust: () => void = () => undefined;
+  const trustAnswered = new Promise<void>((resolve) => { releaseTrust = resolve; });
+  let trustReads = 0;
+  const read = spyOn(opencodeClient, 'getSessionUnscoped').mockImplementation(async (id: string) => session(id, '/outside'));
+  offline.mockImplementation(async (input) => {
+    const url = new URL(String(input));
+    if (url.pathname === '/api/opencode/trust') {
+      trustReads += 1;
+      if (trustReads === 1) {
+        trustRequested();
+        await trustAnswered;
+      }
+      return Response.json({ directory: '/outside', trusted: true, fingerprint: null, items: [] });
+    }
+    if (url.pathname === '/api/projects/session-directory') {
+      return Response.json({ project: { id: 'outside', path: '/outside' } });
