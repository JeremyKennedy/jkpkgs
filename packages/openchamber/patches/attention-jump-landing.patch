diff --git a/packages/ui/src/components/desktop/useDesktopHostList.ts b/packages/ui/src/components/desktop/useDesktopHostList.ts
new file mode 100644
index 000000000..dfbe11814
--- /dev/null
+++ b/packages/ui/src/components/desktop/useDesktopHostList.ts
@@ -0,0 +1,44 @@
+import React from 'react';
+import { isDesktopShell } from '@/lib/desktop';
+import type { DesktopHost } from '@/lib/desktopHosts';
+
+type DesktopHostList = {
+  hosts: DesktopHost[];
+  defaultHostId: string | null;
+  sshHostIds: Record<string, true>;
+};
+
+let lastRead: DesktopHostList | null = null;
+
+export const useDesktopHostList = () => {
+  const [configHosts, setConfigHosts] = React.useState<DesktopHost[]>(() => lastRead?.hosts ?? []);
+  const [defaultHostId, setDefaultHostId] = React.useState<string | null>(() => lastRead?.defaultHostId ?? null);
+  const [sshHostIds, setSshHostIds] = React.useState<Record<string, true>>(() => lastRead?.sshHostIds ?? {});
+  const [remembered] = React.useState(() => lastRead !== null);
+  const [readThisOpen, setReadThisOpen] = React.useState(() => !isDesktopShell());
+
+  const applyRead = React.useCallback((list: DesktopHostList | null) => {
+    lastRead = list;
+    setConfigHosts(list?.hosts ?? []);
+    setDefaultHostId(list?.defaultHostId ?? null);
+    setSshHostIds(list?.sshHostIds ?? {});
+    setReadThisOpen(true);
+  }, []);
+
+  const applySaved = React.useCallback((hosts: DesktopHost[], nextDefaultHostId: string | null) => {
+    if (lastRead) lastRead = { ...lastRead, hosts, defaultHostId: nextDefaultHostId };
+    setConfigHosts(hosts);
+    setDefaultHostId(nextDefaultHostId);
+  }, []);
+
+  return {
+    configHosts,
+    setConfigHosts,
+    defaultHostId,
+    sshHostIds,
+    hostsShown: remembered || readThisOpen,
+    hostsCurrent: readThisOpen,
+    applyRead,
+    applySaved,
+  };
+};
