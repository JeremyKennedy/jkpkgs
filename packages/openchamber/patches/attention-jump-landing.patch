@@ -0,0 +1,98 @@
+import { isOpencodeNotFound, opencodeClient } from '@/lib/opencode/client';
+import { normalizePath } from '@/lib/pathNormalization';
+import { openSession } from '@/lib/router/openSessionFromRoute';
+import { getRuntimeKey, subscribeRuntimeEndpointChanged } from '@/lib/runtime-switch';
+import { resolveGlobalSessionDirectory } from '@/stores/useGlobalSessionsStore';
+import { useProjectsStore } from '@/stores/useProjectsStore';
+import { admitSession, isSessionAdmitted } from './session-admission';
+import { getAdmissionNavigationRevision, useSessionUIStore } from './session-ui-store';
+
+export type HeldSessionOpen = {
+  readonly runtimeKey: string;
+  readonly sessionId: string;
+  readonly directory: string | null;
+};
+
+type SessionOpenOutcome = 'opened' | 'failed' | 'dropped';
+
+let held: HeldSessionOpen | null = null;
+
+export const holdSessionOpen = (target: HeldSessionOpen): HeldSessionOpen => {
+  held = target;
+  return target;
+};
+
+export const releaseSessionOpen = (target: HeldSessionOpen): void => {
+  if (held === target) held = null;
+};
+
+export const isSessionOpenHeld = (runtimeKey: string = getRuntimeKey()): boolean => held?.runtimeKey === runtimeKey;
+
+export const heldSessionOpen = (): HeldSessionOpen | null => held;
+
+type SessionRead = { readonly directory: string | null; readonly gone: boolean };
+
+const readSession = (sessionId: string): Promise<SessionRead> => opencodeClient.getSessionUnscoped(sessionId).then(
+  (session) => ({ directory: normalizePath(resolveGlobalSessionDirectory(session)), gone: false }),
+  (error) => ({ directory: null, gone: isOpencodeNotFound(error) }),
+);
+
+const projectListKnown = (): boolean => {
+  const projects = useProjectsStore.getState();
+  return projects.hasServerSnapshot || projects.serverSnapshotFailed;
+};
+
+const watchHold = (target: HeldSessionOpen) => {
+  const revision = getAdmissionNavigationRevision();
+  const left = () => held !== target
+    || getRuntimeKey() !== target.runtimeKey
+    || getAdmissionNavigationRevision() !== revision;
+  let wake: () => void = () => undefined;
+  let endpointChanges = 0;
+  const check = () => {
+    if (!left()) return;
+    releaseSessionOpen(target);
+    wake();
+  };
+  const stops = [
+    useSessionUIStore.subscribe(check),
+    useProjectsStore.subscribe(() => { check(); wake(); }),
+    subscribeRuntimeEndpointChanged(() => { endpointChanges += 1; check(); }),
+  ];
+  const until = (ready: () => boolean) => new Promise<void>((resolve) => {
+    wake = () => { if (left() || ready()) resolve(); };
+    wake();
+  });
+  return { left, until, endpointChanges: () => endpointChanges, stop: () => { for (const stop of stops) stop(); } };
+};
+
+export const completeSessionOpen = async (target: HeldSessionOpen): Promise<SessionOpenOutcome> => {
+  const hold = watchHold(target);
+  const settle = (outcome: SessionOpenOutcome): SessionOpenOutcome => {
+    hold.stop();
+    releaseSessionOpen(target);
+    return outcome;
+  };
+  if (hold.left()) return settle('dropped');
+
+  const [, read] = await Promise.all([hold.until(projectListKnown), readSession(target.sessionId)]);
+  if (hold.left()) return settle('dropped');
+  if (read.gone) return settle('failed');
+  const directory = read.directory ?? normalizePath(target.directory);
+  if (!directory) return settle('failed');
+
+  let admitted: string | null = null;
+  for (;;) {
+    const changesBefore = hold.endpointChanges();
+    admitted = isSessionAdmitted(directory) ? directory : await admitSession(target.sessionId, directory, true);
+    if (hold.left()) return settle('dropped');
+    if (admitted || hold.endpointChanges() === changesBefore) break;
+    await hold.until(projectListKnown);
+    if (hold.left()) return settle('dropped');
+  }
+  if (!admitted) return settle('failed');
+
+  settle('opened');
+  void openSession(target.sessionId, { directory: admitted });
+  return 'opened';
+};
