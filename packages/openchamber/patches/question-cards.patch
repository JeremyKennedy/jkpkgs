+            <div key={`${entry.partId}:${index}`} className="min-w-0 space-y-0.5 border-s-2 ps-2.5" style={RAIL_STYLE}>
+                <div dir="auto" className={cn('typography-meta text-foreground/70', !open && 'line-clamp-2')} title={entry.question}>
+                    {questionSentence(entry.question)}
+                </div>
+                {showOptions ? (
+                    <div className="space-y-1.5 pt-1">
+                        {entry.options.map((option) => {
+                            const chosen = picked.has(option.label);
+                            return (
+                                <div key={option.label} className="flex items-start gap-2.5">
