@@ -0,0 +1,188 @@
+import React from 'react';
+
+import { useDeviceInfo } from '@/lib/device';
+import { useI18n } from '@/lib/i18n';
+import { cn } from '@/lib/utils';
+import { hasTextSelectionInside } from '@/lib/textSelection';
+import type { Part } from '@/lib/opencode/model';
+import { useUIStore } from '@/stores/useUIStore';
+import {
+    questionCardState,
+    questionEntriesForPart,
+    questionSentence,
+    selectedOptionLabels,
+    withoutRecommendation,
+} from '../lib/questionEntries';
+import { stickyHeaderBackground } from './stickyHeaderBackground';
+import { USER_BUBBLE_TEXT_LINK_CLASS } from '../message/MessageBody';
+
+const RAIL_STYLE: React.CSSProperties = { borderColor: 'var(--status-question)' };
+
+// Match the prompt bubble's shape and subtle border without its body-sized
+// text or full-column footprint. The faint purple fill identifies questions.
+const CARD_STYLE: React.CSSProperties = {
+    borderRadius: 'var(--radius-xl)',
+    borderBottomRightRadius: 'var(--radius-sm)',
+    backgroundColor: 'color-mix(in srgb, var(--status-question-background) 55%, transparent)',
+};
+
+/** A filled mark for the chosen option, an empty ring for the rest. */
+const OptionMark: React.FC<{ chosen: boolean }> = ({ chosen }) => (
+    <span
+        aria-hidden="true"
+        className="mt-[5px] flex size-3.5 flex-shrink-0 items-center justify-center rounded-full border"
+        style={{ borderColor: chosen ? 'var(--status-question)' : 'var(--status-question-border)' }}
+    >
+        {chosen ? <span className="size-1.5 rounded-full" style={{ backgroundColor: 'var(--status-question)' }} /> : null}
+    </span>
+);
+
+/**
+ * A question call as its own transcript row: a purple card with each question
+ * and the answer it got on a rail, or a line saying it went unanswered. Show more opens the card in
+ * place to every option offered, the chosen one marked; a typed answer is one
+ * more marked row. With the sticky user header on, the card sticks like a
+ * prompt until the next prompt or answered question pushes it up, and an open
+ * card scrolls inside past 40% of the screen, as a long prompt does there.
+ */
+export const QuestionTurnHeader: React.FC<{
+    part: Part;
+    messageId: string;
+    /** The row starts its message, so it carries the message's anchor. */
+    startsMessage: boolean;
+    open: boolean;
+    onToggle: (partId: string) => void;
+}> = ({ part, messageId, startsMessage, open, onToggle }) => {
+    const { isMobile } = useDeviceInfo();
+    const { t } = useI18n();
+    const sticks = useUIStore((state) => state.stickyUserHeader);
+    const entries = React.useMemo(() => questionEntriesForPart(part, messageId), [part, messageId]);
+    const cardState = questionCardState(part);
+    // Every question in the call; one without an answer shows the call's state.
+    const answered = entries
+        .map((entry) => ({ entry, answer: entry.answer ? withoutRecommendation(entry.answer.trim()) : '' }));
+    if (answered.length === 0 || cardState === null) return null;
+    // As the stock question row does, a waiting question shows in the
+    // transcript while the form at the composer takes the answer.
+    const statusText = t(cardState === 'waiting' ? 'chat.toolPart.awaitingResponse'
+        : cardState === 'dismissed' ? 'chat.questionCard.notAnswered'
+            : 'chat.questionCard.stoppedBeforeAnswer');
+
+    const toggle = () => onToggle(part.id);
+
+    // Laid out like a prompt row (`ChatMessage`): the same column and top
+    // padding, and the reserve under it a prompt's action row takes (44px
+    // desktop, 36px mobile), which the sticky header's fade sits over.
+    const body = (
+        <div
+            className={cn('relative z-10 w-full', isMobile ? 'pt-2' : 'pt-4')}
+            data-question-turn-header=""
+            data-message-id={startsMessage ? messageId : undefined}
+        >
+            <div className="chat-message-column relative">
+                <div className="relative flex flex-col items-end">
+                    <div className="max-w-[85%]">
+                        <div
+                            className="select-text border border-primary/5 px-5 py-3 shadow-none"
+                            style={CARD_STYLE}
+                        >
+                            <div
+                                className={cn('space-y-2.5', open ? 'max-h-[40dvh] overflow-y-auto overscroll-contain' : 'cursor-pointer')}
+                                onClick={(event) => {
+                                    // Match UserTextPart: a click opens collapsed content;
+                                    // a drag/double-click selecting text must leave it alone.
+                                    // Open text never collapses on click (Show less does).
+                                    if (!open && !hasTextSelectionInside(event.currentTarget)) toggle();
+                                }}
+                            >
+                                {answered.map(({ entry, answer }) => {
