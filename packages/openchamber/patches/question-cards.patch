+                                    <span className="min-w-0">
+                                        <span
+                                            dir="auto"
+                                            className={cn('block break-words typography-markdown leading-snug', chosen ? 'font-medium text-foreground' : 'text-foreground/60')}
+                                        >
+                                            {option.label}
+                                        </span>
+                                        {option.description ? (
+                                            <span dir="auto" className="block break-words typography-meta text-foreground/50">
+                                                {option.description}
+                                            </span>
+                                        ) : null}
+                                    </span>
+                                </div>
+                            );
+                        })}
+                        {!answer ? (
+                            <div className="typography-markdown italic leading-snug text-muted-foreground">{statusText}</div>
+                        ) : null}
+                        {picked.size === 0 && answer ? (
+                            <div className="flex items-start gap-2.5">
+                                <OptionMark chosen />
+                                <span dir="auto" className="min-w-0 whitespace-pre-wrap break-words typography-markdown font-medium leading-snug text-foreground">
+                                    {answer}
+                                </span>
+                            </div>
+                        ) : null}
