+    if (answered.length === 0 || cardState === null) return null;
+    // As the stock question row does, a waiting question shows in the
+    // transcript while the form at the composer takes the answer.
+    const statusText = t(cardState === 'waiting' ? 'chat.toolPart.awaitingResponse'
+        : cardState === 'dismissed' ? 'chat.questionCard.notAnswered'
+            : 'chat.questionCard.stoppedBeforeAnswer');
+    const card = (
+        <QuestionCard
+            answered={answered} cardState={cardState} statusText={statusText} open={open} onToggle={() => onToggle(part.id)}
+            nested={nested} isMobile={isMobile}
+            rowAttributes={{ 'data-question-turn-header': '', 'data-message-id': startsMessage ? messageId : undefined }}
+        />
+    );
+
+    if (!pinned) return card;
+    if (!barred) {
+        return (
+            <div className="pointer-events-auto sticky top-0 z-20 [overflow-anchor:none]" data-turn-sticky-header="" style={stickyHeaderBackground(isMobile)}>
+                {card}
+            </div>
+        );
+    }
+
+    const background = stickyHeaderBackground(isMobile);
+    return (
+        <div className="relative [overflow-anchor:none]">
+            <div ref={flowRef} style={{ transform: `translateY(calc(-1 * var(${STICKY_ROW_OFFSET}, 0px)))` }}>
+                {card}
+            </div>
+            {covered ? (
+                // What covers the top of the chat, so it is the sticky header
+                // the scroll helpers measure.
+                <div className="pointer-events-auto absolute inset-x-0 top-0 z-10" data-turn-sticky-header="" data-question-bar="" style={background}>
+                    {barOpen ? (
+                        <QuestionCard
+                            answered={answered} cardState={cardState} statusText={statusText} open onToggle={() => setBarOpen(false)}
+                            nested={false} isMobile={isMobile}
+                        />
+                    ) : (
+                        <div className={cn('chat-message-column relative', isMobile ? 'pt-2 pb-4' : 'pt-3 pb-8')}>
+                            <div className="flex justify-end">
+                                <button
+                                    type="button"
+                                    onClick={() => setBarOpen(true)}
+                                    aria-expanded={false}
+                                    className="flex min-w-0 max-w-[85%] items-center gap-2 border border-primary/5 px-3 py-1.5 text-start"
+                                    style={CARD_STYLE}
+                                >
+                                    <span aria-hidden="true" className="h-4 shrink-0 border-s-2" style={RAIL_STYLE} />
+                                    <span className="shrink-0 typography-meta text-foreground/70">
+                                        {t('chat.questionCard.answerCount', { count: answered.length })}
+                                    </span>
+                                    <span dir="auto" className="min-w-0 truncate typography-markdown font-medium leading-snug text-foreground">
+                                        {answered.map(({ answer }) => answer || statusText).join(', ')}
+                                    </span>
+                                </button>
+                            </div>
+                        </div>
+                    )}
+                </div>
+            ) : null}
+        </div>
+    );
+};
