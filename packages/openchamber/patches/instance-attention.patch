+export const isUnreadSessionFields = (session: UnreadSessionFields | undefined): boolean => (
+  !session
+    ? false
+    : isUnreadFields(session.parentID, session.idle, session.viewed, session.archived === true)
+)
+
+/** Unread, and the turn that left it unread failed. */
