+} from './mobileConnections';
+import { mobileConnectionInputClass, mobileInputKeyboardProps } from './mobileConnectionUi';
+
+const SheetRow = ({ item, onOpen, children }: InstanceAttentionListRowProps): React.ReactNode => (
+  <MobileSheetRow onClick={() => onOpen(item)}>
+    {children}
+  </MobileSheetRow>
+);
+
+/**
+ * The phone's attention surface: a header bell with a count and a bottom sheet
+ * listing every waiting session, this connection's own included. The rows and
+ * the open path are the desktop ones; only the shell differs. Tapping a row on
+ * this connection opens its session, and tapping one on another saved server
+ * connects that server and opens the session.
+ *
+ * A server that needs a login stops the switch at a password prompt. The sheet
+ * keeps the prompt and the failure in place, so the tap is never a silent
+ * no-op: unlock here and the waiting session opens; cancel to pick another row.
+ */
+export const MobileInstanceAttentionBell: React.FC<{
+  open: boolean;
+  onOpenChange: (open: boolean) => void;
+}> = ({ open, onOpenChange }) => {
+  const { t } = useI18n();
+  const items = useInstanceAttentionStore((state) => state.items);
+  const hosts = useInstanceAttentionStore((state) => state.hosts);
+  const [password, setPassword] = React.useState('');
+  const pendingItemRef = React.useRef<InstanceAttentionItem | null>(null);
+  const tapInFlightRef = React.useRef(false);
+
+  // The sheet is opened to act on the waiters, so read them when it opens
+  // instead of showing whatever the last tick found on the other connections.
+  React.useEffect(() => {
+    if (!open) return;
+    void requestInstanceAttentionRefresh();
+  }, [open]);
+
+  const finishPendingJump = React.useCallback(() => {
+    const item = pendingItemRef.current;
+    if (!item) return;
+    pendingItemRef.current = null;
+    setPassword('');
+    finishInstanceAttentionJump(item);
+    onOpenChange(false);
+  }, [onOpenChange]);
+
+  const {
+    connections,
+    connect,
+    pendingConnection,
+    error,
+    isPasswordBusy,
+    submitPassword,
+    cancelPassword,
+  } = useMobileConnection(() => {
+    // A direct connect finishes inside the tap's own switch function, which
+    // owns closing the sheet. Only the password unlock reaches here alone.
+    if (tapInFlightRef.current) return;
+    finishPendingJump();
+  });
+
+  const clearPending = React.useCallback(() => {
+    pendingItemRef.current = null;
+    setPassword('');
+    if (pendingConnection) cancelPassword();
+  }, [cancelPassword, pendingConnection]);
+
+  React.useEffect(() => {
+    if (open) return;
+    clearPending();
+  }, [open, clearPending]);
+
+  const unreachableLabels = React.useMemo(() => [...new Set(
+    Object.values(hosts)
+      .filter((host) => host.status === 'error')
+      .map((host) => host.label),
