+    sessions: [{ id: 'ses_local', directory: '/repo', title: 'Local queue', archived: false, idle: 10 }],
+    pending: new Map(),
+    busy: new Set(),
+  }, 100);
+  await render(true);
+
+  const row = [...document.querySelectorAll('button')]
+    .find((button) => button.textContent?.includes('Local queue'));
+  expect(row?.textContent).toContain('This instance');
+  await act(async () => row?.click());
+
+  expect(connectCalls).toEqual([]);
+  expect(openedSessions).toEqual([['ses_local', '/repo']]);
+  expect(openChanges).toEqual([false]);
+  expect(useInstanceAttentionStore.getState().hosts[LOCAL_INSTANCE_ATTENTION_HOST_ID]).toBeDefined();
+});
+
+test('a server that needs a login keeps the sheet open with a password prompt', async () => {
+  seed();
+  needsLoginFor = 'host-b';
+  await render(true);
+
+  const row = findRow();
+  await act(async () => row?.click());
+
+  // The tap stopped at the prompt: nothing closed and nothing opened yet.
+  expect(openChanges).toEqual([]);
+  expect(openedSessions).toEqual([]);
+  expect(document.body.textContent).toContain('Unlock and connect');
+  expect(document.body.textContent).toContain('bee');
+  expect(document.querySelector('input[type="password"]')).not.toBeNull();
+  expect(useInstanceAttentionStore.getState().hosts['host-b']).toBeDefined();
+
+  await typePassword('secret');
+  await submitPasswordPrompt();
+
+  expect(openedSessions).toEqual([['ses_a', '/repo']]);
+  expect(openChanges).toEqual([false]);
+  expect(useInstanceAttentionStore.getState().hosts['host-b']).toBeUndefined();
+});
+
+test('a wrong password stays in the sheet with the failure shown', async () => {
+  seed();
+  needsLoginFor = 'host-b';
+  await render(true);
+
+  await act(async () => findRow()?.click());
+  await typePassword('wrong');
+  await submitPasswordPrompt();
+
+  expect(openedSessions).toEqual([]);
+  expect(openChanges).toEqual([]);
+  expect(document.body.textContent).toContain('Could not unlock that server. Check the password.');
+  expect(document.querySelector('input[type="password"]')).not.toBeNull();
+});
+
+test('a server that cannot be reached shows the error and keeps the sheet usable', async () => {
+  seed();
+  failsFor = 'host-b';
+  await render(true);
+
+  await act(async () => findRow()?.click());
+
+  expect(openChanges).toEqual([]);
+  expect(openedSessions).toEqual([]);
+  expect(document.body.textContent).toContain('Could not reach that OpenChamber server.');
+  // The list is still there, so another row can be tapped.
+  expect(document.body.textContent).toContain('Unify sessions');
+});
+
+test('an unreachable server is a quiet note in the sheet', async () => {
+  seed();
+  useInstanceAttentionStore.getState().markUnreachable('host-d', 'halo', 200);
+  await render(true);
+
+  expect(document.body.textContent).toContain('No answer from halo; showing their last known items.');
