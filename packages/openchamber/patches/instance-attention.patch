+
+  const openItem = React.useCallback((item: InstanceAttentionItem) => {
+    // This phone's own connection needs no connect: opening the session is the
+    // whole jump, exactly as it is on the desktop.
+    if (isLocalInstanceAttentionHost(item.hostId)) {
+      openLocalInstanceAttentionItem(item);
+      onOpenChange(false);
+      return;
+    }
