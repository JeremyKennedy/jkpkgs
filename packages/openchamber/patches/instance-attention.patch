@@ -0,0 +1,208 @@
+import { beforeEach, describe, expect, mock, test } from 'bun:test';
+
+import type { DesktopHost, HostProbeResult } from '@/lib/desktopHosts';
+import type { DesktopHostProbe } from '@/lib/desktopHostStatus';
+import type { InstanceAttentionPoll } from '@/lib/instanceAttention';
+
+const answered: InstanceAttentionPoll = {
+  sessions: [{ id: 'ses_a', directory: '/repo', title: 'Session', archived: false, idle: 10 }],
+  pending: new Map(),
+  busy: new Set(),
+};
+
+const probes: Array<{ hostId: string; localClientToken: string; options: unknown }> = [];
+const directReads: Array<{ url: string; token?: string }> = [];
+const relayReads: Array<{ relayUrl: string; token?: string; tunnel?: unknown }> = [];
+const closedTunnels: unknown[] = [];
+let probeResult: DesktopHostProbe = { status: 'ok', latencyMs: 1 };
+let probeTunnel: { close: () => void } | undefined;
+
+const actualStatus = await import('@/lib/desktopHostStatus');
+const actualAttention = await import('@/lib/instanceAttention');
+
+mock.module('@/lib/desktopHostStatus', () => ({
+  ...actualStatus,
+  probeHost: mock(async (host: DesktopHost, localClientToken: string, options: unknown) => {
+    probes.push({ hostId: host.id, localClientToken, options });
+    return probeResult;
+  }),
+}));
+
+mock.module('@/lib/instanceAttention', () => ({
+  ...actualAttention,
+  readInstanceAttention: mock(async (transport: { url: string; token?: string }) => {
+    directReads.push({ url: transport.url, token: transport.token });
+    return answered;
+  }),
+  readRelayInstanceAttention: mock(async (
+    relay: { relayUrl: string },
+    options?: { token?: string; tunnel?: unknown },
+  ) => {
+    relayReads.push({ relayUrl: relay.relayUrl, token: options?.token, tunnel: options?.tunnel });
+    return answered;
+  }),
+}));
+
+const { instanceAttentionTargets, pageReachesLocalOrigin } = await import('./useInstanceAttentionPolling');
+
+const packagedPageHref = 'openchamber-ui://app/index.html';
+
+const setPageHref = (href: string): void => {
+  (globalThis as { window?: { location: { href: string } } }).window = { location: { href } };
+};
+
+const host = (overrides: Partial<DesktopHost> = {}): DesktopHost => ({
+  id: 'host-b',
+  label: 'Build box',
+  url: 'http://lan.test',
+  apiUrl: 'http://lan.test',
+  clientToken: 'secret',
+  relay: { relayUrl: 'wss://relay.test', serverId: 'server-a', hostEncPubJwk: {} },
+  ...overrides,
+});
+
+beforeEach(() => {
+  probes.length = 0;
+  directReads.length = 0;
+  relayReads.length = 0;
+  closedTunnels.length = 0;
+  probeResult = { status: 'ok', latencyMs: 1 };
+  probeTunnel = undefined;
+  setPageHref(packagedPageHref);
+});
+
+describe('desktop attention reachability gate', () => {
+  test('asks the shared probe to keep the tunnel before reading', async () => {
+    const target = instanceAttentionTargets({ hosts: [host()], localOrigin: null }, 'active')[0]!;
+
+    await target.read(new AbortController().signal);
+
+    expect(probes).toEqual([{ hostId: 'host-b', localClientToken: '', options: { keepTunnel: true } }]);
+  });
+
+  test('a direct answer reads the address the probe verified', async () => {
+    const target = instanceAttentionTargets({ hosts: [host()], localOrigin: null }, 'active')[0]!;
+
+    await target.read(new AbortController().signal);
+
+    expect(directReads).toEqual([{ url: 'http://lan.test', token: 'secret' }]);
+    expect(relayReads).toEqual([]);
+  });
+
+  test('a relay answer reads over the tunnel the probe opened and closes it', async () => {
+    probeTunnel = { close: () => { closedTunnels.push(probeTunnel); } };
+    probeResult = { status: 'ok', latencyMs: 1, via: 'relay', tunnel: probeTunnel as never };
+    const target = instanceAttentionTargets({ hosts: [host()], localOrigin: null }, 'active')[0]!;
+
+    await target.read(new AbortController().signal);
+
+    expect(directReads).toEqual([]);
+    expect(relayReads).toEqual([{ relayUrl: 'wss://relay.test', token: 'secret', tunnel: probeTunnel }]);
+    expect(closedTunnels).toEqual([probeTunnel]);
+  });
+
+  for (const status of ['unreachable', 'wrong-service', 'incompatible', 'relay-limit'] satisfies HostProbeResult['status'][]) {
+    test(`a blocked probe (${status}) reads nothing`, async () => {
+      probeResult = { status, latencyMs: 1 };
+      const target = instanceAttentionTargets({ hosts: [host()], localOrigin: null }, 'active')[0]!;
+
+      await target.read(new AbortController().signal);
+
+      expect(directReads).toEqual([]);
+      expect(relayReads).toEqual([]);
+    });
+  }
+
+  test('a direct-only host reads directly after its probe', async () => {
+    const target = instanceAttentionTargets({
+      hosts: [host({ relay: undefined })],
+      localOrigin: null,
+    }, 'active')[0]!;
+
+    await target.read(new AbortController().signal);
+
+    expect(probes).toEqual([{ hostId: 'host-b', localClientToken: '', options: { keepTunnel: true } }]);
+    expect(directReads).toEqual([{ url: 'http://lan.test', token: 'secret' }]);
+    expect(relayReads).toEqual([]);
+  });
+
+  test('a relay-only host reads over its tunnel and closes it', async () => {
+    probeTunnel = { close: () => { closedTunnels.push(probeTunnel); } };
+    probeResult = { status: 'ok', latencyMs: 1, via: 'relay', tunnel: probeTunnel as never };
+    const target = instanceAttentionTargets({
+      hosts: [host({ url: 'relay://server-a', apiUrl: undefined })],
+      localOrigin: null,
+    }, 'active')[0]!;
+
+    await target.read(new AbortController().signal);
+
+    expect(directReads).toEqual([]);
+    expect(relayReads).toEqual([{ relayUrl: 'wss://relay.test', token: 'secret', tunnel: probeTunnel }]);
+    expect(closedTunnels).toEqual([probeTunnel]);
+  });
+});
+
+describe('the app own server as a target', () => {
+  test('is read directly with the local client token while another instance is shown', async () => {
+    const targets = instanceAttentionTargets(
+      { hosts: [host()], localOrigin: 'http://127.0.0.1:57123' },
+      'host-b',
+      'local-token',
+    );
+
+    expect(targets.map((target) => target.hostId)).toEqual(['local']);
+    // The switcher's own name for it, so the two surfaces agree.
+    expect(targets[0]!.label).toBe('Local');
+
+    await targets[0]!.read(new AbortController().signal);
+
+    // No probe: the shell's loopback server is either answering or it is not.
+    expect(probes).toEqual([]);
+    expect(directReads).toEqual([{ url: 'http://127.0.0.1:57123', token: 'local-token' }]);
+  });
+
+  test('is not read while the window shows it', () => {
+    const targets = instanceAttentionTargets(
+      { hosts: [host()], localOrigin: 'http://127.0.0.1:57123' },
+      'local',
+    );
+
+    expect(targets.map((target) => target.hostId)).toEqual(['host-b']);
+  });
+
+  test('is left out when the shell reports no local server', () => {
+    const targets = instanceAttentionTargets({ hosts: [], localOrigin: null }, 'host-b');
+
+    expect(targets).toEqual([]);
+  });
+
+  test('is left out on a page another instance served, which cannot reach it', () => {
+    setPageHref('http://cedar.test:4096/');
+
+    const targets = instanceAttentionTargets(
+      { hosts: [host()], localOrigin: 'http://127.0.0.1:57123' },
+      'host-c',
+    );
+
+    // The saved hosts are still read; only Local waits for the Local UI.
+    expect(targets.map((target) => target.hostId)).toEqual(['host-b']);
+  });
+});
+
+describe('page reach to the local server', () => {
+  test('the packaged UI reaches it', () => {
+    expect(pageReachesLocalOrigin(packagedPageHref, 'http://127.0.0.1:57123')).toBe(true);
+  });
+
+  test('a page already on the local origin reaches it', () => {
+    expect(pageReachesLocalOrigin('http://127.0.0.1:57123/chat', 'http://127.0.0.1:57123')).toBe(true);
+  });
+
+  test('a page another instance served does not', () => {
+    expect(pageReachesLocalOrigin('https://openchamber-cedar.example.net/', 'http://127.0.0.1:57123')).toBe(false);
+  });
+
+  test('an unknown page reaches nothing', () => {
+    expect(pageReachesLocalOrigin('', 'http://127.0.0.1:57123')).toBe(false);
+  });
+});
diff --git a/packages/ui/src/hooks/useInstanceAttentionPolling.test.ts b/packages/ui/src/hooks/useInstanceAttentionPolling.test.ts
new file mode 100644
index 000000000..f15a3a013
--- /dev/null
+++ b/packages/ui/src/hooks/useInstanceAttentionPolling.test.ts
@@ -0,0 +1,425 @@
+import { beforeEach, describe, expect, test } from 'bun:test';
+
+import type { DesktopHost } from '@/lib/desktopHosts';
+import type { InstanceAttentionPoll, InstanceSessionSummary } from '@/lib/instanceAttention';
+import { useInstanceAttentionStore } from '@/stores/useInstanceAttentionStore';
+import {
+  INSTANCE_ATTENTION_POLL_INTERVAL_MS,
+  instanceAttentionTargets,
+  requestInstanceAttentionRefresh,
+  startInstanceAttentionPolling,
+  type InstanceAttentionHosts,
+  type InstanceAttentionTarget,
+} from './useInstanceAttentionPolling';
+
+const flush = async () => {
+  for (let turn = 0; turn < 4; turn += 1) await new Promise<void>((resolve) => setTimeout(resolve, 0));
+};
+
+const timers = () => {
+  let nextId = 0;
+  const pending = new Map<number, { callback: () => void; delay: number }>();
+  return {
+    pending,
+    schedule: (callback: () => void, delay: number) => {
+      const id = ++nextId;
+      pending.set(id, { callback, delay });
+      return id;
+    },
+    clear: (id: number) => { pending.delete(id); },
+    fire: async () => {
+      const entry = [...pending.entries()].find(([, timer]) => timer.delay === INSTANCE_ATTENTION_POLL_INTERVAL_MS);
+      if (!entry) throw new Error('No scheduled poll');
+      pending.delete(entry[0]);
+      entry[1].callback();
+      await flush();
+    },
+    fireDelay: async (delay: number) => {
+      const entry = [...pending.entries()].find(([, timer]) => timer.delay === delay);
+      if (!entry) throw new Error(`No scheduled timer at ${delay}`);
+      pending.delete(entry[0]);
+      entry[1].callback();
+      await flush();
+    },
+    delay: () => [...pending.values()][0]?.delay,
+  };
+};
+
+const host = (id: string, overrides: Partial<DesktopHost> = {}): DesktopHost => ({
+  id,
+  label: `host ${id}`,
+  url: `http://${id}.test`,
+  apiUrl: `http://${id}.test`,
+  ...overrides,
+});
+
+const session = (id: string): InstanceSessionSummary => ({
+  id,
+  directory: '/repo',
+  title: `Session ${id}`,
+  archived: false,
+  idle: 10,
+});
+
+const poll = (
+  sessions: InstanceSessionSummary[] | null,
+  pending: Map<string, never> | null = null,
+  busy: ReadonlySet<string> | null = new Set(),
+): InstanceAttentionPoll => ({
+  sessions,
+  pending,
+  busy,
+});
+
+const target = (
+  id: string,
+  read: (signal: AbortSignal) => Promise<InstanceAttentionPoll>,
+): InstanceAttentionTarget => ({
+  hostId: id,
+  label: `host ${id}`,
+  read,
+});
+
+beforeEach(() => {
+  useInstanceAttentionStore.getState().reset();
+});
+
+describe('instance attention targets', () => {
+  test('skips the active instance and hosts with no address, and includes relay-only hosts', () => {
+    const config: InstanceAttentionHosts = {
+      hosts: [
+        host('host-b'),
+        host('host-c', { relay: { relayUrl: 'wss://relay.test', serverId: 'c', hostEncPubJwk: {} } }),
+        host('host-d', { url: 'relay://server-d', apiUrl: undefined, relay: { relayUrl: 'wss://relay.test', serverId: 'd', hostEncPubJwk: {} } }),
+        host('host-e', { url: 'relay://server-e', apiUrl: undefined }),
+      ],
+      localOrigin: null,
+    };
+
+    const targets = instanceAttentionTargets(config, 'host-b');
+
+    expect(targets.map((entry) => entry.hostId)).toEqual(['host-c', 'host-d']);
+    // Every target covers the probe's direct budget, the relay probe, the
+    // tunnel-backed read and a margin, so a slow-but-healthy host is not cut
+    // off mid-read. 12s + 15s + 8s + 2s.
+    expect(targets.find((entry) => entry.hostId === 'host-d')?.timeoutMs).toBe(37_000);
+    expect(targets.find((entry) => entry.hostId === 'host-c')?.timeoutMs).toBe(37_000);
+  });
+});
+
+describe('instance attention polling lifecycle', () => {
+  test('polls immediately, publishes what answered, and schedules the next cycle', async () => {
+    const clock = timers();
+    const reads: string[] = [];
+    const dispose = startInstanceAttentionPolling({
+      readTargets: async () => [target('host-b', async () => {
+        reads.push('host-b');
+        return poll([session('ses_a')]);
+      })],
+      isVisible: () => true,
+      onVisible: () => () => undefined,
+      scheduleTimeout: clock.schedule,
+      clearScheduledTimeout: clock.clear,
+      now: () => 1_000,
+    });
+    await flush();
+
+    expect(reads).toEqual(['host-b']);
+    expect(useInstanceAttentionStore.getState().items.map((item) => item.sessionId)).toEqual(['ses_a']);
+    expect(clock.delay()).toBe(INSTANCE_ATTENTION_POLL_INTERVAL_MS);
+
+    await clock.fire();
+    expect(reads).toEqual(['host-b', 'host-b']);
+    dispose();
+    expect(clock.pending.size).toBe(0);
+  });
+
+  test('does not read while hidden, and reads at once when the app becomes visible', async () => {
+    const clock = timers();
+    let visible = false;
+    let becameVisible: () => void = () => undefined;
+    let reads = 0;
+    const dispose = startInstanceAttentionPolling({
+      readTargets: async () => [target('host-b', async () => {
+        reads += 1;
+        return poll([session('ses_a')]);
+      })],
+      isVisible: () => visible,
+      onVisible: (listener) => { becameVisible = listener; return () => undefined; },
+      scheduleTimeout: clock.schedule,
+      clearScheduledTimeout: clock.clear,
+      now: () => 1_000,
+    });
+    await flush();
+    expect(reads).toBe(0);
+
+    await clock.fire();
+    expect(reads).toBe(0);
+    // A hidden window leaves no timer; becoming visible reads at once.
+    expect(clock.pending.size).toBe(0);
+
+    visible = true;
+    becameVisible();
+    await flush();
+    expect(reads).toBe(1);
+    dispose();
+  });
+
+  test('an unreachable host keeps its last known items instead of clearing them', async () => {
+    const clock = timers();
+    let answer = true;
+    const dispose = startInstanceAttentionPolling({
+      readTargets: async () => [target('host-b', async () => (answer ? poll([session('ses_a')]) : poll(null)))],
+      isVisible: () => true,
+      onVisible: () => () => undefined,
+      scheduleTimeout: clock.schedule,
+      clearScheduledTimeout: clock.clear,
+      now: () => 1_000,
+    });
+    await flush();
+    answer = false;
+    await clock.fire();
+
+    const state = useInstanceAttentionStore.getState();
+    expect(state.hosts['host-b']?.status).toBe('error');
+    expect(state.items.map((item) => item.sessionId)).toEqual(['ses_a']);
+    dispose();
+  });
+
+  test('a refresh request reads at once and replaces the scheduled cycle', async () => {
+    const clock = timers();
+    let reads = 0;
+    const dispose = startInstanceAttentionPolling({
+      readTargets: async () => [target('host-b', async () => {
+        reads += 1;
+        return poll([session('ses_a')]);
+      })],
+      isVisible: () => true,
+      onVisible: () => () => undefined,
+      scheduleTimeout: clock.schedule,
+      clearScheduledTimeout: clock.clear,
+      now: () => 1_000,
+    });
+    await flush();
+    expect(reads).toBe(1);
+    expect(clock.pending.size).toBe(1);
+
+    await requestInstanceAttentionRefresh();
+
+    expect(reads).toBe(2);
+    // The immediate read owns the only scheduled cycle; it did not stack one.
+    expect(clock.pending.size).toBe(1);
+    expect(clock.delay()).toBe(INSTANCE_ATTENTION_POLL_INTERVAL_MS);
+    dispose();
+  });
+
+  test('requests during an in-flight read share exactly one follow-up read', async () => {
+    const clock = timers();
+    let reads = 0;
+    let releaseFirst: () => void = () => undefined;
+    const firstRead = new Promise<void>((resolve) => { releaseFirst = resolve; });
+    const dispose = startInstanceAttentionPolling({
+      readTargets: async () => [target('host-b', async () => {
+        reads += 1;
+        if (reads === 1) await firstRead;
+        return poll([session('ses_a')]);
+      })],
+      isVisible: () => true,
+      onVisible: () => () => undefined,
+      scheduleTimeout: clock.schedule,
+      clearScheduledTimeout: clock.clear,
+      now: () => 1_000,
+    });
+    await flush();
+    expect(reads).toBe(1);
+
+    const first = requestInstanceAttentionRefresh();
+    const second = requestInstanceAttentionRefresh();
+    releaseFirst();
+    await Promise.all([first, second]);
+
+    expect(reads).toBe(2);
+    expect(clock.pending.size).toBe(1);
+    dispose();
+  });
+
+  test('a refresh request stops reading once the poller is disposed', async () => {
+    const clock = timers();
+    let reads = 0;
+    const dispose = startInstanceAttentionPolling({
+      readTargets: async () => [target('host-b', async () => {
+        reads += 1;
+        return poll([session('ses_a')]);
+      })],
+      isVisible: () => true,
+      onVisible: () => () => undefined,
+      scheduleTimeout: clock.schedule,
+      clearScheduledTimeout: clock.clear,
+      now: () => 1_000,
+    });
+    await flush();
+    dispose();
+
+    await requestInstanceAttentionRefresh();
+
+    expect(reads).toBe(1);
+    expect(clock.pending.size).toBe(0);
+  });
+
+  test('a failed target list schedules the next cycle without dropping known items', async () => {
+    const clock = timers();
+    let fail = false;
+    const dispose = startInstanceAttentionPolling({
+      readTargets: async () => {
+        if (fail) throw new Error('saved instances unavailable');
+        return [target('host-b', async () => poll([session('ses_a')]))];
+      },
+      isVisible: () => true,
+      onVisible: () => () => undefined,
+      scheduleTimeout: clock.schedule,
+      clearScheduledTimeout: clock.clear,
+      now: () => 1_000,
+    });
+    await flush();
+    fail = true;
+    await clock.fire();
+
+    expect(useInstanceAttentionStore.getState().items.map((item) => item.sessionId)).toEqual(['ses_a']);
+    expect(clock.delay()).toBe(INSTANCE_ATTENTION_POLL_INTERVAL_MS);
+    dispose();
+  });
+
+  test('a host that failed backs off instead of probing again the next cycle', async () => {
+    const clock = timers();
+    let now = 1_000;
+    let reads = 0;
+    const dispose = startInstanceAttentionPolling({
+      readTargets: async () => [target('host-b', async () => {
+        reads += 1;
+        return reads === 1 ? poll(null) : poll([session('ses_a')]);
+      })],
+      isVisible: () => true,
+      onVisible: () => () => undefined,
+      scheduleTimeout: clock.schedule,
+      clearScheduledTimeout: clock.clear,
+      now: () => now,
+    });
+    await flush();
+    expect(reads).toBe(1);
+
+    // One failure means the next cycle skips the host: 45s * 2^1.
+    await clock.fire();
+    expect(reads).toBe(1);
+
+    now = 1_000 + INSTANCE_ATTENTION_POLL_INTERVAL_MS * 2;
+    await clock.fire();
+    expect(reads).toBe(2);
+    dispose();
+  });
+
+  test('offline reads nothing and waits at the retry cap', async () => {
+    const clock = timers();
+    let online = false;
+    let reads = 0;
+    const dispose = startInstanceAttentionPolling({
+      readTargets: async () => [target('host-b', async () => {
+        reads += 1;
+        return poll([session('ses_a')]);
+      })],
+      isVisible: () => true,
+      onVisible: () => () => undefined,
+      scheduleTimeout: clock.schedule,
+      clearScheduledTimeout: clock.clear,
+      now: () => 1_000,
+      isOnline: () => online,
+    });
+    await flush();
+    expect(reads).toBe(0);
+    expect(clock.delay()).toBe(5 * 60_000);
+
+    online = true;
+    await clock.fireDelay(5 * 60_000);
+    expect(reads).toBe(1);
+    dispose();
+  });
+
+  test('going offline keeps the last known items instead of marking hosts unreachable', async () => {
+    const clock = timers();
+    let online = true;
+    let reads = 0;
+    const dispose = startInstanceAttentionPolling({
+      readTargets: async () => [target('host-b', async () => {
+        reads += 1;
+        return poll([session('ses_a')]);
+      })],
+      isVisible: () => true,
+      onVisible: () => () => undefined,
+      scheduleTimeout: clock.schedule,
+      clearScheduledTimeout: clock.clear,
+      now: () => 1_000,
+      isOnline: () => online,
+    });
+    await flush();
+    expect(useInstanceAttentionStore.getState().items.map((item) => item.sessionId)).toEqual(['ses_a']);
+
+    online = false;
+    await clock.fire();
+
+    const state = useInstanceAttentionStore.getState();
+    expect(reads).toBe(1);
+    expect(state.hosts['host-b']?.status).not.toBe('error');
+    expect(state.items.map((item) => item.sessionId)).toEqual(['ses_a']);
+    expect(clock.delay()).toBe(5 * 60_000);
+    dispose();
+  });
+
+  test('a read that runs out of time marks the host unreachable instead of dropping it', async () => {
+    const clock = timers();
+    const dispose = startInstanceAttentionPolling({
+      readTargets: async () => [{
+        hostId: 'host-b',
+        label: 'host host-b',
+        timeoutMs: 5_000,
+        read: (signal) => new Promise<InstanceAttentionPoll>((resolve) => {
+          signal.addEventListener('abort', () => resolve(poll(null)), { once: true });
+        }),
+      }],
+      isVisible: () => true,
+      onVisible: () => () => undefined,
+      scheduleTimeout: clock.schedule,
+      clearScheduledTimeout: clock.clear,
+      now: () => 1_000,
+    });
+    await flush();
+
+    await clock.fireDelay(5_000);
+
+    expect(useInstanceAttentionStore.getState().hosts['host-b']?.status).toBe('error');
+    dispose();
+  });
+
+  test('disposal aborts an in-flight read and clears the scheduled cycle', async () => {
+    const clock = timers();
+    const signals: AbortSignal[] = [];
+    const dispose = startInstanceAttentionPolling({
+      readTargets: async () => [target('host-b', (signal) => {
+        signals.push(signal);
+        return new Promise<InstanceAttentionPoll>((resolve) => {
+          signal.addEventListener('abort', () => resolve(poll(null)), { once: true });
+        });
+      })],
+      isVisible: () => true,
+      onVisible: () => () => undefined,
+      scheduleTimeout: clock.schedule,
+      clearScheduledTimeout: clock.clear,
+      now: () => 1_000,
+    });
+    await flush();
+    expect(signals[0]?.aborted).toBe(false);
+
+    dispose();
+    expect(signals[0]?.aborted).toBe(true);
+    await flush();
+    expect(clock.pending.size).toBe(0);
+  });
+});
diff --git a/packages/ui/src/hooks/useInstanceAttentionPolling.ts b/packages/ui/src/hooks/useInstanceAttentionPolling.ts
new file mode 100644
index 000000000..a66a6a7ea
--- /dev/null
+++ b/packages/ui/src/hooks/useInstanceAttentionPolling.ts
@@ -0,0 +1,495 @@
+import React from 'react';
+
+import {
+  desktopHostsGet,
+  desktopLocalClientTokenGet,
+  getDesktopHostApiUrl,
+  locationMatchesHost,
+  normalizeHostUrl,
+  type DesktopHost,
+  type HostProbeResult,
+} from '@/lib/desktopHosts';
+import { resolveCurrentDesktopHost, LOCAL_HOST_ID, withLocalDesktopHost } from '@/lib/desktopCurrentHost';
+import { probeHost } from '@/lib/desktopHostStatus';
+import { formatMessage, useI18nStore } from '@/lib/i18n/store';
+import {
+  readInstanceAttention,
+  readInstanceAttentionWithin,
+  readRelayInstanceAttention,
+  type InstanceAttentionPoll,
+} from '@/lib/instanceAttention';
+import { subscribeRuntimeEndpointChanged } from '@/lib/runtime-switch';
+import { useInstanceAttentionStore } from '@/stores/useInstanceAttentionStore';
+
+// Polls the instances this window is not showing: the saved ones, plus the
+// app's own server while a saved host is shown. The active instance is already
+// reported by the sidebar's own indicators, and its live events keep it
+// current, so it is not read here.
+//
+// Two global routes per server, no directory: `GET /api/session` and
+// `GET /api/sessions/status`. Neither starts an OpenCode location, so a poll
+// never spawns MCP servers on the host. Reachability is the switcher's own
+// answer (`probeHost`): a host the switcher calls unreachable is not read, and
+// a relay answer hands over the tunnel the probe opened, so the read rides it
+// instead of paying a second handshake. The app's own server is read directly,
+// without a probe, and only from a page whose origin can reach it.
+
+export const INSTANCE_ATTENTION_POLL_INTERVAL_MS = 45_000;
+/** A host that did not answer waits longer each time; a dead host is not a 27-second probe every cycle. */
+const INSTANCE_ATTENTION_FAILURE_BACKOFF_MAX_MS = 10 * 60_000;
+/** While the device is offline nothing can answer, so the loop waits at the cap. */
+const INSTANCE_ATTENTION_OFFLINE_RETRY_MS = 5 * 60_000;
+const INSTANCE_ATTENTION_POLL_TIMEOUT_MS = 40_000;
+const INSTANCE_ATTENTION_DIRECT_READ_TIMEOUT_MS = 4_000;
+const INSTANCE_ATTENTION_RELAY_READ_TIMEOUT_MS = 8_000;
+const INSTANCE_ATTENTION_READ_MARGIN_MS = 2_000;
+// The probe's own budgets, which the target's timeout has to include: the
+// main-process direct probe retries up to 12 s, and a relay probe runs to 15 s.
+const INSTANCE_ATTENTION_PROBE_DIRECT_BUDGET_MS = 12_000;
+const INSTANCE_ATTENTION_PROBE_RELAY_BUDGET_MS = 15_000;
+
+type InstanceAttentionRefreshListener = () => Promise<void>;
+const refreshListeners = new Set<InstanceAttentionRefreshListener>();
+
+/**
+ * Reads every running poller's instances now instead of waiting for the next
+ * tick. The returned promise settles when the read it caused has finished, so a
+ * surface can keep a spinner up without gating its own action on it.
+ *
+ * A request that arrives while a read is in flight joins a single follow-up
+ * read rather than starting another cycle.
+ */
+export const requestInstanceAttentionRefresh = async (): Promise<void> => {
+  await Promise.all([...refreshListeners].map((listener) => listener()));
+};
+
+export const subscribeInstanceAttentionRefresh = (listener: InstanceAttentionRefreshListener): (() => void) => {
+  refreshListeners.add(listener);
+  return () => {
+    refreshListeners.delete(listener);
+  };
+};
+
+export type InstanceAttentionHosts = {
+  hosts: DesktopHost[];
+  localOrigin: string | null;
+};
+
+/** One saved server to read, with the transport that server needs. */
+export type InstanceAttentionTarget = {
+  hostId: string;
+  label: string;
+  /** How long this target may take, probe included. */
+  timeoutMs?: number;
+  read: (signal: AbortSignal) => Promise<InstanceAttentionPoll>;
+};
+
+type InstanceAttentionPollingDeps = {
+  readTargets: () => Promise<InstanceAttentionTarget[] | null>;
+  isVisible: () => boolean;
+  onVisible: (listener: () => void) => () => void;
+  scheduleTimeout: (callback: () => void, delay: number) => number;
+  clearScheduledTimeout: (timeoutId: number) => void;
+  now: () => number;
+  /** A cycle while offline reads nothing: a failure there is not the host's. */
+  isOnline?: () => boolean;
+};
+
+type InstanceAttentionVisibility = {
+  isVisible: () => boolean;
+  onVisible: (listener: () => void) => () => void;
+  /** Removes the document listeners; a poller owns one per run. */
+  dispose: () => void;
+};
+
+const ALWAYS_VISIBLE: InstanceAttentionVisibility = {
+  isVisible: () => true,
+  onVisible: () => () => undefined,
+  dispose: () => undefined,
+};
+
+const EMPTY_POLL: InstanceAttentionPoll = { sessions: null, pending: null, busy: null };
+
+/** Statuses that mean the host did not answer for the attention routes either. */
+const isBlockedProbeStatus = (status: HostProbeResult['status']): boolean => (
+  status === 'unreachable'
+  || status === 'wrong-service'
+  || status === 'incompatible'
+  || status === 'relay-limit'
+);
+
+/**
+ * A desktop host's two routes, after the shared probe has decided how it can be
+ * reached. A relay answer already holds the tunnel, so the read does not open a
+ * second one; a direct answer reads the address the probe just verified.
+ */
+const readDesktopHostAttention = async (
+  host: DesktopHost,
+  localClientToken: string,
+  signal: AbortSignal,
+): Promise<InstanceAttentionPoll> => {
+  const probe = await probeHost(host, localClientToken, { keepTunnel: true });
+  if (isBlockedProbeStatus(probe.status)) return EMPTY_POLL;
+  if (probe.tunnel && host.relay) {
+    try {
+      return await readInstanceAttentionWithin(
+        signal,
+        INSTANCE_ATTENTION_RELAY_READ_TIMEOUT_MS,
+        (readSignal) => readRelayInstanceAttention(host.relay!, {
+          tunnel: probe.tunnel,
+          token: host.clientToken,
+          headers: host.requestHeaders,
+          signal: readSignal,
+        }),
+      );
+    } finally {
+      probe.tunnel.close();
+    }
+  }
+  const directUrl = normalizeHostUrl(getDesktopHostApiUrl(host));
+  if (!directUrl) return EMPTY_POLL;
+  const direct = await readInstanceAttentionWithin(
+    signal,
+    INSTANCE_ATTENTION_DIRECT_READ_TIMEOUT_MS,
+    (readSignal) => readInstanceAttention({
+      url: directUrl,
+      token: host.clientToken,
+      headers: host.requestHeaders,
+    }, { signal: readSignal }),
+  );
+  // Both routes answered nothing: the direct path may be reachable for the
+  // probe and still fail for these two, so try the relay before calling the
+  // host unreachable. An idle host answers the session route with an empty
+  // list, so this fallback only runs on a real failure.
+  if (direct.sessions === null && direct.pending === null && host.relay) {
+    return readInstanceAttentionWithin(
+      signal,
+      INSTANCE_ATTENTION_RELAY_READ_TIMEOUT_MS,
+      (readSignal) => readRelayInstanceAttention(host.relay!, {
+        token: host.clientToken,
+        headers: host.requestHeaders,
+        signal: readSignal,
+      }),
+    );
+  }
+  return direct;
+};
+
+/**
+ * Whether a fetch from this page reaches the shell's local server. Its CORS
+ * policy admits the packaged UI and loopback dev pages, not a page another
+ * instance served: that page cannot read this machine until the shell reloads
+ * it into the Local UI. Reading it anyway would fail every cycle and report
+ * Local as unreachable.
+ */
+export const pageReachesLocalOrigin = (pageHref: string, localUrl: string): boolean => (
+  pageHref.startsWith('openchamber-ui://') || locationMatchesHost(pageHref, localUrl)
+);
+
+/**
+ * The desktop instances to read: the app's own server when this window shows a
+ * saved host, and every saved host that is not the one shown. A relay-only host
+ * is included now that its tunnel-backed read exists.
+ */
+export const instanceAttentionTargets = (
+  config: InstanceAttentionHosts,
+  activeHostId: string,
+  localClientToken = '',
+): InstanceAttentionTarget[] => {
+  const targets = config.hosts
+    .filter((host) => host.id !== activeHostId)
+    .flatMap((host) => {
+      const directUrl = normalizeHostUrl(getDesktopHostApiUrl(host));
+      if (!directUrl && !host.relay) return [];
+      return [{
+        hostId: host.id,
+        label: host.label,
+        // Covers the probe's own budgets, the read and a margin, so a healthy
+        // host that probed slowly is not marked unreachable mid-read.
+        timeoutMs: INSTANCE_ATTENTION_PROBE_DIRECT_BUDGET_MS
+          + (host.relay ? INSTANCE_ATTENTION_PROBE_RELAY_BUDGET_MS : 0)
+          + INSTANCE_ATTENTION_RELAY_READ_TIMEOUT_MS
+          + INSTANCE_ATTENTION_READ_MARGIN_MS,
+        read: (signal: AbortSignal) => readDesktopHostAttention(host, localClientToken, signal),
+      }];
+    });
+
+  // The app's own server is not a saved host, so it is read only while the
+  // window shows another instance and only from a page that can reach it. It
+  // needs no probe: the shell's loopback server is either answering or it is
+  // not, and a failed read keeps the last known items instead of reading as
+  // empty.
+  const pageHref = typeof globalThis.window === 'undefined' ? '' : globalThis.window.location.href;
+  const localUrl = activeHostId === LOCAL_HOST_ID
+    ? ''
+    : normalizeHostUrl(config.localOrigin ?? '') ?? '';
+  if (localUrl && pageReachesLocalOrigin(pageHref, localUrl)) {
+    targets.unshift({
+      hostId: LOCAL_HOST_ID,
+      // The switcher's own name for this server, so both surfaces agree in
+      // every locale.
+      label: formatMessage(useI18nStore.getState().dictionary, 'desktopHostSwitcher.instance.local'),
+      timeoutMs: INSTANCE_ATTENTION_DIRECT_READ_TIMEOUT_MS + INSTANCE_ATTENTION_READ_MARGIN_MS,
+      read: (signal: AbortSignal) => readInstanceAttentionWithin(
+        signal,
+        INSTANCE_ATTENTION_DIRECT_READ_TIMEOUT_MS,
+        (readSignal) => readInstanceAttention({
+          url: localUrl,
+          token: localClientToken,
+        }, { signal: readSignal }),
+      ),
+    });
+  }
+  return targets;
+};
+
+/**
+ * Owns the polling loop. Every cycle re-reads the saved instances, so adding,
+ * removing or switching one needs no restart. A failed host keeps its last
+ * known items and is marked unreachable; it is not read as empty. A read that
+ * runs out of time is unreachable too, not silently dropped.
+ *
+ * A host that did not answer backs off instead of paying its probe again next
+ * cycle, and a hidden window leaves no timer: becoming visible reads at once.
+ * Offline reads nothing and waits at the cap, so a sleeping phone does not
+ * report every saved server as unreachable.
+ */
+export const startInstanceAttentionPolling = (
+  deps: InstanceAttentionPollingDeps,
+): (() => void) => {
+  let disposed = false;
+  let running = false;
+  let refreshQueued = false;
+  let queuedRefreshResolvers: Array<() => void> = [];
+  let timeoutId: number | undefined;
+  const controllers = new Set<AbortController>();
+  const failuresByHostId = new Map<string, { attempts: number; nextAttemptAt: number }>();
+  const isOnline = deps.isOnline ?? (() => true);
+
+  const schedule = (delay = INSTANCE_ATTENTION_POLL_INTERVAL_MS) => {
+    if (disposed) return;
+    timeoutId = deps.scheduleTimeout(() => {
+      timeoutId = undefined;
+      if (disposed) return;
+      // Hidden: stop scheduling until `onVisible` wakes the poller.
+      if (!deps.isVisible()) return;
+      void run();
+    }, delay);
+  };
+
+  const recordFailure = (hostId: string): void => {
+    const previous = failuresByHostId.get(hostId);
+    const attempts = (previous?.attempts ?? 0) + 1;
+    const delay = Math.min(
+      INSTANCE_ATTENTION_POLL_INTERVAL_MS * 2 ** attempts,
+      INSTANCE_ATTENTION_FAILURE_BACKOFF_MAX_MS,
+    );
+    failuresByHostId.set(hostId, { attempts, nextAttemptAt: deps.now() + delay });
+  };
+
+  const readTarget = async (target: InstanceAttentionTarget): Promise<void> => {
+    const controller = new AbortController();
+    controllers.add(controller);
+    const timeout = deps.scheduleTimeout(
+      () => controller.abort(),
+      target.timeoutMs ?? INSTANCE_ATTENTION_POLL_TIMEOUT_MS,
+    );
+    try {
+      const poll = await target.read(controller.signal);
+      if (disposed) return;
+      const store = useInstanceAttentionStore.getState();
+      // A partial answer still counts: a session list that answered keeps its
+      // unread turns even when the status route timed out.
+      if (poll.sessions !== null || poll.pending !== null) {
+        failuresByHostId.delete(target.hostId);
+        store.applyPoll(target.hostId, target.label, poll, deps.now());
+      } else {
+        recordFailure(target.hostId);
+        store.markUnreachable(target.hostId, target.label, deps.now());
+      }
+    } catch {
+      if (!disposed) {
+        recordFailure(target.hostId);
+        useInstanceAttentionStore.getState().markUnreachable(target.hostId, target.label, deps.now());
+      }
+    } finally {
+      deps.clearScheduledTimeout(timeout);
+      controllers.delete(controller);
+    }
+  };
+
+  const run = async (): Promise<void> => {
+    if (disposed || running) return;
+    // A read started outside the tick (a refresh request, the surface opening)
+    // replaces the scheduled cycle with the one it is about to schedule.
+    if (timeoutId !== undefined) {
+      deps.clearScheduledTimeout(timeoutId);
+      timeoutId = undefined;
+    }
+    if (!isOnline()) {
+      // Keep every host's last known items: offline is not a host failure.
+      schedule(INSTANCE_ATTENTION_OFFLINE_RETRY_MS);
+      return;
+    }
+    running = true;
+    try {
+      const targets = await deps.readTargets().catch(() => null);
+      if (disposed) return;
+      if (!targets) {
+        schedule();
+        return;
+      }
+      const store = useInstanceAttentionStore.getState();
+      const targetIds = new Set(targets.map((target) => target.hostId));
+      store.retainHosts([...targetIds]);
+      for (const hostId of failuresByHostId.keys()) {
+        if (!targetIds.has(hostId)) failuresByHostId.delete(hostId);
+      }
+      const now = deps.now();
+      const due = targets.filter((target) => (failuresByHostId.get(target.hostId)?.nextAttemptAt ?? 0) <= now);
+      await Promise.allSettled(due.map(readTarget));
+      if (disposed) return;
+      schedule();
+    } finally {
+      running = false;
+      const waiters = queuedRefreshResolvers;
+      queuedRefreshResolvers = [];
+      if (refreshQueued && !disposed) {
+        refreshQueued = false;
+        // Awaiting the follow-up keeps this cycle's promise (and every request
+        // it absorbed) unsettled until the read the caller asked for finished.
+        await run();
+      } else {
+        refreshQueued = false;
+      }
+      for (const resolve of waiters) resolve();
+    }
+  };
+
+  /**
+   * A refresh request is a read promise: it joins the in-flight read's single
+   * follow-up when one is running, so callers that arrived together settle
+   * together and the poller reads once more, not once per caller.
+   */
+  const readNow = (): Promise<void> => {
+    if (disposed) return Promise.resolve();
+    if (!running) return run();
+    refreshQueued = true;
+    return new Promise<void>((resolve) => {
+      queuedRefreshResolvers.push(resolve);
+    });
+  };
+
+  const unsubscribeRefresh = subscribeInstanceAttentionRefresh(readNow);
+
+  const stopVisible = deps.onVisible(() => {
+    if (disposed || running) return;
+    if (timeoutId !== undefined) deps.clearScheduledTimeout(timeoutId);
+    timeoutId = undefined;
+    void run();
+  });
+
+  if (deps.isVisible()) void run();
+  else schedule();
+
+  return () => {
+    disposed = true;
+    unsubscribeRefresh();
+    stopVisible();
+    if (timeoutId !== undefined) deps.clearScheduledTimeout(timeoutId);
+    for (const controller of controllers) controller.abort();
+    controllers.clear();
+  };
+};
+
+/**
+ * The document listeners for one poller run. They stay attached until
+ * `dispose`, so a listener added after another was removed still wakes the
+ * poller: a runtime switch starts a fresh instance instead of reusing one whose
+ * listeners were torn down with its previous listener. Coming back online wakes
+ * it the same way, so a device that regained its network does not wait out the
+ * offline retry.
+ */
+export const instanceAttentionVisibility = (): InstanceAttentionVisibility => {
+  const doc = globalThis.document;
+  if (!doc) return ALWAYS_VISIBLE;
+  let hidden = doc.visibilityState === 'hidden';
+  const listeners = new Set<() => void>();
+  const wake = () => {
+    for (const listener of listeners) listener();
+  };
+  const handle = () => {
+    const next = doc.visibilityState === 'hidden';
+    if (hidden && !next) wake();
+    hidden = next;
+  };
+  const handleOnline = () => wake();
+  doc.addEventListener('visibilitychange', handle);
+  globalThis.window.addEventListener('focus', handle);
+  globalThis.window.addEventListener('online', handleOnline);
+  return {
+    isVisible: () => doc.visibilityState !== 'hidden',
+    onVisible: (listener) => {
+      listeners.add(listener);
+      return () => { listeners.delete(listener); };
+    },
+    dispose: () => {
+      listeners.clear();
+      doc.removeEventListener('visibilitychange', handle);
+      globalThis.window.removeEventListener('focus', handle);
+      globalThis.window.removeEventListener('online', handleOnline);
+    },
+  };
+};
+
+const readDesktopHosts = async (): Promise<InstanceAttentionHosts> => {
+  const config = await desktopHostsGet();
+  return { hosts: config.hosts, localOrigin: config.localOrigin ?? null };
+};
+
+const readDesktopTargets = async (): Promise<InstanceAttentionTarget[]> => {
+  const config = await readDesktopHosts();
+  const activeHostId = resolveCurrentDesktopHost(withLocalDesktopHost(config.hosts, config.localOrigin)).id;
+  const localClientToken = await desktopLocalClientTokenGet().catch(() => '');
+  return instanceAttentionTargets(config, activeHostId, localClientToken);
+};
+
+export const isDeviceOnline = (): boolean => globalThis.navigator?.onLine !== false;
+
+/**
+ * Runs the cross-instance poller in the desktop shell, restarting it when the
+ * window switches instances: the instance just left becomes a target and the
+ * one now shown stops being read.
+ */
+export const useInstanceAttentionPolling = (enabled: boolean): void => {
+  React.useEffect(() => {
+    if (!enabled) return;
+    const start = () => {
+      const visibility = instanceAttentionVisibility();
+      const stopPolling = startInstanceAttentionPolling({
+        readTargets: readDesktopTargets,
+        isVisible: visibility.isVisible,
+        onVisible: visibility.onVisible,
+        scheduleTimeout: window.setTimeout.bind(window),
+        clearScheduledTimeout: window.clearTimeout.bind(window),
+        now: Date.now,
+        isOnline: isDeviceOnline,
+      });
+      return () => {
+        stopPolling();
+        visibility.dispose();
+      };
+    };
+    let stop = start();
+    // The switch drops the store in `runtimeEndpointReset`; this restarts the
+    // loop with the new active instance excluded.
+    const unsubscribe = subscribeRuntimeEndpointChanged(() => {
+      stop();
+      stop = start();
+    });
+    return () => {
+      unsubscribe();
+      stop();
+    };
+  }, [enabled]);
+};
