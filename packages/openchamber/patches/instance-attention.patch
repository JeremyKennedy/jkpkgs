--- /dev/null
+++ b/packages/ui/src/hooks/useInstanceAttentionPolling.test.ts
@@ -0,0 +1,339 @@
+import { beforeEach, describe, expect, test } from 'bun:test';
+
+import type { DesktopHost } from '@/lib/desktopHosts';
+import type { InstanceAttentionPoll, InstanceSessionSummary } from '@/lib/instanceAttention';
+import { useInstanceAttentionStore } from '@/stores/useInstanceAttentionStore';
+import {
+  INSTANCE_ATTENTION_POLL_INTERVAL_MS,
+  instanceAttentionTargets,
+  requestInstanceAttentionRefresh,
+  startInstanceAttentionPolling,
+  type InstanceAttentionHosts,
+  type InstanceAttentionTarget,
+} from './useInstanceAttentionPolling';
+
+const flush = async () => {
+  for (let turn = 0; turn < 4; turn += 1) await new Promise<void>((resolve) => setTimeout(resolve, 0));
+};
+
+const timers = () => {
+  let nextId = 0;
+  const pending = new Map<number, { callback: () => void; delay: number }>();
+  return {
+    pending,
+    schedule: (callback: () => void, delay: number) => {
+      const id = ++nextId;
+      pending.set(id, { callback, delay });
+      return id;
+    },
+    clear: (id: number) => { pending.delete(id); },
+    fire: async () => {
+      const entry = [...pending.entries()].find(([, timer]) => timer.delay === INSTANCE_ATTENTION_POLL_INTERVAL_MS);
+      if (!entry) throw new Error('No scheduled poll');
+      pending.delete(entry[0]);
+      entry[1].callback();
+      await flush();
+    },
+    fireDelay: async (delay: number) => {
+      const entry = [...pending.entries()].find(([, timer]) => timer.delay === delay);
+      if (!entry) throw new Error(`No scheduled timer at ${delay}`);
+      pending.delete(entry[0]);
+      entry[1].callback();
+      await flush();
+    },
+    delay: () => [...pending.values()][0]?.delay,
+  };
+};
+
+const host = (id: string, overrides: Partial<DesktopHost> = {}): DesktopHost => ({
+  id,
+  label: `host ${id}`,
+  url: `http://${id}.test`,
+  apiUrl: `http://${id}.test`,
+  ...overrides,
+});
+
+const session = (id: string): InstanceSessionSummary => ({
+  id,
+  directory: '/repo',
+  title: `Session ${id}`,
+  archived: false,
+  idle: 10,
+});
+
+const poll = (
+  sessions: InstanceSessionSummary[] | null,
+  pending: Map<string, never> | null = null,
+  busy: ReadonlySet<string> | null = new Set(),
+): InstanceAttentionPoll => ({
+  sessions,
+  pending,
+  busy,
+});
+
+const target = (
+  id: string,
+  read: (signal: AbortSignal) => Promise<InstanceAttentionPoll>,
+): InstanceAttentionTarget => ({
+  hostId: id,
+  label: `host ${id}`,
+  read,
+});
+
+beforeEach(() => {
+  useInstanceAttentionStore.getState().reset();
+});
+
+describe('instance attention targets', () => {
+  test('skips the active instance and hosts with no address, and includes relay-only hosts', () => {
+    const config: InstanceAttentionHosts = {
+      hosts: [
+        host('host-b'),
+        host('host-c', { relay: { relayUrl: 'wss://relay.test', serverId: 'c', hostEncPubJwk: {} } }),
+        host('host-d', { url: 'relay://server-d', apiUrl: undefined, relay: { relayUrl: 'wss://relay.test', serverId: 'd', hostEncPubJwk: {} } }),
+        host('host-e', { url: 'relay://server-e', apiUrl: undefined }),
+      ],
+      localOrigin: null,
+    };
+
+    const targets = instanceAttentionTargets(config, 'host-b');
+
+    expect(targets.map((entry) => entry.hostId)).toEqual(['host-c', 'host-d']);
+    // A relay-only host still gets a deadline long enough for its tunnel.
+    expect(targets.find((entry) => entry.hostId === 'host-d')?.timeoutMs).toBe(10_000);
+    // A host with both transports covers the direct attempt and the relay.
+    expect(targets.find((entry) => entry.hostId === 'host-c')?.timeoutMs).toBe(14_000);
+  });
+});
+
+describe('instance attention polling lifecycle', () => {
+  test('polls immediately, publishes what answered, and schedules the next cycle', async () => {
+    const clock = timers();
+    const reads: string[] = [];
+    const dispose = startInstanceAttentionPolling({
+      readTargets: async () => [target('host-b', async () => {
+        reads.push('host-b');
+        return poll([session('ses_a')]);
+      })],
+      isVisible: () => true,
+      onVisible: () => () => undefined,
+      scheduleTimeout: clock.schedule,
+      clearScheduledTimeout: clock.clear,
+      now: () => 1_000,
+    });
+    await flush();
+
+    expect(reads).toEqual(['host-b']);
+    expect(useInstanceAttentionStore.getState().items.map((item) => item.sessionId)).toEqual(['ses_a']);
+    expect(clock.delay()).toBe(INSTANCE_ATTENTION_POLL_INTERVAL_MS);
+
+    await clock.fire();
+    expect(reads).toEqual(['host-b', 'host-b']);
+    dispose();
+    expect(clock.pending.size).toBe(0);
+  });
+
+  test('does not read while hidden, and reads at once when the app becomes visible', async () => {
+    const clock = timers();
+    let visible = false;
+    let becameVisible: () => void = () => undefined;
+    let reads = 0;
+    const dispose = startInstanceAttentionPolling({
+      readTargets: async () => [target('host-b', async () => {
+        reads += 1;
+        return poll([session('ses_a')]);
+      })],
+      isVisible: () => visible,
+      onVisible: (listener) => { becameVisible = listener; return () => undefined; },
+      scheduleTimeout: clock.schedule,
+      clearScheduledTimeout: clock.clear,
+      now: () => 1_000,
+    });
+    await flush();
+    expect(reads).toBe(0);
+
+    await clock.fire();
+    expect(reads).toBe(0);
+    expect(clock.delay()).toBe(INSTANCE_ATTENTION_POLL_INTERVAL_MS);
+
+    visible = true;
+    becameVisible();
+    await flush();
+    expect(reads).toBe(1);
+    dispose();
+  });
+
+  test('an unreachable host keeps its last known items instead of clearing them', async () => {
+    const clock = timers();
+    let answer = true;
+    const dispose = startInstanceAttentionPolling({
+      readTargets: async () => [target('host-b', async () => (answer ? poll([session('ses_a')]) : poll(null)))],
+      isVisible: () => true,
+      onVisible: () => () => undefined,
+      scheduleTimeout: clock.schedule,
+      clearScheduledTimeout: clock.clear,
+      now: () => 1_000,
+    });
+    await flush();
+    answer = false;
+    await clock.fire();
+
+    const state = useInstanceAttentionStore.getState();
+    expect(state.hosts['host-b']?.status).toBe('error');
+    expect(state.items.map((item) => item.sessionId)).toEqual(['ses_a']);
+    dispose();
+  });
+
+  test('a refresh request reads at once and replaces the scheduled cycle', async () => {
+    const clock = timers();
+    let reads = 0;
+    const dispose = startInstanceAttentionPolling({
+      readTargets: async () => [target('host-b', async () => {
+        reads += 1;
+        return poll([session('ses_a')]);
+      })],
+      isVisible: () => true,
+      onVisible: () => () => undefined,
+      scheduleTimeout: clock.schedule,
+      clearScheduledTimeout: clock.clear,
+      now: () => 1_000,
+    });
+    await flush();
+    expect(reads).toBe(1);
+    expect(clock.pending.size).toBe(1);
+
+    await requestInstanceAttentionRefresh();
+
+    expect(reads).toBe(2);
+    // The immediate read owns the only scheduled cycle; it did not stack one.
+    expect(clock.pending.size).toBe(1);
+    expect(clock.delay()).toBe(INSTANCE_ATTENTION_POLL_INTERVAL_MS);
+    dispose();
+  });
+
+  test('requests during an in-flight read share exactly one follow-up read', async () => {
+    const clock = timers();
+    let reads = 0;
+    let releaseFirst: () => void = () => undefined;
+    const firstRead = new Promise<void>((resolve) => { releaseFirst = resolve; });
+    const dispose = startInstanceAttentionPolling({
+      readTargets: async () => [target('host-b', async () => {
+        reads += 1;
+        if (reads === 1) await firstRead;
+        return poll([session('ses_a')]);
+      })],
+      isVisible: () => true,
+      onVisible: () => () => undefined,
+      scheduleTimeout: clock.schedule,
+      clearScheduledTimeout: clock.clear,
+      now: () => 1_000,
+    });
+    await flush();
+    expect(reads).toBe(1);
+
+    const first = requestInstanceAttentionRefresh();
+    const second = requestInstanceAttentionRefresh();
+    releaseFirst();
+    await Promise.all([first, second]);
+
+    expect(reads).toBe(2);
+    expect(clock.pending.size).toBe(1);
+    dispose();
+  });
+
+  test('a refresh request stops reading once the poller is disposed', async () => {
+    const clock = timers();
+    let reads = 0;
+    const dispose = startInstanceAttentionPolling({
+      readTargets: async () => [target('host-b', async () => {
+        reads += 1;
+        return poll([session('ses_a')]);
+      })],
+      isVisible: () => true,
+      onVisible: () => () => undefined,
+      scheduleTimeout: clock.schedule,
+      clearScheduledTimeout: clock.clear,
+      now: () => 1_000,
+    });
+    await flush();
+    dispose();
+
+    await requestInstanceAttentionRefresh();
+
+    expect(reads).toBe(1);
+    expect(clock.pending.size).toBe(0);
+  });
+
+  test('a failed target list schedules the next cycle without dropping known items', async () => {
+    const clock = timers();
+    let fail = false;
+    const dispose = startInstanceAttentionPolling({
+      readTargets: async () => {
+        if (fail) throw new Error('saved instances unavailable');
+        return [target('host-b', async () => poll([session('ses_a')]))];
+      },
+      isVisible: () => true,
+      onVisible: () => () => undefined,
+      scheduleTimeout: clock.schedule,
+      clearScheduledTimeout: clock.clear,
+      now: () => 1_000,
+    });
+    await flush();
+    fail = true;
+    await clock.fire();
+
+    expect(useInstanceAttentionStore.getState().items.map((item) => item.sessionId)).toEqual(['ses_a']);
+    expect(clock.delay()).toBe(INSTANCE_ATTENTION_POLL_INTERVAL_MS);
+    dispose();
+  });
+
+  test('a read that runs out of time marks the host unreachable instead of dropping it', async () => {
+    const clock = timers();
+    const dispose = startInstanceAttentionPolling({
+      readTargets: async () => [{
+        hostId: 'host-b',
+        label: 'host host-b',
+        timeoutMs: 5_000,
+        read: (signal) => new Promise<InstanceAttentionPoll>((resolve) => {
+          signal.addEventListener('abort', () => resolve(poll(null)), { once: true });
+        }),
+      }],
+      isVisible: () => true,
+      onVisible: () => () => undefined,
+      scheduleTimeout: clock.schedule,
+      clearScheduledTimeout: clock.clear,
+      now: () => 1_000,
+    });
+    await flush();
+
+    await clock.fireDelay(5_000);
+
+    expect(useInstanceAttentionStore.getState().hosts['host-b']?.status).toBe('error');
+    dispose();
+  });
+
+  test('disposal aborts an in-flight read and clears the scheduled cycle', async () => {
+    const clock = timers();
+    const signals: AbortSignal[] = [];
+    const dispose = startInstanceAttentionPolling({
+      readTargets: async () => [target('host-b', (signal) => {
+        signals.push(signal);
+        return new Promise<InstanceAttentionPoll>((resolve) => {
+          signal.addEventListener('abort', () => resolve(poll(null)), { once: true });
+        });
+      })],
+      isVisible: () => true,
+      onVisible: () => () => undefined,
+      scheduleTimeout: clock.schedule,
+      clearScheduledTimeout: clock.clear,
+      now: () => 1_000,
+    });
+    await flush();
+    expect(signals[0]?.aborted).toBe(false);
+
+    dispose();
+    expect(signals[0]?.aborted).toBe(true);
+    await flush();
+    expect(clock.pending.size).toBe(0);
+  });
+});
