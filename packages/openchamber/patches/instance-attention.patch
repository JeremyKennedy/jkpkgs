+++ b/packages/ui/src/stores/useInstanceAttentionStore.test.ts
@@ -0,0 +1,206 @@
+import { beforeEach, describe, expect, test } from 'bun:test';
+
+import {
+  LOCAL_INSTANCE_ATTENTION_HOST_ID,
+  type InstanceAttentionPoll,
+  type InstancePendingCounts,
+  type InstanceSessionSummary,
+} from '@/lib/instanceAttention';
+import { useInstanceAttentionStore } from './useInstanceAttentionStore';
+
+const session = (overrides: Partial<InstanceSessionSummary> = {}): InstanceSessionSummary => ({
+  id: 'ses_a',
+  directory: '/repo',
+  title: 'Session A',
+  archived: false,
+  ...overrides,
+});
+
+const poll = (
+  sessions: InstanceSessionSummary[] | null,
+  pending: Map<string, InstancePendingCounts> | null,
+  busy: ReadonlySet<string> | null = new Set(),
+  directories?: InstanceAttentionPoll['directories'],
+): InstanceAttentionPoll => ({ sessions, pending, busy, directories });
+
+beforeEach(() => {
+  useInstanceAttentionStore.getState().reset();
+});
+
+describe('cross-instance attention store', () => {
+  test('publishes the strongest item for a host that answered', () => {
+    useInstanceAttentionStore.getState().applyPoll(
+      'host-b',
+      'Build box',
+      poll([session({ id: 'ses_unread', idle: 10 })], new Map([['ses_unread', { permissions: 1, forms: 0, pages: 0 }]])),
+      100,
+    );
+
+    const state = useInstanceAttentionStore.getState();
+    expect(state.hosts['host-b']?.status).toBe('ok');
+    expect(state.items).toHaveLength(1);
+    expect(state.items[0]).toMatchObject({ hostId: 'host-b', hostLabel: 'Build box', kind: 'permission' });
+    expect(state.items[0]?.sessionId).toBe('ses_unread');
+  });
+
+  test('a failed half of a poll keeps the previous answer for that half', () => {
+    const store = useInstanceAttentionStore.getState();
+    store.applyPoll('host-b', 'Build box', poll([session({ id: 'ses_a', idle: 10 })], new Map([
+      ['ses_a', { permissions: 0, forms: 1, pages: 0 }],
+    ])), 100);
+
+    store.applyPoll('host-b', 'Build box', poll([session({ id: 'ses_b', idle: 20 })], null), 200);
+
+    const state = useInstanceAttentionStore.getState();
+    expect(state.hosts['host-b']?.sessions?.map((entry) => entry.id)).toEqual(['ses_b']);
+    expect(state.hosts['host-b']?.pending?.get('ses_a')).toEqual({ permissions: 0, forms: 1, pages: 0 });
+    expect(state.items.map((item) => item.sessionId).sort()).toEqual(['ses_a', 'ses_b']);
+  });
+
+  test('a busy session stops reading as unread, and a failed status half keeps that fact', () => {
+    const store = useInstanceAttentionStore.getState();
+    store.applyPoll('host-b', 'Build box', poll([session({ id: 'ses_busy', idle: 10 })], new Map(), new Set(['ses_busy'])), 100);
+    expect(useInstanceAttentionStore.getState().items).toEqual([]);
+
+    // The session list answered but the status route did not: the last known
+    // open turn stands, so the session is still not unread.
+    store.applyPoll('host-b', 'Build box', poll([session({ id: 'ses_busy', idle: 10 })], null), 200);
+    expect(useInstanceAttentionStore.getState().items).toEqual([]);
+
+    // Once the status route answers idle, the finished turn is unread again.
+    store.applyPoll('host-b', 'Build box', poll([session({ id: 'ses_busy', idle: 10 })], new Map(), new Set()), 300);
+    expect(useInstanceAttentionStore.getState().items.map((item) => item.kind)).toEqual(['unread']);
+  });
+
+  test('an unreachable host keeps its last known items and is marked as failed', () => {
+    const store = useInstanceAttentionStore.getState();
+    store.applyPoll('host-b', 'Build box', poll([session({ id: 'ses_a', idle: 10 })], new Map()), 100);
+    store.markUnreachable('host-b', 'Build box', 200);
+
+    const state = useInstanceAttentionStore.getState();
+    expect(state.hosts['host-b']?.status).toBe('error');
+    expect(state.items.map((item) => item.sessionId)).toEqual(['ses_a']);
+  });
+
+  test('a poll that answered neither route is treated as unreachable, not empty', () => {
+    const store = useInstanceAttentionStore.getState();
+    store.applyPoll('host-b', 'Build box', poll([session({ id: 'ses_a', idle: 10 })], new Map()), 100);
+    store.applyPoll('host-b', 'Build box', poll(null, null), 200);
+
+    const state = useInstanceAttentionStore.getState();
+    expect(state.hosts['host-b']?.status).toBe('error');
+    expect(state.items.map((item) => item.sessionId)).toEqual(['ses_a']);
+  });
+
+  test('a polled host shows only the sessions in folders it says it opens', () => {
+    const store = useInstanceAttentionStore.getState();
+    store.applyPoll('host-b', 'Build box', poll(
+      [
+        session({ id: 'ses_inside', directory: '/repo', idle: 10 }),
+        session({ id: 'ses_outside', directory: '/tmp/opencode/qcards-proj', idle: 20 }),
+      ],
+      new Map(),
+      new Set(),
+      { roots: ['/repo'], chatRoots: [] },
+    ), 100);
+
+    expect(useInstanceAttentionStore.getState().items.map((item) => item.sessionId)).toEqual(['ses_inside']);
+  });
+
+  test('a directory answer that failed keeps the one before it', () => {
+    const store = useInstanceAttentionStore.getState();
+    store.applyPoll('host-b', 'Build box', poll(
+      [session({ id: 'ses_inside', directory: '/repo', idle: 10 })],
+      new Map(),
+      new Set(),
+      { roots: ['/repo'], chatRoots: [] },
+    ), 100);
+    // The next poll answered its sessions but not the folder list.
+    store.applyPoll('host-b', 'Build box', poll(
+      [session({ id: 'ses_inside', directory: '/repo', idle: 10 })],
+      new Map(),
+      new Set(),
+      undefined,
+    ), 200);
+
+    expect(useInstanceAttentionStore.getState().items.map((item) => item.sessionId)).toEqual(['ses_inside']);
+    expect(useInstanceAttentionStore.getState().hosts['host-b']?.directories).toEqual({ roots: ['/repo'], chatRoots: [] });
+  });
+
+  test('an unreachable host keeps the folders it last answered', () => {
+    const store = useInstanceAttentionStore.getState();
+    store.applyPoll('host-b', 'Build box', poll(
+      [
+        session({ id: 'ses_inside', directory: '/repo', idle: 10 }),
+        session({ id: 'ses_outside', directory: '/tmp/opencode/qcards-proj', idle: 20 }),
+      ],
+      new Map(),
+      new Set(),
+      { roots: ['/repo'], chatRoots: [] },
+    ), 100);
+    store.markUnreachable('host-b', 'Build box', 200);
+
+    expect(useInstanceAttentionStore.getState().items.map((item) => item.sessionId)).toEqual(['ses_inside']);
+  });
+
+  test('retaining hosts drops instances that were removed or became active', () => {
+    const store = useInstanceAttentionStore.getState();
+    store.applyPoll('host-b', 'Build box', poll([session({ id: 'ses_a', idle: 10 })], new Map()), 100);
+    store.applyPoll('host-c', 'Laptop', poll([session({ id: 'ses_b', idle: 20 })], new Map()), 100);
+
+    store.retainHosts(['host-c']);
+
+    expect(useInstanceAttentionStore.getState().items.map((item) => item.hostId)).toEqual(['host-c']);
+  });
+
+  test('the local entry merges into the same list as the polled hosts', () => {
+    const store = useInstanceAttentionStore.getState();
+    store.applyPoll('host-b', 'Build box', poll([
+      session({ id: 'ses_remote_unread', title: 'Remote unread', idle: 10 }),
+    ], new Map()), 100);
+    store.applyPoll(LOCAL_INSTANCE_ATTENTION_HOST_ID, 'This instance', poll([
+      session({ id: 'ses_local_permission', title: 'Local permission', idle: 5 }),
+    ], new Map([['ses_local_permission', { permissions: 1, forms: 0, pages: 0 }]])), 100);
+
+    const state = useInstanceAttentionStore.getState();
+    expect(state.items.map((item) => [item.sessionId, item.kind])).toEqual([
+      ['ses_local_permission', 'permission'],
+      ['ses_remote_unread', 'unread'],
+    ]);
+  });
+
+  test('the local entry survives retention while polled hosts do not', () => {
+    const store = useInstanceAttentionStore.getState();
+    store.applyPoll(LOCAL_INSTANCE_ATTENTION_HOST_ID, 'This instance', poll([
+      session({ id: 'ses_local', idle: 10 }),
+    ], new Map()), 100);
+    store.applyPoll('host-b', 'Build box', poll([session({ id: 'ses_remote', idle: 10 })], new Map()), 100);
+
+    store.retainHosts([]);
+
+    expect(useInstanceAttentionStore.getState().items.map((item) => item.hostId))
+      .toEqual([LOCAL_INSTANCE_ATTENTION_HOST_ID]);
+  });
+
+  test('opening an item drops its host and leaves the others', () => {
+    const store = useInstanceAttentionStore.getState();
+    store.applyPoll('host-b', 'Build box', poll([session({ id: 'ses_a', idle: 10 })], new Map()), 100);
+    store.applyPoll('host-c', 'Laptop', poll([session({ id: 'ses_b', idle: 20 })], new Map()), 100);
+    const top = useInstanceAttentionStore.getState().items[0] ?? null;
+    expect(top).not.toBeNull();
+
+    store.dropHost(top!.hostId);
+
+    expect(useInstanceAttentionStore.getState().items.map((item) => item.hostId)).not.toContain(top!.hostId);
+    expect(useInstanceAttentionStore.getState().items).toHaveLength(1);
+  });
+
+  test('reset clears hosts and items', () => {
+    const store = useInstanceAttentionStore.getState();
+    store.applyPoll('host-b', 'Build box', poll([session({ id: 'ses_a', idle: 10 })], new Map()), 100);
+
+    store.reset();
+
+    expect(useInstanceAttentionStore.getState()).toMatchObject({ hosts: {}, items: [] });
+  });
+});
diff --git a/packages/ui/src/stores/useInstanceAttentionStore.ts b/packages/ui/src/stores/useInstanceAttentionStore.ts
new file mode 100644
index 000000000..079bb4ccc
--- /dev/null
+++ b/packages/ui/src/stores/useInstanceAttentionStore.ts
@@ -0,0 +1,127 @@
+import { create } from 'zustand';
+
+import type { AttentionDirectories } from '@/lib/attentionDirectories';
+import {
+  collectInstanceAttention,
+  LOCAL_INSTANCE_ATTENTION_HOST_ID,
+  type InstanceAttentionItem,
+  type InstanceAttentionPoll,
+  type InstancePendingCounts,
+  type InstanceSessionSummary,
+} from '@/lib/instanceAttention';
+
+// Holds what the saved instances other than the active one last told us, plus
+// this instance's own waiting sessions under a reserved id. Sessions, pending
+// requests and open turns are kept apart so a failed half of a poll keeps the
+// other half's previous answer instead of reading as empty.
+type InstanceAttentionHostRecord = {
+  label: string;
+  status: 'ok' | 'error';
+  checkedAt: number;
+  sessions: readonly InstanceSessionSummary[] | null;
+  pending: ReadonlyMap<string, InstancePendingCounts> | null;
+  busy: ReadonlySet<string> | null;
+  directories?: AttentionDirectories;
+};
+
+type InstanceAttentionStoreState = {
+  hosts: Readonly<Record<string, InstanceAttentionHostRecord>>;
+  /** Attention items across every tracked instance, strongest first. */
+  items: readonly InstanceAttentionItem[];
+  applyPoll: (hostId: string, label: string, poll: InstanceAttentionPoll, checkedAt: number) => void;
+  markUnreachable: (hostId: string, label: string, checkedAt: number) => void;
+  /**
+   * Drop instances that are no longer saved or are now the active one. The
+   * reserved local entry is not a polled target and always stays.
+   */
+  retainHosts: (hostIds: readonly string[]) => void;
+  dropHost: (hostId: string) => void;
+  reset: () => void;
+};
+
+const rebuild = (
+  hosts: Readonly<Record<string, InstanceAttentionHostRecord>>,
+): readonly InstanceAttentionItem[] => collectInstanceAttention(
+  Object.entries(hosts).map(([hostId, record]) => ({
+    hostId,
+    hostLabel: record.label,
+    sessions: record.sessions ?? [],
+    pending: record.pending ?? new Map(),
+    busy: record.busy ?? undefined,
+    directories: record.directories,
+  })),
+);
+
+const withoutHosts = (
+  hosts: Readonly<Record<string, InstanceAttentionHostRecord>>,
+  hostIds: readonly string[],
+) => {
+  const keep = new Set(hostIds);
+  // The local entry is fed by this window's own stores, never by the poller,
+  // so it is absent from every target list and has to survive retention.
+  keep.add(LOCAL_INSTANCE_ATTENTION_HOST_ID);
+  const next: Record<string, InstanceAttentionHostRecord> = {};
+  for (const [hostId, record] of Object.entries(hosts)) {
+    if (keep.has(hostId)) next[hostId] = record;
+  }
+  return next;
+};
+
+const EMPTY_HOSTS: Readonly<Record<string, InstanceAttentionHostRecord>> = {};
+
+export const useInstanceAttentionStore = create<InstanceAttentionStoreState>((set, get) => ({
+  hosts: EMPTY_HOSTS,
+  items: [],
+
+  applyPoll: (hostId, label, poll, checkedAt) => {
+    if (poll.sessions === null && poll.pending === null) {
+      get().markUnreachable(hostId, label, checkedAt);
+      return;
+    }
+    const previous = get().hosts[hostId];
+    const sessions = poll.sessions ?? previous?.sessions ?? null;
+    const pending = poll.pending ?? previous?.pending ?? null;
+    // Pending and busy come from the same status route; a failed status read
+    // keeps the last open turns instead of treating every session as finished.
+    const busy = poll.pending === null ? previous?.busy ?? null : poll.busy;
+    const directories = poll.directories ?? previous?.directories;
+    const hosts = {
+      ...get().hosts,
+      [hostId]: { label, status: 'ok' as const, checkedAt, sessions, pending, busy, directories },
+    };
+    set({ hosts, items: rebuild(hosts) });
+  },
+
+  markUnreachable: (hostId, label, checkedAt) => {
+    const previous = get().hosts[hostId];
+    const hosts = {
+      ...get().hosts,
+      [hostId]: {
+        label,
+        status: 'error' as const,
+        checkedAt,
+        sessions: previous?.sessions ?? null,
+        pending: previous?.pending ?? null,
+        busy: previous?.busy ?? null,
+        directories: previous?.directories,
+      },
+    };
+    // The last known items stay: an unreachable host did not answer "nothing".
+    set({ hosts, items: rebuild(hosts) });
+  },
+
+  retainHosts: (hostIds) => {
+    const hosts = withoutHosts(get().hosts, hostIds);
+    if (Object.keys(hosts).length === Object.keys(get().hosts).length) return;
+    set({ hosts, items: rebuild(hosts) });
+  },
+
+  dropHost: (hostId) => {
+    if (!get().hosts[hostId]) return;
+    const hosts = { ...get().hosts };
+    delete hosts[hostId];
+    set({ hosts, items: rebuild(hosts) });
+  },
+
+  reset: () => set({ hosts: EMPTY_HOSTS, items: [] }),
+}));
