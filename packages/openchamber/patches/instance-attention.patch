+import { afterEach, beforeEach, describe, expect, spyOn, test } from 'bun:test';
+import { Window } from 'happy-dom';
+import type { Session } from '@/lib/opencode/model';
+import { OpencodeApiError, opencodeClient } from '@/lib/opencode/client';
+import { getRuntimeApiBaseUrl, getRuntimeKey, switchRuntimeEndpoint } from '@/lib/runtime-switch';
+import { useDirectoryStore } from '@/stores/useDirectoryStore';
+import { useGlobalSessionsStore } from '@/stores/useGlobalSessionsStore';
+import { useProjectsStore } from '@/stores/useProjectsStore';
+import { clearLastActiveSession, persistLastActiveSession } from './last-session-cache';
+import { beginLastSessionRestore, restoreLastActiveSession } from './last-session-restore';
+import { completeSessionOpen, holdSessionOpen, isSessionOpenHeld, releaseSessionOpen } from './pending-session-open';
+import { useSessionUIStore } from './session-ui-store';
+
+const session = (id: string, directory = '/repo'): Session => ({
+  id,
+  projectID: 'project',
+  directory,
+  title: id,
+  time: { created: 1, updated: 1 },
+  cost: 0,
+  tokens: { input: 0, output: 0, reasoning: 0, cache: { read: 0, write: 0 } },
+});
+
+const originalUI = useSessionUIStore.getState();
+const originalProjects = useProjectsStore.getState();
+const originalSessions = useGlobalSessionsStore.getState();
+const originalDirectory = useDirectoryStore.getState();
+
+let selected: Array<[string | null, string | null | undefined]> = [];
+let sessionListReads = 0;
+let readSession: (id: string) => Promise<Session> = async (id) => session(id);
+let sessionRead: ReturnType<typeof spyOn> | null = null;
+
+beforeEach(() => {
+  selected = [];
+  sessionListReads = 0;
+  readSession = async (id) => session(id);
+  sessionRead = spyOn(opencodeClient, 'getSessionUnscoped').mockImplementation((id: string) => readSession(id));
+  // The new runtime right after the switch: neither its project list nor its
+  // session list has arrived, and the session list is slow (it never answers here).
+  useProjectsStore.setState({ projects: [{ id: 'repo', path: '/repo' }], activeProjectId: 'repo', hasServerSnapshot: false, serverSnapshotFailed: false });
+  useGlobalSessionsStore.setState({
+    hasLoaded: false,
+    status: 'idle',
+    activeSessions: [],
+    archivedSessions: [],
+    loadSessions: () => {
+      sessionListReads += 1;
+      return new Promise(() => undefined);
+    },
+  });
+  useSessionUIStore.setState({
+    currentSessionId: null,
+    currentSessionDirectory: null,
+    setCurrentSession: (id, directory) => {
+      selected.push([id, directory]);
+      useSessionUIStore.setState({ currentSessionId: id, currentSessionDirectory: directory ?? null });
+    },
+  });
+  clearLastActiveSession(getRuntimeKey());
+});
+
+afterEach(() => {
+  sessionRead?.mockRestore();
+  useSessionUIStore.setState(originalUI, true);
+  useProjectsStore.setState(originalProjects, true);
+  useGlobalSessionsStore.setState(originalSessions, true);
+  useDirectoryStore.setState(originalDirectory, true);
+  clearLastActiveSession(getRuntimeKey());
+});
+
+describe('a session held across a host switch', () => {
+  test('opens once the projects are known and the session is read, ahead of the launch restore and without the session list', async () => {
+    persistLastActiveSession(getRuntimeKey(), { sessionId: 'ses_last', directory: '/repo' });
+    const held = holdSessionOpen({ runtimeKey: getRuntimeKey(), sessionId: 'ses_clicked', directory: '/repo' });
+
+    const outcome = completeSessionOpen(held);
+    // The App remounts on the new runtime and starts its launch restore.
+    beginLastSessionRestore({ selectNow: true, refresh: false });
+    expect(await restoreLastActiveSession({ refresh: false })).toBe('none');
+    expect(selected).toEqual([]);
+
+    useProjectsStore.setState({ hasServerSnapshot: true });
+    expect(await outcome).toBe('opened');
+
+    expect(selected[0]).toEqual(['ses_clicked', '/repo']);
+    expect(useSessionUIStore.getState().currentSessionId).toBe('ses_clicked');
+    expect(isSessionOpenHeld()).toBe(false);
+    // The opener reads the list afterwards; the open did not wait for it.
+    expect(sessionListReads).toBeLessThanOrEqual(1);
+  });
+
+  test('the switch does not bring back the session that runtime had open', () => {
+    useSessionUIStore.setState(originalUI, true);
+    useDirectoryStore.setState({ currentDirectory: '/repo', homeDirectory: '/home/me', isHomeReady: true });
+    useSessionUIStore.setState({ currentSessionId: 'ses_last', currentSessionDirectory: '/repo' });
+    useSessionUIStore.getState().prepareForRuntimeSwitch('host:held-a');
+    useSessionUIStore.getState().restoreForRuntimeSwitch('host:held-b', 'host:held-a');
+
+    const held = holdSessionOpen({ runtimeKey: 'host:held-a', sessionId: 'ses_clicked', directory: '/repo' });
+    try {
+      useSessionUIStore.getState().prepareForRuntimeSwitch('host:held-b');
+      useSessionUIStore.getState().restoreForRuntimeSwitch('host:held-a', 'host:held-b');
+      expect(useSessionUIStore.getState().currentSessionId).toBeNull();
+    } finally {
+      releaseSessionOpen(held);
+    }
+  });
+
+  test('navigating elsewhere while the new instance loads releases it at once', async () => {
+    const held = holdSessionOpen({ runtimeKey: getRuntimeKey(), sessionId: 'ses_clicked', directory: '/repo' });
+    const outcome = completeSessionOpen(held);
+
+    // The user picks something else before the project list has arrived.
+    originalUI.setCurrentSession(null);
+    expect(isSessionOpenHeld()).toBe(false);
+
+    expect(await outcome).toBe('dropped');
+    expect(selected).toEqual([]);
+  });
+
+  test('a session the new instance says is gone reports failure', async () => {
+    readSession = async () => { throw new OpencodeApiError('session.get', 'Session not found', { status: 404 }); };
+    const held = holdSessionOpen({ runtimeKey: getRuntimeKey(), sessionId: 'ses_gone', directory: '/repo' });
+    const outcome = completeSessionOpen(held);
+    useProjectsStore.setState({ hasServerSnapshot: true });
+
+    expect(await outcome).toBe('failed');
+    expect(selected).toEqual([]);
+    expect(isSessionOpenHeld()).toBe(false);
+  });
+
+  test('a session read that did not answer still opens in the row folder', async () => {
+    readSession = async () => { throw new Error('network'); };
+    const held = holdSessionOpen({ runtimeKey: getRuntimeKey(), sessionId: 'ses_clicked', directory: '/repo' });
+    const outcome = completeSessionOpen(held);
+    useProjectsStore.setState({ hasServerSnapshot: true });
+
+    expect(await outcome).toBe('opened');
+    expect(selected[0]).toEqual(['ses_clicked', '/repo']);
+  });
+});
+
+describe('a held session and a second switch to the same runtime', () => {
+  const globals = new Map<string, PropertyDescriptor | undefined>();
+  let dom: Window;
+  const originalRuntime = { apiBaseUrl: getRuntimeApiBaseUrl(), runtimeKey: getRuntimeKey() };
+
+  beforeEach(() => {
+    dom = new Window({ url: 'http://localhost/' });
+    for (const [name, value] of Object.entries({ window: dom, CustomEvent: dom.CustomEvent, Event: dom.Event })) {
+      globals.set(name, Object.getOwnPropertyDescriptor(globalThis, name));
+      Object.defineProperty(globalThis, name, { configurable: true, writable: true, value });
+    }
+  });
+
+  afterEach(() => {
+    switchRuntimeEndpoint(originalRuntime);
+    for (const [name, descriptor] of globals) {
+      if (descriptor) Object.defineProperty(globalThis, name, descriptor);
+      else Reflect.deleteProperty(globalThis, name);
+    }
+    globals.clear();
+    dom.close();
+  });
+
+  test('keeps waiting for the server project list when a relay switch moves to the direct address', async () => {
+    switchRuntimeEndpoint({ apiBaseUrl: 'https://relay.test', runtimeKey: 'host:relay' });
+    let sessionWasRead: () => void = () => undefined;
+    const read = new Promise<void>((resolve) => { sessionWasRead = resolve; });
+    readSession = async (id) => { sessionWasRead(); return session(id); };
+    const held = holdSessionOpen({ runtimeKey: 'host:relay', sessionId: 'ses_clicked', directory: '/repo' });
+    const outcome = completeSessionOpen(held);
+    await read;
+
+    // The direct probe wins: same instance, same key, new address. Its reset
+    // shows the persisted projects again until the server's list arrives.
+    switchRuntimeEndpoint({ apiBaseUrl: 'https://direct.test', runtimeKey: 'host:relay' });
+    useProjectsStore.setState({ hasServerSnapshot: false });
+    for (let step = 0; step < 10; step += 1) await Promise.resolve();
+    expect(selected).toEqual([]);
+    expect(isSessionOpenHeld('host:relay')).toBe(true);
+
+    useProjectsStore.setState({ hasServerSnapshot: true });
+    expect(await outcome).toBe('opened');
+    expect(selected[0]).toEqual(['ses_clicked', '/repo']);
+  });
+});
