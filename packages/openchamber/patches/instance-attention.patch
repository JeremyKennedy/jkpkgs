+  test('a form the server still holds is kept', async () => {
+    const stale = await planStalePendingForms(
+      pending('/repo', 'frm_live'),
+      () => '/repo',
+      async () => [form('frm_live')],
+    );
+
+    expect(stale).toEqual([]);
+  });
+
+  test('an unreadable answer keeps every form', async () => {
+    const stale = await planStalePendingForms(
+      pending('/repo', 'frm_a'),
+      () => '/repo',
+      async () => null,
+    );
+
+    expect(stale).toEqual([]);
+  });
+
+  test('the session record decides the directory, then the index entry', async () => {
+    const asked: string[] = [];
+    const stale = await planStalePendingForms(
+      pending('/indexed', 'frm_a'),
+      () => '/from-session',
+      async (directory) => {
+        asked.push(directory);
+        return [];
+      },
+    );
