+const isUnreadFields = (
+  parentID: string | undefined,
+  idle: number | undefined,
+  viewed: number | undefined,
+  archived: boolean,
+): boolean => {
+  if (parentID || archived) return false
+  return idle !== undefined && (viewed === undefined || viewed < idle)
