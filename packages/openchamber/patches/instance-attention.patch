diff --git a/packages/ui/src/hooks/instanceAttentionVisibility.test.ts b/packages/ui/src/hooks/instanceAttentionVisibility.test.ts
new file mode 100644
index 000000000..21f00511e
--- /dev/null
+++ b/packages/ui/src/hooks/instanceAttentionVisibility.test.ts
@@ -0,0 +1,79 @@
+import { afterEach, beforeEach, describe, expect, test } from 'bun:test';
+
+import { instanceAttentionVisibility } from './useInstanceAttentionPolling';
+
+// The document listeners belong to the visibility object, not to whichever
+// listener happens to be subscribed: a poller that stops and starts again must
+// still wake on focus after its first listener was removed.
+
+type FakeEvents = {
+  visibilityState: 'visible' | 'hidden';
+  addEventListener: (type: string, listener: () => void) => void;
+  removeEventListener: (type: string, listener: () => void) => void;
+  fire: (type: string) => void;
+  count: (type: string) => number;
+};
+
+const fakeEvents = (): FakeEvents => {
+  const listeners = new Map<string, Set<() => void>>();
+  return {
+    visibilityState: 'visible',
+    addEventListener: (type, listener) => {
+      const set = listeners.get(type) ?? new Set();
+      set.add(listener);
+      listeners.set(type, set);
+    },
+    removeEventListener: (type, listener) => {
+      listeners.get(type)?.delete(listener);
+    },
+    fire: (type) => {
+      for (const listener of [...(listeners.get(type) ?? [])]) listener();
+    },
+    count: (type) => listeners.get(type)?.size ?? 0,
+  };
+};
+
+let doc: FakeEvents;
+let win: FakeEvents;
+const globals = new Map<string, PropertyDescriptor | undefined>();
+
+beforeEach(() => {
+  for (const name of ['document', 'window']) {
+    globals.set(name, Object.getOwnPropertyDescriptor(globalThis, name));
+  }
+  doc = fakeEvents();
+  win = fakeEvents();
+  Object.defineProperty(globalThis, 'document', { configurable: true, writable: true, value: doc });
+  Object.defineProperty(globalThis, 'window', { configurable: true, writable: true, value: win });
+});
+
+afterEach(() => {
+  for (const [name, descriptor] of globals) {
+    if (descriptor) Object.defineProperty(globalThis, name, descriptor);
+    else Reflect.deleteProperty(globalThis, name);
+  }
+  globals.clear();
+});
+
+describe('instance attention visibility', () => {
+  test('keeps waking after a listener leaves and only stops on dispose', () => {
+    const visibility = instanceAttentionVisibility();
+    let wakes = 0;
+
+    const stopFirst = visibility.onVisible(() => { wakes += 1; });
+    stopFirst();
+    expect(doc.count('visibilitychange')).toBe(1);
+    expect(win.count('focus')).toBe(1);
+
+    visibility.onVisible(() => { wakes += 1; });
+    doc.visibilityState = 'hidden';
+    doc.fire('visibilitychange');
+    doc.visibilityState = 'visible';
+    doc.fire('visibilitychange');
+    expect(wakes).toBe(1);
+
+    visibility.dispose();
+    expect(doc.count('visibilitychange')).toBe(0);
+    expect(win.count('focus')).toBe(0);
+  });
+});
