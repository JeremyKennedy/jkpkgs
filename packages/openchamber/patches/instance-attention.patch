+import { afterEach, beforeEach, expect, test } from 'bun:test';
+
+import { serveTestHttp } from '@/lib/test-http-server';
+
+import { checkDirectCandidateIdentity } from './mobileConnections';
+
+const originalWindow = globalThis.window;
+
+beforeEach(() => {
+  Object.defineProperty(globalThis, 'window', {
+    configurable: true,
+    value: Object.assign(new EventTarget(), {
+      setTimeout: globalThis.setTimeout.bind(globalThis),
+      clearTimeout: globalThis.clearTimeout.bind(globalThis),
+    }),
+  });
+});
+
+afterEach(() => {
+  Object.defineProperty(globalThis, 'window', { configurable: true, value: originalWindow });
+});
+
+const healthServer = async (payload: unknown, status = 200) => {
+  const seen: Array<{ url: string; authorization: string | undefined }> = [];
+  const server = await serveTestHttp((request, response) => {
+    seen.push({ url: request.url ?? '', authorization: request.headers.authorization });
+    response.writeHead(status, { 'Content-Type': 'application/json' });
+    response.end(JSON.stringify(payload));
+  });
+  return { server, seen, url: server.url.toString().replace(/\/$/, '') };
+};
+
+test('matches the pinned identity and sends no bearer to /health', async () => {
+  const { server, seen, url } = await healthServer({ serverId: 'server-a' });
+  try {
+    expect(await checkDirectCandidateIdentity({ kind: 'direct', url }, 'server-a')).toBe('match');
+    expect(seen).toEqual([{ url: '/health', authorization: undefined }]);
+  } finally {
+    server.close();
+  }
+});
+
+test('a different serverId is a mismatch', async () => {
+  const { server, url } = await healthServer({ serverId: 'server-b' });
+  try {
+    expect(await checkDirectCandidateIdentity({ kind: 'direct', url }, 'server-a')).toBe('mismatch');
+  } finally {
+    server.close();
+  }
+});
+
+test('an unreadable /health is unverified, never a match', async () => {
+  const { server, url } = await healthServer({}, 500);
+  try {
+    expect(await checkDirectCandidateIdentity({ kind: 'direct', url }, 'server-a')).toBe('unreachable');
+  } finally {
+    server.close();
+  }
+});
+
+test('a health answer without a serverId keeps the pre-pairing behaviour', async () => {
+  const { server, url } = await healthServer({ status: 'ok' });
+  try {
+    expect(await checkDirectCandidateIdentity({ kind: 'direct', url }, 'server-a')).toBe('match');
+  } finally {
+    server.close();
+  }
+});
+
+test('no pinned identity means no probe request at all', async () => {
+  const { server, seen, url } = await healthServer({ serverId: 'server-a' });
+  try {
+    expect(await checkDirectCandidateIdentity({ kind: 'direct', url }, null)).toBe('match');
+    expect(seen).toEqual([]);
+  } finally {
+    server.close();
+  }
+});
+
+test('a refused connection is unverified', async () => {
+  const { server, url } = await healthServer({ serverId: 'server-a' });
+  server.close();
+  expect(await checkDirectCandidateIdentity({ kind: 'direct', url }, 'server-a')).toBe('unreachable');
+});
