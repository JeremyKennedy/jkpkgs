+
+describe('mobile attention target selection', () => {
+  test('excludes the active connection and keeps direct and relay transports', () => {
+    const targets = mobileAttentionTargets([
+      connection('lan', [{ kind: 'direct', url: 'http://lan.test' }]),
+      connection('away', [{
+        kind: 'relay',
+        relay: { relayUrl: 'wss://relay.test', serverId: 'away', hostEncPubJwk: {} },
+      }]),
+      connection('active', [{ kind: 'direct', url: 'http://active.test' }]),
+    ], 'active');
+
+    expect(targets.map((target) => target.hostId)).toEqual(['lan', 'away']);
+    expect(targets.map((target) => target.label)).toEqual(['Server lan', 'Server away']);
+    // The keychain reads, one direct attempt and the margin for the LAN-only
+    // connection.
+    expect(targets.find((target) => target.hostId === 'lan')?.timeoutMs).toBe(12_000);
+    // The relay keeps its full slice after the direct attempts; the poller
+    // must not abort it at the direct budget.
+    expect(targets.find((target) => target.hostId === 'away')?.timeoutMs).toBe(16_000);
+  });
+
+  test('a connection with two direct candidates and a relay gets both budgets', () => {
+    const targets = mobileAttentionTargets([
+      connection('both', [
+        { kind: 'direct', url: 'http://lan.test' },
+        { kind: 'direct', url: 'https://tunnel.test' },
+        {
+          kind: 'relay',
+          relay: { relayUrl: 'wss://relay.test', serverId: 'both', hostEncPubJwk: {} },
+        },
+      ]),
+    ], null);
+
+    expect(targets[0]?.timeoutMs).toBe(24_000);
+  });
+
+  test('a saved connection without a transport is not polled', () => {
+    const targets = mobileAttentionTargets([
+      connection('empty', []),
+      connection('lan', [{ kind: 'direct', url: 'http://lan.test' }]),
+    ], null);
+
+    expect(targets.map((target) => target.hostId)).toEqual(['lan']);
+  });
+});
diff --git a/packages/ui/src/apps/mobileInstanceAttention.ts b/packages/ui/src/apps/mobileInstanceAttention.ts
new file mode 100644
index 000000000..084d6edcd
--- /dev/null
+++ b/packages/ui/src/apps/mobileInstanceAttention.ts
@@ -0,0 +1,146 @@
+import type { InstanceAttentionPoll } from '@/lib/instanceAttention';
+import {
+  readInstanceAttention,
+  readInstanceAttentionWithin,
+  readRelayInstanceAttention,
+} from '@/lib/instanceAttention';
+import type { InstanceAttentionTarget } from '@/hooks/useInstanceAttentionPolling';
+
+import {
+  checkDirectCandidateIdentity,
+  loadMobileConnectionHeaders,
+  loadMobileConnectionToken,
+  MOBILE_SECURE_TIMEOUT_MS,
+  type MobileSavedConnection,
+} from './mobileConnections';
+import { mobileHeadersForUrl, type MobileRequestHeaders } from './mobileRequestHeaders';
+
+// Mobile's cross-instance attention: the saved connections this phone is not
+// showing. The active connection is excluded because the app itself reports
+// its sessions; every other saved server is read over its own transport.
+//
+// Direct candidates are plain URLs. A relay-only connection is read through an
+// E2EE tunnel: the live runtime tunnel when it already serves that server,
+// otherwise a short-lived one that is closed after the read. This is the same
+// tunnel client the connect flow uses, not a second transport.
+
+// A stale LAN candidate must not consume the whole poll budget: every candidate
+// shares one deadline, and the relay keeps its own slice after the direct
+// attempts. The target's timeout covers the whole sequence.
+const MOBILE_DIRECT_READ_TIMEOUT_MS = 4_000;
+const MOBILE_RELAY_READ_TIMEOUT_MS = 8_000;
+const MOBILE_READ_MARGIN_MS = 2_000;
+
+// Before the first request, the headers and token reads may each spend their
+// full secure-storage budget. The target's timeout has to include both, or the
+// poller aborts the read while the keychain is still answering.
+const MOBILE_STORAGE_BUDGET_MS = MOBILE_SECURE_TIMEOUT_MS * 2;
+
+const answered = (poll: InstanceAttentionPoll): boolean =>
+  poll.sessions !== null || poll.pending !== null;
+
+/**
+ * Reads one saved connection's sessions and pending requests. Direct
+ * candidates are tried in their saved order; if none answers, a saved relay
+ * candidate is used. All candidates share one deadline, so the relay is not
+ * aborted by a spent direct budget.
+ */
+const readMobileConnectionAttention = async (
+  connection: MobileSavedConnection,
+  signal: AbortSignal,
+): Promise<InstanceAttentionPoll> => {
+  const directs = connection.candidates.filter((candidate) => candidate.kind === 'direct');
+  const relayCandidate = connection.candidates.find((candidate) => candidate.kind === 'relay');
+  // The relay's own identity is the pinned one: a direct address that reports a
+  // different serverId is another machine and must not receive the token.
+  const expectedServerId = relayCandidate?.kind === 'relay' ? relayCandidate.relay.serverId : null;
+
+  let headerConfig: MobileRequestHeaders | undefined;
+  try {
+    headerConfig = await loadMobileConnectionHeaders(connection.id);
+  } catch {
+    // The read still works without headers on a server that does not require
+    // them; a required one simply fails and is marked unreachable.
+    headerConfig = undefined;
+  }
+  const token = await loadMobileConnectionToken(connection);
+
+  // Start the network budget after the keychain reads: they have their own
+  // bounds, and letting them eat the relay slice shortened it on a slow phone.
+  const deadline = Date.now()
+    + directs.length * MOBILE_DIRECT_READ_TIMEOUT_MS
+    + (relayCandidate ? MOBILE_RELAY_READ_TIMEOUT_MS : 0);
+
+  for (const candidate of directs) {
+    const remaining = Math.max(0, deadline - Date.now());
+    if (remaining === 0 || signal.aborted) break;
+    // Proxy credentials belong to the address the user configured; a LAN and a
+    // tunnel candidate can have different origins.
+    const headers = mobileHeadersForUrl(candidate.url, headerConfig);
+    const budget = Math.min(MOBILE_DIRECT_READ_TIMEOUT_MS, remaining);
+    const poll = await readInstanceAttentionWithin(
+      signal,
+      budget,
+      async (readSignal) => {
+        if (expectedServerId) {
+          const identity = await checkDirectCandidateIdentity(candidate, expectedServerId, {
+            requestHeaders: headerConfig,
+            totalTimeoutMs: budget,
+          });
+          if (identity !== 'match') return { sessions: null, pending: null, busy: null };
+        }
+        return readInstanceAttention({
+          url: candidate.url,
+          token,
+          headers: Object.keys(headers).length > 0 ? headers : undefined,
+        }, { signal: readSignal });
+      },
+    );
+    if (answered(poll)) return poll;
+    if (signal.aborted) return poll;
+  }
+
+  if (relayCandidate && relayCandidate.kind === 'relay' && !signal.aborted) {
+    const remaining = Math.max(0, deadline - Date.now());
+    if (remaining > 0) {
+      return readInstanceAttentionWithin(
+        signal,
+        Math.min(MOBILE_RELAY_READ_TIMEOUT_MS, remaining),
+        (readSignal) => readRelayInstanceAttention(relayCandidate.relay, {
+          token,
+          headers: headerConfig?.values,
+          signal: readSignal,
+        }),
+      );
+    }
+  }
+
+  return { sessions: null, pending: null, busy: null };
+};
+
+/**
+ * The saved connections to poll: every one except the active connection. The
+ * phone has no persistent instance switcher, so this is the mobile equivalent
+ * of the desktop target list.
+ */
+export const mobileAttentionTargets = (
+  connections: readonly MobileSavedConnection[],
+  activeConnectionId: string | null,
+): InstanceAttentionTarget[] => connections
+  .filter((connection) => connection.id !== activeConnectionId && connection.candidates.length > 0)
+  .map((connection) => {
+    const directs = connection.candidates.filter((candidate) => candidate.kind === 'direct').length;
+    const hasRelay = connection.candidates.some((candidate) => candidate.kind === 'relay');
+    return {
+      hostId: connection.id,
+      label: connection.label,
+      // Covers the keychain reads, every direct attempt, the relay and the
+      // margin, so the poller's abort cannot cut the relay off before its own
+      // timeout or abandon a slow secure-store read.
+      timeoutMs: MOBILE_STORAGE_BUDGET_MS
+        + directs * MOBILE_DIRECT_READ_TIMEOUT_MS
+        + (hasRelay ? MOBILE_RELAY_READ_TIMEOUT_MS : 0)
+        + MOBILE_READ_MARGIN_MS,
+      read: (signal: AbortSignal) => readMobileConnectionAttention(connection, signal),
+    };
+  });
