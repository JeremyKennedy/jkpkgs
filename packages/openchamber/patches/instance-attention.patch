+  id: record.id,
+  parentID: record.parentID,
+  directory: record.location?.directory ?? null,
+  title: record.title ?? '',
+  idle: record.time?.idle,
+  viewed: record.time?.viewed,
+  archived: record.time?.archived !== undefined,
+  updated: record.time?.updated,
+  outcome: record.outcome,
