index 000000000..4b2367e1d
--- /dev/null
+++ b/packages/ui/src/lib/instanceAttentionRelay.test.ts
@@ -0,0 +1,117 @@
+import { describe, expect, test } from 'bun:test';
+
+import type { JsonValue } from '@opencode/client';
+
+import { readRelayInstanceAttention, type InstanceAttentionRelayDeps } from './instanceAttention';
+import type { RelayTunnelClient, RelayTunnelStatus } from './relay/tunnel-client';
+
+const relay = {
+  relayUrl: 'wss://relay.test',
+  serverId: 'server-1',
+  hostEncPubJwk: {},
+};
+
+const sessionPayload: JsonValue = {
+  data: [{ id: 'ses_a', location: { directory: '/repo' }, title: 'A', time: { idle: 1 } }],
+};
+const statusPayload: JsonValue = {
+  sessions: {},
+  pending: {},
+  serverTime: 1_000,
+};
+
+type FakeTunnel = RelayTunnelClient & { paths: string[] };
+
+const fakeTunnel = (): FakeTunnel => {
+  const paths: string[] = [];
+  const tunnel: RelayTunnelClient = {
+    fetch: async (input: string | URL | Request) => {
+      const path = String(input);
+      paths.push(path);
+      const body = path.startsWith('/api/sessions/status') ? statusPayload : sessionPayload;
+      return new Response(JSON.stringify(body), {
+        status: 200,
+        headers: { 'Content-Type': 'application/json' },
+      });
+    },
+    close: () => undefined,
+    getStatus: (): RelayTunnelStatus => ({ state: 'connected' }),
+    openWebSocket: () => { throw new Error('unused'); },
+    subscribeStatus: () => () => undefined,
+    retry: () => undefined,
+  };
+  return { ...tunnel, paths };
+};
+
+const deps = (
+  createTunnel: InstanceAttentionRelayDeps['createTunnel'],
+  activeTunnel: RelayTunnelClient | null = null,
+  activeDescriptor: ReturnType<InstanceAttentionRelayDeps['getActiveDescriptor']> = null,
+): InstanceAttentionRelayDeps => ({
+  createTunnel,
+  getActiveTunnel: () => activeTunnel,
+  getActiveDescriptor: () => activeDescriptor,
+});
+
+describe('relay attention reads', () => {
+  test('opens a tunnel, reads both routes and closes it', async () => {
+    const tunnel = fakeTunnel();
+    let created = 0;
+    let closed = 0;
+    const reader = deps(
+      (options) => {
+        expect(options).toEqual(relay);
+        created += 1;
+        return tunnel;
+      },
+    );
+    const close = tunnel.close.bind(tunnel);
+    tunnel.close = () => { closed += 1; close(); };
+
+    const poll = await readRelayInstanceAttention(relay, { token: 'relay-token' }, reader);
+
+    expect(created).toBe(1);
+    expect(closed).toBe(1);
+    expect(tunnel.paths.sort()).toEqual(['/api/session?limit=200', '/api/sessions/status']);
+    expect(poll.sessions?.map((entry) => entry.id)).toEqual(['ses_a']);
+  });
+
+  test('reuses the live runtime tunnel when it serves the same server', async () => {
+    const tunnel = fakeTunnel();
+    let created = 0;
+    let closed = 0;
+    tunnel.close = () => { closed += 1; };
+    const reader = deps(
+      () => {
+        created += 1;
+        return fakeTunnel();
+      },
+      tunnel,
+      relay,
+    );
+
+    const poll = await readRelayInstanceAttention(relay, {}, reader);
+
+    expect(created).toBe(0);
+    expect(closed).toBe(0);
+    expect(poll.sessions?.map((entry) => entry.id)).toEqual(['ses_a']);
+  });
+
+  test('opens its own tunnel when the live one serves another server', async () => {
+    const active = fakeTunnel();
+    const created = fakeTunnel();
+    let closed = 0;
+    created.close = () => { closed += 1; };
+    const reader = deps(
+      () => created,
+      active,
+      { ...relay, serverId: 'server-2' },
+    );
+
+    const poll = await readRelayInstanceAttention(relay, {}, reader);
+
+    expect(closed).toBe(1);
+    expect(created.paths.sort()).toEqual(['/api/session?limit=200', '/api/sessions/status']);
+    expect(poll.sessions?.map((entry) => entry.id)).toEqual(['ses_a']);
+  });
+});
