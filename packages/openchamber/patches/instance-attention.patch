+import React from 'react';
+
+import {
+  desktopHostProbe,
+  desktopHostsGet,
+  getDesktopHostApiUrl,
+  normalizeHostUrl,
+  type DesktopHost,
+  type HostProbeResult,
+} from '@/lib/desktopHosts';
+import { resolveCurrentDesktopHost, withLocalDesktopHost } from '@/lib/desktopCurrentHost';
+import {
+  readInstanceAttention,
+  readInstanceAttentionWithin,
+  readRelayInstanceAttention,
+  type InstanceAttentionPoll,
+} from '@/lib/instanceAttention';
+import { subscribeRuntimeEndpointChanged } from '@/lib/runtime-switch';
+import { useInstanceAttentionStore } from '@/stores/useInstanceAttentionStore';
+
+// Polls the saved instances this window is not showing. The active instance is
+// already reported by the sidebar's own indicators, and its live events keep it
+// current, so only the others are read here.
+//
+// Two global routes per server, no directory: `GET /api/session` and
+// `GET /api/sessions/status`. Neither starts an OpenCode location, so a poll
+// never spawns MCP servers on the host. A relay host is read through a
+// short-lived tunnel (or the live runtime tunnel when it serves the same
+// server), so a relay-only instance is polled instead of being skipped.
+
+export const INSTANCE_ATTENTION_POLL_INTERVAL_MS = 45_000;
+const INSTANCE_ATTENTION_POLL_TIMEOUT_MS = 12_000;
+const INSTANCE_ATTENTION_DIRECT_TIMEOUT_MS = 4_000;
+const INSTANCE_ATTENTION_RELAY_TIMEOUT_MS = 8_000;
+const INSTANCE_ATTENTION_READ_MARGIN_MS = 2_000;
+
+type InstanceAttentionRefreshListener = () => Promise<void>;
+const refreshListeners = new Set<InstanceAttentionRefreshListener>();
+
+/**
+ * Reads every running poller's instances now instead of waiting for the next
+ * tick. The returned promise settles when the read it caused has finished, so a
+ * surface can keep a spinner up without gating its own action on it.
+ *
+ * A request that arrives while a read is in flight joins a single follow-up
+ * read rather than starting another cycle.
+ */
+export const requestInstanceAttentionRefresh = async (): Promise<void> => {
+  await Promise.all([...refreshListeners].map((listener) => listener()));
+};
+
+const subscribeInstanceAttentionRefresh = (listener: InstanceAttentionRefreshListener): (() => void) => {
+  refreshListeners.add(listener);
+  return () => {
+    refreshListeners.delete(listener);
+  };
+};
+
+export type InstanceAttentionHosts = {
+  hosts: DesktopHost[];
+  localOrigin: string | null;
+};
+
+/** One saved server to read, with the transport that server needs. */
+export type InstanceAttentionTarget = {
+  hostId: string;
+  label: string;
+  /**
+   * How long this target may take. A relay fallback needs the direct attempt
+   * plus the tunnel, so the shell sizes this instead of losing the relay to the
+   * generic poll timeout.
+   */
+  timeoutMs?: number;
+  read: (signal: AbortSignal) => Promise<InstanceAttentionPoll>;
+};
+
+type InstanceAttentionPollingDeps = {
+  readTargets: () => Promise<InstanceAttentionTarget[] | null>;
+  isVisible: () => boolean;
+  onVisible: (listener: () => void) => () => void;
+  scheduleTimeout: (callback: () => void, delay: number) => number;
+  clearScheduledTimeout: (timeoutId: number) => void;
+  now: () => number;
+};
+
+type InstanceAttentionVisibility = {
+  isVisible: () => boolean;
+  onVisible: (listener: () => void) => () => void;
+  /** Removes the document listeners; a poller owns one per run. */
+  dispose: () => void;
+};
+
+const ALWAYS_VISIBLE: InstanceAttentionVisibility = {
+  isVisible: () => true,
+  onVisible: () => () => undefined,
+  dispose: () => undefined,
+};
+
+/**
+ * A direct address is only allowed to receive a host's bearer token once its
+ * UNAUTHENTICATED `/health` has proven it is the instance pinned by the relay
+ * identity. A DHCP address that now belongs to another machine answers
+ * `/health` as itself, so the probe refuses before the token is attached — and
+ * falling through to the relay keeps the host polled. An identity that cannot
+ * be read is not a match.
+ */
+const directAddressOwnsPinnedIdentity = async (
+  url: string,
+  expectedServerId: string | null,
+  signal: AbortSignal,
+): Promise<boolean> => {
+  if (!expectedServerId) return true;
+  // The main-process probe has its own retry budget, longer than the direct
+  // attempt here. Race it against this attempt's signal so a stale LAN address
+  // cannot eat the relay's slice; its late answer is discarded.
+  const aborted = new Promise<HostProbeResult>((resolve) => {
+    if (signal.aborted) {
+      resolve({ status: 'unreachable', latencyMs: 0 });
+      return;
+    }
+    signal.addEventListener('abort', () => resolve({ status: 'unreachable', latencyMs: 0 }), { once: true });
+  });
+  const probe = await Promise.race([
+    desktopHostProbe(url, { expectedServerId }).catch((): HostProbeResult => ({ status: 'unreachable', latencyMs: 0 })),
+    aborted,
+  ]);
+  return probe.status !== 'unreachable' && probe.status !== 'wrong-service' && probe.status !== 'relay-limit';
+};
+
+/**
+ * A desktop host's two routes. A relay host is tried over its direct address
+ * briefly first, then over the tunnel; a stale direct address therefore costs
+ * one short attempt instead of marking the host unreachable.
+ */
+const readDesktopHostAttention = async (
+  host: DesktopHost,
+  directUrl: string | null,
+  signal: AbortSignal,
+): Promise<InstanceAttentionPoll> => {
+  const expectedServerId = host.relay?.serverId ?? null;
+  const deadline = Date.now()
+    + (directUrl ? INSTANCE_ATTENTION_DIRECT_TIMEOUT_MS : 0)
+    + (host.relay ? INSTANCE_ATTENTION_RELAY_TIMEOUT_MS : 0);
+  if (directUrl) {
+    const remaining = Math.max(0, deadline - Date.now());
+    const budget = Math.min(INSTANCE_ATTENTION_DIRECT_TIMEOUT_MS, remaining);
+    const poll = await readInstanceAttentionWithin(
+      signal,
+      budget,
+      async (readSignal) => {
+        const verified = await directAddressOwnsPinnedIdentity(directUrl, expectedServerId, readSignal);
+        if (!verified) return { sessions: null, pending: null, busy: null };
+        return readInstanceAttention({
+          url: directUrl,
+          token: host.clientToken,
+          headers: host.requestHeaders,
+        }, { signal: readSignal });
+      },
+    );
+    if (poll.sessions !== null || poll.pending !== null) return poll;
+    if (signal.aborted) return poll;
+  }
+  if (host.relay) {
+    const remaining = Math.max(0, deadline - Date.now());
+    if (remaining > 0) {
+      return readInstanceAttentionWithin(
+        signal,
+        Math.min(INSTANCE_ATTENTION_RELAY_TIMEOUT_MS, remaining),
+        (readSignal) => readRelayInstanceAttention(host.relay!, {
+          token: host.clientToken,
+          headers: host.requestHeaders,
+          signal: readSignal,
+        }),
+      );
+    }
+  }
+  return { sessions: null, pending: null, busy: null };
+};
+
+/**
+ * The desktop instances to read: saved, not the one this window shows, and
+ * reachable either directly or over the relay. A relay-only host is included
+ * now that its tunnel-backed read exists.
+ */
+export const instanceAttentionTargets = (
+  config: InstanceAttentionHosts,
+  activeHostId: string,
+): InstanceAttentionTarget[] => config.hosts
+  .filter((host) => host.id !== activeHostId)
+  .flatMap((host) => {
+    const directUrl = normalizeHostUrl(getDesktopHostApiUrl(host));
+    if (!directUrl && !host.relay) return [];
+    return [{
+      hostId: host.id,
+      label: host.label,
+      timeoutMs: (directUrl ? INSTANCE_ATTENTION_DIRECT_TIMEOUT_MS : 0)
+        + (host.relay ? INSTANCE_ATTENTION_RELAY_TIMEOUT_MS : 0)
+        + INSTANCE_ATTENTION_READ_MARGIN_MS,
+      read: (signal: AbortSignal) => readDesktopHostAttention(host, directUrl, signal),
+    }];
+  });
+
+/**
+ * Owns the polling loop. Every cycle re-reads the saved instances, so adding,
+ * removing or switching one needs no restart. A failed host keeps its last
+ * known items and is marked unreachable; it is not read as empty. A read that
+ * runs out of time is unreachable too, not silently dropped.
+ */
+export const startInstanceAttentionPolling = (
+  deps: InstanceAttentionPollingDeps,
+): (() => void) => {
+  let disposed = false;
+  let running = false;
+  let refreshQueued = false;
+  let queuedRefreshResolvers: Array<() => void> = [];
+  let timeoutId: number | undefined;
+  const controllers = new Set<AbortController>();
+
+  const schedule = () => {
+    if (disposed) return;
+    timeoutId = deps.scheduleTimeout(() => {
+      timeoutId = undefined;
+      if (disposed) return;
+      if (!deps.isVisible()) {
+        schedule();
+        return;
+      }
+      void run();
+    }, INSTANCE_ATTENTION_POLL_INTERVAL_MS);
+  };
+
+  const readTarget = async (target: InstanceAttentionTarget): Promise<void> => {
+    const controller = new AbortController();
+    controllers.add(controller);
+    const timeout = deps.scheduleTimeout(
+      () => controller.abort(),
+      target.timeoutMs ?? INSTANCE_ATTENTION_POLL_TIMEOUT_MS,
+    );
+    try {
+      const poll = await target.read(controller.signal);
+      if (disposed) return;
+      const store = useInstanceAttentionStore.getState();
+      // A partial answer still counts: a session list that answered keeps its
+      // unread turns even when the status route timed out.
+      if (poll.sessions !== null || poll.pending !== null) {
+        store.applyPoll(target.hostId, target.label, poll, deps.now());
+      } else {
+        store.markUnreachable(target.hostId, target.label, deps.now());
+      }
+    } catch {
+      if (!disposed) useInstanceAttentionStore.getState().markUnreachable(target.hostId, target.label, deps.now());
+    } finally {
+      deps.clearScheduledTimeout(timeout);
+      controllers.delete(controller);
+    }
+  };
+
+  const run = async (): Promise<void> => {
+    if (disposed || running) return;
+    // A read started outside the tick (a refresh request, the surface opening)
+    // replaces the scheduled cycle with the one it is about to schedule.
+    if (timeoutId !== undefined) {
+      deps.clearScheduledTimeout(timeoutId);
+      timeoutId = undefined;
+    }
+    running = true;
+    try {
+      const targets = await deps.readTargets().catch(() => null);
+      if (disposed) return;
+      if (!targets) {
+        schedule();
+        return;
+      }
+      const store = useInstanceAttentionStore.getState();
+      store.retainHosts(targets.map((target) => target.hostId));
+      await Promise.allSettled(targets.map(readTarget));
+      if (disposed) return;
+      schedule();
+    } finally {
+      running = false;
+      const waiters = queuedRefreshResolvers;
+      queuedRefreshResolvers = [];
+      if (refreshQueued && !disposed) {
+        refreshQueued = false;
+        // Awaiting the follow-up keeps this cycle's promise (and every request
+        // it absorbed) unsettled until the read the caller asked for finished.
+        await run();
+      } else {
+        refreshQueued = false;
+      }
+      for (const resolve of waiters) resolve();
+    }
+  };
+
+  /**
+   * A refresh request is a read promise: it joins the in-flight read's single
+   * follow-up when one is running, so callers that arrived together settle
+   * together and the poller reads once more, not once per caller.
+   */
+  const readNow = (): Promise<void> => {
+    if (disposed) return Promise.resolve();
+    if (!running) return run();
+    refreshQueued = true;
+    return new Promise<void>((resolve) => {
+      queuedRefreshResolvers.push(resolve);
+    });
+  };
+
+  const unsubscribeRefresh = subscribeInstanceAttentionRefresh(readNow);
+
+  const stopVisible = deps.onVisible(() => {
+    if (disposed || running) return;
+    if (timeoutId !== undefined) deps.clearScheduledTimeout(timeoutId);
+    timeoutId = undefined;
+    void run();
+  });
+
+  if (deps.isVisible()) void run();
+  else schedule();
+
+  return () => {
+    disposed = true;
+    unsubscribeRefresh();
+    stopVisible();
+    if (timeoutId !== undefined) deps.clearScheduledTimeout(timeoutId);
+    for (const controller of controllers) controller.abort();
+    controllers.clear();
+  };
+};
+
+/**
+ * The document listeners for one poller run. They stay attached until
+ * `dispose`, so a listener added after another was removed still wakes the
+ * poller: a runtime switch starts a fresh instance instead of reusing one whose
+ * listeners were torn down with its previous listener.
+ */
+export const instanceAttentionVisibility = (): InstanceAttentionVisibility => {
+  const doc = globalThis.document;
+  if (!doc) return ALWAYS_VISIBLE;
+  let hidden = doc.visibilityState === 'hidden';
+  const listeners = new Set<() => void>();
+  const handle = () => {
+    const next = doc.visibilityState === 'hidden';
+    if (hidden && !next) for (const listener of listeners) listener();
+    hidden = next;
+  };
+  doc.addEventListener('visibilitychange', handle);
+  globalThis.window.addEventListener('focus', handle);
+  return {
+    isVisible: () => doc.visibilityState !== 'hidden',
+    onVisible: (listener) => {
+      listeners.add(listener);
+      return () => { listeners.delete(listener); };
+    },
+    dispose: () => {
+      listeners.clear();
+      doc.removeEventListener('visibilitychange', handle);
+      globalThis.window.removeEventListener('focus', handle);
+    },
+  };
+};
+
+const readDesktopHosts = async (): Promise<InstanceAttentionHosts> => {
+  const config = await desktopHostsGet();
+  return { hosts: config.hosts, localOrigin: config.localOrigin ?? null };
+};
+
+const readDesktopTargets = async (): Promise<InstanceAttentionTarget[]> => {
+  const config = await readDesktopHosts();
+  const activeHostId = resolveCurrentDesktopHost(withLocalDesktopHost(config.hosts, config.localOrigin)).id;
+  return instanceAttentionTargets(config, activeHostId);
+};
+
+/**
+ * Runs the cross-instance poller in the desktop shell, restarting it when the
+ * window switches instances: the instance just left becomes a target and the
+ * one now shown stops being read.
+ */
+export const useInstanceAttentionPolling = (enabled: boolean): void => {
+  React.useEffect(() => {
+    if (!enabled) return;
+    const start = () => {
+      const visibility = instanceAttentionVisibility();
+      const stopPolling = startInstanceAttentionPolling({
+        readTargets: readDesktopTargets,
+        isVisible: visibility.isVisible,
+        onVisible: visibility.onVisible,
+        scheduleTimeout: window.setTimeout.bind(window),
+        clearScheduledTimeout: window.clearTimeout.bind(window),
+        now: Date.now,
+      });
+      return () => {
+        stopPolling();
+        visibility.dispose();
+      };
+    };
+    let stop = start();
+    // The switch drops the store in `runtimeEndpointReset`; this restarts the
+    // loop with the new active instance excluded.
+    const unsubscribe = subscribeRuntimeEndpointChanged(() => {
+      stop();
+      stop = start();
+    });
+    return () => {
+      unsubscribe();
+      stop();
+    };
+  }, [enabled]);
+};
