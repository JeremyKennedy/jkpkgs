+import { beforeEach, describe, expect, mock, test } from 'bun:test';
+
+import type { DesktopHost, HostProbeResult } from '@/lib/desktopHosts';
+import type { InstanceAttentionPoll } from '@/lib/instanceAttention';
+
+const answered: InstanceAttentionPoll = {
+  sessions: [{ id: 'ses_a', directory: '/repo', title: 'Session', archived: false, idle: 10 }],
+  pending: new Map(),
+  busy: new Set(),
+};
+
+const probes: Array<{ url: string; options: unknown }> = [];
+const directReads: Array<{ url: string; token?: string }> = [];
+const relayReads: Array<{ relayUrl: string; token?: string }> = [];
+let probeStatus: HostProbeResult['status'] = 'ok';
+
+const actualHosts = await import('@/lib/desktopHosts');
+const actualAttention = await import('@/lib/instanceAttention');
+
+mock.module('@/lib/desktopHosts', () => ({
+  ...actualHosts,
+  desktopHostProbe: mock(async (url: string, options: unknown) => {
+    probes.push({ url, options });
+    return { status: probeStatus, latencyMs: 1 };
+  }),
+}));
+
+mock.module('@/lib/instanceAttention', () => ({
+  ...actualAttention,
+  readInstanceAttention: mock(async (transport: { url: string; token?: string }) => {
+    directReads.push({ url: transport.url, token: transport.token });
+    return answered;
+  }),
+  readRelayInstanceAttention: mock(async (relay: { relayUrl: string }, options?: { token?: string }) => {
+    relayReads.push({ relayUrl: relay.relayUrl, token: options?.token });
+    return answered;
+  }),
+}));
+
+const { instanceAttentionTargets } = await import('./useInstanceAttentionPolling');
+
+const host = (overrides: Partial<DesktopHost> = {}): DesktopHost => ({
+  id: 'host-b',
+  label: 'Build box',
+  url: 'http://lan.test',
+  apiUrl: 'http://lan.test',
+  clientToken: 'secret',
+  relay: { relayUrl: 'wss://relay.test', serverId: 'server-a', hostEncPubJwk: {} },
+  ...overrides,
+});
+
+beforeEach(() => {
+  probes.length = 0;
+  directReads.length = 0;
+  relayReads.length = 0;
+  probeStatus = 'ok';
+});
+
+describe('desktop attention identity gate', () => {
+  test('checks the pinned identity unauthenticated before reading the direct address', async () => {
+    const target = instanceAttentionTargets({ hosts: [host()], localOrigin: null }, 'active')[0]!;
+
+    await target.read(new AbortController().signal);
+
+    expect(probes).toEqual([{ url: 'http://lan.test', options: { expectedServerId: 'server-a' } }]);
+    expect(probes[0]?.options).not.toHaveProperty('clientToken');
+    expect(directReads).toEqual([{ url: 'http://lan.test', token: 'secret' }]);
+    expect(relayReads).toEqual([]);
+  });
+
+  test('an identity mismatch keeps the token off the direct address and uses the relay', async () => {
+    probeStatus = 'wrong-service';
+    const target = instanceAttentionTargets({ hosts: [host()], localOrigin: null }, 'active')[0]!;
+
+    await target.read(new AbortController().signal);
+
+    expect(directReads).toEqual([]);
+    expect(relayReads).toEqual([{ relayUrl: 'wss://relay.test', token: 'secret' }]);
+  });
+
+  test('an unreadable probe is unverified, so nothing is sent to the direct address', async () => {
+    probeStatus = 'unreachable';
+    const target = instanceAttentionTargets({ hosts: [host()], localOrigin: null }, 'active')[0]!;
+
+    await target.read(new AbortController().signal);
+
+    expect(directReads).toEqual([]);
+    expect(relayReads).toHaveLength(1);
+  });
+
+  test('a direct-only host has no pinned identity to verify', async () => {
+    const target = instanceAttentionTargets({
+      hosts: [host({ relay: undefined })],
+      localOrigin: null,
+    }, 'active')[0]!;
+
+    await target.read(new AbortController().signal);
+
+    expect(probes).toEqual([]);
+    expect(directReads).toEqual([{ url: 'http://lan.test', token: 'secret' }]);
+  });
+
+  test('a relay-only host never probes an address', async () => {
+    const target = instanceAttentionTargets({
+      hosts: [host({ url: 'relay://server-a', apiUrl: undefined })],
+      localOrigin: null,
+    }, 'active')[0]!;
+
+    await target.read(new AbortController().signal);
+
+    expect(probes).toEqual([]);
+    expect(directReads).toEqual([]);
+    expect(relayReads).toEqual([{ relayUrl: 'wss://relay.test', token: 'secret' }]);
+  });
+});
diff --git a/packages/ui/src/hooks/useInstanceAttentionPolling.test.ts b/packages/ui/src/hooks/useInstanceAttentionPolling.test.ts
