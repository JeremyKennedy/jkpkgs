+import { afterEach, beforeEach, expect, mock, test } from 'bun:test';
+import React, { act } from 'react';
+import type { Root } from 'react-dom/client';
+import { Window } from 'happy-dom';
+
+import { LOCAL_INSTANCE_ATTENTION_HOST_ID } from '@/lib/instanceAttention';
+import type { Session } from '@/lib/opencode/model';
+import { useBackgroundShellsStore } from '@/sync/background-shells';
+import { useGlobalBlockingRequestsStore } from '@/sync/global-blocking-requests';
+import { setSessionParentResolver, useGlobalSessionStatusStore } from '@/sync/global-session-status';
+import { useGlobalSessionsStore } from '@/stores/useGlobalSessionsStore';
+import { useProjectsStore } from '@/stores/useProjectsStore';
+import { useInstanceAttentionStore } from '@/stores/useInstanceAttentionStore';
+
+const actualI18n = await import('@/lib/i18n');
+mock.module('@/lib/i18n', () => ({
+  ...actualI18n,
+  useI18n: () => ({ t: (key: string) => (key === 'instanceAttention.localInstance' ? 'This instance' : key) }),
+}));
+
+const { useLocalInstanceAttention } = await import('./useLocalInstanceAttention');
+
+const session = (id: string, overrides: Partial<Session> = {}): Session => ({
+  id,
+  directory: '/repo',
+  projectID: 'project',
+  title: `Session ${id}`,
+  cost: 0,
+  tokens: { input: 0, output: 0, reasoning: 0, cache: { read: 0, write: 0 } },
+  time: { created: 1, updated: 10, idle: 10 },
+  ...overrides,
+});
+
+const Probe = ({ enabled }: { enabled: boolean }): React.ReactNode => {
+  useLocalInstanceAttention(enabled);
+  return null;
+};
+
+let dom: Window;
+let root: Root | null = null;
+const globals = new Map<string, PropertyDescriptor | undefined>();
+
+beforeEach(() => {
+  dom = new Window({ url: 'http://localhost' });
+  const values = {
+    window: dom, document: dom.document, navigator: dom.navigator,
+    Node: dom.Node, Element: dom.Element, HTMLElement: dom.HTMLElement,
+    Event: dom.Event, MouseEvent: dom.MouseEvent, IS_REACT_ACT_ENVIRONMENT: true,
+  };
+  for (const [name, value] of Object.entries(values)) {
+    globals.set(name, Object.getOwnPropertyDescriptor(globalThis, name));
+    Object.defineProperty(globalThis, name, { configurable: true, writable: true, value });
+  }
+  useInstanceAttentionStore.getState().reset();
+  useGlobalBlockingRequestsStore.setState({ bySession: new Map() });
+  useGlobalSessionsStore.setState({ entityById: new Map<string, Session>() });
+  useGlobalSessionStatusStore.setState({ activeSessionIds: new Set<string>() });
+  useBackgroundShellsStore.setState({ sessionIds: new Set<string>() });
+  setSessionParentResolver((sessionId) => useGlobalSessionsStore.getState().entityById.get(sessionId)?.parentID);
+  // The hook only lists sessions the app can open, so the fixture project has
+  // to be admitted for its sessions to reach the store.
+  useProjectsStore.setState({ projects: [{ id: 'project', path: '/repo' }], activeProjectId: 'project' });
+});
+
+afterEach(async () => {
+  const mounted = root;
+  root = null;
+  if (mounted) await act(async () => mounted.unmount());
+  for (const [name, descriptor] of globals) {
+    if (descriptor) Object.defineProperty(globalThis, name, descriptor);
+    else Reflect.deleteProperty(globalThis, name);
+  }
+  globals.clear();
+  await dom.happyDOM.abort();
+  dom.close();
+});
+
+const mount = async (enabled = true): Promise<void> => {
+  const host = document.createElement('div');
+  document.body.append(host);
+  const { createRoot } = await import('react-dom/client');
+  const created = createRoot(host);
+  root = created;
+  await act(async () => created.render(<Probe enabled={enabled} />));
+};
+
+const localItems = () => useInstanceAttentionStore.getState().items
+  .filter((item) => item.hostId === LOCAL_INSTANCE_ATTENTION_HOST_ID);
+
+test('the hook publishes this instance’s waiting sessions into the attention store', async () => {
+  useGlobalSessionsStore.setState({
+    entityById: new Map([
+      ['ses_unread', session('ses_unread')],
+      ['ses_read', session('ses_read', { time: { created: 1, updated: 10, idle: 10, viewed: 10 } })],
+    ]),
+  });
+  useGlobalBlockingRequestsStore.setState({
+    bySession: new Map([
+      ['ses_read', {
+        directory: '/repo',
+        permissions: [],
+        forms: [{ id: 'form_1', sessionID: 'ses_read', title: 'Pick one' }],
+        pages: [],
+      }],
+    ]),
+  });
+  await mount();
+
+  expect(localItems().map((item) => [item.sessionId, item.kind, item.hostLabel])).toEqual([
+    ['ses_read', 'question', 'This instance'],
+    ['ses_unread', 'unread', 'This instance'],
+  ]);
+  expect(useInstanceAttentionStore.getState().hosts[LOCAL_INSTANCE_ATTENTION_HOST_ID]?.status).toBe('ok');
+});
+
+test('a host switch that cleared the list makes the hook read it again', async () => {
+  // A switch resets the global list to `hasLoaded: false` with no records. The
+  // phone mounts no global poller, so the instance on screen would publish no
+  // rows at all until the sessions sheet happens to be opened.
+  const after = session('ses_after_switch');
+  useGlobalSessionsStore.setState({
+    hasLoaded: false,
+    entityById: new Map<string, Session>(),
+    loadSessions: async () => {
+      useGlobalSessionsStore.setState({ hasLoaded: true, entityById: new Map([[after.id, after]]) });
+      return { activeSessions: [after], archivedSessions: [] };
+    },
+  });
+
+  await mount();
+  await act(async () => { await Promise.resolve(); });
+
+  expect(localItems().map((item) => item.sessionId)).toEqual(['ses_after_switch']);
+});
+
+test('unmounting clears the local entry', async () => {
+  useGlobalSessionsStore.setState({ entityById: new Map([['ses_unread', session('ses_unread')]]) });
+  await mount();
+  expect(localItems()).toHaveLength(1);
+
+  const mounted = root;
+  root = null;
+  if (mounted) await act(async () => mounted.unmount());
+
+  expect(useInstanceAttentionStore.getState().hosts[LOCAL_INSTANCE_ATTENTION_HOST_ID]).toBeUndefined();
+  expect(useInstanceAttentionStore.getState().items).toEqual([]);
+});
+
+test('a disabled subscriber publishes nothing', async () => {
+  useGlobalSessionsStore.setState({ entityById: new Map([['ses_unread', session('ses_unread')]]) });
+  await mount(false);
+
+  expect(useInstanceAttentionStore.getState().items).toEqual([]);
+});
+
+test('a session waiting on a background shell is not unread', async () => {
+  useGlobalSessionsStore.setState({ entityById: new Map([['ses_shell', session('ses_shell')]]) });
+  useBackgroundShellsStore.setState({ sessionIds: new Set(['ses_shell']) });
+  await mount();
+
+  expect(localItems()).toEqual([]);
+});
+
+test('a parent whose subagent is still running is not unread', async () => {
+  useGlobalSessionsStore.setState({
+    entityById: new Map([
+      ['ses_parent', session('ses_parent')],
+      ['ses_child', session('ses_child', { parentID: 'ses_parent' })],
+    ]),
+  });
+  useGlobalSessionStatusStore.setState({ activeSessionIds: new Set(['ses_child']) });
+  await mount();
+
+  expect(localItems()).toEqual([]);
+});
+
+test('a pending request for a session the app has not admitted is left out', async () => {
+  useGlobalSessionsStore.setState({
+    entityById: new Map([
+      ['ses_known', session('ses_known')],
+      ['ses_elsewhere', session('ses_elsewhere', { directory: '/elsewhere' })],
+    ]),
+  });
+  useGlobalBlockingRequestsStore.setState({
+    bySession: new Map([
+      ['ses_elsewhere', {
+        directory: '/elsewhere',
+        permissions: [],
+        forms: [{ id: 'form_1', sessionID: 'ses_elsewhere', title: 'Pick one' }],
+        pages: [],
+      }],
+    ]),
+  });
+  await mount();
+
+  expect(localItems().map((item) => item.sessionId)).toEqual(['ses_known']);
+});
+
+test('a session in a folder the app has not admitted is left out', async () => {
+  useGlobalSessionsStore.setState({
+    entityById: new Map([
+      ['ses_known', session('ses_known')],
+      ['ses_elsewhere', session('ses_elsewhere', { directory: '/elsewhere' })],
+    ]),
+  });
+  await mount();
+
+  expect(localItems().map((item) => item.sessionId)).toEqual(['ses_known']);
+});
diff --git a/packages/ui/src/hooks/useLocalInstanceAttention.ts b/packages/ui/src/hooks/useLocalInstanceAttention.ts
new file mode 100644
index 000000000..1ef49a468
--- /dev/null
+++ b/packages/ui/src/hooks/useLocalInstanceAttention.ts
@@ -0,0 +1,165 @@
+import React from 'react';
+
+import { useI18n } from '@/lib/i18n';
+import { opencodeClient } from '@/lib/opencode/client';
+import { normalizePath } from '@/lib/pathNormalization';
+import { planStalePendingForms } from '@/lib/pendingFormVerification';
+import { getRuntimeKey } from '@/lib/runtime-switch';
+import { LOCAL_INSTANCE_ATTENTION_HOST_ID, type InstancePendingCounts } from '@/lib/instanceAttention';
+import { localInstanceAttentionPoll } from '@/lib/localInstanceAttention';
+import { useBackgroundImagesStore } from '@/sync/background-images';
+import { useBackgroundShellsStore } from '@/sync/background-shells';
+import { settleGlobalBlockingRequest, useGlobalBlockingRequestsStore } from '@/sync/global-blocking-requests';
+import { collectOpenTurnSessionIds, useGlobalSessionStatusStore } from '@/sync/global-session-status';
+import { usePrWatchStore } from '@/sync/pr-watch';
+import { isSessionAdmitted } from '@/sync/session-admission';
+import { useWorkflowActivityStore } from '@/sync/workflow-activity';
+import { useGlobalSessionsStore, ensureGlobalSessionsLoaded } from '@/stores/useGlobalSessionsStore';
+import { subscribeInstanceAttentionRefresh } from './useInstanceAttentionPolling';
+import { useInstanceAttentionStore } from '@/stores/useInstanceAttentionStore';
+import { useProjectsStore } from '@/stores/useProjectsStore';
+import type { Session } from '@/lib/opencode/model';
+
+// One string per admitted session, carrying every field the attention rule
+// reads. Subscribing to this instead of `entityById` keeps a streamed event on
+// an unrelated or archived session from rebuilding and sorting the whole
+// published list; the effect reads the live map when the signature changes.
+const FIELD_SEPARATOR = '\u0001';
+const SESSION_SEPARATOR = '\u0002';
+
+const admittedSessionSignature = (entityById: ReadonlyMap<string, Session>): string => {
+  const parts: string[] = [];
+  for (const session of entityById.values()) {
+    if (!isSessionAdmitted(session.directory)) continue;
+    parts.push([
+      session.id,
+      session.parentID ?? '',
+      session.directory,
+      session.title,
+      session.time.idle ?? '',
+      session.time.viewed ?? '',
+      session.time.archived ?? '',
+      session.time.updated ?? '',
+      session.outcome ?? '',
+    ].join(FIELD_SEPARATOR));
+  }
+  return parts.join(SESSION_SEPARATOR);
+};
+
+/**
+ * Publishes this window's own waiting sessions into the attention store, as
+ * the reserved local entry. Mounted beside the pollers so the same list and
+ * count cover the instance the user is looking at; the polled hosts cover the
+ * others.
+ *
+ * The store's `retainHosts` keeps this entry when it drops the instances the
+ * poller is no longer reading. Unmounting the subscriber clears it, so a shell
+ * without the surfaces does not leave a stale count behind.
+ */
+export const useLocalInstanceAttention = (enabled: boolean): void => {
+  const { t } = useI18n();
+  const hostLabel = t('instanceAttention.localInstance');
+  const bySession = useGlobalBlockingRequestsStore((state) => state.bySession);
+  // Only sessions the app can open right now: a row in a folder that has not
+  // been admitted stops at the trust prompt and appears to do nothing. This is
+  // the same rule the sidebar's links obey, not a heuristic about age.
+  const projects = useProjectsStore((state) => state.projects);
+  const activeSessionIds = useGlobalSessionStatusStore((state) => state.activeSessionIds);
+  // A session whose turn is still open is not unread: it runs itself, waits on
+  // a workflow, a background command, an image or its pull request, or keeps a
+  // turn open for a running subagent. The sidebar suppresses unread with the
+  // same set, so a row and the badge never disagree.
+  const workflowSessionIds = useWorkflowActivityStore((state) => state.runningSessionIds);
+  const shellSessionIds = useBackgroundShellsStore((state) => state.sessionIds);
+  const imageSessionIds = useBackgroundImagesStore((state) => state.sessionIds);
+  const prWatches = usePrWatchStore((state) => state.bySession);
+  const signature = useGlobalSessionsStore(React.useCallback(
+    (state) => (enabled ? admittedSessionSignature(state.entityById) : ''),
+    [enabled],
+  ));
+  const loaded = useGlobalSessionsStore((state) => state.hasLoaded);
+
+  React.useEffect(() => {
+    if (!enabled) return;
+    const verify = async (): Promise<void> => {
+      const runtimeKey = getRuntimeKey();
+      const pending = useGlobalBlockingRequestsStore.getState().bySession;
+      const sessionsById = useGlobalSessionsStore.getState().entityById;
+      const stale = await planStalePendingForms(
+        pending,
+        (sessionId) => normalizePath(sessionsById.get(sessionId)?.directory ?? null),
+        async (directory) => {
+          try {
+            return await opencodeClient.listPendingForms({ directories: [directory] });
+          } catch {
+            return null;
+          }
+        },
+      );
+      if (runtimeKey !== getRuntimeKey()) return;
+      for (const { sessionId, formId } of stale) settleGlobalBlockingRequest('form', sessionId, formId);
+    };
+    void verify();
+    return subscribeInstanceAttentionRefresh(verify);
+  }, [enabled]);
+
+  React.useEffect(() => {
+    if (!enabled || loaded) return;
+    void ensureGlobalSessionsLoaded().catch((error) => {
+      console.warn('[instance-attention] could not read this instance\'s sessions:', error);
+    });
+  }, [enabled, loaded]);
+
+  React.useEffect(() => {
+    if (!enabled) return;
+    const sessions = [...useGlobalSessionsStore.getState().entityById.values()]
+      .filter((session) => isSessionAdmitted(session.directory));
+    const admittedIds = new Set(sessions.map((session) => session.id));
+    // A pending request only names a session the surfaces can open: the
+    // attention list would otherwise add an untitled row for a session the
+    // admission filter deliberately left out.
+    const pending = new Map<string, InstancePendingCounts>();
+    for (const [sessionId, entry] of bySession) {
+      if (!admittedIds.has(sessionId)) continue;
+      if (entry.permissions.length === 0 && entry.forms.length === 0 && entry.pages.length === 0) continue;
+      pending.set(sessionId, {
+        permissions: entry.permissions.length,
+        forms: entry.forms.length,
+        pages: entry.pages.length,
+      });
+    }
+    useInstanceAttentionStore.getState().applyPoll(
+      LOCAL_INSTANCE_ATTENTION_HOST_ID,
+      hostLabel,
+      localInstanceAttentionPoll(
+        sessions,
+        pending,
+        collectOpenTurnSessionIds(activeSessionIds, [
+          workflowSessionIds,
+          shellSessionIds,
+          imageSessionIds,
+          prWatches.keys(),
+        ]),
+      ),
+      Date.now(),
+    );
+  }, [
+    activeSessionIds,
+    bySession,
+    enabled,
+    hostLabel,
+    imageSessionIds,
+    prWatches,
+    projects,
+    shellSessionIds,
+    signature,
+    workflowSessionIds,
+  ]);
+
+  React.useEffect(() => {
+    if (!enabled) return;
+    return () => {
+      useInstanceAttentionStore.getState().dropHost(LOCAL_INSTANCE_ATTENTION_HOST_ID);
+    };
+  }, [enabled]);
+};
diff --git a/packages/ui/src/hooks/useMobileInstanceAttentionPolling.ts b/packages/ui/src/hooks/useMobileInstanceAttentionPolling.ts
new file mode 100644
index 000000000..aeae23569
--- /dev/null
+++ b/packages/ui/src/hooks/useMobileInstanceAttentionPolling.ts
@@ -0,0 +1,57 @@
+import React from 'react';
+
+import {
+  isActiveRuntimeConnection,
+  loadMobileConnections,
+} from '@/apps/mobileConnections';
+import { mobileAttentionTargets } from '@/apps/mobileInstanceAttention';
+import { subscribeRuntimeEndpointChanged } from '@/lib/runtime-switch';
+
+import {
+  instanceAttentionVisibility,
+  isDeviceOnline,
+  startInstanceAttentionPolling,
+  type InstanceAttentionTarget,
+} from './useInstanceAttentionPolling';
+
+// Polls the saved mobile connections this phone is not showing. The active
+// connection is excluded: the app's own session list and indicators cover it.
+// A switch restarts the loop, because the connection just left becomes a
+// target and the one now shown stops being read.
+
+const readMobileTargets = async (): Promise<InstanceAttentionTarget[]> => {
+  const connections = await loadMobileConnections();
+  const active = connections.find(isActiveRuntimeConnection) ?? null;
+  return mobileAttentionTargets(connections, active?.id ?? null);
+};
+
+export const useMobileInstanceAttentionPolling = (enabled: boolean): void => {
+  React.useEffect(() => {
+    if (!enabled) return;
+    const start = () => {
+      const visibility = instanceAttentionVisibility();
+      const stopPolling = startInstanceAttentionPolling({
+        readTargets: readMobileTargets,
+        isVisible: visibility.isVisible,
+        onVisible: visibility.onVisible,
+        scheduleTimeout: window.setTimeout.bind(window),
+        clearScheduledTimeout: window.clearTimeout.bind(window),
+        now: Date.now,
+        isOnline: isDeviceOnline,
+      });
+      return () => {
+        stopPolling();
+        visibility.dispose();
+      };
+    };
+    let stop = start();
+    const unsubscribe = subscribeRuntimeEndpointChanged(() => {
+      stop();
+      stop = start();
+    });
+    return () => {
+      unsubscribe();
+      stop();
+    };
+  }, [enabled]);
+};
