@@ -0,0 +1,130 @@
+import { describe, expect, test } from 'bun:test';
+
+import {
+  collectInstanceAttention,
+  LOCAL_INSTANCE_ATTENTION_HOST_ID,
+  type InstanceAttentionItem,
+  type InstancePendingCounts,
+} from '@/lib/instanceAttention';
+import { localInstanceAttentionPoll } from '@/lib/localInstanceAttention';
+import type { Session } from '@/lib/opencode/model';
+
+const session = (overrides: Partial<Session> = {}): Session => ({
+  id: 'ses_a',
+  directory: '/repo',
+  projectID: 'project',
+  title: 'Session A',
+  cost: 0,
+  tokens: { input: 0, output: 0, reasoning: 0, cache: { read: 0, write: 0 } },
+  time: { created: 1, updated: 1 },
+  ...overrides,
+});
+
+const counts = (overrides: Partial<InstancePendingCounts> = {}): InstancePendingCounts => ({
+  permissions: 0,
+  forms: 0,
+  pages: 0,
+  ...overrides,
+});
+
+const derive = (
+  sessions: readonly Session[],
+  pending: ReadonlyMap<string, InstancePendingCounts> = new Map(),
+): InstanceAttentionItem[] => {
+  const poll = localInstanceAttentionPoll(sessions, pending);
+  return collectInstanceAttention([{
+    hostId: LOCAL_INSTANCE_ATTENTION_HOST_ID,
+    hostLabel: 'This instance',
+    sessions: poll.sessions ?? [],
+    pending: poll.pending ?? new Map(),
+    busy: poll.busy ?? undefined,
+  }]);
+};
+
+describe('local instance attention', () => {
+  test('a pending permission is the strongest reason and carries the session details', () => {
+    const items = derive(
+      [session({ id: 'ses_permission', title: 'Unify sessions', time: { created: 1, updated: 40, idle: 30, viewed: 30 } })],
+      new Map([['ses_permission', counts({ permissions: 1 })]]),
+    );
+
+    expect(items).toHaveLength(1);
+    expect(items[0]).toMatchObject({
+      hostId: LOCAL_INSTANCE_ATTENTION_HOST_ID,
+      hostLabel: 'This instance',
+      sessionId: 'ses_permission',
+      directory: '/repo',
+      title: 'Unify sessions',
+      kind: 'permission',
+      at: 30,
+    });
+  });
+
+  test('a form and a waiting page both read as a question', () => {
+    const items = derive(
+      [session({ id: 'ses_form' }), session({ id: 'ses_page' })],
+      new Map([
+        ['ses_form', counts({ forms: 1 })],
+        ['ses_page', counts({ pages: 1 })],
+      ]),
+    );
+
+    expect(items.map((item) => [item.sessionId, item.kind])).toEqual([
+      ['ses_form', 'question'],
+      ['ses_page', 'question'],
+    ]);
+  });
+
+  test('an unread turn is unread, and a failed one is failed', () => {
+    const items = derive([
+      session({ id: 'ses_unread', time: { created: 1, updated: 20, idle: 10, viewed: 5 } }),
+      session({ id: 'ses_failed', outcome: 'failed', time: { created: 1, updated: 40, idle: 30, viewed: 10 } }),
+    ]);
+
+    expect(items.map((item) => [item.sessionId, item.kind])).toEqual([
+      ['ses_failed', 'failed'],
+      ['ses_unread', 'unread'],
+    ]);
+  });
+
+  test('a read session and an archived one are not waiting', () => {
+    const items = derive([
+      session({ id: 'ses_read', time: { created: 1, updated: 20, idle: 10, viewed: 10 } }),
+      session({ id: 'ses_archived', time: { created: 1, updated: 20, idle: 10, archived: 20 } }),
+    ]);
+
+    expect(items).toEqual([]);
+  });
+
+  test('a subagent request attributes to its top-level parent, like a polled instance', () => {
+    const items = derive(
+      [
+        session({ id: 'ses_parent', title: 'Parent work', time: { created: 1, updated: 40, idle: 40, viewed: 40 } }),
+        session({ id: 'ses_child', parentID: 'ses_parent', title: 'Child work', time: { created: 2, updated: 50, idle: 50 } }),
+        session({ id: 'ses_grandchild', parentID: 'ses_child', title: 'Grandchild work', time: { created: 3, updated: 60, idle: 60 } }),
+      ],
+      new Map([['ses_grandchild', counts({ permissions: 1 })]]),
+    );
+
+    expect(items).toHaveLength(1);
+    expect(items[0]).toMatchObject({ sessionId: 'ses_parent', title: 'Parent work', kind: 'permission', at: 60 });
+  });
+
+  test('a child without a request does not add a row of its own', () => {
+    const items = derive([
+      session({ id: 'ses_parent', title: 'Parent work', time: { created: 1, updated: 20, idle: 20, viewed: 20 } }),
+      session({ id: 'ses_child', parentID: 'ses_parent', time: { created: 2, updated: 30, idle: 30 } }),
+    ]);
+
+    expect(items).toEqual([]);
+  });
+
+  test('one session keeps its strongest reason when several apply', () => {
+    const items = derive(
+      [session({ id: 'ses_a', outcome: 'failed', time: { created: 1, updated: 20, idle: 10 } })],
+      new Map([['ses_a', counts({ forms: 1 })]]),
+    );
+
+    expect(items.map((item) => item.kind)).toEqual(['question']);
+  });
+});
diff --git a/packages/ui/src/lib/localInstanceAttention.ts b/packages/ui/src/lib/localInstanceAttention.ts
new file mode 100644
index 000000000..4f8bb0656
--- /dev/null
+++ b/packages/ui/src/lib/localInstanceAttention.ts
@@ -0,0 +1,47 @@
+import type { Session } from '@/lib/opencode/model';
+import type {
+  InstanceAttentionPoll,
+  InstancePendingCounts,
+  InstanceSessionSummary,
+} from '@/lib/instanceAttention';
+
+// The instance this window shows, in the shape the attention rule already
+// reads. The polled hosts answer from two global routes; this one is derived
+// from the app's own live stores instead, so the waiting sessions of the
+// instance the user is looking at appear in the same list and the same total
+// as the instances they are not.
+//
+// Nothing here reads the network. The sidebar already holds these facts:
+// `useGlobalBlockingRequestsStore` for requests waiting on an answer,
+// `useGlobalSessionsStore` for titles, parents, unread turns and failed ones.
+
+/**
+ * One local session as the shared rule reads it. `archived` follows the same
+ * rule as the sidebar: any archive stamp, from any path, puts the session away.
+ */
+const toSummary = (session: Session): InstanceSessionSummary => ({
+  id: session.id,
+  parentID: session.parentID,
+  directory: session.directory,
+  title: session.title,
+  idle: session.time.idle,
+  viewed: session.time.viewed,
+  archived: session.time.archived !== undefined,
+  updated: session.time.updated,
+  outcome: session.outcome,
+});
+
+/**
+ * The local half of the attention list. The unread rule is the app's own
+ * (`sync/session-unread.ts`), which is also what the sidebar shows, so there is
+ * no separate busy set: a session whose turn finished unread stays an item until
+ * the user looks at it, exactly as it does in the sidebar.
+ */
+export const localInstanceAttentionPoll = (
+  sessions: Iterable<Session>,
+  pending: ReadonlyMap<string, InstancePendingCounts>,
+): InstanceAttentionPoll => ({
+  sessions: [...sessions].map(toSummary),
+  pending,
+  busy: new Set(),
+});
