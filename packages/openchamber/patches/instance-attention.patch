+    expect(asked).toEqual(['/from-session']);
+    expect(stale).toEqual([{ sessionId: 'ses_a', formId: 'frm_a' }]);
+  });
+
+  test('a session already read for one directory is not asked about twice', async () => {
+    const bySession: PendingFormsBySession = new Map([
+      ['ses_a', { directory: '/repo', forms: [form('frm_a')] }],
+      ['ses_b', { directory: '/repo', forms: [form('frm_b')] }],
+    ]);
+    const asked: string[] = [];
+    const stale = await planStalePendingForms(bySession, () => null, async (directory) => {
+      asked.push(directory);
+      return [form('frm_a')];
