+    sessions: [{ id: 'ses_a', directory: '/repo', title: 'Unify sessions', archived: false, idle: 10 }],
+    pending: new Map([['ses_a', { permissions: 1, forms: 0, pages: 0 }]]),
+    busy: new Set(),
+  }, 100);
+  await render();
+
+  const trigger = [...document.querySelectorAll('button')]
