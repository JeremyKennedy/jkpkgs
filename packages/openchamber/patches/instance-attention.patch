new file mode 100644
index 000000000..78b2e2a1f
--- /dev/null
+++ b/packages/ui/src/lib/instanceAttention.ts
@@ -0,0 +1,748 @@
+import type { JsonValue } from '@opencode/client';
+import { z } from 'zod';
+
+import { normalizeHostUrl } from '@/lib/desktopHosts';
+import { isAttentionDirectoryAdmitted, legacyChatsRootForHome, type AttentionDirectories } from '@/lib/attentionDirectories';
+import { normalizePath } from '@/lib/pathNormalization';
+import {
+  hostSessionStatusSnapshotSchema,
+  HOST_STATUS_SEED_MAX_AGE_MS,
+  type HostSessionStatusSnapshot,
+} from '@/lib/opencode/session-status';
+import { descriptorsEqual, getActiveRelayDescriptor, getActiveRelayTunnel } from '@/lib/relay/runtime-tunnel';
+import { createRelayTunnelClient, type RelayTunnelClient } from '@/lib/relay/tunnel-client';
+import { addRuntimeProxyHeaders, fetchBypassingRuntimeBridge, sanitizeHeadersForBrowser } from '@/lib/runtime-fetch';
+import { isUnreadSessionFields } from '@/sync/session-unread';
+
+// Cross-instance attention: what a saved desktop instance needs from the user
+// while this window shows another one. The sidebar already reports the active
+// instance's requests, running turns and unread sessions; this module answers
+// only for instances this window is not showing.
+//
+// The reads are the two global routes the host answers without starting an
+// OpenCode location: `GET /api/session` and `GET /api/sessions/status`. A poll
+// names no directory, so it never starts MCP servers, and it uses the saved
+// host's own address and client token instead of the active runtime's.
+//
+// The instance this window shows is not polled: `localInstanceAttention.ts`
+// derives its items from the app's live stores and publishes them beside these
+// hosts, so every surface reads one list and one total.
+
+export type InstanceAttentionKind = 'permission' | 'question' | 'failed' | 'unread';
+
+/** Only the fields the attention rule reads; the wire schema below fills them. */
+export type InstanceSessionSummary = {
+  id: string;
+  parentID?: string;
+  directory: string | null;
+  title: string;
+  idle?: number;
+  viewed?: number;
+  archived: boolean;
+  updated?: number;
+  outcome?: 'succeeded' | 'failed' | 'interrupted';
+};
+
+export type InstancePendingCounts = {
+  permissions: number;
+  forms: number;
+  pages: number;
+};
+
+export type InstanceAttentionSnapshot = {
+  hostId: string;
+  hostLabel: string;
+  sessions: readonly InstanceSessionSummary[];
+  pending: ReadonlyMap<string, InstancePendingCounts>;
+  /** Sessions whose turn is still open on that host, so they are not unread. */
+  busy?: ReadonlySet<string>;
+  directories?: AttentionDirectories;
+};
+
+export type InstanceAttentionItem = {
+  /** Stable identity across surfaces: host and session. */
+  key: string;
+  hostId: string;
+  hostLabel: string;
+  sessionId: string;
+  directory: string | null;
+  title: string;
+  kind: InstanceAttentionKind;
+  /** Newest activity the item can be dated by, for ordering. */
+  at: number;
+};
+
+/**
+ * The instance this window shows, as a reserved entry in the same store the
+ * polled hosts use. It is not a polled target: it is derived from the app's own
+ * live stores, so `retainHosts` keeps it when every other host is dropped.
+ */
+export const LOCAL_INSTANCE_ATTENTION_HOST_ID = 'openchamber:this-instance';
+
+export const isLocalInstanceAttentionHost = (hostId: string): boolean => (
+  hostId === LOCAL_INSTANCE_ATTENTION_HOST_ID
+);
+
+export type InstanceAttentionPoll = {
+  /** `null` means the read failed; callers keep what they already had. */
+  sessions: readonly InstanceSessionSummary[] | null;
+  /** `null` means the read failed; callers keep what they already had. */
+  pending: ReadonlyMap<string, InstancePendingCounts> | null;
+  /**
+   * Sessions in an open turn. `null` when the status route did not answer, so
+   * the previous answer stands instead of every session reading as finished.
+   */
+  busy: ReadonlySet<string> | null;
+  directories?: AttentionDirectories;
+};
+
+export const instanceAttentionKey = (hostId: string, sessionId: string): string => `${hostId}:${sessionId}`;
+
+const KIND_ORDER = {
+  permission: 0,
+  question: 1,
+  failed: 2,
+  unread: 3,
+} satisfies Record<InstanceAttentionKind, number>;
+
+/**
+ * A finished turn nobody has seen yet. The rule is the sidebar's own
+ * (`isSessionUnread` in `sync/session-unread.ts`), read over the projection:
+ * OpenCode owns `time.idle`/`time.viewed`, and a child session reports to its
+ * parent instead of to the user.
+ */
+const isFinishedUnseen = (session: InstanceSessionSummary): boolean => isUnreadSessionFields(session);
+
+/**
+ * The reason a top-level session asks for the user. Pending requests are read
+ * apart from this because a busy session still has to show its permission or
+ * question, even though its unfinished turn is not "unread".
+ */
+const kindOf = (session: InstanceSessionSummary, busy: ReadonlySet<string> | undefined): InstanceAttentionKind | null => {
+  // The sidebar suppresses unread while a turn is open; the host's status map
+  // is the only live signal for another instance. An idle entry still carries
+  // its last turn's start, so only busy/retry means the turn is open.
+  if (busy?.has(session.id)) return null;
+  if (!isFinishedUnseen(session)) return null;
+  // The tray shows a failed turn only while it is unread (`session-unread.ts`).
+  return session.outcome === 'failed' ? 'failed' : 'unread';
+};
+
+const pendingKindOf = (pending: InstancePendingCounts | undefined): InstanceAttentionKind | null => {
+  if (!pending) return null;
+  if (pending.permissions > 0) return 'permission';
+  if (pending.forms > 0 || pending.pages > 0) return 'question';
+  return null;
+};
+
+const titleOf = (session: InstanceSessionSummary | undefined): string => session?.title?.trim() ?? '';
+
+const atOf = (session: InstanceSessionSummary | undefined): number => (
+  session?.idle ?? session?.updated ?? 0
+);
+
+/**
+ * The top-level session a child belongs to, when the parent is inside the same
+ * page. A child whose parent is outside the page is its own row: opening it
+ * shows its own subtree, which includes the pending request.
+ */
+const topLevelOwner = (
+  session: InstanceSessionSummary,
+  sessionsById: ReadonlyMap<string, InstanceSessionSummary>,
+): InstanceSessionSummary => {
+  let current = session;
+  const visited = new Set<string>();
+  while (current.parentID && !visited.has(current.id)) {
+    visited.add(current.id);
+    const parent = sessionsById.get(current.parentID);
+    if (!parent) return current;
+    current = parent;
+  }
+  return current;
+};
+
+/**
+ * The sessions whose turn is still open on that host: the running ones and the
+ * ancestors they keep open. A parent whose subagent runs is still working, so
+ * it must not read as unread; the same rule the sidebar applies to a local
+ * family. A parent link the page does not hold leaves the child on its own.
+ */
+const busyWithAncestors = (
+  busy: ReadonlySet<string> | undefined,
+  sessionsById: ReadonlyMap<string, InstanceSessionSummary>,
+): ReadonlySet<string> | undefined => {
+  if (!busy || busy.size === 0) return busy;
+  const open = new Set(busy);
+  for (const sessionId of busy) {
+    const visited = new Set<string>();
+    let current = sessionsById.get(sessionId)?.parentID;
+    while (current && !visited.has(current)) {
+      visited.add(current);
+      open.add(current);
+      current = sessionsById.get(current)?.parentID;
+    }
+  }
+  return open;
+};
+
+/**
+ * One item per session that needs the user, strongest reason first. A pending
+ * permission outranks a question, a failed unseen turn and an ordinary unseen
+ * turn. Archived sessions never need the user.
+ *
+ * A child session's pending request is attributed to its top-level parent: the
+ * sidebar counts subagent activity toward the family, and opening the parent
+ * shows the child's request in its scope. A child with no pending request is
+ * not an item; its parent carries its unread mark.
+ */
+export const collectInstanceAttention = (
+  snapshots: readonly InstanceAttentionSnapshot[],
+): InstanceAttentionItem[] => {
+  const itemsByKey = new Map<string, InstanceAttentionItem>();
+  const addItem = (
+    snapshot: InstanceAttentionSnapshot,
+    session: InstanceSessionSummary,
+    kind: InstanceAttentionKind,
+    at: number,
+  ): void => {
+    const key = instanceAttentionKey(snapshot.hostId, session.id);
+    const existing = itemsByKey.get(key);
+    if (existing) {
+      if (KIND_ORDER[kind] < KIND_ORDER[existing.kind]) {
+        itemsByKey.set(key, { ...existing, kind, at: Math.max(existing.at, at) });
+      } else {
+        existing.at = Math.max(existing.at, at);
+      }
+      return;
+    }
+    itemsByKey.set(key, {
+      key,
+      hostId: snapshot.hostId,
+      hostLabel: snapshot.hostLabel,
+      sessionId: session.id,
+      directory: session.directory,
+      title: titleOf(session),
+      kind,
+      at,
+    });
+  };
+
+  for (const snapshot of snapshots) {
+    const sessionsById = new Map(snapshot.sessions.map((session) => [session.id, session]));
+    const busy = busyWithAncestors(snapshot.busy, sessionsById);
+    for (const session of snapshot.sessions) {
+      if (session.archived) continue;
+      if (!isAttentionDirectoryAdmitted(session.directory, snapshot.directories)) continue;
+      const pendingKind = pendingKindOf(snapshot.pending.get(session.id));
+      if (session.parentID) {
+        if (!pendingKind) continue;
+        const owner = topLevelOwner(session, sessionsById);
+        if (owner.archived) continue;
+        addItem(snapshot, owner, pendingKind, Math.max(atOf(owner), atOf(session)));
+        continue;
+      }
+      const kind = pendingKind ?? kindOf(session, busy);
+      if (!kind) continue;
+      addItem(snapshot, session, kind, atOf(session));
+    }
+    // A permission or question can name a session the bounded list did not
+    // return. Its directory is unknown here, but the session's own detail
+    // read resolves it when the user opens the item.
+    for (const [sessionId, pending] of snapshot.pending) {
+      if (sessionsById.has(sessionId)) continue;
+      const kind = pendingKindOf(pending);
+      if (!kind) continue;
+      addItem(snapshot, {
+        id: sessionId,
+        directory: null,
+        title: '',
+        archived: false,
+      }, kind, 0);
+    }
+  }
+  return [...itemsByKey.values()].sort((left, right) => (
+    KIND_ORDER[left.kind] - KIND_ORDER[right.kind]
+    || right.at - left.at
+    || left.key.localeCompare(right.key)
+  ));
+};
+
+// ---------------------------------------------------------------------------
+// Wire reads
+// ---------------------------------------------------------------------------
+
+// A bounded newest-first page. Pending requests and recent turns are near the
+// top; an older unread turn beyond this page is not counted until it moves up.
+export const INSTANCE_ATTENTION_SESSION_LIMIT = 200;
+
+const sessionListRecordSchema = z.object({
+  id: z.string().min(1),
+  parentID: z.string().optional(),
+  location: z.object({ directory: z.string() }).passthrough().optional(),
+  title: z.string().optional(),
+  outcome: z.enum(['succeeded', 'failed', 'interrupted']).optional(),
+  time: z.object({
+    idle: z.number().optional(),
+    viewed: z.number().optional(),
+    archived: z.number().optional(),
+    updated: z.number().optional(),
+  }).passthrough().optional(),
+}).passthrough();
+
+const sessionListSchema = z.union([
+  z.object({ data: z.array(sessionListRecordSchema) }).passthrough(),
+  z.array(sessionListRecordSchema),
+]);
+
+const settingsSchema = z.object({
+  projects: z.array(z.object({ path: z.string() }).passthrough()).optional(),
+}).passthrough();
+
+const homeSchema = z.object({
+  home: z.string(),
+  chatsRoot: z.string().optional(),
+  canonicalChatsRoot: z.string().optional(),
+  canonicalLegacyChatsRoot: z.string().optional(),
+}).passthrough();
+
+const formRecordSchema = z.object({
+  id: z.string().min(1),
+  sessionID: z.string().min(1),
+}).passthrough();
+
+const formListSchema = z.union([
+  z.object({ data: z.array(formRecordSchema) }).passthrough(),
+  z.array(formRecordSchema),
+]);
+
+const formCountsOf = (forms: readonly { sessionID: string }[]): ReadonlyMap<string, number> => {
+  const counts = new Map<string, number>();
+  for (const form of forms) counts.set(form.sessionID, (counts.get(form.sessionID) ?? 0) + 1);
+  return counts;
+};
+
+const readDirectoryFormCounts = async (
+  root: string,
+  directory: string,
+  headers: Headers,
+  fetchImpl: typeof fetch,
+  signal: AbortSignal | undefined,
+): Promise<ReadonlyMap<string, number> | null> => {
+  const requestHeaders = new Headers(headers);
+  requestHeaders.set('x-opencode-directory', encodeURIComponent(directory));
+  const payload = await readJson(`${root}/api/form`, requestHeaders, fetchImpl, signal);
+  const parsed = formListSchema.safeParse(payload);
+  if (!parsed.success) return null;
+  return formCountsOf(Array.isArray(parsed.data) ? parsed.data : parsed.data.data);
+};
+
+const withVerifiedForms = async (
+  root: string,
+  sessions: readonly InstanceSessionSummary[],
+  pending: ReadonlyMap<string, InstancePendingCounts>,
+  headers: Headers,
+  fetchImpl: typeof fetch,
+  signal: AbortSignal | undefined,
+): Promise<ReadonlyMap<string, InstancePendingCounts>> => {
+  const directories = new Map<string, string[]>();
+  const directoryBySession = new Map(sessions.map((session) => [session.id, session.directory]));
+  for (const [sessionId, counts] of pending) {
+    if (counts.forms === 0) continue;
+    const directory = directoryBySession.get(sessionId);
+    if (!directory) continue;
+    const list = directories.get(directory);
+    if (list) list.push(sessionId);
+    else directories.set(directory, [sessionId]);
+  }
+  if (directories.size === 0) return pending;
+  const next = new Map(pending);
+  await Promise.all([...directories].map(async ([directory, sessionIds]) => {
+    const live = await readDirectoryFormCounts(root, directory, headers, fetchImpl, signal);
+    if (!live) return;
+    for (const sessionId of sessionIds) {
+      const entry = next.get(sessionId);
+      if (!entry) continue;
+      next.set(sessionId, { ...entry, forms: live.get(sessionId) ?? 0 });
+    }
+  }));
+  for (const [sessionId, entry] of next) {
+    if (entry.permissions === 0 && entry.forms === 0 && entry.pages === 0) next.delete(sessionId);
+  }
+  return next;
+};
+
+const projectSessionSummary = (record: z.infer<typeof sessionListRecordSchema>): InstanceSessionSummary => ({
+  id: record.id,
+  parentID: record.parentID,
+  directory: record.location?.directory ?? null,
+  title: record.title ?? '',
+  idle: record.time?.idle,
+  viewed: record.time?.viewed,
+  archived: record.time?.archived !== undefined,
+  updated: record.time?.updated,
+  outcome: record.outcome,
+});
+
+const pendingCounts = (snapshot: HostSessionStatusSnapshot): ReadonlyMap<string, InstancePendingCounts> => {
+  const pending = new Map<string, InstancePendingCounts>();
+  for (const [sessionId, entry] of Object.entries(snapshot.pending ?? {})) {
+    pending.set(sessionId, {
+      permissions: entry.permissions.length,
+      forms: entry.forms.length,
+      pages: entry.pages.length,
+    });
+  }
+  return pending;
+};
+
+/**
+ * Sessions the host reports in an open turn. A busy or retrying session is
+ * still working, so its finished-looking record must not read as unread.
+ *
+ * The host keeps a status entry for 24 hours and never reconciles it against
+ * OpenCode after a stream gap, so a missed idle can leave `busy` behind. A
+ * running turn refreshes its entry at every agent-loop step; an entry older
+ * than `HOST_STATUS_SEED_MAX_AGE_MS` is not trusted as current activity, the
+ * same cap the host status seed applies. A genuinely long tool call past that
+ * age simply counts as finished here instead of hiding an unread turn.
+ */
+const busySessionIds = (snapshot: HostSessionStatusSnapshot): ReadonlySet<string> => {
+  const busy = new Set<string>();
+  for (const [sessionId, entry] of Object.entries(snapshot.sessions)) {
+    if (entry.status !== 'busy' && entry.status !== 'retry') continue;
+    if (snapshot.serverTime - entry.lastUpdateAt > HOST_STATUS_SEED_MAX_AGE_MS) continue;
+    busy.add(sessionId);
+  }
+  return busy;
+};
+
+/**
+ * One saved instance as the reader sees it. Desktop hosts and mobile saved
+ * connections both describe a server this way; a relay connection passes its
+ * pseudo-URL and a fetch that rides the E2EE tunnel.
+ */
+type InstanceAttentionTransport = {
+  /** Base URL the two global routes hang off. */
+  url: string;
+  token?: string;
+  headers?: Readonly<Record<string, string>>;
+  /** Overrides global fetch. A relay transport routes each request through its tunnel. */
+  fetchImpl?: typeof fetch;
+};
+
+const buildTransportHeaders = (transport: InstanceAttentionTransport): Headers => {
+  // A saved header value can carry characters the Headers API refuses; encode
+  // them the way `runtimeFetch` does so a non-Latin-1 value still round-trips.
+  const headers = new Headers(sanitizeHeadersForBrowser(transport.headers) ?? transport.headers);
+  headers.set('Accept', 'application/json');
+  const token = transport.token?.trim();
+  if (token) headers.set('Authorization', `Bearer ${token}`);
+  return headers;
+};
+
+const readJson = async (
+  url: string,
+  headers: Headers,
+  fetchImpl: typeof fetch,
+  signal: AbortSignal | undefined,
+): Promise<JsonValue | null> => {
+  try {
+    // Same proxy headers `runtimeFetch` adds, so a host behind ngrok answers a
+    // saved instance the way it answers the active runtime.
+    addRuntimeProxyHeaders(url, headers);
+    const response = await fetchImpl(url, { method: 'GET', headers, signal });
+    if (!response.ok) return null;
+    return await response.json().catch(() => null);
+  } catch {
+    return null;
+  }
+};
+
+const worktreeListSchema = z.array(z.object({ path: z.string() }).passthrough());
+
+const readHostWorktrees = async (
+  url: string,
+  directories: readonly string[],
+  headers: Headers,
+  fetchImpl: typeof fetch,
+  signal: AbortSignal | undefined,
+): Promise<readonly string[]> => {
+  if (directories.length === 0) return directories;
+  let projects: unknown;
+  try {
+    addRuntimeProxyHeaders(url, headers);
+    const response = await fetchImpl(url, {
+      method: 'POST',
+      headers: new Headers({ ...Object.fromEntries(headers), 'Content-Type': 'application/json' }),
+      body: JSON.stringify({ directories }),
+      signal,
+    });
+    if (!response.ok) return directories;
+    const body = await response.json().catch(() => null);
+    projects = z.object({ projects: z.unknown() }).passthrough().safeParse(body).data?.projects;
+  } catch {
+    return directories;
+  }
+  const parsed = z.array(z.object({ worktrees: worktreeListSchema.nullable().optional() }).passthrough()).safeParse(projects);
+  if (!parsed.success) return directories;
+  const roots = new Set<string>(directories);
+  for (const project of parsed.data) {
+    for (const worktree of project.worktrees ?? []) {
+      const normalized = normalizePath(worktree.path);
+      if (normalized) roots.add(normalized);
+    }
+  }
+  return [...roots];
+};
+
+const readInstanceDirectories = async (
+  read: (path: string) => Promise<JsonValue | null>,
+  readWorktrees: (directories: readonly string[]) => Promise<readonly string[]>,
+): Promise<AttentionDirectories | undefined> => {
+  const [settingsPayload, homePayload] = await Promise.all([
+    read('/api/config/settings'),
+    read('/api/fs/home'),
+  ]);
+  const settings = settingsSchema.safeParse(settingsPayload);
+  const home = homeSchema.safeParse(homePayload);
+  if (!settings.success || !home.success) return undefined;
+  const chatRoots = [
+    home.data.chatsRoot,
+    home.data.canonicalChatsRoot,
+    home.data.canonicalLegacyChatsRoot,
+    legacyChatsRootForHome(home.data.home),
+  ].flatMap((root) => {
+    const normalized = normalizePath(root);
+    return normalized ? [normalized] : [];
+  });
+  const projectRoots = (settings.data.projects ?? []).flatMap((project) => {
+    const normalized = normalizePath(project.path);
+    return normalized ? [normalized] : [];
+  });
+  return {
+    roots: await readWorktrees(projectRoots),
+    chatRoots,
+  };
+};
+
+const sessionDetailSchema = z.object({
+  data: z.object({ location: z.object({ directory: z.string() }).passthrough().optional() }).passthrough(),
+}).passthrough();
+
+const readSessionDirectory = async (
+  url: string,
+  headers: Headers,
+  fetchImpl: typeof fetch,
+  signal: AbortSignal | undefined,
+): Promise<string | null> => {
+  try {
+    addRuntimeProxyHeaders(url, headers);
+    const response = await fetchImpl(url, { method: 'GET', headers, signal });
+    if (!response.ok) return null;
+    const detail = sessionDetailSchema.safeParse(await response.json().catch(() => null));
+    return detail.success ? (detail.data.data.location?.directory ?? null) : null;
+  } catch {
+    return null;
+  }
+};
+
+const withPendingSessions = async (
+  sessions: readonly InstanceSessionSummary[],
+  pending: ReadonlyMap<string, InstancePendingCounts>,
+  readDirectory: (sessionId: string) => Promise<string | null>,
+): Promise<readonly InstanceSessionSummary[]> => {
+  const known = new Set(sessions.map((session) => session.id));
+  const missing = [...pending.keys()].filter((sessionId) => !known.has(sessionId));
+  if (missing.length === 0) return sessions;
+  const resolved = await Promise.all(missing.map(async (sessionId) => ({
+    sessionId,
+    directory: await readDirectory(sessionId),
+  })));
+  const additions = resolved.flatMap(({ sessionId, directory }): InstanceSessionSummary[] => (
+    directory === null ? [] : [{ id: sessionId, directory, title: '', archived: false }]
+  ));
+  return additions.length === 0 ? sessions : [...sessions, ...additions];
+};
+
+export const readInstanceAttention = async (
+  transport: InstanceAttentionTransport,
+  options: { signal?: AbortSignal } = {},
+): Promise<InstanceAttentionPoll> => {
+  const baseUrl = transport.fetchImpl
+    ? transport.url.trim().replace(/\/+$/, '')
+    : normalizeHostUrl(transport.url)?.replace(/\/+$/, '');
+  if (!baseUrl) return { sessions: null, pending: null, busy: null };
+  const headers = buildTransportHeaders(transport);
+  const fetchImpl = transport.fetchImpl ?? fetchBypassingRuntimeBridge;
+  const root = baseUrl.replace(/\/+$/, '');
+  const read = (path: string): Promise<JsonValue | null> => readJson(`${root}${path}`, headers, fetchImpl, options.signal);
+  const readWorktrees = (directories: readonly string[]): Promise<readonly string[]> => readHostWorktrees(
+    `${root}/api/git/project-worktrees`,
+    directories,
+    headers,
+    fetchImpl,
+    options.signal,
+  );
+
+  const [sessionsPayload, statusPayload, directories] = await Promise.all([
+    readJson(`${root}/api/session?limit=${INSTANCE_ATTENTION_SESSION_LIMIT}`, headers, fetchImpl, options.signal),
+    readJson(`${root}/api/sessions/status`, headers, fetchImpl, options.signal),
+    readInstanceDirectories(read, readWorktrees),
+  ]);
+
+  const sessionList = sessionListSchema.safeParse(sessionsPayload);
+  const status = hostSessionStatusSnapshotSchema.safeParse(statusPayload);
+  const records = sessionList.success
+    ? (Array.isArray(sessionList.data) ? sessionList.data : sessionList.data.data)
+    : null;
+  const sessions = records ? records.map(projectSessionSummary) : null;
+  const rawPending = status.success ? pendingCounts(status.data) : null;
+  const withOffPage = sessions && rawPending && directories
+    ? await withPendingSessions(sessions, rawPending, (sessionId) => readSessionDirectory(
+      `${root}/api/session/${encodeURIComponent(sessionId)}`,
+      headers,
+      fetchImpl,
+      options.signal,
+    ))
+    : sessions;
+  const pending = rawPending && withOffPage
+    ? await withVerifiedForms(root, withOffPage, rawPending, headers, fetchImpl, options.signal)
+    : rawPending;
+  return {
+    sessions: withOffPage,
+    pending,
+    busy: status.success ? busySessionIds(status.data) : null,
+    directories,
+  };
+};
+
+/**
+ * Bounds one candidate read. The inner controller follows the caller's signal,
+ * so a cancelled poll or a spent budget stops the request instead of leaving
+ * it to finish against a runtime that moved on.
+ */
+export const readInstanceAttentionWithin = async (
+  signal: AbortSignal,
+  timeoutMs: number,
+  read: (signal: AbortSignal) => Promise<InstanceAttentionPoll>,
+): Promise<InstanceAttentionPoll> => {
+  const controller = new AbortController();
+  const abort = () => controller.abort();
+  signal.addEventListener('abort', abort, { once: true });
+  const timer = setTimeout(() => controller.abort(), timeoutMs);
+  try {
+    return await read(controller.signal);
+  } finally {
+    clearTimeout(timer);
+    signal.removeEventListener('abort', abort);
+  }
+};
+
+// ---------------------------------------------------------------------------
+// Relay transport
+// ---------------------------------------------------------------------------
+
+export type InstanceAttentionRelay = {
+  relayUrl: string;
+  serverId: string;
+  hostEncPubJwk: JsonWebKey;
+};
+
+type RelayDescriptor = Omit<InstanceAttentionRelay, 'hostEncPubJwk'> & { hostEncPubJwk: JsonWebKey };
+
+export type InstanceAttentionRelayDeps = {
+  createTunnel: (options: InstanceAttentionRelay) => RelayTunnelClient;
+  getActiveTunnel: () => RelayTunnelClient | null;
+  getActiveDescriptor: () => RelayDescriptor | null;
+};
+
+const defaultRelayDeps: InstanceAttentionRelayDeps = {
+  createTunnel: (options) => createRelayTunnelClient(options),
+  getActiveTunnel: getActiveRelayTunnel,
+  getActiveDescriptor: getActiveRelayDescriptor,
+};
+
+/** The same descriptor comparison the runtime uses to reuse its live tunnel. */
+const sameRelay = (left: InstanceAttentionRelay, right: RelayDescriptor): boolean => descriptorsEqual(left, right);
+
+/**
+ * Reads one relay-only server through its E2EE tunnel. The live runtime tunnel
+ * is reused when it already serves this server, so a poll never disturbs the
+ * active instance's connection; otherwise a short-lived tunnel is opened and
+ * closed after the two GETs. A caller that already holds a tunnel (a probe that
+ * kept one) passes it and keeps ownership of closing it.
+ */
+export const readRelayInstanceAttention = async (
+  relay: InstanceAttentionRelay,
+  options: {
+    token?: string;
+    headers?: Readonly<Record<string, string>>;
+    signal?: AbortSignal;
+    tunnel?: RelayTunnelClient;
+  } = {},
+  deps: InstanceAttentionRelayDeps = defaultRelayDeps,
+): Promise<InstanceAttentionPoll> => {
+  const activeTunnel = deps.getActiveTunnel();
+  const activeDescriptor = deps.getActiveDescriptor();
+  const reusable = Boolean(
+    activeTunnel
+    && activeDescriptor
+    && activeTunnel.getStatus().state === 'connected'
+    && sameRelay(relay, activeDescriptor),
+  );
+  const tunnel = options.tunnel ?? (reusable && activeTunnel ? activeTunnel : deps.createTunnel(relay));
+  const owned = options.tunnel ? false : !reusable;
+  try {
+    return await readInstanceAttention({
+      // A relay has no network base URL; the fetch adapter takes the paths.
+      url: `relay://${relay.serverId}`,
+      token: options.token,
+      headers: options.headers,
+      fetchImpl: async (input, init) => {
+        const url = new URL(String(input));
+        return tunnel.fetch(`${url.pathname}${url.search}`, init);
+      },
+    }, { signal: options.signal });
+  } finally {
+    if (owned) tunnel.close();
+  }
+};
+
+// ---------------------------------------------------------------------------
+// Surface totals
+// ---------------------------------------------------------------------------
+
+/**
+ * How many items a surface shows: every instance's, or one instance's own. The
+ * switcher, the collapsed-sidebar toggle, the phone bell and an instance row
+ * must read one derivation, so none of them can drift from the shared list.
+ */
+export const countInstanceAttentionItems = (
+  items: readonly InstanceAttentionItem[],
+  hostId?: string,
+): number => {
+  if (hostId === undefined) return items.length;
+  let count = 0;
+  for (const item of items) {
+    if (item.hostId === hostId) count += 1;
+  }
+  return count;
+};
+
+/** The host record fields the unreachable note reads. */
+type InstanceAttentionHostView = {
+  label: string;
+  status: 'ok' | 'error';
+};
+
+/**
+ * The instances a poll could not reach, once each, for the surfaces' quiet
+ * note. Their last known items stay on screen, so the note says why.
+ */
+export const collectUnreachableInstanceLabels = (
+  hosts: Readonly<Record<string, InstanceAttentionHostView>>,
+): string[] => [...new Set(
+  Object.values(hosts)
+    .filter((host) => host.status === 'error')
+    .map((host) => host.label),
+)];
