@@ -0,0 +1,125 @@
+import { afterEach, beforeEach, expect, mock, test } from 'bun:test';
+import React, { act } from 'react';
+import type { Root } from 'react-dom/client';
+import { Window } from 'happy-dom';
+
+import { LOCAL_INSTANCE_ATTENTION_HOST_ID } from '@/lib/instanceAttention';
+import type { Session } from '@/lib/opencode/model';
+import { useGlobalBlockingRequestsStore } from '@/sync/global-blocking-requests';
+import { useGlobalSessionsStore } from '@/stores/useGlobalSessionsStore';
+import { useInstanceAttentionStore } from '@/stores/useInstanceAttentionStore';
+
+const actualI18n = await import('@/lib/i18n');
+mock.module('@/lib/i18n', () => ({
+  ...actualI18n,
+  useI18n: () => ({ t: (key: string) => (key === 'instanceAttention.localInstance' ? 'This instance' : key) }),
+}));
+
+const { useLocalInstanceAttention } = await import('./useLocalInstanceAttention');
+
+const session = (id: string, overrides: Partial<Session> = {}): Session => ({
+  id,
+  directory: '/repo',
+  projectID: 'project',
+  title: `Session ${id}`,
+  cost: 0,
+  tokens: { input: 0, output: 0, reasoning: 0, cache: { read: 0, write: 0 } },
+  time: { created: 1, updated: 10, idle: 10 },
+  ...overrides,
+});
+
+const Probe = ({ enabled }: { enabled: boolean }): React.ReactNode => {
+  useLocalInstanceAttention(enabled);
+  return null;
+};
+
+let dom: Window;
+let root: Root | null = null;
+const globals = new Map<string, PropertyDescriptor | undefined>();
+
+beforeEach(() => {
+  dom = new Window({ url: 'http://localhost' });
+  const values = {
+    window: dom, document: dom.document, navigator: dom.navigator,
+    Node: dom.Node, Element: dom.Element, HTMLElement: dom.HTMLElement,
+    Event: dom.Event, MouseEvent: dom.MouseEvent, IS_REACT_ACT_ENVIRONMENT: true,
+  };
+  for (const [name, value] of Object.entries(values)) {
+    globals.set(name, Object.getOwnPropertyDescriptor(globalThis, name));
+    Object.defineProperty(globalThis, name, { configurable: true, writable: true, value });
+  }
+  useInstanceAttentionStore.getState().reset();
+  useGlobalBlockingRequestsStore.setState({ bySession: new Map() });
+  useGlobalSessionsStore.setState({ entityById: new Map<string, Session>() });
+});
+
+afterEach(async () => {
+  const mounted = root;
+  root = null;
+  if (mounted) await act(async () => mounted.unmount());
+  for (const [name, descriptor] of globals) {
+    if (descriptor) Object.defineProperty(globalThis, name, descriptor);
+    else Reflect.deleteProperty(globalThis, name);
+  }
+  globals.clear();
+  await dom.happyDOM.abort();
+  dom.close();
+});
+
+const mount = async (enabled = true): Promise<void> => {
+  const host = document.createElement('div');
+  document.body.append(host);
+  const { createRoot } = await import('react-dom/client');
+  const created = createRoot(host);
+  root = created;
+  await act(async () => created.render(<Probe enabled={enabled} />));
+};
+
+const localItems = () => useInstanceAttentionStore.getState().items
+  .filter((item) => item.hostId === LOCAL_INSTANCE_ATTENTION_HOST_ID);
+
+test('the hook publishes this instance’s waiting sessions into the attention store', async () => {
+  useGlobalSessionsStore.setState({
+    entityById: new Map([
+      ['ses_unread', session('ses_unread')],
+      ['ses_read', session('ses_read', { time: { created: 1, updated: 10, idle: 10, viewed: 10 } })],
+    ]),
+  });
+  useGlobalBlockingRequestsStore.setState({
+    bySession: new Map([
+      ['ses_read', {
+        directory: '/repo',
+        permissions: [],
+        forms: [{ id: 'form_1', sessionID: 'ses_read', title: 'Pick one' }],
+        pages: [],
+      }],
+    ]),
+  });
+  await mount();
+
+  expect(localItems().map((item) => [item.sessionId, item.kind, item.hostLabel])).toEqual([
+    ['ses_read', 'question', 'This instance'],
+    ['ses_unread', 'unread', 'This instance'],
+  ]);
+  expect(useInstanceAttentionStore.getState().hosts[LOCAL_INSTANCE_ATTENTION_HOST_ID]?.status).toBe('ok');
+});
+
+test('unmounting clears the local entry', async () => {
+  useGlobalSessionsStore.setState({ entityById: new Map([['ses_unread', session('ses_unread')]]) });
+  await mount();
+  expect(localItems()).toHaveLength(1);
+
+  const mounted = root;
+  root = null;
+  if (mounted) await act(async () => mounted.unmount());
+
+  expect(useInstanceAttentionStore.getState().hosts[LOCAL_INSTANCE_ATTENTION_HOST_ID]).toBeUndefined();
+  expect(useInstanceAttentionStore.getState().items).toEqual([]);
+});
+
+test('a disabled subscriber publishes nothing', async () => {
+  useGlobalSessionsStore.setState({ entityById: new Map([['ses_unread', session('ses_unread')]]) });
+  await mount(false);
+
+  expect(useInstanceAttentionStore.getState().items).toEqual([]);
+});
diff --git a/packages/ui/src/hooks/useLocalInstanceAttention.ts b/packages/ui/src/hooks/useLocalInstanceAttention.ts
new file mode 100644
index 000000000..94b0914ce
--- /dev/null
+++ b/packages/ui/src/hooks/useLocalInstanceAttention.ts
@@ -0,0 +1,51 @@
+import React from 'react';
+
+import { useI18n } from '@/lib/i18n';
+import { LOCAL_INSTANCE_ATTENTION_HOST_ID, type InstancePendingCounts } from '@/lib/instanceAttention';
+import { localInstanceAttentionPoll } from '@/lib/localInstanceAttention';
+import { useGlobalBlockingRequestsStore } from '@/sync/global-blocking-requests';
+import { useGlobalSessionsStore } from '@/stores/useGlobalSessionsStore';
+import { useInstanceAttentionStore } from '@/stores/useInstanceAttentionStore';
+
+/**
+ * Publishes this window's own waiting sessions into the attention store, as
+ * the reserved local entry. Mounted beside the pollers so the same list and
+ * count cover the instance the user is looking at; the polled hosts cover the
+ * others.
+ *
+ * The store's `retainHosts` keeps this entry when it drops the instances the
+ * poller is no longer reading. Unmounting the subscriber clears it, so a shell
+ * without the surfaces does not leave a stale count behind.
+ */
+export const useLocalInstanceAttention = (enabled: boolean): void => {
+  const { t } = useI18n();
+  const hostLabel = t('instanceAttention.localInstance');
+  const entityById = useGlobalSessionsStore((state) => state.entityById);
+  const bySession = useGlobalBlockingRequestsStore((state) => state.bySession);
+
+  React.useEffect(() => {
+    if (!enabled) return;
+    const pending = new Map<string, InstancePendingCounts>();
+    for (const [sessionId, entry] of bySession) {
+      if (entry.permissions.length === 0 && entry.forms.length === 0 && entry.pages.length === 0) continue;
+      pending.set(sessionId, {
+        permissions: entry.permissions.length,
+        forms: entry.forms.length,
+        pages: entry.pages.length,
+      });
+    }
+    useInstanceAttentionStore.getState().applyPoll(
+      LOCAL_INSTANCE_ATTENTION_HOST_ID,
+      hostLabel,
+      localInstanceAttentionPoll(entityById.values(), pending),
+      Date.now(),
+    );
+  }, [bySession, enabled, entityById, hostLabel]);
+
+  React.useEffect(() => {
+    if (!enabled) return;
+    return () => {
+      useInstanceAttentionStore.getState().dropHost(LOCAL_INSTANCE_ATTENTION_HOST_ID);
+    };
+  }, [enabled]);
+};
