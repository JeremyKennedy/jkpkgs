@@ -0,0 +1,108 @@
+import { afterEach, beforeEach, expect, mock, test } from 'bun:test';
+import React, { act } from 'react';
+import type { Root } from 'react-dom/client';
+import { Window } from 'happy-dom';
+
+import { useInstanceAttentionStore } from '@/stores/useInstanceAttentionStore';
+
+const messages = new Map<string, string>([
+  ['instanceAttention.instancesCountAriaOne', '{count} session on {instance} is waiting on you'],
+  ['instanceAttention.instancesCountAriaMany', '{count} sessions on {instance} are waiting on you'],
+]);
+const translate = (key: string, params?: Record<string, string | number>): string => {
+  let text = messages.get(key) ?? key;
+  for (const [name, value] of Object.entries(params ?? {})) {
+    text = text.replaceAll(`{${name}}`, String(value));
+  }
+  return text;
+};
+
+mock.module('@/lib/i18n', () => ({ useI18n: () => ({ t: translate }) }));
+mock.module('@/components/icon/Icon', () => ({ Icon: () => null }));
+
+const { MobileInstanceAttentionBadge } = await import('./MobileInstanceAttentionBadge');
+
+let dom: Window;
+let root: Root;
+const globals = new Map<string, PropertyDescriptor | undefined>();
+
+beforeEach(async () => {
+  dom = new Window({ url: 'http://localhost' });
+  const values = {
+    window: dom, document: dom.document, navigator: dom.navigator,
+    Node: dom.Node, Element: dom.Element, HTMLElement: dom.HTMLElement,
+    Event: dom.Event, MouseEvent: dom.MouseEvent, IS_REACT_ACT_ENVIRONMENT: true,
+  };
+  for (const [name, value] of Object.entries(values)) {
+    globals.set(name, Object.getOwnPropertyDescriptor(globalThis, name));
+    Object.defineProperty(globalThis, name, { configurable: true, writable: true, value });
+  }
+  useInstanceAttentionStore.getState().reset();
+  const host = document.createElement('div');
+  document.body.append(host);
+  const { createRoot } = await import('react-dom/client');
+  root = createRoot(host);
+});
+
+afterEach(async () => {
+  await act(async () => root.unmount());
+  for (const [name, descriptor] of globals) {
+    if (descriptor) Object.defineProperty(globalThis, name, descriptor);
+    else Reflect.deleteProperty(globalThis, name);
+  }
+  globals.clear();
+  await dom.happyDOM.abort();
+  dom.close();
+});
+
+const render = async (hostId: string, label: string): Promise<void> => {
+  await act(async () => root.render(<MobileInstanceAttentionBadge hostId={hostId} label={label} />));
+};
+
+test('shows how many sessions on that server wait for the user', async () => {
+  const store = useInstanceAttentionStore.getState();
+  store.applyPoll('host-b', 'bee', {
+    sessions: [
+      { id: 'ses_a', directory: '/repo', title: 'A', archived: false, idle: 10 },
+      { id: 'ses_b', directory: '/repo', title: 'B', archived: false, idle: 20 },
+    ],
+    pending: new Map([['ses_a', { permissions: 1, forms: 0, pages: 0 }]]),
+    busy: new Set(),
+  }, 100);
+  store.applyPoll('host-c', 'cedar', {
+    sessions: [{ id: 'ses_c', directory: '/repo', title: 'C', archived: false, idle: 30 }],
+    pending: new Map(),
+    busy: new Set(),
+  }, 100);
+
+  await render('host-b', 'bee');
+
+  const badge = document.querySelector('span[aria-label]');
+  expect(badge?.getAttribute('aria-label')).toBe('2 sessions on bee are waiting on you');
+  expect(badge?.textContent).toContain('2');
+});
+
+test('one waiting session reads in the singular', async () => {
+  useInstanceAttentionStore.getState().applyPoll('host-b', 'bee', {
+    sessions: [{ id: 'ses_a', directory: '/repo', title: 'A', archived: false, idle: 10 }],
+    pending: new Map([['ses_a', { permissions: 1, forms: 0, pages: 0 }]]),
+    busy: new Set(),
+  }, 100);
+
+  await render('host-b', 'bee');
+
+  const badge = document.querySelector('span[aria-label]');
+  expect(badge?.getAttribute('aria-label')).toBe('1 session on bee is waiting on you');
+});
+
+test('no badge for a server with nothing waiting', async () => {
+  useInstanceAttentionStore.getState().applyPoll('host-b', 'bee', {
+    sessions: [{ id: 'ses_a', directory: '/repo', title: 'A', archived: false, idle: 10, viewed: 10 }],
+    pending: new Map(),
+    busy: new Set(),
+  }, 100);
+
+  await render('host-b', 'bee');
+
+  expect(document.querySelector('span[aria-label]')).toBeNull();
+});
