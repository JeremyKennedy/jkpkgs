+import type { JsonValue } from '@opencode/client';
+import { z } from 'zod';
+
+import { normalizeHostUrl } from '@/lib/desktopHosts';
+import {
+  hostSessionStatusSnapshotSchema,
+  type HostSessionStatusSnapshot,
+} from '@/lib/opencode/session-status';
+import { getActiveRelayDescriptor, getActiveRelayTunnel } from '@/lib/relay/runtime-tunnel';
+import { createRelayTunnelClient, type RelayTunnelClient } from '@/lib/relay/tunnel-client';
+
+// Cross-instance attention: what a saved desktop instance needs from the user
+// while this window shows another one. The sidebar already reports the active
+// instance's requests, running turns and unread sessions; this module answers
+// only for instances this window is not showing.
+//
+// The reads are the two global routes the host answers without starting an
+// OpenCode location: `GET /api/session` and `GET /api/sessions/status`. A poll
+// names no directory, so it never starts MCP servers, and it uses the saved
+// host's own address and client token instead of the active runtime's.
+//
+// The instance this window shows is not polled: `localInstanceAttention.ts`
+// derives its items from the app's live stores and publishes them beside these
+// hosts, so every surface reads one list and one total.
+
+export type InstanceAttentionKind = 'permission' | 'question' | 'failed' | 'unread';
+
+/** Only the fields the attention rule reads; the wire schema below fills them. */
+export type InstanceSessionSummary = {
+  id: string;
+  parentID?: string;
+  directory: string | null;
+  title: string;
+  idle?: number;
+  viewed?: number;
+  archived: boolean;
+  updated?: number;
+  outcome?: 'succeeded' | 'failed' | 'interrupted';
+};
+
+export type InstancePendingCounts = {
+  permissions: number;
+  forms: number;
+  pages: number;
+};
+
+export type InstanceAttentionSnapshot = {
+  hostId: string;
+  hostLabel: string;
+  sessions: readonly InstanceSessionSummary[];
+  pending: ReadonlyMap<string, InstancePendingCounts>;
+  /** Sessions whose turn is still open on that host, so they are not unread. */
+  busy?: ReadonlySet<string>;
+};
+
+export type InstanceAttentionItem = {
+  /** Stable identity across surfaces: host and session. */
+  key: string;
+  hostId: string;
+  hostLabel: string;
+  sessionId: string;
+  directory: string | null;
+  title: string;
+  kind: InstanceAttentionKind;
+  /** Newest activity the item can be dated by, for ordering. */
+  at: number;
+};
+
+/**
+ * The instance this window shows, as a reserved entry in the same store the
+ * polled hosts use. It is not a polled target: it is derived from the app's own
+ * live stores, so `retainHosts` keeps it when every other host is dropped.
+ */
+export const LOCAL_INSTANCE_ATTENTION_HOST_ID = 'openchamber:this-instance';
+
+export const isLocalInstanceAttentionHost = (hostId: string): boolean => (
+  hostId === LOCAL_INSTANCE_ATTENTION_HOST_ID
+);
+
+export type InstanceAttentionPoll = {
+  /** `null` means the read failed; callers keep what they already had. */
+  sessions: readonly InstanceSessionSummary[] | null;
+  /** `null` means the read failed; callers keep what they already had. */
+  pending: ReadonlyMap<string, InstancePendingCounts> | null;
+  /**
+   * Sessions in an open turn. `null` when the status route did not answer, so
+   * the previous answer stands instead of every session reading as finished.
+   */
+  busy: ReadonlySet<string> | null;
+};
+
+export const instanceAttentionKey = (hostId: string, sessionId: string): string => `${hostId}:${sessionId}`;
+
+const KIND_ORDER = {
+  permission: 0,
+  question: 1,
+  failed: 2,
+  unread: 3,
+} satisfies Record<InstanceAttentionKind, number>;
+
+/**
+ * A finished turn nobody has seen yet. Same rule as `isSessionUnread` in
+ * `sync/session-unread.ts`: OpenCode owns `time.idle`/`time.viewed`, and a
+ * child session reports to its parent instead of to the user.
+ */
+const isFinishedUnseen = (session: InstanceSessionSummary): boolean => (
+  session.idle !== undefined && (session.viewed === undefined || session.viewed < session.idle)
+);
+
+/**
+ * The reason a top-level session asks for the user. Pending requests are read
+ * apart from this because a busy session still has to show its permission or
+ * question, even though its unfinished turn is not "unread".
+ */
+const kindOf = (session: InstanceSessionSummary, busy: ReadonlySet<string> | undefined): InstanceAttentionKind | null => {
+  // The sidebar suppresses unread while a turn is open; the host's status map
+  // is the only live signal for another instance. An idle entry still carries
+  // its last turn's start, so only busy/retry means the turn is open.
+  if (busy?.has(session.id)) return null;
+  if (!isFinishedUnseen(session)) return null;
+  // The tray shows a failed turn only while it is unread (`session-unread.ts`).
+  return session.outcome === 'failed' ? 'failed' : 'unread';
+};
+
+const pendingKindOf = (pending: InstancePendingCounts | undefined): InstanceAttentionKind | null => {
+  if (!pending) return null;
+  if (pending.permissions > 0) return 'permission';
+  if (pending.forms > 0 || pending.pages > 0) return 'question';
+  return null;
+};
+
+const titleOf = (session: InstanceSessionSummary | undefined): string => session?.title?.trim() ?? '';
+
+const atOf = (session: InstanceSessionSummary | undefined): number => (
+  session?.idle ?? session?.updated ?? 0
+);
+
+/**
+ * The top-level session a child belongs to, when the parent is inside the same
+ * page. A child whose parent is outside the page is its own row: opening it
+ * shows its own subtree, which includes the pending request.
+ */
+const topLevelOwner = (
+  session: InstanceSessionSummary,
+  sessionsById: ReadonlyMap<string, InstanceSessionSummary>,
+): InstanceSessionSummary => {
+  let current = session;
+  const visited = new Set<string>();
+  while (current.parentID && !visited.has(current.id)) {
+    visited.add(current.id);
+    const parent = sessionsById.get(current.parentID);
+    if (!parent) return current;
+    current = parent;
+  }
+  return current;
+};
+
+/**
+ * One item per session that needs the user, strongest reason first. A pending
+ * permission outranks a question, a failed unseen turn and an ordinary unseen
+ * turn. Archived sessions never need the user.
+ *
+ * A child session's pending request is attributed to its top-level parent: the
+ * sidebar counts subagent activity toward the family, and opening the parent
+ * shows the child's request in its scope. A child with no pending request is
+ * not an item; its parent carries its unread mark.
+ */
+export const collectInstanceAttention = (
+  snapshots: readonly InstanceAttentionSnapshot[],
+): InstanceAttentionItem[] => {
+  const itemsByKey = new Map<string, InstanceAttentionItem>();
+  const addItem = (
+    snapshot: InstanceAttentionSnapshot,
+    session: InstanceSessionSummary,
+    kind: InstanceAttentionKind,
+    at: number,
+  ): void => {
+    const key = instanceAttentionKey(snapshot.hostId, session.id);
+    const existing = itemsByKey.get(key);
+    if (existing) {
+      if (KIND_ORDER[kind] < KIND_ORDER[existing.kind]) {
+        itemsByKey.set(key, { ...existing, kind, at: Math.max(existing.at, at) });
+      } else {
+        existing.at = Math.max(existing.at, at);
+      }
+      return;
+    }
+    itemsByKey.set(key, {
+      key,
+      hostId: snapshot.hostId,
+      hostLabel: snapshot.hostLabel,
+      sessionId: session.id,
+      directory: session.directory,
+      title: titleOf(session),
+      kind,
+      at,
+    });
+  };
