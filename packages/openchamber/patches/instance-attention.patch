@@ -0,0 +1,158 @@
+import { beforeEach, describe, expect, mock, test } from 'bun:test';
+
+import type { InstanceAttentionPoll } from '@/lib/instanceAttention';
+import type { MobileSavedConnection } from './mobileConnections';
+
+const flush = async () => {
+  for (let turn = 0; turn < 4; turn += 1) await new Promise<void>((resolve) => setTimeout(resolve, 0));
+};
+
+const sleep = (ms: number) => new Promise<void>((resolve) => setTimeout(resolve, ms));
+
+const answered: InstanceAttentionPoll = {
+  sessions: [{ id: 'ses_a', directory: '/repo', title: 'Session', archived: false, idle: 10 }],
+  pending: new Map(),
+  busy: new Set(),
+};
+
+const directReads: Array<{ url: string; token?: string }> = [];
+const relayReads: Array<{ relayUrl: string; token?: string }> = [];
+const withinTimeouts: number[] = [];
+let identity: 'match' | 'mismatch' | 'unreachable' = 'match';
+let headerDelay = 0;
+let tokenDelay = 0;
+
+const actualAttention = await import('@/lib/instanceAttention');
+const actualMobile = await import('./mobileConnections');
+
+mock.module('@/lib/instanceAttention', () => ({
+  ...actualAttention,
+  readInstanceAttention: mock(async (transport: { url: string; token?: string }) => {
+    directReads.push({ url: transport.url, token: transport.token });
+    return answered;
+  }),
+  readRelayInstanceAttention: mock(async (relay: { relayUrl: string }, options?: { token?: string }) => {
+    relayReads.push({ relayUrl: relay.relayUrl, token: options?.token });
+    return answered;
+  }),
+  readInstanceAttentionWithin: async (
+    signal: AbortSignal,
+    timeoutMs: number,
+    read: (signal: AbortSignal) => Promise<InstanceAttentionPoll>,
+  ) => {
+    withinTimeouts.push(timeoutMs);
+    return read(signal);
+  },
+}));
+
+mock.module('./mobileConnections', () => ({
+  ...actualMobile,
+  loadMobileConnectionHeaders: async () => {
+    if (headerDelay > 0) await sleep(headerDelay);
+    return undefined;
+  },
+  loadMobileConnectionToken: async () => {
+    if (tokenDelay > 0) await sleep(tokenDelay);
+    return 'secret';
+  },
+  checkDirectCandidateIdentity: async () => identity,
+}));
+
+const { mobileAttentionTargets } = await import('./mobileInstanceAttention');
+
+const connection = (
+  id: string,
+  candidates: MobileSavedConnection['candidates'],
+  clientToken?: string,
+): MobileSavedConnection => ({
+  id,
+  label: `Server ${id}`,
+  candidates,
+  clientToken,
+  lastUsedAt: 0,
+});
+
+beforeEach(() => {
+  directReads.length = 0;
+  relayReads.length = 0;
+  withinTimeouts.length = 0;
+  identity = 'match';
+  headerDelay = 0;
+  tokenDelay = 0;
+});
+
+describe('mobile attention identity gate', () => {
+  test('sends the token to a direct candidate that proves the pinned identity', async () => {
+    const target = mobileAttentionTargets([
+      connection('both', [
+        { kind: 'direct', url: 'http://lan.test' },
+        { kind: 'relay', relay: { relayUrl: 'wss://relay.test', serverId: 'server-a', hostEncPubJwk: {} } },
+      ]),
+    ], null)[0]!;
+
+    await target.read(new AbortController().signal);
+
+    expect(directReads).toEqual([{ url: 'http://lan.test', token: 'secret' }]);
+    expect(relayReads).toEqual([]);
+  });
+
+  test('a different serverId is never sent the token, and the relay is tried', async () => {
+    identity = 'mismatch';
+    const target = mobileAttentionTargets([
+      connection('both', [
+        { kind: 'direct', url: 'http://lan.test' },
+        { kind: 'relay', relay: { relayUrl: 'wss://relay.test', serverId: 'server-a', hostEncPubJwk: {} } },
+      ]),
+    ], null)[0]!;
+
+    await target.read(new AbortController().signal);
+
+    expect(directReads).toEqual([]);
+    expect(relayReads).toEqual([{ relayUrl: 'wss://relay.test', token: 'secret' }]);
+  });
+
+  test('an unreadable /health is unverified, so the direct address gets no token', async () => {
+    identity = 'unreachable';
+    const target = mobileAttentionTargets([
+      connection('both', [
+        { kind: 'direct', url: 'http://lan.test' },
+        { kind: 'relay', relay: { relayUrl: 'wss://relay.test', serverId: 'server-a', hostEncPubJwk: {} } },
+      ]),
+    ], null)[0]!;
+
+    await target.read(new AbortController().signal);
+
+    expect(directReads).toEqual([]);
+    expect(relayReads).toHaveLength(1);
+  });
+
+  test('a direct-only connection has no pinned identity and is read as before', async () => {
+    const target = mobileAttentionTargets([
+      connection('lan', [{ kind: 'direct', url: 'http://lan.test' }]),
+    ], null)[0]!;
+
+    await target.read(new AbortController().signal);
+
+    expect(directReads).toEqual([{ url: 'http://lan.test', token: 'secret' }]);
+    expect(relayReads).toEqual([]);
+  });
+});
+
+describe('mobile attention budget', () => {
+  test('the direct attempt keeps its full timeout after slow secure-storage reads', async () => {
+    headerDelay = 150;
+    tokenDelay = 150;
+    const target = mobileAttentionTargets([
+      connection('both', [
+        { kind: 'direct', url: 'http://lan.test' },
+        { kind: 'relay', relay: { relayUrl: 'wss://relay.test', serverId: 'server-a', hostEncPubJwk: {} } },
+      ]),
+    ], null)[0]!;
+
+    await target.read(new AbortController().signal);
+    await flush();
+
+    // 4000ms for the direct attempt, not what is left after 300ms of keychain.
+    expect(withinTimeouts[0]).toBeGreaterThan(3_900);
+  });
+});
