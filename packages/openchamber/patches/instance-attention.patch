+/**
+ * Clears one request the host says is no longer waiting. A verification read
+ * can find a form the index kept after a lost settlement; recording it as
+ * settled here also keeps the next snapshot from putting it back.
+ */
+export const settleGlobalBlockingRequest = (
+  kind: 'permission' | 'form',
+  sessionID: string,
+  requestID: string,
+): void => {
+  if (!sessionID || !requestID) return;
+  settledByRead.add(settledKey(kind === 'permission' ? 'permissions' : 'forms', sessionID, requestID));
+  const state = useGlobalBlockingRequestsStore.getState();
+  const existing = state.bySession.get(sessionID);
+  if (!existing) return;
+  const bySession = new Map(state.bySession);
+  if (kind === 'permission') {
+    const permissions = existing.permissions.filter((entry) => entry.id !== requestID);
+    if (permissions.length === existing.permissions.length) return;
+    if (permissions.length === 0 && existing.forms.length === 0 && existing.pages.length === 0) bySession.delete(sessionID);
+    else bySession.set(sessionID, { ...existing, permissions });
+  } else {
+    const forms = existing.forms.filter((entry) => entry.id !== requestID);
+    if (forms.length === existing.forms.length) return;
+    if (forms.length === 0 && existing.permissions.length === 0 && existing.pages.length === 0) bySession.delete(sessionID);
+    else bySession.set(sessionID, { ...existing, forms });
+  }
+  useGlobalBlockingRequestsStore.setState({ bySession });
+};
