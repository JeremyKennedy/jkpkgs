@@ -0,0 +1,55 @@
+import React from 'react';
+
+import {
+  isActiveRuntimeConnection,
+  loadMobileConnections,
+} from '@/apps/mobileConnections';
+import { mobileAttentionTargets } from '@/apps/mobileInstanceAttention';
+import { subscribeRuntimeEndpointChanged } from '@/lib/runtime-switch';
+
+import {
+  instanceAttentionVisibility,
+  startInstanceAttentionPolling,
+  type InstanceAttentionTarget,
+} from './useInstanceAttentionPolling';
+
+// Polls the saved mobile connections this phone is not showing. The active
+// connection is excluded: the app's own session list and indicators cover it.
+// A switch restarts the loop, because the connection just left becomes a
+// target and the one now shown stops being read.
+
+const readMobileTargets = async (): Promise<InstanceAttentionTarget[]> => {
+  const connections = await loadMobileConnections();
+  const active = connections.find(isActiveRuntimeConnection) ?? null;
+  return mobileAttentionTargets(connections, active?.id ?? null);
+};
+
+export const useMobileInstanceAttentionPolling = (enabled: boolean): void => {
+  React.useEffect(() => {
+    if (!enabled) return;
+    const start = () => {
+      const visibility = instanceAttentionVisibility();
+      const stopPolling = startInstanceAttentionPolling({
+        readTargets: readMobileTargets,
+        isVisible: visibility.isVisible,
+        onVisible: visibility.onVisible,
+        scheduleTimeout: window.setTimeout.bind(window),
+        clearScheduledTimeout: window.clearTimeout.bind(window),
+        now: Date.now,
+      });
+      return () => {
+        stopPolling();
+        visibility.dispose();
+      };
+    };
+    let stop = start();
+    const unsubscribe = subscribeRuntimeEndpointChanged(() => {
+      stop();
+      stop = start();
+    });
+    return () => {
+      unsubscribe();
+      stop();
+    };
+  }, [enabled]);
+};
