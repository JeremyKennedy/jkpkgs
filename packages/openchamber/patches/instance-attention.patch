+import React from 'react';
+
+import { useI18n } from '@/lib/i18n';
+import type { InstanceAttentionItem, InstanceAttentionKind } from '@/lib/instanceAttention';
+import { cn } from '@/lib/utils';
+
+/**
+ * One compact row: the session title, the instance it belongs to and what it
+ * needs. The row primitive is supplied by the shell so the desktop menu keeps
+ * its keyboard navigation and a phone sheet can render plain buttons.
+ */
+const INSTANCE_ATTENTION_ROW_CLASS = 'flex min-h-7 items-center gap-2 rounded-lg px-2 py-1.5 typography-ui-label outline-hidden select-none';
+
+export type InstanceAttentionListRowProps = {
+  item: InstanceAttentionItem;
+  onOpen: (item: InstanceAttentionItem) => void;
+  className?: string;
+  children: React.ReactNode;
+};
+
+export type InstanceAttentionListProps = {
+  items: readonly InstanceAttentionItem[];
+  unreachableLabels: readonly string[];
+  onOpen: (item: InstanceAttentionItem) => void;
+  /** Desktop menus pass their own row; a sheet uses the default button. */
+  row?: React.ComponentType<InstanceAttentionListRowProps>;
+  /** False when the shell already names the list (a phone sheet's title). */
+  showTitle?: boolean;
+  className?: string;
+};
+
+const KIND_LABEL_KEY = {
+  permission: 'instanceAttention.kind.permission',
+  question: 'instanceAttention.kind.question',
+  failed: 'instanceAttention.kind.failed',
+  unread: 'instanceAttention.kind.unread',
+} as const satisfies Record<InstanceAttentionKind, string>;
+
+const KIND_TEXT_CLASS = {
+  permission: 'text-[var(--status-warning-text)]',
+  question: 'text-[var(--status-warning-text)]',
+  failed: 'text-[var(--status-error-text)]',
+  unread: 'text-[var(--status-success-text)]',
+} as const satisfies Record<InstanceAttentionKind, string>;
+
+const DefaultRow = ({ item, onOpen, className, children }: InstanceAttentionListRowProps): React.ReactNode => (
+  <button
+    type="button"
+    onClick={() => onOpen(item)}
+    className={cn(INSTANCE_ATTENTION_ROW_CLASS, 'w-full text-start hover:bg-interactive-hover', className)}
+  >
+    {children}
+  </button>
+);
+
+/**
+ * Every session that needs the user, this instance's own and the saved ones,
+ * strongest first. Presentational: the popover shell and a phone sheet both
+ * render it, and only the row primitive changes between them.
+ */
+export function InstanceAttentionList({
+  items,
+  unreachableLabels,
+  onOpen,
+  row: Row = DefaultRow,
+  showTitle = true,
+  className,
+}: InstanceAttentionListProps): React.ReactNode {
+  const { t } = useI18n();
+  if (items.length === 0) return null;
+
+  return (
+    <div className={cn('flex flex-col', className)}>
+      {showTitle ? (
+        <div className="px-2 py-1 typography-ui-label font-medium text-muted-foreground">
+          {t('instanceAttention.list.title')}
+        </div>
+      ) : null}
+      {items.map((item) => (
+        <Row key={item.key} item={item} onOpen={onOpen} className={INSTANCE_ATTENTION_ROW_CLASS}>
+          <span className="flex min-w-0 flex-1 flex-col gap-0.5">
+            <span className="min-w-0 truncate text-foreground" title={item.title || undefined}>
+              {item.title || t('sessions.sidebar.session.untitled')}
+            </span>
+            <span className="flex min-w-0 items-center gap-1 typography-micro">
+              <span className="min-w-0 truncate text-muted-foreground">{item.hostLabel}</span>
+              <span className="shrink-0 text-muted-foreground">·</span>
+              <span className={cn('shrink-0 font-medium', KIND_TEXT_CLASS[item.kind])}>
+                {t(KIND_LABEL_KEY[item.kind])}
+              </span>
+            </span>
+          </span>
+        </Row>
+      ))}
+      {unreachableLabels.length > 0 ? (
+        <p className="px-2 pb-1 pt-0.5 typography-micro text-muted-foreground" title={unreachableLabels.join(', ')}>
+          {t('instanceAttention.unreachable', { instances: unreachableLabels.join(', ') })}
+        </p>
+      ) : null}
+    </div>
+  );
+}
