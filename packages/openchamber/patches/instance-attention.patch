+import { afterEach, beforeEach, expect, mock, test } from 'bun:test';
+import React, { act } from 'react';
+import type { Root } from 'react-dom/client';
+import { Window } from 'happy-dom';
+
+import type { InstanceAttentionItem } from '@/lib/instanceAttention';
+
+const messages = new Map<string, string>([
+  ['instanceAttention.list.title', 'Waiting on you'],
+  ['instanceAttention.kind.permission', 'Permission'],
+  ['instanceAttention.kind.question', 'Question'],
+  ['instanceAttention.kind.failed', 'Failed'],
+  ['instanceAttention.kind.unread', 'Unread'],
+  ['instanceAttention.unreachable', 'No answer from {instances}; showing their last known items.'],
+  ['sessions.sidebar.session.untitled', 'Untitled Session'],
+]);
+
+const translate = (key: string, params?: Record<string, string | number>): string => {
+  let text = messages.get(key) ?? key;
+  for (const [name, value] of Object.entries(params ?? {})) {
+    text = text.replaceAll(`{${name}}`, String(value));
+  }
+  return text;
+};
+
+mock.module('@/lib/i18n', () => ({ useI18n: () => ({ t: translate }) }));
+
+let listModule: typeof import('./InstanceAttentionList');
+let dom: Window;
+let root: Root;
+const globals = new Map<string, PropertyDescriptor | undefined>();
+
+beforeEach(async () => {
+  dom = new Window({ url: 'http://localhost' });
+  const values = {
+    window: dom, document: dom.document, navigator: dom.navigator,
+    Node: dom.Node, Element: dom.Element, HTMLElement: dom.HTMLElement,
+    Event: dom.Event, MouseEvent: dom.MouseEvent, IS_REACT_ACT_ENVIRONMENT: true,
+  };
+  for (const [name, value] of Object.entries(values)) {
+    globals.set(name, Object.getOwnPropertyDescriptor(globalThis, name));
+    Object.defineProperty(globalThis, name, { configurable: true, writable: true, value });
+  }
+  listModule = await import('./InstanceAttentionList');
+  const host = document.createElement('div');
+  document.body.append(host);
+  const { createRoot } = await import('react-dom/client');
+  root = createRoot(host);
+});
+
+afterEach(async () => {
+  await act(async () => root.unmount());
+  for (const [name, descriptor] of globals) {
+    if (descriptor) Object.defineProperty(globalThis, name, descriptor);
+    else Reflect.deleteProperty(globalThis, name);
+  }
+  globals.clear();
+  await dom.happyDOM.abort();
+  dom.close();
+});
+
+const item = (overrides: Partial<InstanceAttentionItem>): InstanceAttentionItem => ({
+  key: 'host-b:ses_a',
+  hostId: 'host-b',
+  hostLabel: 'Build box',
+  sessionId: 'ses_a',
+  directory: '/repo',
+  title: 'Session A',
+  kind: 'unread',
+  at: 10,
+  ...overrides,
+});
+
+const render = async (items: InstanceAttentionItem[], unreachableLabels: string[] = []): Promise<void> => {
+  await act(async () => {
+    root.render(
+      <listModule.InstanceAttentionList
+        items={items}
+        unreachableLabels={unreachableLabels}
+        onOpen={() => undefined}
+      />,
+    );
+  });
+};
+
+test('lists every waiting session with its instance, title and kind, strongest first', async () => {
+  await render([
+    item({ key: 'host-c:ses_c', hostId: 'host-c', hostLabel: 'Laptop', sessionId: 'ses_c', title: 'Review the migration', kind: 'permission' }),
+    item({ key: 'host-b:ses_b', hostId: 'host-b', hostLabel: 'Build box', sessionId: 'ses_b', title: 'Finish the sidebar', kind: 'unread' }),
+  ]);
+
+  expect(document.body.textContent).toContain('Waiting on you');
+  const rows = [...document.querySelectorAll('button')];
+  expect(rows).toHaveLength(2);
+  expect(rows[0]?.textContent).toContain('Review the migration');
+  expect(rows[0]?.textContent).toContain('Laptop');
+  expect(rows[0]?.textContent).toContain('Permission');
+  expect(rows[1]?.textContent).toContain('Finish the sidebar');
+  expect(rows[1]?.textContent).toContain('Build box');
+  expect(rows[1]?.textContent).toContain('Unread');
+});
+
+test('an unreachable host is a quiet note, not a row', async () => {
+  await render([item({})], ['halo']);
+
+  const rows = [...document.querySelectorAll('button')];
+  expect(rows).toHaveLength(1);
+  expect(document.body.textContent).toContain('No answer from halo; showing their last known items.');
+});
+
+test('an unreachable host is visible even when nothing else waits', async () => {
+  await render([], ['halo']);
+
+  expect(document.querySelectorAll('button')).toHaveLength(0);
+  expect(document.body.textContent).toContain('No answer from halo; showing their last known items.');
+  expect(document.body.textContent).not.toContain('Waiting on you');
+});
+
+test('nothing renders when no session waits and every host answered', async () => {
+  await render([]);
+
+  expect(document.querySelectorAll('button')).toHaveLength(0);
+  expect(document.body.textContent).toBe('');
+});
