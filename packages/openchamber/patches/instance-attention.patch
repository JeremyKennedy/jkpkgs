 ### Feature cache / query stores
 
+#### Cross-instance attention
+
+`useInstanceAttentionStore.ts` holds one list for every session that needs the
+user, strongest reason first and newest within that. The saved instances the
+poller reads answer from their `/api/session` and `/api/sessions/status` routes.
+The instance this window shows is published by `hooks/useLocalInstanceAttention.ts`
+as the reserved `openchamber:this-instance` entry, derived from
+`sync/global-blocking-requests.ts`, `useGlobalSessionsStore` and
+`sync/session-unread.ts`; a subagent request attributes to its top-level parent.
+Every surface reads the same `items` array, so the switcher, the phone bell and
+the collapsed-sidebar badge show one total. `retainHosts` keeps the reserved
+entry because it is never in a poller's target list.
+
+#### Why the local instance is a store entry and not a second list
+
+A separate local list would make every surface merge two arrays and choose
+between two counts, and the merge would have to repeat the strength order and
+subagent attribution the polled path already owns. Publishing the local half as
+another host entry keeps one derivation and one sorted list; the reserved id is
+the only thing that distinguishes it, and the hook resolves
+`instanceAttention.localInstance` when it publishes, so the row label follows
+the locale instead of storing English in the record.
+
 #### Provider quota visibility
 
 `useQuotaAutoRefresh(visible, allProviders)` registers demand only for a mounted,
diff --git a/packages/ui/src/stores/useInstanceAttentionStore.test.ts b/packages/ui/src/stores/useInstanceAttentionStore.test.ts
new file mode 100644
index 000000000..12b06193d
--- /dev/null
+++ b/packages/ui/src/stores/useInstanceAttentionStore.test.ts
@@ -0,0 +1,154 @@
+import { beforeEach, describe, expect, test } from 'bun:test';
+
+import {
+  LOCAL_INSTANCE_ATTENTION_HOST_ID,
+  type InstanceAttentionPoll,
+  type InstancePendingCounts,
+  type InstanceSessionSummary,
+} from '@/lib/instanceAttention';
+import { useInstanceAttentionStore } from './useInstanceAttentionStore';
+
+const session = (overrides: Partial<InstanceSessionSummary> = {}): InstanceSessionSummary => ({
+  id: 'ses_a',
+  directory: '/repo',
+  title: 'Session A',
+  archived: false,
+  ...overrides,
+});
+
+const poll = (
+  sessions: InstanceSessionSummary[] | null,
+  pending: Map<string, InstancePendingCounts> | null,
+  busy: ReadonlySet<string> | null = new Set(),
+): InstanceAttentionPoll => ({ sessions, pending, busy });
+
+beforeEach(() => {
+  useInstanceAttentionStore.getState().reset();
+});
+
+describe('cross-instance attention store', () => {
+  test('publishes the strongest item for a host that answered', () => {
+    useInstanceAttentionStore.getState().applyPoll(
+      'host-b',
+      'Build box',
+      poll([session({ id: 'ses_unread', idle: 10 })], new Map([['ses_unread', { permissions: 1, forms: 0, pages: 0 }]])),
+      100,
+    );
+
+    const state = useInstanceAttentionStore.getState();
+    expect(state.hosts['host-b']?.status).toBe('ok');
+    expect(state.items).toHaveLength(1);
+    expect(state.items[0]).toMatchObject({ hostId: 'host-b', hostLabel: 'Build box', kind: 'permission' });
+    expect(state.items[0]?.sessionId).toBe('ses_unread');
+  });
+
+  test('a failed half of a poll keeps the previous answer for that half', () => {
+    const store = useInstanceAttentionStore.getState();
+    store.applyPoll('host-b', 'Build box', poll([session({ id: 'ses_a', idle: 10 })], new Map([
+      ['ses_a', { permissions: 0, forms: 1, pages: 0 }],
+    ])), 100);
+
+    store.applyPoll('host-b', 'Build box', poll([session({ id: 'ses_b', idle: 20 })], null), 200);
+
+    const state = useInstanceAttentionStore.getState();
+    expect(state.hosts['host-b']?.sessions?.map((entry) => entry.id)).toEqual(['ses_b']);
+    expect(state.hosts['host-b']?.pending?.get('ses_a')).toEqual({ permissions: 0, forms: 1, pages: 0 });
+    expect(state.items.map((item) => item.sessionId).sort()).toEqual(['ses_a', 'ses_b']);
+  });
+
+  test('a busy session stops reading as unread, and a failed status half keeps that fact', () => {
+    const store = useInstanceAttentionStore.getState();
+    store.applyPoll('host-b', 'Build box', poll([session({ id: 'ses_busy', idle: 10 })], new Map(), new Set(['ses_busy'])), 100);
+    expect(useInstanceAttentionStore.getState().items).toEqual([]);
+
+    // The session list answered but the status route did not: the last known
+    // open turn stands, so the session is still not unread.
+    store.applyPoll('host-b', 'Build box', poll([session({ id: 'ses_busy', idle: 10 })], null), 200);
+    expect(useInstanceAttentionStore.getState().items).toEqual([]);
+
+    // Once the status route answers idle, the finished turn is unread again.
+    store.applyPoll('host-b', 'Build box', poll([session({ id: 'ses_busy', idle: 10 })], new Map(), new Set()), 300);
+    expect(useInstanceAttentionStore.getState().items.map((item) => item.kind)).toEqual(['unread']);
+  });
+
+  test('an unreachable host keeps its last known items and is marked as failed', () => {
+    const store = useInstanceAttentionStore.getState();
+    store.applyPoll('host-b', 'Build box', poll([session({ id: 'ses_a', idle: 10 })], new Map()), 100);
+    store.markUnreachable('host-b', 'Build box', 200);
+
+    const state = useInstanceAttentionStore.getState();
+    expect(state.hosts['host-b']?.status).toBe('error');
+    expect(state.items.map((item) => item.sessionId)).toEqual(['ses_a']);
+  });
+
+  test('a poll that answered neither route is treated as unreachable, not empty', () => {
+    const store = useInstanceAttentionStore.getState();
+    store.applyPoll('host-b', 'Build box', poll([session({ id: 'ses_a', idle: 10 })], new Map()), 100);
+    store.applyPoll('host-b', 'Build box', poll(null, null), 200);
+
+    const state = useInstanceAttentionStore.getState();
+    expect(state.hosts['host-b']?.status).toBe('error');
+    expect(state.items.map((item) => item.sessionId)).toEqual(['ses_a']);
+  });
+
+  test('retaining hosts drops instances that were removed or became active', () => {
+    const store = useInstanceAttentionStore.getState();
+    store.applyPoll('host-b', 'Build box', poll([session({ id: 'ses_a', idle: 10 })], new Map()), 100);
+    store.applyPoll('host-c', 'Laptop', poll([session({ id: 'ses_b', idle: 20 })], new Map()), 100);
+
+    store.retainHosts(['host-c']);
+
+    expect(useInstanceAttentionStore.getState().items.map((item) => item.hostId)).toEqual(['host-c']);
+  });
+
+  test('the local entry merges into the same list as the polled hosts', () => {
+    const store = useInstanceAttentionStore.getState();
+    store.applyPoll('host-b', 'Build box', poll([
+      session({ id: 'ses_remote_unread', title: 'Remote unread', idle: 10 }),
+    ], new Map()), 100);
+    store.applyPoll(LOCAL_INSTANCE_ATTENTION_HOST_ID, 'This instance', poll([
+      session({ id: 'ses_local_permission', title: 'Local permission', idle: 5 }),
+    ], new Map([['ses_local_permission', { permissions: 1, forms: 0, pages: 0 }]])), 100);
+
+    const state = useInstanceAttentionStore.getState();
+    expect(state.items.map((item) => [item.sessionId, item.kind])).toEqual([
+      ['ses_local_permission', 'permission'],
+      ['ses_remote_unread', 'unread'],
+    ]);
+  });
+
+  test('the local entry survives retention while polled hosts do not', () => {
+    const store = useInstanceAttentionStore.getState();
+    store.applyPoll(LOCAL_INSTANCE_ATTENTION_HOST_ID, 'This instance', poll([
+      session({ id: 'ses_local', idle: 10 }),
+    ], new Map()), 100);
+    store.applyPoll('host-b', 'Build box', poll([session({ id: 'ses_remote', idle: 10 })], new Map()), 100);
+
+    store.retainHosts([]);
+
+    expect(useInstanceAttentionStore.getState().items.map((item) => item.hostId))
+      .toEqual([LOCAL_INSTANCE_ATTENTION_HOST_ID]);
+  });
+
+  test('opening an item drops its host and leaves the others', () => {
+    const store = useInstanceAttentionStore.getState();
+    store.applyPoll('host-b', 'Build box', poll([session({ id: 'ses_a', idle: 10 })], new Map()), 100);
+    store.applyPoll('host-c', 'Laptop', poll([session({ id: 'ses_b', idle: 20 })], new Map()), 100);
+    const top = useInstanceAttentionStore.getState().items[0] ?? null;
+    expect(top).not.toBeNull();
+
+    store.dropHost(top!.hostId);
+
+    expect(useInstanceAttentionStore.getState().items.map((item) => item.hostId)).not.toContain(top!.hostId);
+    expect(useInstanceAttentionStore.getState().items).toHaveLength(1);
+  });
+
+  test('reset clears hosts and items', () => {
+    const store = useInstanceAttentionStore.getState();
+    store.applyPoll('host-b', 'Build box', poll([session({ id: 'ses_a', idle: 10 })], new Map()), 100);
+
+    store.reset();
+
+    expect(useInstanceAttentionStore.getState()).toMatchObject({ hosts: {}, items: [] });
+  });
+});
