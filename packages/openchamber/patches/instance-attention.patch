@@ -0,0 +1,72 @@
+import React from 'react';
+
+import { useInstanceAttentionStore } from '@/stores/useInstanceAttentionStore';
+
+// Preview-only seed for cross-instance attention. The real poller runs in the
+// desktop shell, so a browser preview would otherwise always show nothing.
+// Open the web app with `?instanceAttentionPreview=1` to render the instance
+// switcher with its count badge and the "Waiting on you" section, seeded from
+// two fake instances plus one unreachable host.
+
+const INSTANCE_ATTENTION_PREVIEW_FLAG = 'instanceAttentionPreview';
+const PREVIEW_STORAGE_KEY = 'openchamber.instanceAttentionPreview';
+
+// Read at module load, before the router replaces the address bar: a first
+// visit with the query flag keeps the preview on for this page.
+const previewRequestedByUrl = globalThis.location
+  ? new URLSearchParams(globalThis.location.search).has(INSTANCE_ATTENTION_PREVIEW_FLAG)
+  : false;
+
+export const isInstanceAttentionPreview = (): boolean => {
+  if (!globalThis.document) return false;
+  if (previewRequestedByUrl) return true;
+  try {
+    return globalThis.localStorage.getItem(PREVIEW_STORAGE_KEY) === '1';
+  } catch {
+    return false;
+  }
+};
+
+export const useInstanceAttentionPreview = (): void => {
+  React.useEffect(() => {
+    if (!isInstanceAttentionPreview()) return;
+    const now = Date.now();
+    const store = useInstanceAttentionStore.getState();
+    store.applyPoll('preview-bee', 'bee', {
+      sessions: [
+        {
+          id: 'ses_preview_permission',
+          directory: '/home/jeremy/dev/openchamber',
+          title: 'Unify sessions across instances',
+          idle: now - 40_000,
+          viewed: now - 40_000,
+          archived: false,
+          updated: now - 40_000,
+        },
+      ],
+      pending: new Map([
+        ['ses_preview_permission', { permissions: 1, forms: 0, pages: 0 }],
+      ]),
+      busy: new Set(),
+    }, now);
+    store.applyPoll('preview-cedar', 'cedar', {
+      sessions: [
+        {
+          id: 'ses_preview_unread',
+          directory: '/home/jeremy/dev/openchamber',
+          title: 'Sidebar attention queue',
+          idle: now - 90_000,
+          viewed: now - 180_000,
+          archived: false,
+          outcome: 'succeeded',
+          updated: now - 90_000,
+        },
+      ],
+      pending: new Map(),
+      busy: new Set(),
+    }, now);
+    // A third host that did not answer, so the panel's quiet note is visible
+    // in the preview without pretending it has items of its own.
+    store.markUnreachable('preview-halo', 'halo', now);
+  }, []);
+};
diff --git a/packages/ui/src/hooks/useLocalInstanceAttention.test.tsx b/packages/ui/src/hooks/useLocalInstanceAttention.test.tsx
