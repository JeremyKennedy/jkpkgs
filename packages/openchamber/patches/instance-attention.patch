+    ? transport.url.trim().replace(/\/+$/, '')
+    : normalizeHostUrl(transport.url)?.replace(/\/+$/, '');
+  if (!baseUrl) return { sessions: null, pending: null, busy: null };
+  const headers = buildTransportHeaders(transport);
+  const fetchImpl = transport.fetchImpl ?? fetch;
+  const root = baseUrl.replace(/\/+$/, '');
+
+  const [sessionsPayload, statusPayload] = await Promise.all([
+    readJson(`${root}/api/session?limit=${INSTANCE_ATTENTION_SESSION_LIMIT}`, headers, fetchImpl, options.signal),
+    readJson(`${root}/api/sessions/status`, headers, fetchImpl, options.signal),
+  ]);
+
+  const sessionList = sessionListSchema.safeParse(sessionsPayload);
+  const status = hostSessionStatusSnapshotSchema.safeParse(statusPayload);
+  const records = sessionList.success
+    ? (Array.isArray(sessionList.data) ? sessionList.data : sessionList.data.data)
+    : null;
+  return {
+    sessions: records ? records.map(projectSessionSummary) : null,
+    pending: status.success ? pendingCounts(status.data) : null,
+    busy: status.success ? busySessionIds(status.data) : null,
+  };
+};
+
+/**
+ * Bounds one candidate read. The inner controller follows the caller's signal,
+ * so a cancelled poll or a spent budget stops the request instead of leaving
+ * it to finish against a runtime that moved on.
+ */
+export const readInstanceAttentionWithin = async (
+  signal: AbortSignal,
+  timeoutMs: number,
+  read: (signal: AbortSignal) => Promise<InstanceAttentionPoll>,
+): Promise<InstanceAttentionPoll> => {
+  const controller = new AbortController();
+  const abort = () => controller.abort();
+  signal.addEventListener('abort', abort, { once: true });
+  const timer = setTimeout(() => controller.abort(), timeoutMs);
+  try {
+    return await read(controller.signal);
+  } finally {
+    clearTimeout(timer);
+    signal.removeEventListener('abort', abort);
+  }
+};
+
+// ---------------------------------------------------------------------------
+// Relay transport
+// ---------------------------------------------------------------------------
+
+export type InstanceAttentionRelay = {
+  relayUrl: string;
+  serverId: string;
+  hostEncPubJwk: JsonWebKey;
+};
+
+type RelayDescriptor = Omit<InstanceAttentionRelay, 'hostEncPubJwk'> & { hostEncPubJwk: JsonWebKey };
+
+export type InstanceAttentionRelayDeps = {
+  createTunnel: (options: InstanceAttentionRelay) => RelayTunnelClient;
+  getActiveTunnel: () => RelayTunnelClient | null;
+  getActiveDescriptor: () => RelayDescriptor | null;
+};
+
+const sameRelay = (left: InstanceAttentionRelay, right: RelayDescriptor): boolean =>
+  left.relayUrl === right.relayUrl
+  && left.serverId === right.serverId
+  && JSON.stringify(left.hostEncPubJwk) === JSON.stringify(right.hostEncPubJwk);
+
+const defaultRelayDeps: InstanceAttentionRelayDeps = {
+  createTunnel: (options) => createRelayTunnelClient(options),
+  getActiveTunnel: getActiveRelayTunnel,
+  getActiveDescriptor: getActiveRelayDescriptor,
+};
+
+/**
+ * Reads one relay-only server through its E2EE tunnel. The live runtime tunnel
+ * is reused when it already serves this server, so a poll never disturbs the
+ * active instance's connection; otherwise a short-lived tunnel is opened and
+ * closed after the two GETs.
+ */
+export const readRelayInstanceAttention = async (
+  relay: InstanceAttentionRelay,
+  options: { token?: string; headers?: Readonly<Record<string, string>>; signal?: AbortSignal } = {},
+  deps: InstanceAttentionRelayDeps = defaultRelayDeps,
+): Promise<InstanceAttentionPoll> => {
+  const activeTunnel = deps.getActiveTunnel();
+  const activeDescriptor = deps.getActiveDescriptor();
+  const reusable = Boolean(
+    activeTunnel
+    && activeDescriptor
+    && activeTunnel.getStatus().state === 'connected'
+    && sameRelay(relay, activeDescriptor),
+  );
+  const tunnel = reusable && activeTunnel ? activeTunnel : deps.createTunnel(relay);
+  try {
+    return await readInstanceAttention({
+      // A relay has no network base URL; the fetch adapter takes the paths.
+      url: `relay://${relay.serverId}`,
+      token: options.token,
+      headers: options.headers,
+      fetchImpl: async (input, init) => {
+        const url = new URL(String(input));
+        return tunnel.fetch(`${url.pathname}${url.search}`, init);
+      },
+    }, { signal: options.signal });
+  } finally {
+    if (!reusable) tunnel.close();
+  }
+};
diff --git a/packages/ui/src/lib/instanceAttentionJump.test.ts b/packages/ui/src/lib/instanceAttentionJump.test.ts
