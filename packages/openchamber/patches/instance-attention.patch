@@ -0,0 +1,35 @@
+import { describe, expect, test } from 'bun:test';
+
+import { instanceAttentionI18n } from './instance-attention.i18n';
+
+const locales = ['en', 'de', 'fr', 'nl', 'es', 'ja', 'pt-BR', 'uk', 'ko', 'pl', 'zh-CN', 'zh-TW', 'tr', 'ar', 'he'] as const;
+
+describe('instance attention translations', () => {
+  test('every locale has every key and carries the count', () => {
+    const english = Object.entries(instanceAttentionI18n.en);
+    for (const locale of locales) {
+      const dictionary = new Map<string, string>(Object.entries(instanceAttentionI18n[locale]));
+      expect([...dictionary.keys()].sort()).toEqual(english.map(([key]) => key).sort());
+      for (const [key] of english) {
+        const text = dictionary.get(key) ?? '';
+        expect(text.trim()).toBeTruthy();
+        if (key.endsWith('AriaOne') || key.endsWith('AriaMany')) {
+          expect(`${locale} ${key}: ${text.includes('{count}')}`).toBe(`${locale} ${key}: true`);
+        }
+      }
+    }
+  });
+
+  test('the singular count labels are separate from the plural ones', () => {
+    expect(instanceAttentionI18n.en['instanceAttention.ariaOne']).not.toContain('sessions');
+    expect(instanceAttentionI18n.en['instanceAttention.ariaMany']).toContain('sessions');
+    expect(instanceAttentionI18n.en['instanceAttention.instancesCountAriaOne']).not.toContain('sessions');
+    expect(instanceAttentionI18n.en['instanceAttention.instancesCountAriaMany']).toContain('sessions');
+  });
+
+  test('the total labels count every instance instead of naming the others', () => {
+    expect(instanceAttentionI18n.en['instanceAttention.ariaOne']).toBe('{count} session is waiting on you');
+    expect(instanceAttentionI18n.en['instanceAttention.ariaMany']).toBe('{count} sessions are waiting on you');
+    expect(instanceAttentionI18n.en['instanceAttention.localInstance']).toBe('This instance');
+  });
+});
