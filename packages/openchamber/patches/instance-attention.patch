+    const container = document.createElement('div');
+    document.body.append(container);
+    const mounted = createRoot(container);
+    await act(async () => {
+      mounted.render(<I18nProvider><DesktopHostSwitcherDialog open embedded onOpenChange={() => undefined} /></I18nProvider>);
+      await flush();
+    });
+    return { container, unmount: () => act(async () => mounted.unmount()) };
+  };
+
+  const read = await mount();
+  expect(read.container.querySelectorAll('[inert]').length).toBe(0);
+  await read.unmount();
+
+  pendingRead = () => Promise.reject(new Error('shell unavailable'));
+  const failed = await mount();
+  await failed.unmount();
+
+  pendingRead = () => new Promise(() => undefined);
+  try {
+    const next = await mount();
+    expect(next.container.textContent).not.toContain('Paired server');
+    await next.unmount();
+  } finally {
+    pendingRead = null;
+  }
+});
