+    </form>
+  ) : null;
+
+  return (
+    <>
+      <button
+        type="button"
+        className={cn(MOBILE_HEADER_BUTTON_CLASS, hasAttention && 'gap-0.5 text-[var(--status-warning)]')}
+        aria-label={hasAttention
+          ? t(attentionCount === 1 ? 'instanceAttention.ariaOne' : 'instanceAttention.ariaMany', { count: attentionCount })
+          : t('instanceAttention.list.title')}
+        aria-haspopup="dialog"
+        aria-expanded={open}
+        onClick={() => onOpenChange(true)}
+      >
+        <Icon name="notification-3" className="size-5" />
+        {hasAttention ? (
+          <span
+            data-instance-attention-badge
+            aria-hidden="true"
+            className="inline-flex h-4 min-w-4 items-center justify-center rounded-full bg-[var(--status-warning-background)] px-1 typography-micro font-medium tabular-nums text-[var(--status-warning-text)]"
+          >
+            {attentionCount}
+          </span>
+        ) : null}
+      </button>
+      <MobileOverlayPanel
+        open={open}
+        title={t('instanceAttention.list.title')}
+        onClose={close}
+      >
+        {passwordPrompt ?? (
+          <>
+            {error ? <p className="px-2 pb-1 typography-meta text-[var(--status-error-text)]">{error}</p> : null}
+            <InstanceAttentionList
+              items={items}
+              unreachableLabels={unreachableLabels}
+              onOpen={openItem}
+              row={SheetRow}
+              showTitle={false}
+            />
+          </>
+        )}
+      </MobileOverlayPanel>
+    </>
+  );
+};
