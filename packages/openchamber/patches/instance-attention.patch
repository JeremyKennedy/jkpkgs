+import { afterAll, expect, spyOn, test } from 'bun:test';
+import { Window } from 'happy-dom';
+import type { Session } from '@/lib/opencode/model';
+
+// The admission module listens for endpoint changes from the moment it loads,
+// so the window exists before any app module is imported.
+const dom = new Window({ url: 'http://localhost/' });
+Object.assign(globalThis, { window: dom, document: dom.document, CustomEvent: dom.CustomEvent, Event: dom.Event, localStorage: dom.localStorage });
+const originalFetch = globalThis.fetch;
+const offline = spyOn(globalThis, 'fetch').mockImplementation(async () => Response.json({}));
+
+const { opencodeClient } = await import('@/lib/opencode/client');
+const { getRuntimeApiBaseUrl, getRuntimeKey, switchRuntimeEndpoint } = await import('@/lib/runtime-switch');
+const { useGlobalSessionsStore } = await import('@/stores/useGlobalSessionsStore');
+const { useProjectsStore } = await import('@/stores/useProjectsStore');
+const { useSessionUIStore } = await import('./session-ui-store');
+const { completeSessionOpen, holdSessionOpen } = await import('./pending-session-open');
+
+const session = (id: string, directory: string): Session => ({
+  id,
+  projectID: 'project',
+  directory,
+  title: id,
+  time: { created: 1, updated: 1 },
+  cost: 0,
+  tokens: { input: 0, output: 0, reasoning: 0, cache: { read: 0, write: 0 } },
+});
+
+const originalRuntime = { apiBaseUrl: getRuntimeApiBaseUrl(), runtimeKey: getRuntimeKey() };
+const originalUI = useSessionUIStore.getState();
+const originalProjects = useProjectsStore.getState();
+const originalSessions = useGlobalSessionsStore.getState();
+
+afterAll(() => {
+  offline.mockRestore();
+  globalThis.fetch = originalFetch;
+  switchRuntimeEndpoint(originalRuntime);
+  useSessionUIStore.setState(originalUI, true);
+  useProjectsStore.setState(originalProjects, true);
+  useGlobalSessionsStore.setState(originalSessions, true);
+  dom.close();
+});
+
+test('a switch to the same runtime during admission retries it instead of reporting failure', async () => {
+  switchRuntimeEndpoint({ apiBaseUrl: 'https://relay.test', runtimeKey: 'host:admission-relay' });
+  useProjectsStore.setState({ projects: [{ id: 'repo', path: '/repo' }], hasServerSnapshot: true, serverSnapshotFailed: false });
+  useGlobalSessionsStore.setState({ activeSessions: [], archivedSessions: [], entityById: new Map(), hasLoaded: true });
+  const selected: Array<[string | null, string | null | undefined]> = [];
+  useSessionUIStore.setState({
+    currentSessionId: null,
+    availableWorktreesByProject: new Map(),
+    setCurrentSession: (id, directory) => {
+      selected.push([id, directory]);
+      useSessionUIStore.setState({ currentSessionId: id, currentSessionDirectory: directory ?? null });
+    },
+  });
+
+  const home = spyOn(opencodeClient, 'getFilesystemHomeInfo').mockImplementation(async () => ({ home: '/home/me', chatsRoot: '/home/me/chats' }));
+  let trustRequested: () => void = () => undefined;
+  const trustAsked = new Promise<void>((resolve) => { trustRequested = resolve; });
+  let releaseTrust: () => void = () => undefined;
+  const trustAnswered = new Promise<void>((resolve) => { releaseTrust = resolve; });
+  let trustReads = 0;
+  const read = spyOn(opencodeClient, 'getSessionUnscoped').mockImplementation(async (id: string) => session(id, '/outside'));
+  offline.mockImplementation(async (input) => {
+    const url = new URL(String(input));
+    if (url.pathname === '/api/opencode/trust') {
+      trustReads += 1;
+      if (trustReads === 1) {
+        trustRequested();
+        await trustAnswered;
+      }
+      return Response.json({ directory: '/outside', trusted: true, fingerprint: null, items: [] });
+    }
+    // Admission lists the folder's worktrees first (one batched read): a
+    // plain folder that is no repository has none.
+    if (url.pathname === '/api/git/project-worktrees') {
+      return Response.json({ projects: [{ directory: '/outside', isGitRepository: false, worktrees: [] }] });
+    }
+    if (url.pathname === '/api/projects/session-directory') {
+      return Response.json({ project: { id: 'outside', path: '/outside' } });
+    }
+    return Response.json({});
+  });
+  try {
+    const held = holdSessionOpen({ runtimeKey: 'host:admission-relay', sessionId: 'ses_clicked', directory: '/outside' });
+    const outcome = completeSessionOpen(held);
+    await trustAsked;
+
+    // The direct probe wins while the session's folder is being admitted:
+    // same instance and key, new address.
+    switchRuntimeEndpoint({ apiBaseUrl: 'https://direct.test', runtimeKey: 'host:admission-relay' });
+    releaseTrust();
+
+    expect(await outcome).toBe('opened');
+    expect(selected[0]).toEqual(['ses_clicked', '/outside']);
+  } finally {
+    home.mockRestore();
+    read.mockRestore();
+  }
+});
