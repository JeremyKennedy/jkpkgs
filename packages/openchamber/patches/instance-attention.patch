+/** Attention: every session that needs the user, on this instance and the saved ones. Merged into each locale's main dictionary. */
+export const instanceAttentionI18n = {
+  en: {
+    'instanceAttention.ariaOne': '{count} session is waiting on you',
+    'instanceAttention.ariaMany': '{count} sessions are waiting on you',
+    'instanceAttention.list.title': 'Waiting on you',
+    'instanceAttention.localInstance': 'This instance',
+    'instanceAttention.instancesCountAriaOne': '{count} session on {instance} is waiting on you',
