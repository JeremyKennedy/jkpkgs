+import { afterEach, beforeEach, expect, mock, test } from 'bun:test';
+import React, { act } from 'react';
+import type { Root } from 'react-dom/client';
+import { Window } from 'happy-dom';
+
+import { LOCAL_INSTANCE_ATTENTION_HOST_ID } from '@/lib/instanceAttention';
+import { useInstanceAttentionStore } from '@/stores/useInstanceAttentionStore';
+import type { MobileSavedConnection } from './mobileConnections';
+
+type ConnectInput = {
+  id?: string;
+  candidates?: MobileSavedConnection['candidates'];
+  clientToken?: string;
+  label?: string;
+};
+
+const connections: MobileSavedConnection[] = [
+  {
+    id: 'host-b',
+    label: 'bee',
+    candidates: [{ kind: 'direct', url: 'http://bee.test' }],
+    clientToken: 'token-b',
+    lastUsedAt: 0,
+  },
+  {
+    id: 'host-c',
+    label: 'cedar',
+    candidates: [{ kind: 'direct', url: 'http://cedar.test' }],
+    lastUsedAt: 0,
+  },
+];
+let activeConnectionId: string | null = null;
+let needsLoginFor: string | null = null;
+let failsFor: string | null = null;
+const connectCalls: ConnectInput[] = [];
+const openedSessions: Array<[string, string | null]> = [];
+const openChanges: boolean[] = [];
+const setCurrentSession = mock((sessionId: string, directory: string | null) => {
+  openedSessions.push([sessionId, directory]);
+});
+
+const messages = new Map<string, string>([
+  ['instanceAttention.ariaOne', '{count} session is waiting on you'],
+  ['instanceAttention.ariaMany', '{count} sessions are waiting on you'],
+  ['instanceAttention.list.title', 'Waiting on you'],
+  ['instanceAttention.localInstance', 'This instance'],
+  ['instanceAttention.kind.permission', 'Permission'],
+  ['instanceAttention.kind.question', 'Question'],
+  ['instanceAttention.kind.failed', 'Failed'],
+  ['instanceAttention.kind.unread', 'Unread'],
+  ['instanceAttention.unreachable', 'No answer from {instances}; showing their last known items.'],
+  ['sessions.sidebar.session.untitled', 'Untitled Session'],
+  ['mobile.connect.relay.badge', 'via OpenChamber Relay'],
+  ['mobile.connect.password.label', 'Password'],
+  ['mobile.connect.password.placeholder', 'OpenChamber password'],
+  ['mobile.connect.unlockButton', 'Unlock and connect'],
+  ['mobile.connect.cancelPassword', 'Use another server'],
+  ['mobile.connect.connecting', 'Connecting...'],
+]);
+const translate = (key: string, params?: Record<string, string | number>): string => {
+  let text = messages.get(key) ?? key;
+  for (const [name, value] of Object.entries(params ?? {})) {
+    text = text.replaceAll(`{${name}}`, String(value));
+  }
+  return text;
+};
+
+// The real hook keeps the prompt and the failure in its own state. The mock
+// does the same so the sheet can be checked while a connect stops at a login.
+const useMobileConnectionMock = (onConnected: () => void) => {
+  const [pendingConnection, setPendingConnection] = React.useState<{
+    id: string;
+    label?: string;
+    candidates?: MobileSavedConnection['candidates'];
+  } | null>(null);
+  const [error, setError] = React.useState<string | null>(null);
+  const connect = React.useCallback(async (input: ConnectInput) => {
+    connectCalls.push(input);
+    setError(null);
+    if (failsFor === input.id) {
+      setError('Could not reach that OpenChamber server.');
+      return;
+    }
+    if (needsLoginFor === input.id) {
+      setPendingConnection({ id: input.id ?? '', label: input.label, candidates: input.candidates });
+      return;
+    }
+    activeConnectionId = input.id ?? null;
+    onConnected();
+  }, [onConnected]);
+  const submitPassword = React.useCallback(async (password: string) => {
+    if (!pendingConnection) return;
+    if (password !== 'secret') {
+      setError('Could not unlock that server. Check the password.');
+      return;
+    }
+    activeConnectionId = pendingConnection.id;
+    setPendingConnection(null);
+    onConnected();
+  }, [onConnected, pendingConnection]);
+  const cancelPassword = React.useCallback(() => {
+    setPendingConnection(null);
+    setError(null);
+  }, []);
+  return {
+    connections,
+    connect,
+    pendingConnection,
+    error,
+    isPasswordBusy: false,
+    submitPassword,
+    cancelPassword,
+  };
+};
+
+const actualMobileConnections = await import('./mobileConnections');
+const actualMobileOverlayPanel = await import('@/components/ui/MobileOverlayPanel');
+const actualMobileSheetList = await import('@/components/ui/MobileSheetList');
+const actualMobileHeader = await import('@/components/ui/mobileHeader');
+const actualIcon = await import('@/components/icon/Icon');
+const actualI18n = await import('@/lib/i18n');
+
+mock.module('./mobileConnections', () => ({
+  ...actualMobileConnections,
+  useMobileConnection: useMobileConnectionMock,
+  isActiveRuntimeConnection: (connection: MobileSavedConnection) => connection.id === activeConnectionId,
+}));
+mock.module('@/lib/desktopHostActions', () => ({ activateHost: async () => undefined }));
+let attentionRefreshCalls = 0;
+mock.module('@/hooks/useInstanceAttentionPolling', () => ({
+  requestInstanceAttentionRefresh: async () => { attentionRefreshCalls += 1; },
+}));
+mock.module('@/lib/i18n', () => ({
+  ...actualI18n,
+  useI18n: () => ({ t: translate }),
+}));
+mock.module('@/sync/session-ui-store', () => ({
+  useSessionUIStore: { getState: () => ({ setCurrentSession }) },
+}));
+mock.module('@/components/ui/MobileOverlayPanel', () => ({
+  ...actualMobileOverlayPanel,
+  MobileOverlayPanel: ({ open, title, children }: React.PropsWithChildren<{ open: boolean; title: string }>) => (
+    open ? <div>{title}{children}</div> : null
+  ),
+}));
+mock.module('@/components/ui/MobileSheetList', () => ({
+  ...actualMobileSheetList,
+  MobileSheetRow: ({ children, onClick }: React.PropsWithChildren<{ onClick?: () => void }>) => (
+    <button type="button" onClick={onClick}>{children}</button>
+  ),
+}));
+mock.module('@/components/ui/mobileHeader', () => ({
+  ...actualMobileHeader,
+  MOBILE_HEADER_BUTTON_CLASS: 'header-button',
+}));
+mock.module('@/components/icon/Icon', () => ({
+  ...actualIcon,
+  Icon: () => null,
+}));
+
+const { MobileInstanceAttentionBell } = await import('./MobileInstanceAttentionBell');
+
+let dom: Window;
+let root: Root;
+const globals = new Map<string, PropertyDescriptor | undefined>();
+
+beforeEach(async () => {
+  dom = new Window({ url: 'http://localhost' });
+  const values = {
+    window: dom, document: dom.document, navigator: dom.navigator,
+    Node: dom.Node, Element: dom.Element, HTMLElement: dom.HTMLElement,
+    Event: dom.Event, MouseEvent: dom.MouseEvent, IS_REACT_ACT_ENVIRONMENT: true,
+  };
+  for (const [name, value] of Object.entries(values)) {
+    globals.set(name, Object.getOwnPropertyDescriptor(globalThis, name));
+    Object.defineProperty(globalThis, name, { configurable: true, writable: true, value });
+  }
+  useInstanceAttentionStore.getState().reset();
+  connectCalls.length = 0;
+  attentionRefreshCalls = 0;
+  openedSessions.length = 0;
+  openChanges.length = 0;
+  activeConnectionId = null;
+  needsLoginFor = null;
+  failsFor = null;
+  const host = document.createElement('div');
+  document.body.append(host);
+  const { createRoot } = await import('react-dom/client');
+  root = createRoot(host);
+});
+
+afterEach(async () => {
+  await act(async () => root.unmount());
+  for (const [name, descriptor] of globals) {
+    if (descriptor) Object.defineProperty(globalThis, name, descriptor);
+    else Reflect.deleteProperty(globalThis, name);
+  }
+  globals.clear();
+  await dom.happyDOM.abort();
+  dom.close();
+});
+
+const render = async (open: boolean): Promise<void> => {
+  await act(async () => root.render(
+    <MobileInstanceAttentionBell
+      open={open}
+      onOpenChange={(next) => { openChanges.push(next); }}
+    />,
+  ));
+};
+
+const seed = (): void => {
+  useInstanceAttentionStore.getState().applyPoll('host-b', 'bee', {
+    sessions: [{ id: 'ses_a', directory: '/repo', title: 'Unify sessions', archived: false, idle: 10 }],
+    pending: new Map([['ses_a', { permissions: 1, forms: 0, pages: 0 }]]),
+    busy: new Set(),
+  }, 100);
+};
+
+const findRow = (): HTMLButtonElement | undefined => [...document.querySelectorAll('button')]
+  .find((button) => button.textContent?.includes('Unify sessions'));
+
+const typePassword = async (value: string): Promise<void> => {
+  const input = document.querySelector<HTMLInputElement>('input[type="password"]');
+  if (!input) throw new Error('no password input');
+  const setter = Object.getOwnPropertyDescriptor(dom.HTMLInputElement.prototype, 'value')?.set;
+  setter?.call(input, value);
+  await act(async () => input.dispatchEvent(new Event('input', { bubbles: true })));
+};
+
+const submitPasswordPrompt = async (): Promise<void> => {
+  const form = document.querySelector('form');
+  if (!form) throw new Error('no password form');
+  await act(async () => form.dispatchEvent(new Event('submit', { bubbles: true, cancelable: true })));
+};
+
+test('no bell when nothing waits', async () => {
+  await render(true);
+
+  expect(document.querySelectorAll('button')).toHaveLength(0);
+});
+
+test('the bell shows the count and the sheet lists every waiting session', async () => {
+  seed();
+  await render(true);
+
+  const buttons = [...document.querySelectorAll('button')];
+  const bell = buttons.find((button) => (button.getAttribute('aria-label') || '').includes('waiting on you'));
+  expect(bell?.getAttribute('aria-label')).toBe('1 session is waiting on you');
+  // The badge is a bare number in the corner, the same treatment as desktop.
+  const badge = bell?.querySelector('[data-instance-attention-badge]');
+  expect(badge?.textContent?.trim()).toBe('1');
+  expect(bell?.textContent?.trim()).toBe('1');
+  expect(document.body.textContent).toContain('Waiting on you');
+  expect(document.body.textContent).toContain('Unify sessions');
+  expect(document.body.textContent).toContain('bee');
+  expect(document.body.textContent).toContain('Permission');
+});
+
+test('tapping a row connects that saved server and opens the session', async () => {
+  seed();
+  await render(true);
+
+  const row = findRow();
+  expect(row).toBeDefined();
+  await act(async () => row?.click());
+
+  expect(connectCalls).toEqual([{
+    id: 'host-b',
+    candidates: [{ kind: 'direct', url: 'http://bee.test' }],
+    clientToken: 'token-b',
+    label: 'bee',
+  }]);
+  expect(openedSessions).toEqual([['ses_a', '/repo']]);
+  expect(useInstanceAttentionStore.getState().hosts['host-b']).toBeUndefined();
+  expect(openChanges).toEqual([false]);
+});
+
+test('opening the sheet reads the connections again', async () => {
+  seed();
+  await render(false);
+  expect(attentionRefreshCalls).toBe(0);
+
+  await render(true);
+
+  expect(attentionRefreshCalls).toBe(1);
+});
+
+test('a row on this connection opens the session without connecting', async () => {
