@@ -0,0 +1,147 @@
+import { beforeEach, describe, expect, mock, test } from 'bun:test';
+
+import { LOCAL_INSTANCE_ATTENTION_HOST_ID, type InstanceAttentionItem } from '@/lib/instanceAttention';
+import { useInstanceAttentionStore } from '@/stores/useInstanceAttentionStore';
+
+const activations: string[] = [];
+const openedSessions: Array<[string, string | null]> = [];
+let failNextActivation = false;
+
+const activateHost = mock(async (hostId: string) => {
+  activations.push(hostId);
+  if (failNextActivation) {
+    failNextActivation = false;
+    throw new Error('unreachable');
+  }
+});
+const setCurrentSession = mock((sessionId: string, directory: string | null) => {
+  openedSessions.push([sessionId, directory]);
+});
+
+mock.module('@/lib/desktopHostActions', () => ({ activateHost }));
+mock.module('@/sync/session-ui-store', () => ({
+  useSessionUIStore: { getState: () => ({ setCurrentSession }) },
+}));
+
+const { finishInstanceAttentionJump, openInstanceAttentionItem, openInstanceAttentionItemWith } = await import('./instanceAttentionJump');
+
+const item = (overrides: Partial<InstanceAttentionItem> = {}): InstanceAttentionItem => ({
+  key: 'host-b:ses_a',
+  hostId: 'host-b',
+  hostLabel: 'Build box',
+  sessionId: 'ses_a',
+  directory: '/repo',
+  title: 'Session A',
+  kind: 'permission',
+  at: 10,
+  ...overrides,
+});
+
+beforeEach(() => {
+  activations.length = 0;
+  openedSessions.length = 0;
+  failNextActivation = false;
+  useInstanceAttentionStore.getState().reset();
+});
+
+const seed = (): void => {
+  useInstanceAttentionStore.getState().applyPoll('host-b', 'Build box', {
+    sessions: [{ id: 'ses_a', directory: '/repo', title: 'Session A', archived: false, idle: 10 }],
+    pending: new Map([['ses_a', { permissions: 1, forms: 0, pages: 0 }]]),
+    busy: new Set(),
+  }, 100);
+};
+
+describe('cross-instance attention jump', () => {
+  test('switches to the host, drops it and opens the session', async () => {
+    seed();
+
+    const opened = await openInstanceAttentionItem(item());
+
+    expect(opened).toBe(true);
+    expect(activations).toEqual(['host-b']);
+    expect(openedSessions).toEqual([['ses_a', '/repo']]);
+    expect(useInstanceAttentionStore.getState().hosts['host-b']).toBeUndefined();
+  });
+
+  test('a failed switch keeps the host and does not open a session', async () => {
+    seed();
+    failNextActivation = true;
+
+    const opened = await openInstanceAttentionItem(item());
+
+    expect(opened).toBe(false);
+    expect(openedSessions).toEqual([]);
+    expect(useInstanceAttentionStore.getState().hosts['host-b']).toBeDefined();
+  });
+
+  test('an unreachable host does not switch, keeping its last-known item', async () => {
+    seed();
+    useInstanceAttentionStore.getState().markUnreachable('host-b', 'Build box', 200);
+
+    const opened = await openInstanceAttentionItem(item());
+
+    expect(opened).toBe(false);
+    expect(activations).toEqual([]);
+    expect(openedSessions).toEqual([]);
+    expect(useInstanceAttentionStore.getState().items.map((entry) => entry.sessionId)).toEqual(['ses_a']);
+  });
+
+  test('the guard releases after a failure so the next jump can run', async () => {
+    seed();
+    failNextActivation = true;
+
+    await openInstanceAttentionItem(item());
+    await openInstanceAttentionItem(item());
+
+    expect(activations).toEqual(['host-b', 'host-b']);
+    expect(openedSessions).toEqual([['ses_a', '/repo']]);
+  });
+
+  test('a local item opens the session without switching hosts', async () => {
+    const opened = await openInstanceAttentionItem(item({
+      key: `${LOCAL_INSTANCE_ATTENTION_HOST_ID}:ses_local`,
+      hostId: LOCAL_INSTANCE_ATTENTION_HOST_ID,
+      hostLabel: 'This instance',
+      sessionId: 'ses_local',
+    }));
+
+    expect(opened).toBe(true);
+    expect(activations).toEqual([]);
+    expect(openedSessions).toEqual([['ses_local', '/repo']]);
+  });
+
+  test('the phone supplies its own switch and gets the same open path', async () => {
+    seed();
+    const switched: string[] = [];
+
+    const opened = await openInstanceAttentionItemWith(item(), async (hostId) => {
+      switched.push(hostId);
+      return true;
+    });
+
+    expect(opened).toBe(true);
+    expect(switched).toEqual(['host-b']);
+    expect(openedSessions).toEqual([['ses_a', '/repo']]);
+    expect(useInstanceAttentionStore.getState().hosts['host-b']).toBeUndefined();
+  });
+
+  test('a switch that stopped at a password prompt keeps the host and opens nothing', async () => {
+    seed();
+
+    const opened = await openInstanceAttentionItemWith(item(), async () => false);
+
+    expect(opened).toBe(false);
+    expect(openedSessions).toEqual([]);
+    expect(useInstanceAttentionStore.getState().hosts['host-b']).toBeDefined();
+  });
+
+  test('finishing a deferred switch drops the host and opens the session', () => {
+    seed();
+
+    finishInstanceAttentionJump(item());
+
+    expect(openedSessions).toEqual([['ses_a', '/repo']]);
+    expect(useInstanceAttentionStore.getState().hosts['host-b']).toBeUndefined();
+  });
+});
diff --git a/packages/ui/src/lib/instanceAttentionJump.ts b/packages/ui/src/lib/instanceAttentionJump.ts
new file mode 100644
index 000000000..90c331ad9
--- /dev/null
+++ b/packages/ui/src/lib/instanceAttentionJump.ts
@@ -0,0 +1,78 @@
+import { activateHost } from '@/lib/desktopHostActions';
+import { isLocalInstanceAttentionHost, type InstanceAttentionItem } from '@/lib/instanceAttention';
+import { useInstanceAttentionStore } from '@/stores/useInstanceAttentionStore';
+import { useSessionUIStore } from '@/sync/session-ui-store';
+
+// One switch-and-open path for every cross-instance attention surface: a row
+// in the desktop instance panel and a row in the phone's attention sheet. Only
+// one jump runs at a time, so two surfaces cannot start overlapping runtime
+// switches.
+
+let opening = false;
+
+/**
+ * Drops the server and opens its session once the switch is known to have
+ * happened. The phone's password unlock reaches this after its own switch, so
+ * a prompt that stopped the first attempt does not leave the item behind.
+ */
+export const finishInstanceAttentionJump = (item: InstanceAttentionItem): void => {
+  useInstanceAttentionStore.getState().dropHost(item.hostId);
+  useSessionUIStore.getState().setCurrentSession(item.sessionId, item.directory);
+};
+
+/**
+ * Switches this window to the item's server and opens its session. The switch
+ * is supplied by the shell: desktop activates a saved host, mobile connects a
+ * saved connection. It answers whether the switch really happened; a server
+ * that stopped at a password prompt keeps its items and the surface stays open.
+ * A successful switch drops the server at once: it is the active instance now,
+ * not an "other" one.
+ */
+export const openInstanceAttentionItemWith = async (
+  item: InstanceAttentionItem,
+  switchToHost: (hostId: string) => Promise<boolean>,
+): Promise<boolean> => {
+  if (opening) return false;
+  opening = true;
+  let switched = false;
+  try {
+    switched = await switchToHost(item.hostId);
+  } catch (error) {
+    console.warn('[instance-attention] host switch failed', error);
+    return false;
+  } finally {
+    opening = false;
+  }
+  if (!switched) return false;
+  finishInstanceAttentionJump(item);
+  return true;
+};
+
+/**
+ * Opens a waiting session that lives on the instance this window already
+ * shows. There is nothing to switch to, so it goes straight to the session;
+ * its item clears on its own once the session is read or the request answered.
+ */
+export const openLocalInstanceAttentionItem = (item: InstanceAttentionItem): void => {
+  useSessionUIStore.getState().setCurrentSession(item.sessionId, item.directory);
+};
+
+/**
+ * The desktop shell's switch-and-open path. A host whose last poll failed still
+ * shows its last-known items, so the row is tappable; switching blind would
+ * move the window onto an instance that is not answering. The guard leaves the
+ * surface and its unreachable note in place instead.
+ */
+export const openInstanceAttentionItem = (item: InstanceAttentionItem): Promise<boolean> => {
+  if (isLocalInstanceAttentionHost(item.hostId)) {
+    openLocalInstanceAttentionItem(item);
+    return Promise.resolve(true);
+  }
+  if (useInstanceAttentionStore.getState().hosts[item.hostId]?.status === 'error') {
+    return Promise.resolve(false);
+  }
+  return openInstanceAttentionItemWith(item, async (hostId) => {
+    await activateHost(hostId);
+    return true;
+  });
+};
