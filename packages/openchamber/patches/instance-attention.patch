+import { MOBILE_HEADER_BUTTON_CLASS } from '@/components/ui/mobileHeader';
+import {
+  InstanceAttentionList,
+  type InstanceAttentionListRowProps,
+} from '@/components/instance-attention/InstanceAttentionList';
+import { requestInstanceAttentionRefresh } from '@/hooks/useInstanceAttentionPolling';
+import { isLocalInstanceAttentionHost, type InstanceAttentionItem } from '@/lib/instanceAttention';
+import {
+  finishInstanceAttentionJump,
