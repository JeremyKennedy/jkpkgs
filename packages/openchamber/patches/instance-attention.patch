@@ -0,0 +1,30 @@
+import React from 'react';
+
+import { Icon } from '@/components/icon/Icon';
+import { useI18n } from '@/lib/i18n';
+import { useInstanceAttentionStore } from '@/stores/useInstanceAttentionStore';
+
+/**
+ * How many sessions on one saved server wait for the user. A secondary signal
+ * in the instances list; the header bell is the primary surface.
+ */
+export const MobileInstanceAttentionBadge: React.FC<{
+  hostId: string;
+  label: string;
+}> = ({ hostId, label }) => {
+  const { t } = useI18n();
+  const count = useInstanceAttentionStore((state) => state.items.reduce(
+    (total, item) => (item.hostId === hostId ? total + 1 : total),
+    0,
+  ));
+  if (count === 0) return null;
+  return (
+    <span
+      aria-label={t(count === 1 ? 'instanceAttention.instancesCountAriaOne' : 'instanceAttention.instancesCountAriaMany', { count, instance: label })}
+      className="inline-flex shrink-0 items-center gap-1 rounded-full bg-[var(--status-warning-background)] px-1.5 py-0.5 typography-micro font-medium tabular-nums text-[var(--status-warning-text)]"
+    >
+      <Icon name="notification-3" className="size-3" />
+      {count}
+    </span>
+  );
+};
