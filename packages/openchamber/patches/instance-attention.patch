+import { afterEach, expect, mock, test } from 'bun:test';
+import React, { act } from 'react';
+import { createRoot } from 'react-dom/client';
+import { Window } from 'happy-dom';
+import type { DesktopHost, HostProbeResult } from '@/lib/desktopHosts';
+
+const dom = new Window({ url: 'http://localhost/' });
+Object.assign(globalThis, {
+  window: dom, document: dom.document, navigator: dom.navigator,
+  Node: dom.Node, Element: dom.Element, HTMLElement: dom.HTMLElement,
+  Event: dom.Event, MouseEvent: dom.MouseEvent, IS_REACT_ACT_ENVIRONMENT: true,
+  localStorage: dom.localStorage,
+  requestAnimationFrame: dom.requestAnimationFrame.bind(dom),
+  cancelAnimationFrame: dom.cancelAnimationFrame.bind(dom),
+  getComputedStyle: dom.getComputedStyle.bind(dom),
+});
+
+type UiStub = { setSettingsDialogOpen: () => void; setSettingsPage: () => void };
+mock.module('@/stores/useUIStore', () => ({
+  useUIStore: <T,>(select: (state: UiStub) => T): T => (
+    select({ setSettingsDialogOpen: () => undefined, setSettingsPage: () => undefined })
+  ),
+}));
+mock.module('@/stores/useConfigStore', () => ({
+  useConfigStore: <T,>(select: (state: { isConnected: boolean }) => T): T => select({ isConnected: true }),
+}));
+mock.module('@/components/ui', () => ({ toast: { error() {} } }));
+
+const host: DesktopHost = {
+  id: 'paired',
+  label: 'Paired server',
+  url: 'http://192.0.2.10:3000',
+  apiUrl: 'http://192.0.2.10:3000',
+};
+let probeCalls = 0;
+let attentionRefreshCalls = 0;
+
+const desktop = await import('@/lib/desktop');
+mock.module('@/lib/desktop', () => ({ ...desktop, isDesktopShell: () => true, isElectronShell: () => true }));
+const hosts = await import('@/lib/desktopHosts');
+mock.module('@/lib/desktopHosts', () => ({
+  ...hosts,
+  desktopHostsGet: async () => ({ hosts: [host], defaultHostId: 'local', localOrigin: 'http://localhost' }),
+  desktopLocalClientTokenGet: async () => 'local-token',
+  desktopHostProbe: async (): Promise<HostProbeResult> => {
+    probeCalls += 1;
+    return { status: 'ok', latencyMs: 1 };
+  },
+  probeRelayDesktopHost: async (): Promise<HostProbeResult> => ({ status: 'ok', latencyMs: 1 }),
+}));
+const ssh = await import('@/lib/desktopSsh');
+mock.module('@/lib/desktopSsh', () => ({ ...ssh, desktopSshInstancesGet: async () => ({ instances: [] }), desktopSshStatus: async () => [] }));
+const runtime = await import('@/lib/runtime-switch');
+mock.module('@/lib/runtime-switch', () => ({
+  ...runtime, switchRuntimeEndpoint: () => undefined,
+}));
+mock.module('@/lib/desktopRelayRestore', () => ({ scheduleDesktopHostCandidateRefresh: () => undefined }));
+mock.module('@/hooks/useInstanceAttentionPolling', () => ({
+  requestInstanceAttentionRefresh: async () => { attentionRefreshCalls += 1; },
+}));
+
+const { I18nProvider } = await import('@/lib/i18n');
+const { DesktopHostSwitcherDialog } = await import('./DesktopHostSwitcher');
+
+const flush = async () => {
+  for (let turn = 0; turn < 4; turn += 1) await new Promise<void>((resolve) => setTimeout(resolve, 0));
+};
+
+afterEach(async () => {
+  await dom.happyDOM.close();
+});
+
+test('opening the panel and its refresh button each read the waiters', async () => {
+  const container = document.createElement('div');
+  document.body.append(container);
+  const mounted = createRoot(container);
+  try {
+    const refreshesBefore = attentionRefreshCalls;
+    await act(async () => {
+      mounted.render(<I18nProvider><DesktopHostSwitcherDialog open embedded onOpenChange={() => undefined} /></I18nProvider>);
+      await flush();
+    });
+    expect(attentionRefreshCalls).toBe(refreshesBefore + 1);
+
+    const probesAfterOpen = probeCalls;
+    const refreshButton = container.querySelector<HTMLButtonElement>('[aria-label="Refresh instances"]');
+    expect(refreshButton).not.toBeNull();
+    await act(async () => {
+      refreshButton!.click();
+      await flush();
+    });
+
+    expect(attentionRefreshCalls).toBe(refreshesBefore + 2);
+    expect(probeCalls).toBeGreaterThan(probesAfterOpen);
+  } finally {
+    await act(async () => mounted.unmount());
+  }
+});
