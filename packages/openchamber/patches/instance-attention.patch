+// ---------------------------------------------------------------------------
+// Wire reads
+// ---------------------------------------------------------------------------
+
+// A bounded newest-first page. Pending requests and recent turns are near the
+// top; an older unread turn beyond this page is not counted until it moves up.
+export const INSTANCE_ATTENTION_SESSION_LIMIT = 200;
+
+const sessionListRecordSchema = z.object({
+  id: z.string().min(1),
+  parentID: z.string().optional(),
+  location: z.object({ directory: z.string() }).passthrough().optional(),
+  title: z.string().optional(),
+  outcome: z.enum(['succeeded', 'failed', 'interrupted']).optional(),
+  time: z.object({
+    idle: z.number().optional(),
+    viewed: z.number().optional(),
+    archived: z.number().optional(),
+    updated: z.number().optional(),
+  }).passthrough().optional(),
+}).passthrough();
+
+const sessionListSchema = z.union([
+  z.object({ data: z.array(sessionListRecordSchema) }).passthrough(),
+  z.array(sessionListRecordSchema),
