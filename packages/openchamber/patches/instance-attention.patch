+  for (const snapshot of snapshots) {
+    const sessionsById = new Map(snapshot.sessions.map((session) => [session.id, session]));
+    for (const session of snapshot.sessions) {
+      if (session.archived) continue;
+      const pendingKind = pendingKindOf(snapshot.pending.get(session.id));
+      if (session.parentID) {
+        if (!pendingKind) continue;
+        const owner = topLevelOwner(session, sessionsById);
+        if (owner.archived) continue;
+        addItem(snapshot, owner, pendingKind, Math.max(atOf(owner), atOf(session)));
+        continue;
+      }
+      const kind = pendingKind ?? kindOf(session, snapshot.busy);
+      if (!kind) continue;
+      addItem(snapshot, session, kind, atOf(session));
+    }
+    // A permission or question can name a session the bounded list did not
+    // return. Its directory is unknown here, but the session's own detail
+    // read resolves it when the user opens the item.
+    for (const [sessionId, pending] of snapshot.pending) {
+      if (sessionsById.has(sessionId)) continue;
+      const kind = pendingKindOf(pending);
+      if (!kind) continue;
+      addItem(snapshot, {
+        id: sessionId,
+        directory: null,
+        title: '',
+        archived: false,
+      }, kind, 0);
+    }
+  }
+  return [...itemsByKey.values()].sort((left, right) => (
+    KIND_ORDER[left.kind] - KIND_ORDER[right.kind]
+    || right.at - left.at
+    || left.key.localeCompare(right.key)
+  ));
+};
