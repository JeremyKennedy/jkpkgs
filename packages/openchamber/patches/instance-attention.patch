+} from '@/lib/instanceAttention';
+import {
+  finishInstanceAttentionJump,
+  openInstanceAttentionItemWith,
+  openLocalInstanceAttentionItem,
+  releaseInstanceAttentionHold,
+} from '@/lib/instanceAttentionJump';
+import { useI18n } from '@/lib/i18n';
+import { cn } from '@/lib/utils';
+import { useInstanceAttentionStore } from '@/stores/useInstanceAttentionStore';
+
+import {
+  connectionDisplayUrl,
+  isActiveRuntimeConnection,
+  isRelayOnly,
+  secureTokenKeyOf,
+  useMobileConnection,
+} from './mobileConnections';
+import { mobileConnectionInputClass, mobileInputKeyboardProps } from './mobileConnectionUi';
+
+const SheetRow = ({ item, onOpen, children }: InstanceAttentionListRowProps): React.ReactNode => (
+  <MobileSheetRow onClick={() => onOpen(item)}>
+    {children}
+  </MobileSheetRow>
+);
+
+/**
+ * The phone's attention surface: a header bell with a count and a bottom sheet
+ * listing every waiting session, this connection's own included. The rows and
+ * the open path are the desktop ones; only the shell differs. Tapping a row on
+ * this connection opens its session, and tapping one on another saved server
+ * connects that server and opens the session.
+ *
+ * A server that needs a login stops the switch at a password prompt. The sheet
+ * keeps the prompt and the failure in place, so the tap is never a silent
+ * no-op: unlock here and the waiting session opens; cancel to pick another row.
+ */
+export const MobileInstanceAttentionBell: React.FC<{
+  open: boolean;
+  onOpenChange: (open: boolean) => void;
+}> = ({ open, onOpenChange }) => {
+  const { t } = useI18n();
+  const items = useInstanceAttentionStore((state) => state.items);
+  const hosts = useInstanceAttentionStore((state) => state.hosts);
+  const [password, setPassword] = React.useState('');
+  const pendingItemRef = React.useRef<InstanceAttentionItem | null>(null);
+  const tapInFlightRef = React.useRef(false);
+  // A close requested from one path must not be repeated by the empty-list
+  // effect while the parent is still catching up.
+  const closingRef = React.useRef(false);
+
+  const requestClose = React.useCallback(() => {
+    if (closingRef.current) return;
+    closingRef.current = true;
+    onOpenChange(false);
+  }, [onOpenChange]);
+
+  // The sheet is opened to act on the waiters, so read them when it opens
+  // instead of showing whatever the last tick found on the other connections.
+  React.useEffect(() => {
+    if (!open) return;
+    void requestInstanceAttentionRefresh();
+  }, [open]);
+
+  const finishPendingJump = React.useCallback(() => {
+    const item = pendingItemRef.current;
+    if (!item) return;
+    pendingItemRef.current = null;
+    setPassword('');
+    finishInstanceAttentionJump(item);
+    requestClose();
+  }, [requestClose]);
+
+  const {
+    connections,
+    connect,
+    pendingConnection,
+    error,
+    isPasswordBusy,
+    submitPassword,
+    cancelPassword,
+  } = useMobileConnection(() => {
+    // A direct connect finishes inside the tap's own switch function, which
+    // owns closing the sheet. Only the password unlock reaches here alone.
+    if (tapInFlightRef.current) return;
+    finishPendingJump();
+  });
+
+  const clearPending = React.useCallback(() => {
+    if (pendingItemRef.current) releaseInstanceAttentionHold(pendingItemRef.current);
+    pendingItemRef.current = null;
+    setPassword('');
+    if (pendingConnection) cancelPassword();
+  }, [cancelPassword, pendingConnection]);
+
+  React.useEffect(() => {
+    if (open) return;
+    clearPending();
+  }, [open, clearPending]);
+
+  const unreachableLabels = React.useMemo(
+    () => collectUnreachableInstanceLabels(hosts),
+    [hosts],
+  );
+
+  const openItem = React.useCallback((item: InstanceAttentionItem) => {
+    // This phone's own connection needs no connect: opening the session is the
+    // whole jump, exactly as it is on the desktop.
+    if (isLocalInstanceAttentionHost(item.hostId)) {
+      openLocalInstanceAttentionItem(item);
+      requestClose();
+      return;
+    }
+    // A failed poll keeps the last-known rows; tapping one would connect blind.
+    // Keep the sheet and its note in place instead, as the desktop menu does.
+    if (hosts[item.hostId]?.status === 'error') return;
+    pendingItemRef.current = item;
+    tapInFlightRef.current = true;
+    const connection = connections.find((entry) => entry.id === item.hostId);
+    void openInstanceAttentionItemWith(item, async () => {
+      if (!connection) {
+        // Removed elsewhere: drop the row instead of leaving a dead tap target.
+        useInstanceAttentionStore.getState().dropHost(item.hostId);
+        return false;
+      }
+      await connect({
+        id: connection.id,
+        candidates: connection.candidates,
+        clientToken: connection.clientToken,
+        label: connection.label,
+      });
+      // `connect` resolves even when it stopped at a password prompt or failed.
+      // The jump only happened when the runtime really is that connection.
+      return isActiveRuntimeConnection(connection);
+    }, connection ? secureTokenKeyOf(connection) : undefined, { keepHoldWhenStopped: true }).then((opened) => {
+      tapInFlightRef.current = false;
+      if (!opened) return;
+      pendingItemRef.current = null;
+      setPassword('');
+      requestClose();
+    });
+  }, [connect, connections, hosts, requestClose]);
+
+  const close = React.useCallback(() => {
+    clearPending();
+    requestClose();
+  }, [clearPending, requestClose]);
+
+  const attentionCount = countInstanceAttentionItems(items);
+  // The bell stays neutral and unnumbered while nothing waits; an unreachable
+  // server alone still opens the sheet that carries its note.
+  const hasAttention = attentionCount > 0;
+
+  const hasUnreachable = unreachableLabels.length > 0;
+
+  // The sheet is only opened for waiting sessions or an unreachable note; when
+  // both clear, close it instead of leaving an empty panel that the next item
+  // reopens.
+  React.useEffect(() => {
+    if (!open) {
+      closingRef.current = false;
+      return;
+    }
+    if (attentionCount === 0 && !hasUnreachable) requestClose();
+  }, [attentionCount, hasUnreachable, open, requestClose]);
+
+  if (attentionCount === 0 && !hasUnreachable) return null;
+
+  const passwordPrompt = pendingConnection ? (
+    <form
+      className="flex flex-col gap-3 px-1 pb-1"
+      onSubmit={(event) => {
+        event.preventDefault();
+        void submitPassword(password);
+      }}
+    >
+      <div className="oc-tile rounded-xl p-4">
+        <p className="truncate typography-ui-label font-semibold text-foreground">{pendingConnection.label}</p>
+        <p className="truncate typography-meta text-muted-foreground">
+          {isRelayOnly(pendingConnection) ? t('mobile.connect.relay.badge') : connectionDisplayUrl(pendingConnection)}
+        </p>
+      </div>
+      <input
+        {...mobileInputKeyboardProps}
+        value={password}
+        onChange={(event) => setPassword(event.target.value)}
+        placeholder={t('mobile.connect.password.placeholder')}
+        aria-label={t('mobile.connect.password.label')}
+        type="password"
+        autoFocus
+        className={mobileConnectionInputClass}
+      />
+      {error ? <p className="px-1 typography-meta text-[var(--status-error-text)]">{error}</p> : null}
+      <div className="flex items-center justify-end gap-2">
+        <Button type="button" variant="ghost" onClick={clearPending}>
+          {t('mobile.connect.cancelPassword')}
