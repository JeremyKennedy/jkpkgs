+import { afterEach, beforeEach, describe, expect, mock, spyOn, test } from 'bun:test';
+
+import { toast } from '@/components/ui';
+import { LOCAL_HOST_ID } from '@/lib/desktopCurrentHost';
+import { LOCAL_INSTANCE_ATTENTION_HOST_ID, type InstanceAttentionItem } from '@/lib/instanceAttention';
+import type { Session } from '@/lib/opencode/model';
+import { OpencodeApiError, opencodeClient } from '@/lib/opencode/client';
+import { getRuntimeApiBaseUrl, getRuntimeKey, switchRuntimeEndpoint } from '@/lib/runtime-switch';
+import { useGlobalSessionsStore } from '@/stores/useGlobalSessionsStore';
+import { useInstanceAttentionStore } from '@/stores/useInstanceAttentionStore';
+import { useProjectsStore } from '@/stores/useProjectsStore';
+import { heldSessionOpen, type HeldSessionOpen } from '@/sync/pending-session-open';
+
+type Held = HeldSessionOpen;
+
+const activations: string[] = [];
+const localActivations: boolean[] = [];
+const openedSessions: Array<[string, string | null]> = [];
+const heldAtSwitch: Array<Held | null> = [];
+let openWaiters: Array<() => void> = [];
+const nextOpen = () => new Promise<void>((resolve) => { openWaiters.push(resolve); });
+let sessionRead: ReturnType<typeof spyOn> | null = null;
+let readSession: (id: string) => Promise<Session> = async (id) => session(id);
+let failNextActivation = false;
+let nextLocalSwitch = true;
+// What a saved host's activation does: switch the window and say so, or stop
+// without switching (a relay restore that bailed) and say that.
+let hostSwitches = true;
+
+const moveTo = (runtimeKey: string) => {
+  switchRuntimeEndpoint({ apiBaseUrl: `https://${runtimeKey.replace(':', '-')}.test`, runtimeKey });
+};
+
+const activateHost = mock(async (hostId: string) => {
+  activations.push(hostId);
+  heldAtSwitch.push(heldSessionOpen());
+  if (failNextActivation) {
+    failNextActivation = false;
+    throw new Error('unreachable');
+  }
+  if (!hostSwitches) return false;
+  moveTo(`host:${hostId}`);
+  return true;
+});
+const activateLocalHost = mock(async () => {
+  localActivations.push(true);
+  heldAtSwitch.push(heldSessionOpen());
+  if (nextLocalSwitch) moveTo('local');
+  return nextLocalSwitch;
+});
+const setCurrentSession = mock((sessionId: string, directory: string | null) => {
+  openedSessions.push([sessionId, directory]);
+  const waiters = openWaiters;
+  openWaiters = [];
+  for (const resolve of waiters) resolve();
+});
+
+mock.module('@/lib/desktopHostActions', () => ({ activateHost, activateLocalHost }));
+mock.module('@/sync/session-ui-store', () => ({
+  getAdmissionNavigationRevision: () => 0,
+  useSessionUIStore: {
+    subscribe: () => () => undefined,
+    getState: () => ({
+      setCurrentSession,
+      currentSessionId: null,
+      currentSessionDirectory: null,
+      getDirectoryForSession: () => null,
+      availableWorktreesByProject: new Map(),
+    }),
+  },
+}));
+
+const { finishInstanceAttentionJump, openInstanceAttentionItem, openInstanceAttentionItemWith } = await import('./instanceAttentionJump');
+
+const item = (overrides: Partial<InstanceAttentionItem> = {}): InstanceAttentionItem => ({
+  key: 'host-b:ses_a',
+  hostId: 'host-b',
+  hostLabel: 'Build box',
+  sessionId: 'ses_a',
+  directory: '/repo',
+  title: 'Session A',
+  kind: 'permission',
+  at: 10,
+  ...overrides,
+});
+
+const localItem = () => item({
+  key: `${LOCAL_HOST_ID}:ses_navi`,
+  hostId: LOCAL_HOST_ID,
+  hostLabel: 'Local',
+  sessionId: 'ses_navi',
+});
+
+const originalRuntime = { apiBaseUrl: getRuntimeApiBaseUrl(), runtimeKey: getRuntimeKey() };
+const originalProjects = useProjectsStore.getState();
+const originalSessions = useGlobalSessionsStore.getState();
+
+const session = (id: string): Session => ({
+  id,
+  projectID: 'project',
+  directory: '/repo',
+  title: id,
+  time: { created: 1, updated: 1 },
+  cost: 0,
+  tokens: { input: 0, output: 0, reasoning: 0, cache: { read: 0, write: 0 } },
+});
+
+beforeEach(() => {
+  activations.length = 0;
+  localActivations.length = 0;
+  openedSessions.length = 0;
+  heldAtSwitch.length = 0;
+  openWaiters = [];
+  failNextActivation = false;
+  nextLocalSwitch = true;
+  hostSwitches = true;
+  moveTo('host:start');
+  useInstanceAttentionStore.getState().reset();
+  readSession = async (id) => session(id);
+  sessionRead = spyOn(opencodeClient, 'getSessionUnscoped').mockImplementation((id: string) => readSession(id));
+  // What the instance switched to has loaded: its projects and its sessions.
+  useProjectsStore.setState({ projects: [{ id: 'repo', path: '/repo' }], hasServerSnapshot: true, serverSnapshotFailed: false });
+  useGlobalSessionsStore.setState({
+    hasLoaded: true,
+    status: 'ready',
+    activeSessions: [session('ses_a'), session('ses_navi')],
+    archivedSessions: [],
+  });
+});
+
+afterEach(() => {
+  sessionRead?.mockRestore();
+  switchRuntimeEndpoint(originalRuntime);
+  useProjectsStore.setState(originalProjects, true);
+  useGlobalSessionsStore.setState(originalSessions, true);
+});
+
+const seed = (): void => {
+  useInstanceAttentionStore.getState().applyPoll('host-b', 'Build box', {
+    sessions: [{ id: 'ses_a', directory: '/repo', title: 'Session A', archived: false, idle: 10 }],
+    pending: new Map([['ses_a', { permissions: 1, forms: 0, pages: 0 }]]),
+    busy: new Set(),
+  }, 100);
+};
+
+const seedLocal = (): void => {
+  useInstanceAttentionStore.getState().applyPoll(LOCAL_HOST_ID, 'Local', {
+    sessions: [{ id: 'ses_navi', directory: '/repo', title: 'Session Navi', archived: false, idle: 10 }],
+    pending: new Map([['ses_navi', { permissions: 1, forms: 0, pages: 0 }]]),
+    busy: new Set(),
+  }, 100);
+};
+
+describe('cross-instance attention jump', () => {
+  test('holds the session for the host before switching, then opens it there', async () => {
+    seed();
+    const sessionOpened = nextOpen();
+
+    const opened = await openInstanceAttentionItem(item());
+
+    expect(opened).toBe(true);
+    expect(activations).toEqual(['host-b']);
+    // Held before the switch, so the switch does not restore that host's last session.
+    expect(heldAtSwitch.map((entry) => entry?.runtimeKey)).toEqual(['host:host-b']);
+    expect(useInstanceAttentionStore.getState().hosts['host-b']).toBeUndefined();
+    await sessionOpened;
+    expect(openedSessions).toEqual([['ses_a', '/repo']]);
+    expect(heldSessionOpen()).toBeNull();
+  });
+
+  test('an activation that did not switch is not a jump', async () => {
+    seed();
+    hostSwitches = false;
+
+    const opened = await openInstanceAttentionItem(item());
+
+    expect(opened).toBe(false);
+    expect(getRuntimeKey()).toBe('host:start');
+    expect(openedSessions).toEqual([]);
+    expect(heldSessionOpen()).toBeNull();
+    expect(useInstanceAttentionStore.getState().hosts['host-b']).toBeDefined();
+  });
+
+  test('a switch that says it happened but left another runtime active is not a jump', async () => {
+    seed();
+    const opened = await openInstanceAttentionItemWith(item(), async () => true, 'host:host-b');
+
+    expect(opened).toBe(false);
+    expect(openedSessions).toEqual([]);
+    expect(heldSessionOpen()).toBeNull();
+    expect(useInstanceAttentionStore.getState().hosts['host-b']).toBeDefined();
+  });
+
+  test('a failed switch keeps the host and does not open a session', async () => {
+    seed();
+    failNextActivation = true;
+
+    const opened = await openInstanceAttentionItem(item());
+
+    expect(opened).toBe(false);
+    expect(openedSessions).toEqual([]);
+    expect(heldSessionOpen()).toBeNull();
+    expect(useInstanceAttentionStore.getState().hosts['host-b']).toBeDefined();
+  });
+
+  test('an unreachable host does not switch, keeping its last-known item', async () => {
+    seed();
+    useInstanceAttentionStore.getState().markUnreachable('host-b', 'Build box', 200);
+
+    const opened = await openInstanceAttentionItem(item());
+
+    expect(opened).toBe(false);
+    expect(activations).toEqual([]);
+    expect(openedSessions).toEqual([]);
+    expect(useInstanceAttentionStore.getState().items.map((entry) => entry.sessionId)).toEqual(['ses_a']);
+  });
+
+  test('the guard releases after a failure so the next jump can run', async () => {
+    seed();
+    failNextActivation = true;
+    const sessionOpened = nextOpen();
+
+    await openInstanceAttentionItem(item());
+    await openInstanceAttentionItem(item());
+
+    expect(activations).toEqual(['host-b', 'host-b']);
+    await sessionOpened;
+    expect(openedSessions).toEqual([['ses_a', '/repo']]);
+  });
+
+  test('a session the new instance cannot open says so', async () => {
+    seed();
+    readSession = async () => { throw new OpencodeApiError('session.get', 'Session not found', { status: 404 }); };
+    let shown: (message: string) => void = () => undefined;
+    const toastShown = new Promise<string>((resolve) => { shown = resolve; });
+    const error = spyOn(toast, 'error').mockImplementation((message) => { shown(String(message)); return 0; });
+    try {
+      expect(await openInstanceAttentionItem(item({ sessionId: 'ses_gone' }))).toBe(true);
+
+      expect(await toastShown).toContain('Build box');
+      expect(openedSessions).toEqual([]);
+    } finally {
+      error.mockRestore();
+    }
+  });
+
+  test('a local item opens the session without switching hosts', async () => {
+    const opened = await openInstanceAttentionItem(item({
+      key: `${LOCAL_INSTANCE_ATTENTION_HOST_ID}:ses_local`,
+      hostId: LOCAL_INSTANCE_ATTENTION_HOST_ID,
+      hostLabel: 'This instance',
+      sessionId: 'ses_local',
+    }));
+
+    expect(opened).toBe(true);
+    expect(activations).toEqual([]);
+    expect(openedSessions).toEqual([['ses_local', '/repo']]);
+  });
+
+  test('an item from the app own server switches back to Local and opens the session', async () => {
+    seedLocal();
+    const sessionOpened = nextOpen();
+
+    const opened = await openInstanceAttentionItem(localItem());
+
+    expect(opened).toBe(true);
+    // Local is not a saved host, so it goes through the shell's own switch.
+    expect(activations).toEqual([]);
+    expect(localActivations).toEqual([true]);
+    expect(heldAtSwitch.map((entry) => entry?.runtimeKey)).toEqual(['local']);
+    await sessionOpened;
+    expect(openedSessions).toEqual([['ses_navi', '/repo']]);
+    expect(useInstanceAttentionStore.getState().hosts[LOCAL_HOST_ID]).toBeUndefined();
+  });
+
+  test('a Local switch that did not happen keeps the item', async () => {
+    seedLocal();
+    nextLocalSwitch = false;
+
+    const opened = await openInstanceAttentionItem(localItem());
+
+    expect(opened).toBe(false);
+    expect(openedSessions).toEqual([]);
+    expect(heldSessionOpen()).toBeNull();
+    expect(useInstanceAttentionStore.getState().hosts[LOCAL_HOST_ID]).toBeDefined();
+  });
+
+  test('the phone supplies its own switch and gets the same open path', async () => {
+    seed();
+    const switched: string[] = [];
+    const sessionOpened = nextOpen();
+
+    const opened = await openInstanceAttentionItemWith(item(), async (hostId) => {
+      switched.push(hostId);
+      moveTo('phone:host-b');
+      return true;
+    }, 'phone:host-b');
+
+    expect(opened).toBe(true);
+    expect(switched).toEqual(['host-b']);
+    await sessionOpened;
+    expect(openedSessions).toEqual([['ses_a', '/repo']]);
+    expect(useInstanceAttentionStore.getState().hosts['host-b']).toBeUndefined();
+  });
+
+  test('a switch that stopped at a password prompt keeps the host and opens nothing', async () => {
+    seed();
+
+    const opened = await openInstanceAttentionItemWith(item(), async () => false, 'phone:host-b');
+
+    expect(opened).toBe(false);
+    expect(openedSessions).toEqual([]);
+    expect(heldSessionOpen()).toBeNull();
+    expect(useInstanceAttentionStore.getState().hosts['host-b']).toBeDefined();
+  });
+
+  test('finishing a deferred switch drops the host and opens the session on the runtime now shown', async () => {
+    seed();
+    moveTo('phone:host-b');
+    const sessionOpened = nextOpen();
+
+    finishInstanceAttentionJump(item());
+
+    expect(useInstanceAttentionStore.getState().hosts['host-b']).toBeUndefined();
+    await sessionOpened;
+    expect(openedSessions).toEqual([['ses_a', '/repo']]);
+  });
+});
diff --git a/packages/ui/src/lib/instanceAttentionJump.ts b/packages/ui/src/lib/instanceAttentionJump.ts
new file mode 100644
index 000000000..9752031ee
--- /dev/null
+++ b/packages/ui/src/lib/instanceAttentionJump.ts
@@ -0,0 +1,125 @@
+import { toast } from '@/components/ui';
+import { activateHost, activateLocalHost } from '@/lib/desktopHostActions';
+import { LOCAL_HOST_ID, LOCAL_RUNTIME_KEY, runtimeKeyForDesktopHost } from '@/lib/desktopCurrentHost';
+import { formatMessage, useI18nStore } from '@/lib/i18n';
+import { isLocalInstanceAttentionHost, type InstanceAttentionItem } from '@/lib/instanceAttention';
+import { getRuntimeKey } from '@/lib/runtime-switch';
+import { useInstanceAttentionStore } from '@/stores/useInstanceAttentionStore';
+import {
+  completeSessionOpen,
+  heldSessionOpen,
+  holdSessionOpen,
+  releaseSessionOpen,
+  type HeldSessionOpen,
+} from '@/sync/pending-session-open';
+import { useSessionUIStore } from '@/sync/session-ui-store';
+
+// One switch-and-open path for every cross-instance attention surface: a row
+// in the desktop instance panel and a row in the phone's attention sheet. Only
+// one jump runs at a time, so two surfaces cannot start overlapping runtime
+// switches.
+
+let opening = false;
+
+const holdFor = (item: InstanceAttentionItem, runtimeKey: string): HeldSessionOpen => holdSessionOpen({
+  runtimeKey,
+  sessionId: item.sessionId,
+  directory: item.directory,
+});
+
+const reportOpen = async (item: InstanceAttentionItem, held: HeldSessionOpen): Promise<void> => {
+  if (await completeSessionOpen(held) !== 'failed') return;
+  toast.error(formatMessage(useI18nStore.getState().dictionary, 'instanceAttention.openFailed', {
+    instance: item.hostLabel,
+  }));
+};
+
+export const releaseInstanceAttentionHold = (item: InstanceAttentionItem): void => {
+  const held = heldSessionOpen();
+  if (held?.sessionId === item.sessionId) releaseSessionOpen(held);
+};
+
+/**
+ * Drops the server and opens its session once the switch is known to have
+ * happened. The session opens when the new instance has loaded its projects
+ * and sessions, not here: at this point that instance knows neither. The
+ * phone's password unlock reaches this after its own switch, so a prompt that
+ * stopped the first attempt does not leave the item behind.
+ */
+export const finishInstanceAttentionJump = (item: InstanceAttentionItem): void => {
+  useInstanceAttentionStore.getState().dropHost(item.hostId);
+  const held = heldSessionOpen();
+  const current = held && held.runtimeKey === getRuntimeKey() && held.sessionId === item.sessionId
+    ? held
+    : holdFor(item, getRuntimeKey());
+  void reportOpen(item, current);
+};
+
+/**
+ * Switches this window to the item's server and opens its session. The switch
+ * is supplied by the shell: desktop activates a saved host, mobile connects a
+ * saved connection. It answers whether the switch really happened; a server
+ * that stopped at a password prompt keeps its items and the surface stays open.
+ * A successful switch drops the server at once: it is the active instance now,
+ * not an "other" one.
+ *
+ * With the target's runtime key, the open is held before switching, so the
+ * switch does not restore the session that runtime last had open. A surface
+ * whose switch can finish later (the phone's password prompt) keeps the hold
+ * when this switch stops and releases it itself.
+ */
+export const openInstanceAttentionItemWith = async (
+  item: InstanceAttentionItem,
+  switchToHost: (hostId: string) => Promise<boolean>,
+  targetRuntimeKey?: string,
+  options?: { keepHoldWhenStopped?: boolean },
+): Promise<boolean> => {
+  if (opening) return false;
+  opening = true;
+  const held = targetRuntimeKey ? holdFor(item, targetRuntimeKey) : null;
+  let switched = false;
+  try {
+    switched = await switchToHost(item.hostId);
+  } catch (error) {
+    console.warn('[instance-attention] host switch failed', error);
+  } finally {
+    opening = false;
+  }
+  if (!switched || (targetRuntimeKey && getRuntimeKey() !== targetRuntimeKey)) {
+    if (held && !options?.keepHoldWhenStopped) releaseSessionOpen(held);
+    return false;
+  }
+  finishInstanceAttentionJump(item);
+  return true;
+};
+
+/**
+ * Opens a waiting session that lives on the instance this window already
+ * shows. There is nothing to switch to, so it goes straight to the session;
+ * its item clears on its own once the session is read or the request answered.
+ */
+export const openLocalInstanceAttentionItem = (item: InstanceAttentionItem): void => {
+  useSessionUIStore.getState().setCurrentSession(item.sessionId, item.directory);
+};
+
+/**
+ * The desktop shell's switch-and-open path. A host whose last poll failed still
+ * shows its last-known items, so the row is tappable; switching blind would
+ * move the window onto an instance that is not answering. The guard leaves the
+ * surface and its unreachable note in place instead.
+ */
+export const openInstanceAttentionItem = (item: InstanceAttentionItem): Promise<boolean> => {
+  if (isLocalInstanceAttentionHost(item.hostId)) {
+    openLocalInstanceAttentionItem(item);
+    return Promise.resolve(true);
+  }
+  if (useInstanceAttentionStore.getState().hosts[item.hostId]?.status === 'error') {
+    return Promise.resolve(false);
+  }
+  // The app's own server is not in the saved list, so `activateHost` cannot
+  // find it: the shell's Local switch is the path back to this machine.
+  if (item.hostId === LOCAL_HOST_ID) {
+    return openInstanceAttentionItemWith(item, activateLocalHost, LOCAL_RUNTIME_KEY);
+  }
+  return openInstanceAttentionItemWith(item, activateHost, runtimeKeyForDesktopHost({ id: item.hostId }));
+};
