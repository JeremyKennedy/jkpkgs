+import { describe, expect, test } from 'bun:test';
+
+import type { MobileSavedConnection } from './mobileConnections';
+import { mobileAttentionTargets } from './mobileInstanceAttention';
+
+const connection = (
+  id: string,
+  candidates: MobileSavedConnection['candidates'],
+): MobileSavedConnection => ({
