+      // The jump only happened when the runtime really is that connection.
+      return isActiveRuntimeConnection(connection);
+    }).then((opened) => {
+      tapInFlightRef.current = false;
+      if (!opened) return;
+      pendingItemRef.current = null;
+      setPassword('');
+      onOpenChange(false);
+    });
+  }, [connect, connections, onOpenChange]);
+
+  const close = React.useCallback(() => {
+    clearPending();
+    onOpenChange(false);
+  }, [clearPending, onOpenChange]);
+
+  if (items.length === 0) return null;
+
+  const passwordPrompt = pendingConnection ? (
+    <form
+      className="flex flex-col gap-3 px-1 pb-1"
+      onSubmit={(event) => {
+        event.preventDefault();
+        void submitPassword(password);
+      }}
+    >
+      <div className="oc-tile rounded-xl p-4">
+        <p className="truncate typography-ui-label font-semibold text-foreground">{pendingConnection.label}</p>
+        <p className="truncate typography-meta text-muted-foreground">
+          {isRelayOnly(pendingConnection) ? t('mobile.connect.relay.badge') : connectionDisplayUrl(pendingConnection)}
+        </p>
+      </div>
+      <input
+        {...mobileInputKeyboardProps}
+        value={password}
+        onChange={(event) => setPassword(event.target.value)}
+        placeholder={t('mobile.connect.password.placeholder')}
+        aria-label={t('mobile.connect.password.label')}
+        type="password"
+        autoFocus
+        className={mobileConnectionInputClass}
+      />
+      {error ? <p className="px-1 typography-meta text-[var(--status-error-text)]">{error}</p> : null}
+      <div className="flex items-center justify-end gap-2">
+        <Button type="button" variant="ghost" onClick={clearPending}>
+          {t('mobile.connect.cancelPassword')}
+        </Button>
+        <Button type="submit" disabled={isPasswordBusy || !password.trim()}>
+          {isPasswordBusy ? t('mobile.connect.connecting') : t('mobile.connect.unlockButton')}
+        </Button>
+      </div>
+    </form>
+  ) : null;
+
+  return (
+    <>
+      <button
+        type="button"
+        className={cn(MOBILE_HEADER_BUTTON_CLASS, 'text-[var(--status-warning)]')}
+        aria-label={t(items.length === 1 ? 'instanceAttention.ariaOne' : 'instanceAttention.ariaMany', { count: items.length })}
+        aria-haspopup="dialog"
+        aria-expanded={open}
+        onClick={() => onOpenChange(true)}
+        style={{ touchAction: 'manipulation', width: 'auto', paddingInline: 8, gap: 4 }}
+      >
+        <Icon name="notification-3" className="size-5" />
+        <span
+          data-instance-attention-badge
+          aria-hidden="true"
+          className="inline-flex h-4 min-w-4 items-center justify-center rounded-full bg-[var(--status-warning-background)] px-1 typography-micro font-medium tabular-nums text-[var(--status-warning-text)]"
+        >
+          {items.length}
+        </span>
+      </button>
+      <MobileOverlayPanel
+        open={open}
+        title={t('instanceAttention.list.title')}
+        onClose={close}
+      >
+        {passwordPrompt ?? (
+          <>
+            {error ? <p className="px-2 pb-1 typography-meta text-[var(--status-error-text)]">{error}</p> : null}
+            <InstanceAttentionList
+              items={items}
+              unreachableLabels={unreachableLabels}
+              onOpen={openItem}
+              row={SheetRow}
+              showTitle={false}
+            />
+          </>
+        )}
+      </MobileOverlayPanel>
+    </>
+  );
+};
