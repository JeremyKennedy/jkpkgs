--- /dev/null
+++ b/packages/ui/src/stores/useInstanceAttentionStore.ts
@@ -0,0 +1,122 @@
+import { create } from 'zustand';
+
+import {
+  collectInstanceAttention,
+  LOCAL_INSTANCE_ATTENTION_HOST_ID,
+  type InstanceAttentionItem,
+  type InstanceAttentionPoll,
+  type InstancePendingCounts,
+  type InstanceSessionSummary,
+} from '@/lib/instanceAttention';
+
+// Holds what the saved instances other than the active one last told us, plus
+// this instance's own waiting sessions under a reserved id. Sessions, pending
+// requests and open turns are kept apart so a failed half of a poll keeps the
+// other half's previous answer instead of reading as empty.
+type InstanceAttentionHostRecord = {
+  label: string;
+  status: 'ok' | 'error';
+  checkedAt: number;
+  sessions: readonly InstanceSessionSummary[] | null;
+  pending: ReadonlyMap<string, InstancePendingCounts> | null;
+  busy: ReadonlySet<string> | null;
+};
+
+type InstanceAttentionStoreState = {
+  hosts: Readonly<Record<string, InstanceAttentionHostRecord>>;
+  /** Attention items across every tracked instance, strongest first. */
+  items: readonly InstanceAttentionItem[];
+  applyPoll: (hostId: string, label: string, poll: InstanceAttentionPoll, checkedAt: number) => void;
+  markUnreachable: (hostId: string, label: string, checkedAt: number) => void;
+  /**
+   * Drop instances that are no longer saved or are now the active one. The
+   * reserved local entry is not a polled target and always stays.
+   */
+  retainHosts: (hostIds: readonly string[]) => void;
+  dropHost: (hostId: string) => void;
+  reset: () => void;
+};
+
+const rebuild = (
+  hosts: Readonly<Record<string, InstanceAttentionHostRecord>>,
+): readonly InstanceAttentionItem[] => collectInstanceAttention(
+  Object.entries(hosts).map(([hostId, record]) => ({
+    hostId,
+    hostLabel: record.label,
+    sessions: record.sessions ?? [],
+    pending: record.pending ?? new Map(),
+    busy: record.busy ?? undefined,
+  })),
+);
+
+const withoutHosts = (
+  hosts: Readonly<Record<string, InstanceAttentionHostRecord>>,
+  hostIds: readonly string[],
+) => {
+  const keep = new Set(hostIds);
+  // The local entry is fed by this window's own stores, never by the poller,
+  // so it is absent from every target list and has to survive retention.
+  keep.add(LOCAL_INSTANCE_ATTENTION_HOST_ID);
+  const next: Record<string, InstanceAttentionHostRecord> = {};
+  for (const [hostId, record] of Object.entries(hosts)) {
+    if (keep.has(hostId)) next[hostId] = record;
+  }
+  return next;
+};
+
+const EMPTY_HOSTS: Readonly<Record<string, InstanceAttentionHostRecord>> = {};
+
+export const useInstanceAttentionStore = create<InstanceAttentionStoreState>((set, get) => ({
+  hosts: EMPTY_HOSTS,
+  items: [],
+
+  applyPoll: (hostId, label, poll, checkedAt) => {
+    if (poll.sessions === null && poll.pending === null) {
+      get().markUnreachable(hostId, label, checkedAt);
+      return;
+    }
+    const previous = get().hosts[hostId];
+    const sessions = poll.sessions ?? previous?.sessions ?? null;
+    const pending = poll.pending ?? previous?.pending ?? null;
+    // Pending and busy come from the same status route; a failed status read
+    // keeps the last open turns instead of treating every session as finished.
+    const busy = poll.pending === null ? previous?.busy ?? null : poll.busy;
+    const hosts = {
+      ...get().hosts,
+      [hostId]: { label, status: 'ok' as const, checkedAt, sessions, pending, busy },
+    };
+    set({ hosts, items: rebuild(hosts) });
+  },
+
+  markUnreachable: (hostId, label, checkedAt) => {
+    const previous = get().hosts[hostId];
+    const hosts = {
+      ...get().hosts,
+      [hostId]: {
+        label,
+        status: 'error' as const,
+        checkedAt,
+        sessions: previous?.sessions ?? null,
+        pending: previous?.pending ?? null,
+        busy: previous?.busy ?? null,
+      },
+    };
+    // The last known items stay: an unreachable host did not answer "nothing".
+    set({ hosts, items: rebuild(hosts) });
+  },
+
+  retainHosts: (hostIds) => {
+    const hosts = withoutHosts(get().hosts, hostIds);
+    if (Object.keys(hosts).length === Object.keys(get().hosts).length) return;
+    set({ hosts, items: rebuild(hosts) });
+  },
+
+  dropHost: (hostId) => {
+    if (!get().hosts[hostId]) return;
+    const hosts = { ...get().hosts };
+    delete hosts[hostId];
+    set({ hosts, items: rebuild(hosts) });
+  },
+
+  reset: () => set({ hosts: EMPTY_HOSTS, items: [] }),
+}));
