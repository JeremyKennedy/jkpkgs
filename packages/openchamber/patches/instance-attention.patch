diff --git a/packages/ui/src/lib/pendingFormVerification.ts b/packages/ui/src/lib/pendingFormVerification.ts
new file mode 100644
index 000000000..ae4121927
--- /dev/null
+++ b/packages/ui/src/lib/pendingFormVerification.ts
@@ -0,0 +1,37 @@
+export type PendingFormLike = { id: string };
+
+export type PendingFormsBySession = ReadonlyMap<string, {
+  directory: string;
+  forms: readonly PendingFormLike[];
+}>;
+
+type StalePendingForm = { sessionId: string; formId: string };
+
+export const planStalePendingForms = async (
+  bySession: PendingFormsBySession,
+  directoryOfSession: (sessionId: string) => string | null,
+  readForms: (directory: string) => Promise<readonly PendingFormLike[] | null>,
+): Promise<StalePendingForm[]> => {
+  const byDirectory = new Map<string, string[]>();
+  for (const [sessionId, entry] of bySession) {
+    if (entry.forms.length === 0) continue;
+    const directory = directoryOfSession(sessionId) ?? entry.directory;
+    if (!directory) continue;
+    const list = byDirectory.get(directory);
+    if (list) list.push(sessionId);
+    else byDirectory.set(directory, [sessionId]);
+  }
+
+  const stale: StalePendingForm[] = [];
+  for (const [directory, sessionIds] of byDirectory) {
+    const live = await readForms(directory);
+    if (!live) continue;
+    const liveIds = new Set(live.map((form) => form.id));
+    for (const sessionId of sessionIds) {
+      for (const form of bySession.get(sessionId)?.forms ?? []) {
+        if (!liveIds.has(form.id)) stale.push({ sessionId, formId: form.id });
+      }
+    }
+  }
+  return stale;
+};
