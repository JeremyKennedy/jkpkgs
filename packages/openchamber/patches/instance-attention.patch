+import { afterEach, beforeEach, expect, spyOn, test } from 'bun:test';
+import React, { act } from 'react';
+import { createRoot, type Root } from 'react-dom/client';
+import { Window } from 'happy-dom';
+
+import { useRouter } from '@/hooks/useRouter';
+import type { InstanceAttentionItem } from '@/lib/instanceAttention';
+import type { Session } from '@/lib/opencode/model';
+import { opencodeClient } from '@/lib/opencode/client';
+import { getRuntimeApiBaseUrl, getRuntimeKey, switchRuntimeEndpoint } from '@/lib/runtime-switch';
+import { useDirectoryStore } from '@/stores/useDirectoryStore';
+import { useGlobalSessionsStore } from '@/stores/useGlobalSessionsStore';
+import { useProjectsStore } from '@/stores/useProjectsStore';
+import { useSessionUIStore } from '@/sync/session-ui-store';
+import { openInstanceAttentionItemWith } from './instanceAttentionJump';
+
+const session = (id: string): Session => ({
+  id,
+  projectID: 'project',
+  directory: '/repo',
+  title: id,
+  time: { created: 1, updated: 1 },
+  cost: 0,
+  tokens: { input: 0, output: 0, reasoning: 0, cache: { read: 0, write: 0 } },
+});
+
+const item: InstanceAttentionItem = {
+  key: 'target:ses_clicked',
+  hostId: 'target',
+  hostLabel: 'Target',
+  sessionId: 'ses_clicked',
+  directory: '/repo',
+  title: 'Clicked',
+  kind: 'unread',
+  at: 10,
+};
+
+const RouterHost = () => {
+  useRouter();
+  return null;
+};
+
+const originalUI = useSessionUIStore.getState();
+const originalProjects = useProjectsStore.getState();
+const originalSessions = useGlobalSessionsStore.getState();
+const originalDirectory = useDirectoryStore.getState();
+const originalRuntime = { apiBaseUrl: getRuntimeApiBaseUrl(), runtimeKey: getRuntimeKey() };
+const globals = new Map<string, PropertyDescriptor | undefined>();
+let dom: Window;
+let clickedOpened: () => void = () => undefined;
+let fetchSpy: ReturnType<typeof spyOn> | null = null;
+let sessionRead: ReturnType<typeof spyOn> | null = null;
+
+const moveTo = (runtimeKey: string) => {
+  switchRuntimeEndpoint({ apiBaseUrl: `https://${runtimeKey.replace(':', '-')}.test`, runtimeKey });
+};
+
+const mountApp = async (): Promise<Root> => {
+  const host = document.createElement('div');
+  document.body.append(host);
+  const root = createRoot(host);
+  await act(async () => root.render(<RouterHost />));
+  return root;
+};
+
+const routedSession = () => new URLSearchParams(window.location.search).get('session');
+
+beforeEach(() => {
+  dom = new Window({ url: 'http://localhost/' });
+  const values = {
+    window: dom, document: dom.document, navigator: dom.navigator,
+    Node: dom.Node, Element: dom.Element, HTMLElement: dom.HTMLElement,
+    Event: dom.Event, CustomEvent: dom.CustomEvent, IS_REACT_ACT_ENVIRONMENT: true,
+  };
+  for (const [name, value] of Object.entries(values)) {
+    globals.set(name, Object.getOwnPropertyDescriptor(globalThis, name));
+    Object.defineProperty(globalThis, name, { configurable: true, writable: true, value });
+  }
+  useProjectsStore.setState({ projects: [{ id: 'repo', path: '/repo' }], hasServerSnapshot: true, serverSnapshotFailed: false });
+  useGlobalSessionsStore.setState({
+    hasLoaded: true,
+    status: 'ready',
+    activeSessions: [session('ses_remembered'), session('ses_clicked'), session('ses_here')],
+    archivedSessions: [],
+  });
+  useDirectoryStore.setState({ currentDirectory: '/repo', homeDirectory: '/home/me', isHomeReady: true });
+  sessionRead = spyOn(opencodeClient, 'getSessionUnscoped').mockImplementation(async (id: string) => session(id));
+  fetchSpy = spyOn(globalThis, 'fetch').mockImplementation(async () => new Response(null, { status: 404 }));
+  useSessionUIStore.setState({
+    setCurrentSession: (id, directory, options) => {
+      originalUI.setCurrentSession(id, directory, options);
+      if (id === 'ses_clicked' && useSessionUIStore.getState().currentSessionId === id) clickedOpened();
+    },
+  });
+});
+
+afterEach(() => {
+  fetchSpy?.mockRestore();
+  sessionRead?.mockRestore();
+  switchRuntimeEndpoint(originalRuntime);
+  useSessionUIStore.setState(originalUI, true);
+  useProjectsStore.setState(originalProjects, true);
+  useGlobalSessionsStore.setState(originalSessions, true);
+  useDirectoryStore.setState(originalDirectory, true);
+  for (const [name, descriptor] of globals) {
+    if (descriptor) Object.defineProperty(globalThis, name, descriptor);
+    else Reflect.deleteProperty(globalThis, name);
+  }
+  globals.clear();
+  dom.close();
+});
+
+test('a jump to an instance with a remembered session lands on the clicked one after the app remounts', async () => {
+  // The window had a session open on the target before; it is on another instance now.
+  moveTo('host:target');
+  useSessionUIStore.setState({ currentSessionId: 'ses_remembered', currentSessionDirectory: '/repo' });
+  useSessionUIStore.getState().prepareForRuntimeSwitch('host:target');
+  moveTo('host:here');
+  useSessionUIStore.setState({ currentSessionId: 'ses_here', currentSessionDirectory: '/repo' });
+  const before = await mountApp();
+  expect(routedSession()).toBe('ses_here');
+
+  const clicked = new Promise<void>((resolve) => { clickedOpened = resolve; });
+  // The switch as the app runs it: the store restore for the new runtime while
+  // the old app is still mounted, then the auth gate unmounting that app.
+  const opened = await openInstanceAttentionItemWith(item, async () => {
+    useSessionUIStore.getState().prepareForRuntimeSwitch('host:here');
+    moveTo('host:target');
+    useProjectsStore.setState({ hasServerSnapshot: false });
+    useSessionUIStore.getState().restoreForRuntimeSwitch('host:target', 'host:here');
+    await act(async () => before.unmount());
+    return true;
+  }, 'host:target');
+  expect(opened).toBe(true);
+
+  // The app mounts again on the new runtime and replays its URL, then the
+  // settings sync brings the project list.
+  const after = await mountApp();
+  await act(async () => useProjectsStore.setState({ hasServerSnapshot: true }));
+  await clicked;
+
+  expect(useSessionUIStore.getState().currentSessionId).toBe('ses_clicked');
+  expect(routedSession()).toBe('ses_clicked');
+  await act(async () => after.unmount());
+});
