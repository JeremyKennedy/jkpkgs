+const busySessionIds = (snapshot: HostSessionStatusSnapshot): ReadonlySet<string> => {
+  const busy = new Set<string>();
+  for (const [sessionId, entry] of Object.entries(snapshot.sessions)) {
+    if (entry.status === 'busy' || entry.status === 'retry') busy.add(sessionId);
+  }
+  return busy;
