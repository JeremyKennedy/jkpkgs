 import { getLocalSttModelDir, getLocalSttModelSpec } from './model-catalog.js';
 import { resolveModelLanguage } from './model-language.js';
 import { pcm16ToWav } from '../audio.js';
+import { availableParallelism } from 'os';
 
 process.title = 'OpenChamber Dictation';
 
+// ONNX Runtime threads for the sherpa engines. Upstream pins 2, which leaves
+// most of a workstation idle while the tail of a dictation decodes: on a
+// 32-core host the same 7.4s clip decodes in 195ms at 8 threads instead of
+// 409ms at 2. The worker exits after its idle TTL, so this does not hold
+// cores while dictation is unused.
+const ENGINE_THREADS = Math.max(1, Math.min(8, availableParallelism()));
+
 const engines = new Map();
 const ttsEngines = new Map();
 const sessions = new Map();
