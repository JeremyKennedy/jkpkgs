diff --git a/packages/ui/src/components/chat/lib/questionExpandedState.ts b/packages/ui/src/components/chat/lib/questionExpandedState.ts
new file mode 100644
index 000000000..c7c010dc8
--- /dev/null
+++ b/packages/ui/src/components/chat/lib/questionExpandedState.ts
@@ -0,0 +1,86 @@
+import type { Part } from '@/lib/opencode/model';
+import { isQuestionTool } from '@/lib/opencode/tools';
+
+import { isAnsweredQuestionPart } from './questionEntries';
+
+/**
+ * Which tool rows a message opens with. A question row follows the
+ * `autoExpandAnsweredQuestions` setting and the reader's own decisions instead
+ * of the generic tool cache, so turning the setting off closes them and a row
+ * the reader opened stays open.
+ *
+ * The caches are keyed by message id and survive session switches until a
+ * reload or the 4000-entry trim.
+ */
+const EXPANDED_TOOLS_CACHE_MAX = 4000;
+const expandedToolsStateCache = new Map<string, Set<string>>();
+// Question rows the reader collapsed on purpose. They stay collapsed when the
+// message is shown again, even though answered questions open by default.
+const collapsedQuestionStateCache = new Map<string, Set<string>>();
+// Question rows the reader opened on purpose. They stay open when the setting
+// that opens answered questions is off.
+const expandedQuestionStateCache = new Map<string, Set<string>>();
+
+const trimCache = (cache: Map<string, Set<string>>, messageId: string): void => {
+    if (cache.size >= EXPANDED_TOOLS_CACHE_MAX && !cache.has(messageId)) {
+        const oldest = cache.keys().next().value;
+        if (typeof oldest === 'string') {
+            cache.delete(oldest);
+        }
+    }
+};
+
+const readExpandedToolsCache = (messageId: string): Set<string> | undefined => {
+    const cached = expandedToolsStateCache.get(messageId);
+    return cached ? new Set(cached) : undefined;
+};
+
+export const writeExpandedToolsCache = (messageId: string, value: Set<string>): void => {
+    trimCache(expandedToolsStateCache, messageId);
+    expandedToolsStateCache.set(messageId, new Set(value));
+};
+
+export const readCollapsedQuestionsCache = (messageId: string): Set<string> => {
+    const cached = collapsedQuestionStateCache.get(messageId);
+    return cached ? new Set(cached) : new Set();
+};
+
+export const writeCollapsedQuestionsCache = (messageId: string, value: Set<string>): void => {
+    trimCache(collapsedQuestionStateCache, messageId);
+    collapsedQuestionStateCache.set(messageId, new Set(value));
+};
+
+export const readExpandedQuestionsCache = (messageId: string): Set<string> => {
+    const cached = expandedQuestionStateCache.get(messageId);
+    return cached ? new Set(cached) : new Set();
+};
+
+export const writeExpandedQuestionsCache = (messageId: string, value: Set<string>): void => {
+    trimCache(expandedQuestionStateCache, messageId);
+    expandedQuestionStateCache.set(messageId, new Set(value));
+};
+
+export const answeredQuestionIds = (parts: readonly Part[]): string[] =>
+    parts.filter(isAnsweredQuestionPart).map((part) => part.id);
+
+export const questionIds = (parts: readonly Part[]): Set<string> =>
+    new Set(parts.filter((part) => part.type === 'tool' && isQuestionTool(part.tool)).map((part) => part.id));
+
+export const seedExpandedTools = (
+    messageId: string,
+    parts: readonly Part[],
+    autoExpandAnsweredQuestions: boolean,
+): Set<string> => {
+    const cached = readExpandedToolsCache(messageId);
+    const collapsed = readCollapsedQuestionsCache(messageId);
+    const explicit = readExpandedQuestionsCache(messageId);
+    const ids = questionIds(parts);
+    const answered = answeredQuestionIds(parts);
+    const expanded = cached ? new Set(cached) : new Set<string>();
+    for (const id of ids) expanded.delete(id);
+    for (const id of explicit) if (ids.has(id)) expanded.add(id);
+    if (autoExpandAnsweredQuestions) {
+        for (const id of answered) if (!collapsed.has(id)) expanded.add(id);
+    }
+    return expanded;
+};
