diff --git a/packages/web/server/lib/quota/providers/command-code.js b/packages/web/server/lib/quota/providers/command-code.js
new file mode 100644
index 0000000..f6293bd
--- /dev/null
+++ b/packages/web/server/lib/quota/providers/command-code.js
@@ -0,0 +1,187 @@
+/**
+ * Command Code quota.
+ *
+ * Upstream removed this provider in 1.21.0 ("their official API exposes no
+ * usage data") and declined to restore it, so this module is a local patch. It
+ * reads the same billing routes the Command Code web app uses and reports only
+ * what they return; there is no documented usage API to fall back to.
+ *
+ * The credential is the browser session token, not an API key: the inference
+ * key (`CMD_API_KEY`) is accepted by `/provider/v1/models` but answers 401 on
+ * every billing route. `COMMANDCODE_COOKIE` carries the token (the variable
+ * headroom's collector reads), and an OpenCode `command-code` entry is accepted
+ * when it holds one.
+ */
+import { readOpenCodeCredentials } from '../../opencode/auth.js';
+import {
+  asObject,
+  buildResult,
+  formatMoney,
+  getAuthEntry,
+  normalizeAuthEntry,
+  toNumber,
+  toTimestamp,
+  toUsageWindow
+} from '../utils/index.js';
+
+export const providerId = 'command-code';
+export const providerName = 'Command Code';
+export const aliases = ['command-code', 'commandcode', 'command_code', 'command code'];
+
+const API_BASE_URL = 'https://api.commandcode.ai';
+const CREDITS_PATH = '/internal/billing/credits';
+const SUBSCRIPTIONS_PATH = '/internal/billing/subscriptions';
+const COOKIE_ENV = 'COMMANDCODE_COOKIE';
+const SESSION_COOKIE = '__Secure-commandcode_prod_.session_token';
+
+/** Plan ids from the subscription payload, as Command Code's own app names them. */
+const PLAN_LABELS = {
+  'individual-go': 'Go',
+  'individual-goat': 'GOAT',
+  'individual-pro': 'Pro',
+  'individual-max': 'Max 10x',
+  'individual-ultra': 'Max 20x'
+};
+
+/**
+ * A bare session token becomes a Cookie header; a full captured Cookie header
+ * (several pairs, or one already named) is passed through unchanged.
+ */
+export const normalizeCookie = (value) => {
+  const trimmed = typeof value === 'string' ? value.trim() : '';
+  if (!trimmed) return null;
+  return /^[\w.-]*commandcode_prod_\.session_(?:token|data)=/i.test(trimmed)
+    ? trimmed
+    : `${SESSION_COOKIE}=${trimmed}`;
+};
+
+const readCookie = (auth) => {
+  const envCookie = normalizeCookie(process.env[COOKIE_ENV]);
+  if (envCookie) return envCookie;
+  const entry = normalizeAuthEntry(getAuthEntry(auth ?? {}, aliases));
+  return normalizeCookie(entry?.key ?? entry?.token ?? entry?.access);
+};
+
+const requestJson = async (path, cookie, fetchImpl) => {
+  const response = await fetchImpl(`${API_BASE_URL}${path}`, {
+    headers: {
+      Accept: 'application/json',
+      Cookie: cookie,
+      'User-Agent': 'OpenChamber quota provider'
+    },
+    signal: AbortSignal.timeout(15_000)
+  });
+  if (response.status === 401 || response.status === 403) {
+    throw new Error('Command Code session expired — refresh COMMANDCODE_COOKIE');
+  }
+  if (!response.ok) throw new Error(`Command Code usage API returned HTTP ${response.status}`);
+  return response.json().catch(() => null);
+};
+
+const clampPercent = (value) => Math.min(100, Math.max(0, value));
+
+const rollingWindow = (limit, windowSeconds) => {
+  const used = toNumber(limit?.used);
+  const cap = toNumber(limit?.cap);
+  if (used === null || cap === null || cap <= 0) return null;
+  return toUsageWindow({
+    usedPercent: clampPercent((used / cap) * 100),
+    windowSeconds,
+    resetAt: toTimestamp(toNumber(limit?.resetAt))
+  });
+};
+
+export const parseCommandCodeCredits = (payload, subscription = null) => {
+  const root = asObject(payload);
+  const credits = asObject(root?.credits);
+  const limits = asObject(root?.windowLimits);
+  const windows = {};
+
+  const fiveHour = rollingWindow(limits?.fiveHour, 5 * 60 * 60);
+  if (fiveHour) windows['5h'] = fiveHour;
+
+  const weekly = rollingWindow(limits?.weekly, 7 * 24 * 60 * 60);
+  if (weekly) windows.weekly = weekly;
+
+  // `monthlyCredits` is what remains of the granted allowance, so the grant is
+  // the denominator: this row is consumption, not a balance. The reset comes
+  // from the subscription period, which the credits payload does not carry.
+  const granted = toNumber(credits?.monthlyCreditsGranted);
+  const remaining = toNumber(credits?.monthlyCredits);
+  if (granted !== null && remaining !== null && granted > 0) {
+    windows.monthly = toUsageWindow({
+      usedPercent: clampPercent(((granted - remaining) / granted) * 100),
+      windowSeconds: 30 * 24 * 60 * 60,
+      resetAt: toTimestamp(asObject(subscription)?.currentPeriodEnd)
+    });
+  }
+
+  const purchased = toNumber(credits?.purchasedCredits);
+  if (purchased !== null) {
+    windows.credits_balance = toUsageWindow({
+      usedPercent: null,
+      windowSeconds: null,
+      resetAt: null,
+      valueLabel: `$${formatMoney(purchased)}`
+    });
+  }
+
+  return windows;
+};
+
+/** Best-effort: the plan label and the monthly reset are enrichment, never a reason to fail. */
+const readSubscription = async (cookie, fetchImpl) => {
+  try {
+    const payload = asObject(await requestJson(SUBSCRIPTIONS_PATH, cookie, fetchImpl));
+    const data = asObject(payload?.data);
+    if (!data) return null;
+    const planId = typeof data.planId === 'string' ? data.planId : '';
+    return {
+      currentPeriodEnd: data.currentPeriodEnd ?? data.current_period_end ?? null,
+      planLabel: PLAN_LABELS[planId] ?? null
+    };
+  } catch {
+    return null;
+  }
+};
+
+export const fetchCommandCodeUsage = async (cookie, fetchImpl = fetch) => {
+  const [credits, subscription] = await Promise.all([
+    requestJson(CREDITS_PATH, cookie, fetchImpl),
+    readSubscription(cookie, fetchImpl)
+  ]);
+  const windows = parseCommandCodeCredits(credits, subscription);
+  if (Object.keys(windows).length === 0) {
+    throw new Error('Command Code usage data could not be parsed');
+  }
+  return { windows, planLabel: subscription?.planLabel ?? null };
+};
+
+export const isConfigured = (auth) => Boolean(readCookie(auth));
+
+export const fetchQuota = async ({ readAuth = readOpenCodeCredentials, fetchImpl = fetch } = {}) => {
+  let auth = {};
+  try {
+    auth = (await readAuth()) ?? {};
+  } catch {
+    // The environment cookie is enough on its own; OpenCode need not answer.
+  }
+
+  const cookie = readCookie(auth);
+  if (!cookie) {
+    return buildResult({ providerId, providerName, ok: false, configured: false, error: 'Not configured' });
+  }
+
+  try {
+    const { windows, planLabel } = await fetchCommandCodeUsage(cookie, fetchImpl);
+    return buildResult({ providerId, providerName, ok: true, configured: true, usage: { windows }, planLabel });
+  } catch (error) {
+    return buildResult({
+      providerId,
+      providerName,
+      ok: false,
+      configured: true,
+      error: error instanceof Error ? error.message : 'Request failed'
+    });
+  }
+};
