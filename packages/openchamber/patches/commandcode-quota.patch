@@ -100,6 +101,8 @@ Provider modules must export `providerId`, `providerName`, `aliases`, `isConfigu
 
 exe.dev, Cursor, and ZenMux credentials are explicitly managed through Settings. exe.dev usage uses a separately generated HTTPS API token restricted to `billing credits usage` and aggregates every `exe-*` model provider into one monthly credit window. Generate the token with `ssh exe.dev "ssh-key generate-api-key --label=openchamber --exp=30d --cmds='billing credits usage'"`. ZenMux usage uses an optional Platform API key pasted on the Usage page; the OpenCode chat key is never used, and a missing Platform API key means ZenMux quota is not fetched. The server validates managed credentials before atomic `0600` writes and never returns secrets through its API. OpenChamber never scans browser cookie stores or automatically reads Cursor storage; Cursor import is an explicit one-time user action and never modifies Cursor's database.
 
+Command Code usage reads the billing routes the Command Code web app itself uses: `GET /internal/billing/credits` for the five-hour, weekly and monthly figures, and `GET /internal/billing/subscriptions` (best-effort) for the plan label and the monthly reset. Both are session-backed and undocumented, so the credential is the browser session token, not the inference key — `CMD_API_KEY` is accepted by `/provider/v1/models` but answers 401 on these routes. `COMMANDCODE_COOKIE` carries the token (a bare value is sent as `__Secure-commandcode_prod_.session_token`), and an OpenCode `command-code` auth entry holding one is accepted as a fallback. Monthly credits are reported as consumption against `monthlyCreditsGranted`, not as a balance. The session expires and must be refreshed; an expired token reports "Command Code session expired" rather than zero usage.
+
 ## Extension usage providers
 
 An installed extension with `provides: ["quota"]` and `contributes.quota` (the SDK role, `packages/sdk/GUEST_SERVICES.md`, *Usage provider*) is one more registry entry, `ext-<guestId>`, attached after the built-ins by `extension-quotas.js` and answered by `extension-quota.js`.
diff --git a/packages/web/server/lib/quota/providers/command-code.ts b/packages/web/server/lib/quota/providers/command-code.ts
new file mode 100644
index 000000000..e9f71851a
--- /dev/null
+++ b/packages/web/server/lib/quota/providers/command-code.ts
@@ -0,0 +1,210 @@
+import { readOpenCodeCredentials } from '../../opencode/auth.js';
+import type { LegacyAuthFile } from '../../opencode/auth.js';
+import type { ProviderUsage, QuotaResult, UsageWindow } from '../utils/contracts.js';
+import {
+  asObject,
+  buildResult,
+  formatMoney,
+  getAuthEntry,
+  normalizeAuthEntry,
+  toNumber,
+  toTimestamp,
+  toUsageWindow
+} from '../utils/index.js';
+
+export const providerId = 'command-code';
+export const providerName = 'Command Code';
+export const aliases = ['command-code', 'commandcode', 'command_code', 'command code'];
+
+const API_BASE_URL = 'https://api.commandcode.ai';
+const CREDITS_PATH = '/internal/billing/credits';
+const SUBSCRIPTIONS_PATH = '/internal/billing/subscriptions';
+const COOKIE_ENV = 'COMMANDCODE_COOKIE';
+const SESSION_COOKIE = '__Secure-commandcode_prod_.session_token';
+
+/** Plan ids from the subscription payload, as Command Code's own app names them. */
+const PLAN_LABELS: Readonly<Record<string, string>> = {
+  'individual-go': 'Go',
+  'individual-goat': 'GOAT',
+  'individual-pro': 'Pro',
+  'individual-max': 'Max 10x',
+  'individual-ultra': 'Max 20x'
+};
+
+type FetchImpl = (input: string, init?: RequestInit) => Promise<Response>;
+
+type JsonObject = Record<string, unknown>;
+
+type Warnings = Partial<Record<string, UsageWindow>>;
+
+/**
+ * What the subscription read contributes: the plan label the usage card shows,
+ * and the period end the monthly row resets at.
+ */
+type SubscriptionInfo = { currentPeriodEnd: unknown; planLabel: string | null };
+
+/**
+ * A bare session token becomes a Cookie header; a full captured Cookie header
+ * (several pairs, or one already named) is passed through unchanged.
+ */
+export const normalizeCookie = (value: unknown): string | null => {
+  const trimmed = typeof value === 'string' ? value.trim() : '';
+  if (!trimmed) return null;
+  return /^[\w.-]*commandcode_prod_\.session_(?:token|data)=/i.test(trimmed)
+    ? trimmed
+    : `${SESSION_COOKIE}=${trimmed}`;
+};
+
+const readCookie = (auth: LegacyAuthFile | null | undefined): string | null => {
+  const envCookie = normalizeCookie(process.env[COOKIE_ENV]);
+  if (envCookie) return envCookie;
+  const entry = normalizeAuthEntry(getAuthEntry(auth ?? {}, aliases));
+  return normalizeCookie(field(entry, 'key') ?? field(entry, 'token') ?? field(entry, 'access'));
+};
+
+const requestJson = async (path: string, cookie: string, fetchImpl: FetchImpl): Promise<unknown> => {
+  const response = await fetchImpl(`${API_BASE_URL}${path}`, {
+    headers: {
+      Accept: 'application/json',
+      Cookie: cookie,
+      'User-Agent': 'OpenChamber quota provider'
+    },
+    signal: AbortSignal.timeout(15_000)
+  });
+  if (response.status === 401 || response.status === 403) {
+    throw new Error('Command Code session expired — refresh COMMANDCODE_COOKIE');
+  }
+  if (!response.ok) throw new Error(`Command Code usage API returned HTTP ${response.status}`);
+  return response.json().catch(() => null);
+};
+
+const clampPercent = (value: number): number => Math.min(100, Math.max(0, value));
+
+/**
+ * A field of a payload `asObject` accepted. `asObject` answers `object | null`,
+ * which types no property at all; every read of this provider's payloads goes
+ * through here so the shapes stay in one place.
+ */
+const field = (value: object | null | undefined, key: string): unknown => (
+  value === null || value === undefined ? undefined : (value as Record<string, unknown>)[key]
+);
+
+const objectField = (value: object | null | undefined, key: string): JsonObject | null => (
+  asObject(field(value, key)) as JsonObject | null
+);
+
+const rollingWindow = (limit: object | null | undefined, windowSeconds: number): UsageWindow | null => {
+  const used = toNumber(field(limit, 'used'));
+  const cap = toNumber(field(limit, 'cap'));
+  if (used === null || cap === null || cap <= 0) return null;
+  return toUsageWindow({
+    usedPercent: clampPercent((used / cap) * 100),
+    windowSeconds,
+    resetAt: toTimestamp(field(limit, 'resetAt'))
+  });
+};
+
+export const parseCommandCodeCredits = (payload: unknown, subscription: unknown = null): Warnings => {
+  const root = asObject(payload);
+  const credits = objectField(root, 'credits');
+  const limits = objectField(root, 'windowLimits');
+  const windows: Warnings = {};
+
+  const fiveHour = rollingWindow(objectField(limits, 'fiveHour') ?? null, 5 * 60 * 60);
+  if (fiveHour) windows['5h'] = fiveHour;
+
+  const weekly = rollingWindow(objectField(limits, 'weekly') ?? null, 7 * 24 * 60 * 60);
+  if (weekly) windows.weekly = weekly;
+
+  // `monthlyCredits` is what remains of the granted allowance, so the grant is
+  // the denominator: this row is consumption, not a balance. The reset comes
+  // from the subscription period, which the credits payload does not carry.
+  const granted = toNumber(field(credits, 'monthlyCreditsGranted'));
+  const remaining = toNumber(field(credits, 'monthlyCredits'));
+  if (granted !== null && remaining !== null && granted > 0) {
+    windows.monthly = toUsageWindow({
+      usedPercent: clampPercent(((granted - remaining) / granted) * 100),
+      windowSeconds: 30 * 24 * 60 * 60,
+      resetAt: toTimestamp(field(asObject(subscription), 'currentPeriodEnd'))
+    });
+  }
+
+  const purchased = toNumber(field(credits, 'purchasedCredits'));
+  if (purchased !== null) {
+    windows.credits_balance = toUsageWindow({
+      usedPercent: null,
+      windowSeconds: null,
+      resetAt: null,
+      valueLabel: `$${formatMoney(purchased)}`
+    });
+  }
+
+  return windows;
+};
+
+/** Best-effort: the plan label and the monthly reset are enrichment, never a reason to fail. */
+const readSubscription = async (cookie: string, fetchImpl: FetchImpl): Promise<SubscriptionInfo | null> => {
+  try {
+    const payload = asObject(await requestJson(SUBSCRIPTIONS_PATH, cookie, fetchImpl));
+    const data = objectField(payload, 'data');
+    if (!data) return null;
+    const planId = field(data, 'planId');
+    return {
+      currentPeriodEnd: field(data, 'currentPeriodEnd') ?? field(data, 'current_period_end') ?? null,
+      planLabel: typeof planId === 'string' ? PLAN_LABELS[planId] ?? null : null
+    };
+  } catch {
+    return null;
+  }
+};
+
+export const fetchCommandCodeUsage = async (cookie: string, fetchImpl: FetchImpl = fetch) => {
+  const [credits, subscription] = await Promise.all([
+    requestJson(CREDITS_PATH, cookie, fetchImpl),
+    readSubscription(cookie, fetchImpl)
+  ]);
+  const windows = parseCommandCodeCredits(credits, subscription);
+  if (Object.keys(windows).length === 0) {
+    throw new Error('Command Code usage data could not be parsed');
+  }
+  return { windows, planLabel: subscription?.planLabel ?? null };
+};
+
+export const isConfigured = (auth: LegacyAuthFile | null | undefined): boolean => Boolean(readCookie(auth));
+
+/**
+ * The registry calls this with no arguments; the options exist so a test can
+ * inject a credential read and a fake fetch.
+ */
+export const fetchQuota = async ({
+  readAuth = readOpenCodeCredentials,
+  fetchImpl = fetch
+}: {
+  readAuth?: () => Promise<LegacyAuthFile | null | undefined>;
+  fetchImpl?: FetchImpl;
+} = {}): Promise<QuotaResult<string | null, string, ProviderUsage>> => {
+  let auth: LegacyAuthFile | null | undefined = {};
+  try {
+    auth = (await readAuth()) ?? {};
+  } catch {
+    // The environment cookie is enough on its own; OpenCode need not answer.
+  }
+
+  const cookie = readCookie(auth);
+  if (!cookie) {
+    return buildResult({ providerId, providerName, ok: false, configured: false, error: 'Not configured' }) as QuotaResult<string | null, string, ProviderUsage>;
+  }
+
+  try {
+    const { windows, planLabel } = await fetchCommandCodeUsage(cookie, fetchImpl);
+    return buildResult({ providerId, providerName, ok: true, configured: true, usage: { windows }, planLabel }) as QuotaResult<string | null, string, ProviderUsage>;
+  } catch (error) {
+    return buildResult({
+      providerId,
+      providerName,
+      ok: false,
+      configured: true,
+      error: error instanceof Error ? error.message : 'Request failed'
+    }) as QuotaResult<string | null, string, ProviderUsage>;
+  }
+};
