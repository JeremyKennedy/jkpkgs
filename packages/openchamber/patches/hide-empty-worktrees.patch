+    draftGroupKeys: ReadonlySet<string>;
+    /** Work keys archived sessions hold a place at (`buildWorktreeArchiveAnchors`). */
+    archiveAnchors: ReadonlyMap<string, number>;
+    /** Normalized paths of the worktrees this client is removing now. */
+    removingDirectories: ReadonlySet<string>;
+    /**
+     * Whether the open, not yet stored new-session draft waits in this
