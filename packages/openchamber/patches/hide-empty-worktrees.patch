+/**
+ * A worktree work with nothing to show: no session in it, none archived
+ * (no archive anchor), no draft waiting there, no pin, and no removal running.
+ * The display setting leaves these rows out of every list; a search for the
+ * worktree's name still finds it, because the worktree still exists.
+ */
+export const isEmptyWorktreeWork = (
+  ref: SidebarWorkRef,
+  context: {
+    /** Work keys a draft waits in (`draftPlacement.byGroupKey`). */
+    draftGroupKeys: ReadonlySet<string>;
+    /** Work keys archived sessions hold a place at (`buildWorktreeArchiveAnchors`). */
+    archiveAnchors: ReadonlyMap<string, number>;
+    /** Normalized paths of the worktrees this client is removing now. */
+    removingDirectories: ReadonlySet<string>;
+    /**
+     * Whether the open, not yet stored new-session draft waits in this
+     * directory: a worktree the app just made for a task is in use.
+     */
+    hasOpenDraftIn: (directory: string | null) => boolean;
+  },
+): boolean => {
+  if (ref.kind !== 'group' || ref.group.worktree === null || ref.group.sessions.length > 0) return false;
+  if (ref.group.worktree.pinnedAt !== undefined) return false;
+  if (context.draftGroupKeys.has(ref.key) || context.archiveAnchors.has(ref.key)) return false;
+  if (context.hasOpenDraftIn(ref.group.directory ?? null)) return false;
+  const directory = normalizePath(ref.group.directory ?? null);
+  return !directory || !context.removingDirectories.has(directory);
+};
