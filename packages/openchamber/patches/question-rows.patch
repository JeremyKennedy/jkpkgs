+                </div>
+            </div>
+        </div>
+    );
+};
+
+/**
+ * A question call as its own transcript row: a purple card with each question
+ * and the answer it got on a rail, or a line saying it went unanswered. Show
+ * more opens the card in place (see `QuestionCard`). With the sticky user
+ * header on, an answered card sticks like a prompt until the next prompt or
+ * answered question pushes it up. A batch of questions scrolls away instead
+ * and leaves a one-line bar of its answers, which opens the card where it is.
+ */
+export const QuestionTurnHeader: React.FC<{
+    part: Part;
+    messageId: string;
+    /** The row starts its message, so it carries the message's anchor. */
+    startsMessage: boolean;
+    /** Set only by a copy that is not the row, such as the bar's opened card. */
+    open?: boolean;
+    onToggle?: (partId: string) => void;
+    /** Off in a fold's preview, where the card never sticks. */
+    pinnable?: boolean;
+    /** Drawn inside a message (a fold's preview), which already sets the column. */
+    nested?: boolean;
+}> = ({ part, messageId, startsMessage, open: controlledOpen, onToggle, pinnable = true, nested = false }) => {
+    const { isMobile } = useDeviceInfo();
+    const { t } = useI18n();
+    const autoExpandAnsweredQuestions = useUIStore((state) => state.autoExpandAnsweredQuestions);
+    // The reader's decision is one module cache, so the transcript row and a
+    // fold's preview of the same part draw the same state.
+    const readerOpen = useQuestionOpen(part.id, autoExpandAnsweredQuestions);
+    const open = controlledOpen ?? readerOpen;
+    const toggle = React.useCallback(() => {
+        if (onToggle) {
+            onToggle(part.id);
+            return;
+        }
+        writeQuestionOpen(part.id, !readerOpen);
+    }, [onToggle, part.id, readerOpen]);
+    const sticks = useUIStore((state) => state.stickyUserHeader);
+    const formsInChat = React.useContext(FormsInChatContext);
+    const entries = React.useMemo(() => questionEntriesForPart(part, messageId), [part, messageId]);
+    const answered = React.useMemo<AnsweredEntry[]>(
+        () => entries.map((entry) => ({ entry, answer: entry.answer ? withoutRecommendation(entry.answer.trim()) : '' })),
+        [entries],
+    );
+    const cardState = questionCardState(part);
+    const pinned = pinnable && sticks && cardState === 'answered';
+    const barred = pinned && answered.length > 1;
+    const { flowRef, covered } = useBarHandover(barred);
+    const [barOpen, setBarOpen] = React.useState(false);
+    React.useEffect(() => {
+        if (!covered) setBarOpen(false);
+    }, [covered]);
+
+    if (answered.length === 0 || cardState === null) return null;
+    // With questions in the chat, the waiting question is answered from its
+    // card at the transcript's end; this one appears once it is answered.
+    if (cardState === 'waiting' && formsInChat) return null;
+    // As the stock question row does, a waiting question shows in the
+    // transcript while the form at the composer takes the answer.
+    const statusText = t(cardState === 'waiting' ? 'chat.toolPart.awaitingResponse'
+        : cardState === 'dismissed' ? 'chat.questionCard.notAnswered'
+            : 'chat.questionCard.stoppedBeforeAnswer');
+    const card = (
+        <QuestionCard
+            answered={answered} cardState={cardState} statusText={statusText} open={open} onToggle={toggle}
+            nested={nested} isMobile={isMobile}
+            rowAttributes={{ 'data-question-turn-header': '', 'data-message-id': startsMessage ? messageId : undefined }}
+        />
+    );
+
+    if (!pinned) return card;
+    if (!barred) {
+        return (
+            <div className="pointer-events-auto sticky top-0 z-20 [overflow-anchor:none]" data-turn-sticky-header="" style={stickyHeaderBackground(isMobile)}>
+                {card}
+            </div>
+        );
+    }
+
+    const background = stickyHeaderBackground(isMobile);
+    return (
+        <div className="relative [overflow-anchor:none]">
+            <div ref={flowRef} style={{ transform: `translateY(calc(-1 * var(${STICKY_ROW_OFFSET}, 0px)))` }}>
+                {card}
+            </div>
+            {covered ? (
+                // What covers the top of the chat, so it is the sticky header
+                // the scroll helpers measure.
+                <div className="pointer-events-auto absolute inset-x-0 top-0 z-10" data-turn-sticky-header="" data-question-bar="" style={background}>
+                    {barOpen ? (
+                        <QuestionCard
+                            answered={answered} cardState={cardState} statusText={statusText} open onToggle={() => setBarOpen(false)}
+                            nested={false} isMobile={isMobile}
+                        />
+                    ) : (
+                        <div className={cn('chat-message-column relative', isMobile ? 'pt-2 pb-4' : 'pt-3 pb-8')}>
+                            <div className="flex justify-end">
+                                <button
+                                    type="button"
+                                    onClick={() => setBarOpen(true)}
+                                    aria-expanded={false}
+                                    className="flex min-w-0 max-w-[85%] items-center gap-2 border border-primary/5 px-3 py-1.5 text-start"
+                                    style={CARD_STYLE}
+                                >
+                                    <span aria-hidden="true" className="h-4 shrink-0 border-s-2" style={RAIL_STYLE} />
+                                    <span className="shrink-0 typography-meta text-foreground/70">
+                                        {t('chat.questionCard.answerCount', { count: answered.length })}
+                                    </span>
+                                    <span dir="auto" className="min-w-0 truncate typography-markdown font-medium leading-snug text-foreground">
+                                        {answered.map(({ answer }) => answer || statusText).join(', ')}
+                                    </span>
+                                </button>
+                            </div>
+                        </div>
+                    )}
+                </div>
+            ) : null}
+        </div>
+    );
+};
