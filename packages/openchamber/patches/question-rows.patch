+                                                    )}
+                                                </div>
+                                            ))}
+                                        </div>
+                                        {hiddenRows > 0 ? (
+                                            <div className="pt-1 typography-meta text-muted-foreground">
+                                                {t('chat.questionCard.moreQuestions', { count: hiddenRows })}
