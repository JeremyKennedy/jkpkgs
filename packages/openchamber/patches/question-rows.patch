+import { describe, expect, test } from 'bun:test';
+
+import type { Part, ToolPart } from '@/lib/opencode/model';
+import {
+    seedExpandedTools,
+    writeCollapsedQuestionsCache,
+    writeExpandedQuestionsCache,
+} from './questionExpandedState';
+
+const answeredQuestion = (id: string): ToolPart => ({
+    id,
+    sessionID: 'ses_1',
+    messageID: 'msg_assistant',
+    type: 'tool',
+    callID: id,
+    tool: 'question',
+    state: {
+        status: 'completed',
+        input: { questions: [{ question: 'Ship it?', options: [{ label: 'Yes' }] }] },
+        output: 'User has answered your questions: "Ship it?"="Yes". You can now continue with the user\'s answers in mind.',
+        metadata: {},
+        time: { start: 1, end: 2 },
+    },
+});
+
+const parts = (id: string): Part[] => [answeredQuestion(id)];
+
+describe('seedExpandedTools', () => {
+    test('opens an answered question while the setting is on', () => {
+        expect(seedExpandedTools('msg_setting_on', parts('call_on'), true)).toContain('call_on');
+    });
+
+    test('the setting toggle closes a row it opened', () => {
+        const messageId = 'msg_setting_off';
+        const question = parts('call_off');
+        expect(seedExpandedTools(messageId, question, true)).toContain('call_off');
+        expect(seedExpandedTools(messageId, question, false)).not.toContain('call_off');
+    });
+
+    test('a row the reader collapsed stays collapsed when it is shown again', () => {
+        const messageId = 'msg_reader_collapsed';
+        const question = parts('call_collapsed');
+        writeCollapsedQuestionsCache(messageId, new Set(['call_collapsed']));
+        expect(seedExpandedTools(messageId, question, true)).not.toContain('call_collapsed');
+        expect(seedExpandedTools(messageId, question, true)).not.toContain('call_collapsed');
+    });
+
+    test('a row the reader opened stays open while the setting is off', () => {
+        const messageId = 'msg_reader_open';
+        const question = parts('call_open');
+        writeExpandedQuestionsCache(messageId, new Set(['call_open']));
+        expect(seedExpandedTools(messageId, question, false)).toContain('call_open');
+    });
+});
