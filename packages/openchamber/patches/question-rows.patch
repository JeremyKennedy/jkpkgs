+                                    if (!open && !hasTextSelectionInside(event.currentTarget)) toggle();
+                                }}
+                            >
+                                {batch && !open ? (
+                                    <div className="min-w-0 border-s-2 ps-2.5" style={RAIL_STYLE}>
+                                        <div ref={listRef} className="relative grid grid-cols-[fit-content(40%)_minmax(0,1fr)] gap-x-2 gap-y-1 overflow-hidden">
+                                            {answered.map(({ entry, answer }, index) => (
+                                                <div
+                                                    key={`${entry.partId}:${index}`}
+                                                    data-question-row=""
+                                                    className="col-span-2 grid min-w-0 grid-cols-subgrid items-baseline"
+                                                >
+                                                    <span dir="auto" className="min-w-0 truncate typography-meta text-foreground/70" title={entry.question}>
+                                                        {entry.header || questionSentence(entry.question)}
+                                                    </span>
+                                                    {answer ? (
+                                                        <span dir="auto" className="min-w-0 line-clamp-2 break-words typography-markdown font-medium leading-snug text-foreground">
+                                                            {answer}
