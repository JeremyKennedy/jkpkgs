@@ -0,0 +1,251 @@
+import { describe, expect, test } from 'bun:test';
+
+import type { ChatMessageEntry } from './turns/types';
+import type { Part, ToolInput, ToolPart } from '@/lib/opencode/model';
+import {
+    buildQuestionEntriesByTurnId,
+    isAnsweredQuestionPart,
+    parseQuestionAnswers,
+    questionEntriesForPart,
+    readQuestionInput,
+    selectedOptionLabels,
+} from './questionEntries';
+
+const questionPart = (input: ToolInput, output?: string, id = 'call_1'): ToolPart => ({
+    id,
+    sessionID: 'ses_1',
+    messageID: 'msg_assistant',
+    type: 'tool',
+    callID: id,
+    tool: 'question',
+    state: output === undefined
+        ? { status: 'running', input, time: { start: 1 } }
+        : { status: 'completed', input, output, metadata: {}, time: { start: 1, end: 2 } },
+});
+
+const userMessage = (id: string, text: string): ChatMessageEntry => ({
+    info: { id, sessionID: 'ses_1', role: 'user', time: { created: 1 } },
+    parts: [{ id: `${id}:text:0`, sessionID: 'ses_1', messageID: id, type: 'text', text }],
+});
+
+const assistantMessage = (id: string, parts: Part[]): ChatMessageEntry => ({
+    info: {
+        id,
+        sessionID: 'ses_1',
+        role: 'assistant',
+        time: { created: 1 },
+        agent: 'build',
+        providerID: 'test',
+        modelID: 'test',
+    },
+    parts,
+});
+
+const compactionMessage = (id: string): ChatMessageEntry => ({
+    info: {
+        id,
+        sessionID: 'ses_1',
+        role: 'compaction',
+        time: { created: 2 },
+        status: 'completed',
+        reason: 'auto',
+        summary: 'Earlier context was compacted.',
+    },
+    parts: [],
+});
+
+const answered = (pairs: Array<[string, string]>): string =>
+    `User has answered your questions: ${pairs.map(([q, a]) => `"${q}"="${a}"`).join(', ')}. You can now continue with the user's answers in mind.`;
+
+describe('readQuestionInput', () => {
+    test('reads questions, headers, options and multi-select', () => {
+        expect(readQuestionInput({
+            questions: [
+                {
+                    header: 'Ship it',
+                    question: 'Ship it?',
+                    options: [{ label: 'Yes', description: 'Merge now' }, { label: 'No' }],
+                    multiple: true,
+                },
+                { question: 'Why?', options: [] },
+            ],
+        })).toEqual([
+            {
+                header: 'Ship it',
+                question: 'Ship it?',
+                options: [{ label: 'Yes', description: 'Merge now' }, { label: 'No' }],
+                multiple: true,
+            },
+            { header: undefined, question: 'Why?', options: [], multiple: false },
+        ]);
+    });
+
+    test('skips malformed entries and an input without questions', () => {
+        expect(readQuestionInput({ questions: [{ question: '   ' }, { options: [{ label: 'x' }] }, 'nope'] })).toEqual([]);
+        expect(readQuestionInput({})).toEqual([]);
+        expect(readQuestionInput(undefined)).toEqual([]);
+    });
+});
+
+describe('parseQuestionAnswers', () => {
+    test('reads each question and answer pair, escapes included', () => {
+        expect(parseQuestionAnswers(answered(
+            [['Ship it?', 'Yes'], ['Why \\"now\\"?', 'Because \\"it\\" is ready']],
+        ))).toEqual([
+            { question: 'Ship it?', answer: 'Yes' },
+            { question: 'Why "now"?', answer: 'Because "it" is ready' },
+        ]);
+    });
+
+    test('returns null when the reply is not an answer', () => {
+        expect(parseQuestionAnswers('User dismissed your questions.')).toBeNull();
+        expect(parseQuestionAnswers('')).toBeNull();
+    });
+});
+
+describe('questionEntriesForPart', () => {
+    test('matches answers to the questions that were asked', () => {
+        const input = { questions: [{ header: 'Ship it', question: 'Ship it?', options: [{ label: 'Yes' }, { label: 'No' }] }] };
+        const entries = questionEntriesForPart(questionPart(input, answered([['Ship it?', 'Yes']])), 'msg_assistant');
+        expect(entries).toHaveLength(1);
+        expect(entries[0]).toMatchObject({
+            messageId: 'msg_assistant',
+            header: 'Ship it',
+            question: 'Ship it?',
+            options: [{ label: 'Yes' }, { label: 'No' }],
+            multiple: false,
+            answer: 'Yes',
+        });
+    });
+
+    test('gives each of two identically worded questions its own answer', () => {
+        const input = {
+            questions: [
+                { question: 'Which branch?', options: [{ label: 'main' }, { label: 'dev' }] },
+                { question: 'Which branch?', options: [{ label: 'main' }, { label: 'dev' }] },
+            ],
+        };
+        const entries = questionEntriesForPart(
+            questionPart(input, answered([['Which branch?', 'main'], ['Which branch?', 'dev']])),
+            'msg_assistant',
+        );
+        expect(entries.map((entry) => entry.answer)).toEqual(['main', 'dev']);
+    });
+
+    test('leaves an unanswered question open and marks it pending while the call runs', () => {
+        const input = { questions: [{ question: 'Ship it?', options: [{ label: 'Yes' }] }] };
+        const [entry] = questionEntriesForPart(questionPart(input), 'msg_assistant');
+        expect(entry.answer).toBeNull();
+        expect(entry.pending).toBe(true);
+        const [answeredEntry] = questionEntriesForPart(questionPart(input, answered([['Ship it?', 'Yes']])), 'msg_assistant');
+        expect(answeredEntry.pending).toBe(false);
+    });
+
+    test('reads a reply whose input is gone', () => {
+        const [entry] = questionEntriesForPart(
+            questionPart({}, answered([['Ship it?', 'Yes']])),
+            'msg_assistant',
+        );
+        expect(entry).toMatchObject({ question: 'Ship it?', answer: 'Yes', options: [] });
+    });
+
+    test('ignores other tools and unfinished calls', () => {
+        const shellPart: Part = { ...questionPart({}), tool: 'shell' };
+        expect(questionEntriesForPart(shellPart, 'msg_assistant')).toEqual([]);
+        expect(isAnsweredQuestionPart(questionPart({ questions: [{ question: 'Q' }] }))).toBe(false);
+        expect(isAnsweredQuestionPart(questionPart({ questions: [{ question: 'Q' }] }, answered([['Q', 'A']])))).toBe(true);
+    });
+});
+
+describe('selectedOptionLabels', () => {
+    const options = [{ label: 'Yes' }, { label: 'No' }, { label: 'Later' }];
+
+    test('matches a single answer and a joined multi-select answer whole', () => {
+        expect([...selectedOptionLabels(options, 'Yes', false)]).toEqual(['Yes']);
+        expect([...selectedOptionLabels(options, 'Yes, Later', true)]).toEqual(['Yes', 'Later']);
+    });
+
+    test('matches the option the question tool marked as recommended', () => {
+        expect([...selectedOptionLabels(options, 'Yes (Recommended)', false)]).toEqual(['Yes']);
+        expect([...selectedOptionLabels(options, 'Yes, Later (Recommended)', true)]).toEqual(['Yes', 'Later']);
+    });
+
+    test('marks a recommended pick in the middle of a multi-select reply', () => {
+        expect([...selectedOptionLabels(options, 'Later (Recommended), Yes', true)]).toEqual(['Yes', 'Later']);
+    });
+
+    test('keeps a label that itself ends with the recommendation marker', () => {
+        expect([...selectedOptionLabels([{ label: 'Yes (Recommended)' }], 'Yes (Recommended)', false)]).toEqual(['Yes (Recommended)']);
+    });
+
+    test('does not split a label that contains a comma when the answer is that label', () => {
+        expect([...selectedOptionLabels([{ label: 'Yes, please' }, { label: 'No' }], 'Yes, please', true)]).toEqual(['Yes, please']);
+    });
+
+    test('parses a joined multi-select reply whose labels contain commas', () => {
+        expect([...selectedOptionLabels([{ label: 'Yes, please' }, { label: 'No' }], 'Yes, please, No', true)])
+            .toEqual(['Yes, please', 'No']);
+    });
+
+    test('a single-select answer names an option only when it is that label', () => {
+        expect([...selectedOptionLabels(options, 'Yes, but later', false)]).toEqual([]);
+    });
+
+    test('matches nothing for a free-form answer', () => {
+        expect([...selectedOptionLabels(options, 'Something else', false)]).toEqual([]);
+        expect([...selectedOptionLabels(options, 'Something else', true)]).toEqual([]);
+        expect([...selectedOptionLabels(options, null, false)]).toEqual([]);
+    });
+});
+
+describe('question builders', () => {
+    const turnPart = questionPart(
+        { questions: [{ question: 'Ship it?', options: [{ label: 'Yes' }, { label: 'No' }] }] },
+        answered([['Ship it?', 'Yes']]),
+    );
+    const openPart = questionPart(
+        { questions: [{ question: 'Why?', options: [{ label: 'Because' }] }] },
+        undefined,
+        'call_2',
+    );
+    const messages: ChatMessageEntry[] = [
+        userMessage('msg_user', 'Deploy the release'),
+        assistantMessage('msg_assistant', [turnPart, openPart]),
+    ];
+
+    test('answered questions attach to the turn that asked them', () => {
+        const byTurn = buildQuestionEntriesByTurnId(messages);
+        expect([...byTurn.keys()]).toEqual(['msg_user']);
+        expect(byTurn.get('msg_user')?.map((entry) => entry.answer)).toEqual(['Yes']);
+        expect(byTurn.get('msg_user')?.[0]).toMatchObject({ question: 'Ship it?', answer: 'Yes' });
+    });
+
+    test('an unanswered question stays out of the selector and the timeline', () => {
+        const byTurn = buildQuestionEntriesByTurnId(messages);
+        expect(byTurn.get('msg_user')?.some((entry) => entry.question === 'Why?')).toBe(false);
+    });
+
+    test('a question keeps its turn when the prompt has no readable text', () => {
+        const byTurn = buildQuestionEntriesByTurnId([
+            userMessage('msg_empty', ''),
+            assistantMessage('msg_assistant', [turnPart]),
+        ]);
+        expect(byTurn.get('msg_empty')?.map((entry) => entry.question)).toEqual(['Ship it?']);
+    });
+
+    test('a question asked after a mid-run compaction anchors to the compaction turn', () => {
+        const byTurn = buildQuestionEntriesByTurnId([
+            userMessage('msg_user', 'Deploy the release'),
+            compactionMessage('msg_compact'),
+            assistantMessage('msg_assistant', [turnPart]),
+        ]);
+        expect([...byTurn.keys()]).toEqual(['msg_compact']);
+        expect(byTurn.get('msg_compact')?.[0]).toMatchObject({ question: 'Ship it?', answer: 'Yes' });
+    });
+
+    test('rebuilding unchanged messages keeps the same entry array', () => {
+        const first = buildQuestionEntriesByTurnId(messages);
+        const second = buildQuestionEntriesByTurnId(messages);
+        expect(second.get('msg_user')).toBe(first.get('msg_user'));
+    });
+});
diff --git a/packages/ui/src/components/chat/lib/questionEntries.ts b/packages/ui/src/components/chat/lib/questionEntries.ts
new file mode 100644
index 000000000..bc8236ea0
--- /dev/null
+++ b/packages/ui/src/components/chat/lib/questionEntries.ts
@@ -0,0 +1,301 @@
+/**
+ * The questions an assistant turn asked and the answers the user gave.
+ *
+ * The question tool keeps its options in the call input and the user's reply in
+ * the call output, so both survive a message page. These readers turn that pair
+ * into the entries the transcript, the prompt selector and the timeline draw.
+ */
+
+import { z } from 'zod';
+
+import type { ChatMessageEntry } from './turns/types';
+import { buildTurnWindowModel, type TurnWindowModel } from './turns/windowTurns';
+import { isQuestionTool } from '@/lib/opencode/tools';
+import type { Part, ToolInput } from '@/lib/opencode/model';
+
+export interface QuestionOption {
+    label: string;
+    description?: string;
+}
+
+interface QuestionAsked {
+    header?: string;
+    question: string;
+    options: QuestionOption[];
+    multiple: boolean;
+}
+
+export interface QuestionAnswerEntry {
+    partId: string;
+    messageId: string;
+    header?: string;
+    question: string;
+    options: QuestionOption[];
+    multiple: boolean;
+    /** The reply the user gave, or null when the question was not answered. */
+    answer: string | null;
+    /** True while the call still waits for the reply. */
+    pending: boolean;
+}
+
+interface QuestionAnswerPair {
+    question: string;
+    answer: string;
+}
+
+const questionOptionSchema = z.object({
+    label: z.string().trim().min(1),
+    description: z.string().trim().optional(),
+});
+
+const questionAskedSchema = z.object({
+    header: z.string().trim().optional(),
+    question: z.string().trim().min(1),
+    options: z.array(questionOptionSchema).optional(),
+    multiple: z.boolean().optional(),
+});
+
+const questionInputSchema = z.object({
+    questions: z.array(questionAskedSchema),
+});
+
+/** The questions a question call asked, in the order the call stored them. */
+export const readQuestionInput = (input: ToolInput | undefined): QuestionAsked[] => {
+    const parsed = questionInputSchema.safeParse(input);
+    if (!parsed.success) return [];
+    return parsed.data.questions.map((question) => ({
+        header: question.header || undefined,
+        question: question.question,
+        options: (question.options ?? []).map((option) => (
+            option.description ? { label: option.label, description: option.description } : { label: option.label }
+        )),
+        multiple: question.multiple === true,
+    }));
+};
+
+const unescapeQuoted = (value: string): string => value.replace(/\\(["\\])/g, '$1');
+
+/**
+ * The question tool appends this marker to the option it recommends, so the
+ * recorded answer carries it even though the option's label does not. Matching
+ * the label needs the marker gone.
+ */
+const RECOMMENDATION_SUFFIX = ' (Recommended)';
+export const withoutRecommendation = (value: string): string => (
+    value.endsWith(RECOMMENDATION_SUFFIX)
+        ? value.slice(0, -RECOMMENDATION_SUFFIX.length)
+        : value
+);
+
+/**
+ * Parses the question tool's reply:
+ * `User has answered your questions: "Q1"="A1", "Q2"="A2". You can now…`
+ */
+export const parseQuestionAnswers = (output: string): QuestionAnswerPair[] | null => {
+    const match = output.match(/^User has answered your questions:\s*(.+?)\.\s*You can now/s);
+    if (!match) return null;
+
+    const pairs: QuestionAnswerPair[] = [];
+    // A quoted string with backslash escapes on both sides; an answer may carry
+    // a quote the user typed.
+    const pairRegex = /"((?:[^"\\]|\\.)*)"="((?:[^"\\]|\\.)*)"/g;
+    let pairMatch: RegExpExecArray | null;
+    while ((pairMatch = pairRegex.exec(match[1])) !== null) {
+        pairs.push({
+            question: unescapeQuoted(pairMatch[1]),
+            answer: unescapeQuoted(pairMatch[2]),
+        });
+    }
+    return pairs.length > 0 ? pairs : null;
+};
+
+const answerForQuestion = (
+    question: string,
+    index: number,
+    answers: QuestionAnswerPair[],
+): string | null => {
+    // The tool writes the answers in the order it asked the questions, so the
+    // pair at this index is this question's answer. Matching by text first
+    // would hand the first answer to every entry when a call asks the same
+    // question text twice.
+    const indexed = answers[index];
+    if (indexed && indexed.question === question) return indexed.answer;
+    const exact = answers.find((pair) => pair.question === question);
+    if (exact) return exact.answer;
+    return indexed?.answer ?? null;
+};
+
+/** One question call's entries, with its answers matched back to its questions. */
+export const questionEntriesForPart = (part: Part, messageId: string): QuestionAnswerEntry[] => {
+    if (part.type !== 'tool' || !isQuestionTool(part.tool)) return [];
+
+    const state = part.state;
+    const asked = readQuestionInput(state.input);
+    const output = state.status === 'completed' ? state.output : '';
+    const answers = output ? parseQuestionAnswers(output) ?? [] : [];
+    const pending = state.status === 'pending' || state.status === 'running';
+
+    if (asked.length === 0) {
+        return answers.map((pair, index) => ({
+            partId: `${part.id}:${index}`,
+            messageId,
+            question: pair.question,
+            options: [],
+            multiple: false,
+            answer: pair.answer,
+            pending: false,
+        }));
+    }
+
+    return asked.map((question, index) => ({
+        partId: `${part.id}:${index}`,
+        messageId,
+        header: question.header,
+        question: question.question,
+        options: question.options,
+        multiple: question.multiple,
+        answer: answerForQuestion(question.question, index, answers),
+        pending,
+    }));
+};
+
+/** Whether a question call finished with at least one answer. */
+export const isAnsweredQuestionPart = (part: Part): boolean => {
+    if (part.type !== 'tool' || !isQuestionTool(part.tool)) return false;
+    if (part.state.status !== 'completed') return false;
+    return (parseQuestionAnswers(part.state.output)?.length ?? 0) > 0;
+};
+
+/**
+ * Splits a multi-select reply into the labels it names. The reply is the
+ * chosen labels joined with `, `, and a label may itself contain a comma, so
+ * the longest label wins at each step; a reply that does not decompose into
+ * labels is not a set of picks.
+ */
+const parseJoinedLabels = (reply: string, labels: readonly string[]): string[] | null => {
+    const candidates = [...new Set(labels)].sort((a, b) => b.length - a.length);
+    const walk = (rest: string): string[] | null => {
+        if (rest.length === 0) return [];
+        for (const label of candidates) {
+            if (!rest.startsWith(label)) continue;
+            const after = rest.slice(label.length);
+            if (after.length === 0) return [label];
+            if (!after.startsWith(', ')) continue;
+            const tail = walk(after.slice(2));
+            if (tail) return [label, ...tail];
+        }
+        return null;
+    };
+    return walk(reply);
+};
+
+/**
+ * The labels among `options` that the answer names. A single-select answer
+ * names an option only when it is that label exactly; a multi-select reply is
+ * the chosen labels joined, so it is parsed as a sequence of whole labels.
+ */
+export const selectedOptionLabels = (
+    options: readonly QuestionOption[],
+    answer: string | null,
+    multiple: boolean,
+): Set<string> => {
+    const selected = new Set<string>();
+    if (!answer) return selected;
+    const trimmed = answer.trim();
+    if (!trimmed) return selected;
+
+    const labels = options.map((option) => option.label);
+    // The tool marks its recommended option in the recorded answer, so the
+    // label match has to ignore that marker.
+    const bare = withoutRecommendation(trimmed);
+    const exact = labels.find((label) => label === trimmed || label === bare);
+    if (exact) {
+        selected.add(exact);
+        return selected;
+    }
+    if (!multiple) return selected;
+
+    const parsed = parseJoinedLabels(bare, labels) ?? parseJoinedLabels(trimmed, labels);
+    if (parsed) {
+        for (const label of parsed) selected.add(label);
+        return selected;
+    }
+
+    // A reply that is not exactly the joined labels (free text alongside picks)
+    // still marks the labels it names as whole comma segments. The tool's
+    // recommendation marker can sit on any pick, not only the last one.
+    const segments = trimmed.split(/\s*,\s*/).map((segment) => segment.trim());
+    const bareSegments = segments.map(withoutRecommendation);
+    for (const label of labels) {
+        if (segments.includes(label) || bareSegments.includes(label)) selected.add(label);
+    }
+    return selected;
+};
+
+/**
+ * The turn whose opening is the latest at or before `index`. The turn model's
+ * ordered openings place a step after a mid-run compaction in the compaction's
+ * turn; v2 assistant messages carry no parent id, so the position is what
+ * anchors them.
+ */
+const turnIdForMessageIndex = (model: TurnWindowModel, index: number): string | null => {
+    let turnId: string | null = null;
+    for (let position = 0; position < model.turnMessageStartIndexes.length; position += 1) {
+        if (model.turnMessageStartIndexes[position] > index) break;
+        turnId = model.turnIds[position] ?? turnId;
+    }
+    return turnId;
+};
+
+/**
+ * The answered entries a turn's question parts carry. Cached by the parts
+ * sequence, so a rebuild over unchanged messages hands the caller the same
+ * array and a memoized consumer can keep its previous map.
+ */
+const turnQuestionEntriesCache = new WeakMap<Part, { parts: readonly Part[]; entries: QuestionAnswerEntry[] }>();
+
+const entriesForQuestionParts = (parts: readonly Part[]): QuestionAnswerEntry[] => {
+    const first = parts[0];
+    if (!first) return [];
+    const cached = turnQuestionEntriesCache.get(first);
+    if (cached && cached.parts.length === parts.length && cached.parts.every((part, index) => part === parts[index])) {
+        return cached.entries;
+    }
+    const entries: QuestionAnswerEntry[] = [];
+    for (const part of parts) {
+        entries.push(...questionEntriesForPart(part, part.messageID).filter((entry) => entry.answer !== null));
+    }
+    turnQuestionEntriesCache.set(first, { parts: [...parts], entries });
+    return entries;
+};
+
+/**
+ * Answered questions keyed by the turn they were asked in, for the prompt
+ * selector and the timeline. The turn comes from the same fold/turn model the
+ * transcript uses (`buildTurnWindowModel`), so a question keeps its row when
+ * its prompt has no readable text, and a question asked after a mid-run
+ * compaction belongs to the turn the compaction opened.
+ */
+export const buildQuestionEntriesByTurnId = (
+    messages: readonly ChatMessageEntry[],
+): Map<string, QuestionAnswerEntry[]> => {
+    const model = buildTurnWindowModel([...messages]);
+    const partsByTurn = new Map<string, Part[]>();
+    messages.forEach((message, index) => {
+        if (message.info.role !== 'assistant') return;
+        const turnId = turnIdForMessageIndex(model, index);
+        if (!turnId) return;
+        for (const part of message.parts) {
+            if (part.type !== 'tool' || !isQuestionTool(part.tool)) continue;
+            const parts = partsByTurn.get(turnId) ?? [];
+            parts.push(part);
+            partsByTurn.set(turnId, parts);
+        }
+    });
+    const byTurn = new Map<string, QuestionAnswerEntry[]>();
+    for (const [turnId, parts] of partsByTurn) {
+        const entries = entriesForQuestionParts(parts);
+        if (entries.length > 0) byTurn.set(turnId, entries);
+    }
+    return byTurn;
+};
