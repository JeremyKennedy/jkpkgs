+/**
+ * The catalog could not be read and nothing is loaded. Distinct from an empty
+ * ready list: the phone must say the read failed instead of "no extensions",
+ * or a server without `GET /api/guests` looks like a clean install. A failed
+ * refresh of a catalog already loaded keeps `status: 'ready'` and its guests,
+ * so it does not raise this.
+ */
+export const useGuestCatalogFailed = (): boolean => useGuestsStore((state) => state.status === 'error');
