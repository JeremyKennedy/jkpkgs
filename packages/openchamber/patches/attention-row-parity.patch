index 000000000..fa98b343a
--- /dev/null
+++ b/packages/ui/src/lib/instanceAttentionRows.ts
@@ -0,0 +1,168 @@
+import { z } from 'zod';
+
+import {
+  buildSidebarRowBase,
+  resolveSessionRowOf,
+  type SidebarRowSources,
+} from '@/components/session/sidebar/list/sidebarRows';
+import { chatRootsMatcher, legacyRootForHome } from '@/lib/chatDirectories';
+import type { JsonValue, Session } from '@/lib/opencode/model';
+import { projectSession } from '@/lib/opencode/projection';
+import { normalizePath } from '@/lib/pathNormalization';
+import { addRuntimeProxyHeaders } from '@/lib/runtime-fetch';
+import { getRuntimeKey } from '@/lib/runtime-switch';
+import { getPinnedSessionKey, isSessionPinnedInMetadata } from '@/lib/sessionPins';
+import type { WorktreeMetadata } from '@/types/worktree';
+
+const NO_TOKENS = { input: 0, output: 0, reasoning: 0, cache: { read: 0, write: 0 } };
+
+const sessionRecordSchema = z.object({
+  id: z.string().min(1),
+  parentID: z.string().optional().catch(undefined),
+  projectID: z.string().catch(''),
+  location: z.object({ directory: z.string() }).passthrough(),
+  title: z.string().optional().catch(undefined),
+  cost: z.number().catch(0),
+  tokens: z.object({
+    input: z.number(),
+    output: z.number(),
+    reasoning: z.number(),
+    cache: z.object({ read: z.number(), write: z.number() }).passthrough(),
+  }).passthrough().catch(NO_TOKENS),
+  outcome: z.enum(['succeeded', 'failed', 'interrupted']).optional().catch(undefined),
+  time: z.object({
+    created: z.number().optional().catch(undefined),
+    updated: z.number(),
+    idle: z.number().optional().catch(undefined),
+    viewed: z.number().optional().catch(undefined),
+    archived: z.number().optional().catch(undefined),
+  }).passthrough(),
+  metadata: z.record(z.string(), z.json()).optional().catch(undefined),
+  fork: z.object({
+    sessionID: z.string(),
+    boundary: z.object({ type: z.enum(['before', 'through']), messageID: z.string() }),
+  }).optional().catch(undefined),
+}).passthrough();
+
+export const projectSessionRecords = (records: readonly unknown[]): Session[] | null => {
+  const sessions = records.flatMap((record) => {
+    const parsed = sessionRecordSchema.safeParse(record);
+    if (!parsed.success) return [];
+    const { time } = parsed.data;
+    return [projectSession({ ...parsed.data, time: { ...time, created: time.created ?? time.updated } })];
+  });
+  return records.length > 0 && sessions.length === 0 ? null : sessions;
+};
+
+const settingsSchema = z.object({
+  projects: z.array(z.object({ id: z.string().optional(), path: z.string() }).passthrough()).optional(),
+}).passthrough();
+
+const homeSchema = z.object({
+  home: z.string(),
+  chatsRoot: z.string().optional(),
+  canonicalChatsRoot: z.string().optional(),
+  canonicalLegacyChatsRoot: z.string().optional(),
+}).passthrough();
+
+const worktreeListSchema = z.array(z.object({ path: z.string(), branch: z.string().optional() }).passthrough());
+
+export const readHostWorktrees = async (
+  url: string,
+  directories: readonly string[],
+  headers: Headers,
+  fetchImpl: typeof fetch,
+  signal: AbortSignal | undefined,
+): Promise<Map<string, WorktreeMetadata[]>> => {
+  const byProject = new Map<string, WorktreeMetadata[]>();
+  if (directories.length === 0) return byProject;
+  let projects: unknown;
+  try {
+    addRuntimeProxyHeaders(url, headers);
+    const response = await fetchImpl(url, {
+      method: 'POST',
+      headers: new Headers({ ...Object.fromEntries(headers), 'Content-Type': 'application/json' }),
+      body: JSON.stringify({ directories }),
+      signal,
+    });
+    if (!response.ok) return byProject;
+    const body = await response.json().catch(() => null);
+    projects = z.object({ projects: z.unknown() }).passthrough().safeParse(body).data?.projects;
+  } catch {
+    return byProject;
+  }
+  const parsed = z.array(z.object({
+    directory: z.string(),
+    worktrees: worktreeListSchema.nullable().optional(),
+  }).passthrough()).safeParse(projects);
+  if (!parsed.success) return byProject;
+  for (const project of parsed.data) {
+    const projectDirectory = normalizePath(project.directory);
+    if (!projectDirectory) continue;
+    const worktrees = (project.worktrees ?? []).flatMap((worktree): WorktreeMetadata[] => {
+      const path = normalizePath(worktree.path);
+      const branch = worktree.branch?.replace(/^refs\/heads\//, '').trim() ?? '';
+      return path ? [{ path, projectDirectory, branch, label: branch }] : [];
+    });
+    if (worktrees.length > 0) byProject.set(projectDirectory, worktrees);
+  }
+  return byProject;
+};
+
+type InstanceFolders = Pick<SidebarRowSources, 'projects' | 'worktreesByProject' | 'isChatDirectory'>;
+
+export const readInstanceFolders = async (
+  read: (path: string) => Promise<JsonValue | null>,
+  readWorktrees: (directories: readonly string[]) => Promise<Map<string, WorktreeMetadata[]>>,
+): Promise<InstanceFolders | undefined> => {
+  const [settingsPayload, homePayload] = await Promise.all([
+    read('/api/config/settings'),
+    read('/api/fs/home'),
+  ]);
+  const settings = settingsSchema.safeParse(settingsPayload);
+  const home = homeSchema.safeParse(homePayload);
+  if (!settings.success || !home.success) return undefined;
+  const chatRoots = [
+    home.data.chatsRoot,
+    home.data.canonicalChatsRoot,
+    home.data.canonicalLegacyChatsRoot,
+    legacyRootForHome(home.data.home),
+  ].flatMap((root) => {
+    const normalized = normalizePath(root);
+    return normalized ? [normalized] : [];
+  });
+  const projects = (settings.data.projects ?? []).flatMap((project) => {
+    const path = normalizePath(project.path);
+    return path ? [{ id: project.id ?? path, path }] : [];
+  });
+  return {
+    projects,
+    worktreesByProject: await readWorktrees(projects.map((project) => project.path)),
+    isChatDirectory: chatRootsMatcher(chatRoots),
+  };
+};
+
+export const instanceSidebarRows = (
+  sessions: readonly Session[],
+  spaces: SidebarRowSources['spaces'],
+  folders: InstanceFolders,
+  unresolved: ReadonlySet<string> = new Set(),
+): ReadonlyMap<string, string | null> => {
+  const runtimeKey = getRuntimeKey();
+  const pinnedSessionIds = new Set(sessions.flatMap((session) => {
+    if (!isSessionPinnedInMetadata(session)) return [];
+    const key = getPinnedSessionKey(runtimeKey, session.directory, session.id);
+    return key ? [key] : [];
+  }));
+  const base = buildSidebarRowBase({
+    activeSessions: sessions.filter((session) => session.time.archived === undefined),
+    archivedSessions: sessions.filter((session) => session.time.archived !== undefined),
+    liveSessions: [],
+    spaces,
+    authoritativeProjects: [],
+    ...folders,
+  });
+  const rowOf = new Map(resolveSessionRowOf(base, sessions, pinnedSessionIds));
+  for (const sessionId of unresolved) rowOf.delete(sessionId);
+  return rowOf;
+};
