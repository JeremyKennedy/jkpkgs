+  { kind: 'archived unread session', records: [record('ses_archived', PROJECT, archived)], worktrees: [], items: [] },
+  {
+    kind: 'unread session in a folder outside every project',
+    records: [record('ses_outside', '/tmp/opencode/qcards-proj', unseen)],
+    waiting: ['ses_outside'],
+    worktrees: [],
