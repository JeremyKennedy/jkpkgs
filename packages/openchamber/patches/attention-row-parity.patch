+const permission = (sessionId: string) => ({ id: `per_${sessionId}`, sessionID: sessionId, action: 'edit', resources: ['file'] });
+
+type Fixture = {
+  kind: string;
+  records: SessionInfo[];
+  /** Sessions with a pending permission. */
+  waiting?: string[];
+  /** The worktrees this instance knows besides its project root. */
+  worktrees: string[];
+  /** The rows the attention list must show, as [row, kind]. */
+  items: Array<[string, string]>;
+  /** Sessions the instance holds beyond the page the poller lists; read one by one. */
+  offPage?: SessionInfo[];
+  /** Reads that fail on the polled host. */
+  fails?: { settings?: boolean; detail?: string[] };
+  /** Fields the polled host leaves out of its session records. */
+  omitOnWire?: string[];
+  /** What the poller must still show when a read failed: unsure means shown. */
+  polledItems?: Array<[string, string]>;
+};
+
+const fixtures: Fixture[] = [
+  { kind: 'plain unread session', records: [record('ses_plain', PROJECT, unseen)], worktrees: [], items: [['ses_plain', 'unread']] },
+  { kind: 'seen session', records: [record('ses_seen', PROJECT)], worktrees: [], items: [] },
+  {
+    kind: 'subagent with a pending permission',
+    records: [record('ses_parent', PROJECT), record('ses_sub', PROJECT, { parentID: 'ses_parent', ...unseen })],
+    waiting: ['ses_sub'],
+    worktrees: [],
+    items: [['ses_parent', 'permission']],
+  },
+  {
+    // The reported session: dispatched with ownWork, so OpenCode stores no
+    // parentID and the link lives in metadata only. Unread, not archived, in
+    // an agent worktree; its parent is a read lead session in the project.
+    kind: 'operator child in an agent worktree the instance knows',
+    records: [
+      record('ses_lead', PROJECT, { metadata: { openchamber: { lead: { at: 1 } } } }),
+      record('ses_df1c7a4ebffe7h7gU5tWp7sAx7', AGENT_WORKTREE, {
+        title: 'Fix PR 7460 review',
+        metadata: { openchamber: { kind: 'operator-child', parentID: 'ses_lead' } },
+        outcome: 'succeeded',
+        ...unseen,
+      }),
+    ],
+    worktrees: [AGENT_WORKTREE],
+    items: [],
+  },
+  {
+    kind: 'operator child in an agent worktree the instance does not know',
+    records: [
+      record('ses_lead', PROJECT, { metadata: { openchamber: { lead: { at: 1 } } } }),
+      record('ses_df1c7a4ebffe7h7gU5tWp7sAx7', AGENT_WORKTREE, {
+        title: 'Fix PR 7460 review',
+        metadata: { openchamber: { kind: 'operator-child', parentID: 'ses_lead' } },
+        ...unseen,
+      }),
+    ],
+    worktrees: [],
+    items: [],
+  },
+  {
+    kind: 'operator child with a pending permission',
+    records: [
+      record('ses_lead', PROJECT),
+      record('ses_child', AGENT_WORKTREE, { metadata: { openchamber: { kind: 'operator-child', parentID: 'ses_lead' } } }),
+    ],
+    waiting: ['ses_child'],
+    worktrees: [AGENT_WORKTREE],
+    items: [['ses_lead', 'permission']],
+  },
+  {
+    // A review session nests under the session it reviews, without a parentID;
+    // the sidebar rolls its unseen turn into the original's row.
+    kind: 'review session of a read original',
+    records: [
+      record('ses_origin', PROJECT),
+      record('ses_review', PROJECT, { title: 'Review: ses_origin', metadata: { openchamber: { kind: 'review', originalSessionID: 'ses_origin' } }, ...unseen }),
+    ],
+    worktrees: [],
+    items: [['ses_origin', 'unread']],
+  },
+  {
+    kind: 'session the user marked unread',
+    records: [record('ses_marked', PROJECT, { metadata: { openchamber: { markedUnread: { at: 5 } } } })],
+    worktrees: [],
+    items: [['ses_marked', 'unread']],
+  },
+  {
+    kind: 'failed settings read on the polled host',
+    records: [record('ses_plain', PROJECT, unseen), record('ses_outside', '/tmp/opencode/qcards-proj', unseen)],
+    waiting: ['ses_outside'],
+    worktrees: [],
+    items: [['ses_plain', 'unread']],
+    fails: { settings: true },
+    polledItems: [['ses_outside', 'permission'], ['ses_plain', 'unread']],
+  },
+  {
+    kind: 'off-page pending session whose detail read fails',
+    records: [record('ses_plain', PROJECT)],
+    offPage: [record('ses_offpage', PROJECT)],
+    waiting: ['ses_offpage'],
+    worktrees: [],
+    items: [['ses_offpage', 'permission']],
+    fails: { detail: ['ses_offpage'] },
+  },
+  {
+    // A dispatched child in an agent worktree the instance does not list,
+    // whose parent also fell off the page: the parent is read too.
+    kind: 'off-page pending child with an off-page parent',
+    records: [record('ses_plain', PROJECT)],
+    offPage: [
+      record('ses_lead', PROJECT),
+      record('ses_child', AGENT_WORKTREE, { metadata: { openchamber: { kind: 'operator-child', parentID: 'ses_lead' } } }),
+    ],
+    waiting: ['ses_child'],
+    worktrees: [],
+    items: [['ses_lead', 'permission']],
+  },
+  {
+    kind: 'off-page pending child whose parent cannot be read',
+    records: [record('ses_plain', PROJECT)],
+    offPage: [
+      record('ses_lead', PROJECT),
+      record('ses_child', AGENT_WORKTREE, { metadata: { openchamber: { kind: 'operator-child', parentID: 'ses_lead' } } }),
+    ],
+    waiting: ['ses_child'],
+    worktrees: [],
+    items: [['ses_lead', 'permission']],
+    fails: { detail: ['ses_lead'] },
+    polledItems: [['ses_child', 'permission']],
+  },
+  {
+    kind: 'record without the fields the row rule does not read',
+    records: [record('ses_bare', PROJECT, unseen)],
+    omitOnWire: ['projectID', 'cost', 'tokens', 'title'],
+    worktrees: [],
+    items: [['ses_bare', 'unread']],
+  },
+  {
+    kind: '/btw session with a pending permission',
+    records: [
+      record('ses_origin', PROJECT),
+      record('ses_btw', PROJECT, { metadata: { openchamber: { kind: 'btw', originalSessionID: 'ses_origin' } } }),
+    ],
+    waiting: ['ses_btw'],
+    worktrees: [],
+    items: [['ses_origin', 'permission']],
+  },
+  {
+    kind: 'session marked unread after its failed turn was seen',
+    records: [record('ses_marked_failed', PROJECT, {
+      outcome: 'failed',
+      metadata: { openchamber: { markedUnread: { at: 30 } } },
+    })],
+    worktrees: [],
+    items: [['ses_marked_failed', 'unread']],
