+import type { Project as OpenCodeProject, Session } from '@/lib/opencode/model';
+import { normalizePath } from '@/lib/pathNormalization';
+import { getBtwOriginalSessionID, isBtwSession } from '@/lib/sessionBtwMetadata';
+import { mergeSidebarSpaces, useSpacesStore, type SpaceMark } from '@/lib/spaces/spaces-store';
+import { useGlobalSessionsStore } from '@/stores/useGlobalSessionsStore';
+import { useProjectsStore } from '@/stores/useProjectsStore';
+import { useGlobalSyncStore } from '@/sync/global-sync-store';
+import { useSessionUIStore } from '@/sync/session-ui-store';
+import { getAllSyncSessionMap } from '@/sync/sync-refs';
+import type { WorktreeMetadata } from '@/types/worktree';
+import { createSessionOwnershipIndex } from '../sessions/sessionOwnership';
+import { buildKnownSessionDirectories } from './sessionListDirectories';
+import {
+  buildSidebarSessionTree,
+  collectNestedSessionIds,
+  filterSidebarArchivedSessions,
+  resolveSidebarSessionRows,
+  type SidebarSessionTree,
+} from './sidebarSessionTree';
+
+export type SidebarRowSources = {
+  activeSessions: readonly Session[];
+  archivedSessions: readonly Session[];
+  
+  liveSessions: readonly Session[];
+  projects: Array<{ id: string; path: string }>;
+  worktreesByProject: Map<string, WorktreeMetadata[]>;
+  spaces: readonly SpaceMark[];
+  authoritativeProjects: readonly Pick<OpenCodeProject, 'id' | 'worktree'>[];
+  
+  isChatDirectory?: (directory: string | null | undefined) => boolean;
+};
+
+type SidebarRowBase = {
+  tree: SidebarSessionTree;
+  nestedSessionIds: ReadonlySet<string>;
+  ownerBySessionId: ReadonlyMap<string, unknown>;
+};
+
+export type SidebarZones = { chats: boolean; pinned: boolean };
+
+const EVERY_SIDEBAR_ZONE: SidebarZones = { chats: true, pinned: true };
+
+export const buildSidebarRowBase = (sources: SidebarRowSources): SidebarRowBase => {
+  const isVSCode = false;
+  const { activeSessions, archivedSessions, projects, worktreesByProject, isChatDirectory } = sources;
+  const knownDirectories = buildKnownSessionDirectories(projects, worktreesByProject, { includeWorktrees: true });
+  const globalIds = new Set([...activeSessions, ...archivedSessions].map((session) => session.id));
+  const liveSessions = sources.liveSessions.filter((session) => !globalIds.has(session.id));
+  const tree = buildSidebarSessionTree({ globalActiveSessions: activeSessions, liveSessions, knownDirectories, isVSCode, isChatDirectory });
+  const archived = filterSidebarArchivedSessions(archivedSessions, knownDirectories, isVSCode, isChatDirectory);
+  const normalizedProjects = projects.flatMap((project) => {
+    const normalizedPath = normalizePath(project.path);
+    return normalizedPath ? [{ id: project.id, normalizedPath }] : [];
+  });
+  const ownership = createSessionOwnershipIndex(
+    tree.projectSessions, normalizedProjects, worktreesByProject, isVSCode, archived, sources.authoritativeProjects, sources.spaces,
+  );
+  return { tree, nestedSessionIds: collectNestedSessionIds(tree, archived), ownerBySessionId: ownership.bySessionId };
+};
+
+type SessionRowOf = ReadonlyMap<string, string | null>;
+
+export const resolveSessionRowOf = (
+  base: SidebarRowBase,
+  judgedSessions: Iterable<Session>,
+  pinnedSessionIds: Set<string>,
+): SessionRowOf => {
+  const rootOf = resolveSidebarSessionRows(base.tree, base.nestedSessionIds, {
+    ownerBySessionId: base.ownerBySessionId, pinnedSessionIds, zones: EVERY_SIDEBAR_ZONE,
+  }).rootOf;
+  const rowOf = new Map<string, string | null>();
+  const btwOriginals = new Map<string, string>();
+  for (const session of judgedSessions) {
+    const original = isBtwSession(session) ? getBtwOriginalSessionID(session) : null;
+    if (original) btwOriginals.set(session.id, original);
+    else rowOf.set(session.id, rootOf.get(session.id) ?? null);
+  }
+  for (const [sessionId, original] of btwOriginals) {
+    const originalRow = rowOf.get(original);
+    if (originalRow !== undefined) rowOf.set(sessionId, originalRow);
+  }
+  return rowOf;
+};
+
+let windowRowBaseCache: { inputs: readonly unknown[]; base: SidebarRowBase } | null = null;
+
+export const readSidebarRowBase = (): SidebarRowBase => {
+  const { activeSessions, archivedSessions } = useGlobalSessionsStore.getState();
+  const projects = useProjectsStore.getState().projects;
+  const worktreesByProject = useSessionUIStore.getState().availableWorktreesByProject;
+  const { spaces, journey } = useSpacesStore.getState();
+  const authoritativeProjects = useGlobalSyncStore.getState().projects;
+  const live = getAllSyncSessionMap();
+  const inputs = [activeSessions, archivedSessions, projects, worktreesByProject, spaces, journey, authoritativeProjects, live];
+  if (windowRowBaseCache && windowRowBaseCache.inputs.every((input, index) => input === inputs[index])) return windowRowBaseCache.base;
+  const base = buildSidebarRowBase({
+    activeSessions,
+    archivedSessions,
+    liveSessions: [...live.values()],
+    projects,
+    worktreesByProject,
+    spaces: mergeSidebarSpaces(spaces, journey),
+    authoritativeProjects,
+  });
+  windowRowBaseCache = { inputs, base };
+  return base;
+};
