+  {
+    kind: 'unread session in a known worktree',
+    records: [record('ses_worktree', KNOWN_WORKTREE, unseen)],
+    worktrees: [KNOWN_WORKTREE],
+    items: [['ses_worktree', 'unread']],
+  },
+];
+
+const worktreeMap = (paths: string[]): Map<string, WorktreeMetadata[]> => new Map(paths.length === 0 ? [] : [[
+  PROJECT,
+  paths.map((path) => ({ path, projectDirectory: PROJECT, branch: '', label: '' })),
+]]);
+
+const sorted = (items: Array<{ sessionId: string; kind: string }>) => items
+  .map((item): [string, string] => [item.sessionId, item.kind])
+  .sort(([left], [right]) => left.localeCompare(right));
+
+/** The rows the instance's own sidebar draws, and the sessions inside each. */
+const sidebarRows = (sessions: Session[], worktrees: Map<string, WorktreeMetadata[]>): Map<string, Set<string>> => {
+  const active = sessions.filter((session) => session.time.archived === undefined);
+  const projection = buildSidebarSessionProjection({
+    globalActiveSessions: active,
+    liveSessions: [],
+    knownDirectories: buildKnownSessionDirectories([{ path: PROJECT }], worktrees, { includeWorktrees: true }),
+    isVSCode: false,
+    pinnedSessionIds: new Set(),
+    sessionOrderRanks: new Map(),
+  });
+  const owners = createSessionOwnershipIndex(projection.projectSessions, [{ id: 'project', normalizedPath: PROJECT }], worktrees, false).bySessionId;
+  const nested = new Set([...projection.childrenMap.values()].flat().map((session) => session.id));
+  const rows = new Map<string, Set<string>>();
+  for (const root of projection.projectSessions) {
+    if (nested.has(root.id) || !owners.has(root.id)) continue;
+    const members = new Set<string>();
+    const visit = (id: string) => {
+      if (members.has(id)) return;
+      members.add(id);
+      for (const child of projection.childrenMap.get(id) ?? []) visit(child.id);
+    };
+    visit(root.id);
+    for (const session of sessions) {
+      const original = getBtwOriginalSessionID(session);
+      if (original && members.has(original)) members.add(session.id);
+    }
+    rows.set(root.id, members);
+  }
+  return rows;
+};
+
+const pollInstance = async (fixture: Fixture) => {
+  const status = {
+    sessions: {},
+    pending: Object.fromEntries((fixture.waiting ?? []).map((id) => [id, { permissions: [permission(id)], forms: [], pages: [] }])),
+    serverTime: 1_000,
+  };
+  // SAFETY: the stub answers every route the reader calls with JSON, from the
+  // same fixture the local stores are seeded with.
+  const fetchImpl = (async (input: string | URL | Request) => {
+    const url = String(input);
+    if (url.includes('/api/sessions/status')) return Response.json(status);
+    if (url.includes('/api/config/settings')) {
+      return fixture.fails?.settings ? new Response(null, { status: 500 }) : Response.json({ projects: [{ id: 'project', path: PROJECT }] });
+    }
+    const detail = /\/api\/session\/([^/?]+)$/.exec(new URL(url).pathname)?.[1];
+    if (detail) {
+      const found = fixture.offPage?.find((entry) => entry.id === detail);
+      return found && !fixture.fails?.detail?.includes(detail) ? Response.json({ data: found }) : new Response(null, { status: 404 });
+    }
+    if (url.includes('/api/fs/home')) return Response.json({ home: '/home/me', chatsRoot: '/home/me/.local/share/openchamber/chats' });
+    if (url.includes('/api/git/project-worktrees')) {
+      return Response.json({ projects: [{ directory: PROJECT, worktrees: [{ path: PROJECT }, ...fixture.worktrees.map((path) => ({ path }))] }] });
+    }
+    const omitted = new Set(fixture.omitOnWire ?? []);
+    return Response.json({ data: fixture.records.map((entry) => Object.fromEntries(Object.entries(entry).filter(([key]) => !omitted.has(key)))) });
+  }) as typeof fetch;
+  const poll = await readInstanceAttention({ url: 'http://instance.test', fetchImpl });
+  return collectInstanceAttention([{
+    ...poll,
+    hostId: 'polled',
+    hostLabel: 'polled',
+    sessions: poll.sessions ?? [],
+    pending: poll.pending ?? new Map(),
+    busy: poll.busy ?? undefined,
+  }]);
+};
+
+const Probe = (): React.ReactNode => {
+  useLocalInstanceAttention(true);
+  return null;
+};
+
+let dom: Window;
+let root: Root | null = null;
+const globals = new Map<string, PropertyDescriptor | undefined>();
+
+const showInstance = async (fixture: Fixture, sessions: Session[], worktrees: Map<string, WorktreeMetadata[]>) => {
+  useGlobalSessionsStore.setState({
+    hasLoaded: true,
+    entityById: new Map(sessions.map((session) => [session.id, session])),
+    activeSessions: sessions.filter((session) => session.time.archived === undefined),
+    archivedSessions: sessions.filter((session) => session.time.archived !== undefined),
+  });
+  useSessionUIStore.setState({ availableWorktreesByProject: worktrees });
+  useGlobalBlockingRequestsStore.setState({
+    bySession: new Map((fixture.waiting ?? []).map((id) => [id, {
+      directory: sessions.find((session) => session.id === id)?.directory ?? PROJECT,
+      permissions: [{ ...permission(id), sessionID: id }],
+      forms: [],
+      pages: [],
+    }])),
+  });
+  const host = document.createElement('div');
+  document.body.append(host);
+  const { createRoot } = await import('react-dom/client');
+  const created = createRoot(host);
+  root = created;
+  await act(async () => created.render(<I18nProvider><Probe /></I18nProvider>));
+  return useInstanceAttentionStore.getState().items.filter((item) => item.hostId === LOCAL_INSTANCE_ATTENTION_HOST_ID);
+};
+
+beforeEach(() => {
+  dom = new Window({ url: 'http://localhost' });
+  const values = {
+    window: dom, document: dom.document, navigator: dom.navigator,
+    Node: dom.Node, Element: dom.Element, HTMLElement: dom.HTMLElement,
+    Event: dom.Event, MouseEvent: dom.MouseEvent, IS_REACT_ACT_ENVIRONMENT: true,
+  };
+  for (const [name, value] of Object.entries(values)) {
+    globals.set(name, Object.getOwnPropertyDescriptor(globalThis, name));
+    Object.defineProperty(globalThis, name, { configurable: true, writable: true, value });
+  }
+  useInstanceAttentionStore.getState().reset();
+  useGlobalSessionStatusStore.setState({ activeSessionIds: new Set<string>() });
+  setSessionParentResolver((sessionId) => useGlobalSessionsStore.getState().entityById.get(sessionId)?.parentID);
+  useProjectsStore.setState({ projects: [{ id: 'project', path: PROJECT }], activeProjectId: 'project' });
+});
+
+afterEach(async () => {
+  const mounted = root;
+  root = null;
+  if (mounted) await act(async () => mounted.unmount());
+  for (const [name, descriptor] of globals) {
+    if (descriptor) Object.defineProperty(globalThis, name, descriptor);
+    else Reflect.deleteProperty(globalThis, name);
+  }
+  globals.clear();
+  await dom.happyDOM.abort();
+  dom.close();
+});
+
+describe('one instance lists the same attention rows however it is reached', () => {
+  for (const fixture of fixtures) {
+    test(fixture.kind, async () => {
+      // What this window's client makes of the same records (`opencodeClient`).
+      const sessions = [...fixture.records, ...(fixture.offPage ?? [])].map(projectSession);
+      const worktrees = worktreeMap(fixture.worktrees);
+
+      const local = sorted(await showInstance(fixture, sessions, worktrees));
+      const polled = sorted(await pollInstance(fixture));
+      const rows = sidebarRows(sessions, worktrees);
+
+      expect(local).toEqual(fixture.items);
+      expect(polled).toEqual(fixture.polledItems ?? local);
+      // Every item is a row the sidebar draws, and every waiting session the
+      // sidebar draws inside a row is listed through that row.
+      for (const [sessionId] of local) expect(rows.has(sessionId)).toBe(true);
+      const waiting = new Set([
+        ...(fixture.waiting ?? []),
+        ...sessions.filter(isSessionUnread).map((session) => session.id),
+      ]);
+      const shownRowsWithWaiting = [...rows].filter(([, members]) => [...members].some((id) => waiting.has(id))).map(([rowId]) => rowId).sort();
+      expect(local.map(([sessionId]) => sessionId)).toEqual(shownRowsWithWaiting);
+    });
+  }
+});
