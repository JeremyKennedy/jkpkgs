diff --git a/packages/ui/src/hooks/useDictation.empty-result.test.tsx b/packages/ui/src/hooks/useDictation.empty-result.test.tsx
new file mode 100644
index 000000000..000b477dd
--- /dev/null
+++ b/packages/ui/src/hooks/useDictation.empty-result.test.tsx
@@ -0,0 +1,187 @@
+import { afterEach, beforeEach, describe, expect, mock, test } from 'bun:test';
+import * as bunTest from 'bun:test';
+
+// Bun implements setSystemTime but its bundled types do not declare it yet.
+const setSystemTime = (bunTest as unknown as { setSystemTime: (date?: Date) => void }).setSystemTime;
+import { Window } from 'happy-dom';
+import React, { act } from 'react';
+import { createRoot, type Root } from 'react-dom/client';
+
+import type { UseDictationResult } from './useDictation';
+
+// A dictation that produced no text used to return to idle with no message:
+// the overlay closed and the recording was gone. These tests pin the audio and
+// the failure so the user can see it and dismiss it on purpose.
+
+const senderState = {
+    finalSeq: 0,
+    finalText: '',
+    segments: 1,
+    finishError: null as Error | null,
+    clears: 0,
+    finished: false,
+};
+
+mock.module('@/lib/dictation/dictation-client', () => ({
+    dictationClient: {
+        isConnected: false,
+        onPartial: () => () => {},
+        subscribeConnectionStatus: () => () => {},
+        subscribeStreamError: () => () => {},
+        abandonDictationStream: () => {},
+    },
+}));
+
+mock.module('@/lib/dictation/dictation-stream-sender', () => ({
+    DictationStreamSender: class {
+        getDictationId() { return 'dic_test'; }
+        getFinalSeq() { return senderState.finalSeq; }
+        hasSegments() { return senderState.segments > 0; }
+        clearAll() { senderState.clears += 1; }
+        resetStreamForReplay() {}
+        restartStream() { return Promise.resolve(); }
+        enqueueSegment() {}
+        cancel() {}
+        finish() {
+            senderState.finished = true;
+            if (senderState.finishError) {
+                return Promise.reject(senderState.finishError);
+            }
+            return Promise.resolve({ dictationId: 'dic_test', text: senderState.finalText });
+        }
+    },
+}));
+
+const audioState = {
+    startError: null as Error | null,
+    levels: new Set<(level: number) => void>(),
+};
+
+mock.module('@/lib/dictation/use-dictation-audio-source', () => ({
+    useDictationAudioSource: () => ({
+        start: async () => {
+            if (audioState.startError) throw audioState.startError;
+            return true;
+        },
+        stop: async () => {},
+        subscribeLevel: (listener: (level: number) => void) => {
+            audioState.levels.add(listener);
+            return () => { audioState.levels.delete(listener); };
+        },
+    }),
+}));
+
+const { canRetryDictationFailure, useDictation } = await import('./useDictation');
+
+let dom: Window;
+let root: Root;
+let hook: UseDictationResult;
+const transcripts: string[] = [];
+
+const Probe = () => {
+    hook = useDictation({ onTranscript: (text) => transcripts.push(text) });
+    return null;
+};
+
+beforeEach(async () => {
+    senderState.finalSeq = 0;
+    senderState.finalText = '';
+    senderState.segments = 1;
+    senderState.finishError = null;
+    audioState.startError = null;
+    audioState.levels.clear();
+    senderState.clears = 0;
+    senderState.finished = false;
+    transcripts.length = 0;
+    dom = new Window();
+    Object.assign(globalThis, { window: dom, document: dom.document, IS_REACT_ACT_ENVIRONMENT: true });
+    const host = document.createElement('div');
+    document.body.append(host);
+    root = createRoot(host);
+    await act(async () => root.render(<Probe />));
+});
+
+afterEach(async () => {
+    setSystemTime();
+    await act(async () => root.unmount());
+    await dom.happyDOM.close();
+});
+
+/** Returns how many times the sender was cleared between start and finish. */
+const dictate = async () => {
+    await act(async () => { await hook.startDictation(); });
+    const clearsBeforeConfirm = senderState.clears;
+    await act(async () => { await hook.confirmDictation(); });
+    return senderState.clears - clearsBeforeConfirm;
+};
+
+describe('a dictation that transcribed nothing', () => {
+    test('is shown as a failure instead of silently returning to idle', async () => {
+        const clearsAfterFinish = await dictate();
+
+        expect(hook.status).toBe('failed');
+        expect(hook.errorReason).toBe('no_speech');
+        expect(hook.error).toContain('No speech was transcribed');
+        expect(transcripts).toEqual([]);
+        // Finishing an empty transcript keeps the audio; only discarding clears it.
+        expect(clearsAfterFinish).toBe(0);
+    });
+
+    test('is a failure even when no audio reached the sender', async () => {
+        senderState.finalSeq = -1;
+        senderState.segments = 0;
+        await dictate();
+
+        expect(hook.status).toBe('failed');
+        expect(hook.errorReason).toBe('empty_recording');
+        expect(hook.error).toContain('Nothing was recorded');
+        expect(transcripts).toEqual([]);
+        expect(senderState.finished).toBe(false);
+    });
+
+    test('a real finish failure is surfaced as a failed dictation', async () => {
+        senderState.finishError = new Error('Dictation connection lost');
+        await dictate();
+
+        expect(hook.status).toBe('failed');
+        expect(hook.errorReason).toBeNull();
+        expect(hook.error).toContain('Dictation connection lost');
+        expect(transcripts).toEqual([]);
+    });
+
+    test('says the microphone is silent while it is still recording, and clears it', async () => {
+        await act(async () => { await hook.startDictation(); });
+        const emit = (level: number) => { for (const listener of audioState.levels) listener(level); };
+
+        await act(async () => { emit(0); });
+        setSystemTime(new Date(Date.now() + 7000));
+        await act(async () => { emit(0); });
+
+        expect(hook.status).toBe('recording');
+        expect(hook.error).toContain('No sound from the microphone');
+
+        await act(async () => { emit(0.4); });
+        expect(hook.error).toBeNull();
+    });
+
+    test('a microphone that never started is shown instead of doing nothing', async () => {
+        audioState.startError = new Error('Permission denied');
+        await act(async () => { await hook.startDictation(); });
+
+        expect(hook.status).toBe('failed');
+        expect(hook.errorReason).toBe('start_failed');
+        expect(hook.error).toContain('Permission denied');
+        expect(canRetryDictationFailure(hook.errorReason)).toBe(false);
+    });
+
+    test('dismissing the empty result clears the retained audio', async () => {
+        const clearsAfterFinish = await dictate();
+        expect(clearsAfterFinish).toBe(0);
+        const clearsBeforeDiscard = senderState.clears;
+
+        await act(async () => { hook.discardFailedDictation(); });
+
+        expect(hook.status).toBe('idle');
+        expect(senderState.clears).toBe(clearsBeforeDiscard + 1);
+    });
+});
diff --git a/packages/ui/src/hooks/useDictation.ts b/packages/ui/src/hooks/useDictation.ts
index 004c6ebc3..04a3a1799 100644
--- a/packages/ui/src/hooks/useDictation.ts
+++ b/packages/ui/src/hooks/useDictation.ts
@@ -1,3 +1,19 @@
+/**
+ * Streaming dictation state machine.
+ *
+ * Status flow: idle -> recording -> uploading -> idle | failed.
+ * While recording, mic PCM chunks stream to the server, which transcribes them
+ * segment by segment; confirm finalizes and resolves the full text. Nothing is
+ * shown while recording — `partialTranscript` holds whatever the server has
+ * transcribed so far and exists only so a failed dictation can be salvaged
+ * instead of losing minutes of speech. Failed dictations also retain their
+ * audio segments so retry can replay them.
+ *
