@@ -0,0 +1,25 @@
+import React from 'react';
+import { useInputStore } from '@/sync/input-store';
+
+type PendingDraftDictationOptions = {
+    draftId: number | null;
+    enabled: boolean;
+    start: () => void;
+};
+
+// A deep link (openchamber://new-session?dictate=1) asks for recording once the
+// draft's composer is mounted. The request is bound to a draft id, so a composer
+// showing another draft drops it instead of recording there.
+//
+// This lives in its own hook because it was lost once already: the composer was
+// rewritten for dictation recovery and the consumer went with the old body, so a
+// dictate link opened the draft and never started recording.
+export const usePendingDraftDictation = ({ draftId, enabled, start }: PendingDraftDictationOptions): void => {
+    const pendingDraftDictation = useInputStore((state) => state.pendingDraftDictation);
+    React.useEffect(() => {
+        if (!enabled || pendingDraftDictation == null) return;
+        if (draftId !== pendingDraftDictation.draftId) return;
+        if (!useInputStore.getState().consumePendingDraftDictation(draftId)) return;
+        start();
+    }, [draftId, enabled, pendingDraftDictation, start]);
+};
