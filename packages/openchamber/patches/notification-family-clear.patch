+  // Viewing a session also handles what its subagents asked: their banners
+  // carry the subagent's own id, and the user reaches a subagent through its
+  // parent. Only sessions with an open banner are looked up, each up its
+  // parent chain (the parent cache, else its record), so a deep or cyclic
+  // tree costs a bounded number of reads. A session whose chain cannot be
+  // read keeps its banners.
+  const SUBAGENT_CLEAR_MAX_SESSIONS = 50;
+  const SUBAGENT_CLEAR_MAX_DEPTH = 8;
+  const isSubagentOf = async (sessionId, ancestorId) => {
+    const seen = new Set([sessionId]);
+    let current = sessionId;
+    for (let depth = 0; depth < SUBAGENT_CLEAR_MAX_DEPTH; depth += 1) {
+      const parentId = await fetchSessionParentId(current, undefined);
+      if (!parentId) return false;
+      if (parentId === ancestorId) return true;
+      if (seen.has(parentId)) return false;
+      seen.add(parentId);
+      current = parentId;
+    }
+    return false;
+  };
