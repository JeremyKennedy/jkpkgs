+      const candidate = open.sessionId;
+      if (candidate === sessionId || candidate === LOCATION_SCOPED_FORM_SESSION_ID || candidates.includes(candidate)) continue;
+      candidates.push(candidate);
+      if (candidates.length >= SUBAGENT_CLEAR_MAX_SESSIONS) break;
+    }
+    const results = await Promise.all(candidates.map((candidate) => isSubagentOf(candidate, sessionId).catch(() => false)));
+    for (const [index, candidate] of candidates.entries()) {
+      if (results[index]) await clearSessionPushNotifications(candidate);
+    }
   };
 
