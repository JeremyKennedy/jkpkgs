@@ -0,0 +1,58 @@
+import { readFileSync } from 'node:fs';
+
+import { describe, expect, test, vi } from 'vitest';
+
+import { registerNotificationRoutes } from './routes.js';
+
+// The routes receive an injected clearSessionPushNotifications; the server
+// builds that injection in index.js. A wrapper there once dropped the second
+// argument, so a view never asked the runtime to walk subagents and no runtime
+// test could see it. These two tests pin both halves of the wiring.
+
+const withRoutes = (dependencies) => {
+  const handlers = new Map();
+  const app = {
+    get: (path, handler) => handlers.set(path, handler),
+    post: (path, handler) => handlers.set(path, handler),
+    put: () => undefined,
+    delete: () => undefined,
+  };
+  const clearPendingPushBadge = vi.fn();
+  registerNotificationRoutes(app, { ...dependencies, clearPendingPushBadge });
+  return { handlers, clearPendingPushBadge };
+};
+
+const response = () => {
+  const json = vi.fn((body) => body);
+  return { json };
+};
+
+describe('session view clears a session and its subagents', () => {
+  test('the view route asks for the subagent walk', () => {
+    const clearSessionPushNotifications = vi.fn();
+    const { handlers } = withRoutes({ clearSessionPushNotifications });
+    const handler = handlers.get('/api/sessions/:id/view');
+    expect(handler).toBeTypeOf('function');
+
+    handler({ params: { id: 'ses_parent' } }, response());
+
+    expect(clearSessionPushNotifications).toHaveBeenCalledWith('ses_parent', { withSubagents: true });
+  });
+
+  test('a sent message clears only that session', () => {
+    const clearSessionPushNotifications = vi.fn();
+    const { handlers } = withRoutes({ clearSessionPushNotifications });
+    const handler = handlers.get('/api/sessions/:id/message-sent');
+
+    handler({ params: { id: 'ses_parent' } }, response());
+
+    expect(clearSessionPushNotifications).toHaveBeenCalledWith('ses_parent');
+  });
+
+  test('the server wiring forwards the options it is given', () => {
+    // index.js builds the injection; the one-line assertion is deliberate, so a
+    // wrapper that drops the argument fails here rather than only on a phone.
+    const source = readFileSync(new URL('../../index.js', import.meta.url), 'utf8');
+    expect(source).toContain('clearSessionPushNotifications: (sessionId, options) => notificationTriggerRuntime.clearSessionPushNotifications(sessionId, options)');
+  });
+});
