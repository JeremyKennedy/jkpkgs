+/**
+ * Levels an earlier local build stored, each mapped to the nearest level here:
+ * Compact (48rem) is the reading column, Standard (64rem) the wider column, and
+ * Full Width (the transcript across the chat) is Full. Wide is not a legacy
+ * name: it is a level of its own at 80rem, so it maps to itself and is
+ * deliberately absent here.
+ */
+const LEGACY_CHAT_WIDTHS: Readonly<Record<string, 'default' | 'wider' | 'full'>> = {
+  compact: 'default',
+  standard: 'wider',
+  'full-width': 'full',
+};
 
