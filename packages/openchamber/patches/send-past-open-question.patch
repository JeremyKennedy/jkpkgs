diff --git a/packages/ui/src/components/chat/__tests__/ChatInput.pendingForm.test.tsx b/packages/ui/src/components/chat/__tests__/ChatInput.pendingForm.test.tsx
new file mode 100644
index 000000000..b6e59a14e
--- /dev/null
+++ b/packages/ui/src/components/chat/__tests__/ChatInput.pendingForm.test.tsx
@@ -0,0 +1,257 @@
+import { afterAll, afterEach, beforeEach, expect, spyOn, test } from 'bun:test';
+import { plugin } from 'bun';
+import { readFileSync, readdirSync } from 'node:fs';
+import { dirname, resolve } from 'node:path';
+import { pathToFileURL } from 'node:url';
+import { Window } from 'happy-dom';
+import type { RuntimeAPIs } from '@/lib/api/types';
+import type { FormRequest, Session } from '@/lib/opencode/model';
+import type { AutoReviewRun } from '@/stores/useAutoReviewStore';
+
+// Local patch send-past-open-question: a send while the composer shows a
+// pending form joins the turn that waits on it (steer) and leaves the form
+// open, instead of cancelling it and queueing the message (upstream #6960
+// defers such a send instead).
+
+const browser = new Window({ url: 'http://localhost/' });
+Object.assign(globalThis, {
+  window: browser, document: browser.document, navigator: browser.navigator,
+  localStorage: browser.localStorage, sessionStorage: browser.sessionStorage,
+  ...Object.fromEntries(([
+    'Window', 'Node', 'Text', 'Element', 'HTMLElement', 'HTMLInputElement', 'HTMLTextAreaElement',
+    'HTMLFormElement', 'Range', 'Selection', 'DocumentFragment', 'Event', 'KeyboardEvent',
+    'MouseEvent', 'FocusEvent', 'InputEvent', 'CustomEvent', 'MutationObserver',
+    'ResizeObserver', 'IntersectionObserver', 'HTMLDivElement', 'HTMLSpanElement',
+    'SVGElement', 'ShadowRoot', 'CSSStyleSheet', 'DOMParser',
+  ] satisfies (keyof Window)[]).map((name) => [name, browser[name]])),
+  matchMedia: browser.matchMedia.bind(browser),
+  getComputedStyle: browser.getComputedStyle.bind(browser),
+  requestAnimationFrame: browser.requestAnimationFrame.bind(browser),
+  cancelAnimationFrame: browser.cancelAnimationFrame.bind(browser),
+  customElements: browser.customElements, IS_REACT_ACT_ENVIRONMENT: true,
+});
+
+const DIRECTORY = '/pending-form-fixture';
+const location = { directory: DIRECTORY, project: { id: 'project', directory: DIRECTORY, canonical: DIRECTORY } };
+// Backend data is isolated; the composer, its submit path and the sync stores are real.
+const responseFor = (input: RequestInfo | URL) => {
+  const path = new URL(input instanceof Request ? input.url : input.toString(), 'http://localhost/').pathname;
+  if (path === '/api/config/settings') return Response.json({ projects: [{ id: 'project', path: DIRECTORY }] });
+  if (path.endsWith('/event')) return new Response(new ReadableStream(), { headers: { 'content-type': 'text/event-stream' } });
+  if (path.endsWith('/location')) return Response.json(location);
+  if (path.endsWith('/session/active')) return Response.json({ data: {} });
+  const composerSession = /^\/api\/session\/(ses_form_\d+)$/.exec(path)?.[1];
+  if (composerSession) return Response.json({
+    location,
+    data: { ...session(composerSession), model: { providerID: 'provider', id: 'model' }, location: { directory: DIRECTORY } },
+  });
+  if (path === '/api/config') return Response.json([]);
+  if (path === '/api/project') return Response.json([]);
+  if (path.endsWith('/vcs')) return Response.json({ data: { branch: { current: 'main', default: 'main' } } });
+  if (path.endsWith('/session-warming')) return Response.json({ revision: 0, enabled: false, minutes: 60, sessions: [] });
+  return Response.json({ location, data: [] });
+};
+spyOn(globalThis, 'fetch').mockImplementation(async (input) => responseFor(input));
+
+// Match the Vite-only import transforms in the sibling real-composer tests.
+plugin({
+  name: 'composer-pending-form-vite-modules',
+  setup(build) {
+    build.onLoad({ filter: /useProviderLogo\.ts$/ }, ({ path }) => {
+      const directory = resolve(dirname(path), '../assets/provider-logos');
+      const logos = Object.fromEntries(readdirSync(directory).filter((name) => name.endsWith('.svg')).map((name) => [
+        `../assets/provider-logos/${name}`, pathToFileURL(resolve(directory, name)).href,
+      ]));
+      return { contents: readFileSync(path, 'utf8').replace(/import\.meta\.glob<string>\([\s\S]*?\);/, `${JSON.stringify(logos)};`), loader: 'ts' };
+    });
+  },
+});
+
+const { act } = await import('react');
+const { createRoot } = await import('react-dom/client');
+const { EditorView } = await import('@codemirror/view');
+const { I18nProvider } = await import('@/lib/i18n');
+const { ThemeSystemProvider } = await import('@/contexts/ThemeSystemContext');
+const { RuntimeAPIContext } = await import('@/contexts/runtimeAPIContext');
+const { ChatInput } = await import('../ChatInput');
+const { SyncProvider } = await import('@/sync/sync-context');
+const { useDirectoryStore } = await import('@/stores/useDirectoryStore');
+const { useConfigStore } = await import('@/stores/useConfigStore');
+const { useSessionUIStore } = await import('@/sync/session-ui-store');
+const { useProjectsStore } = await import('@/stores/useProjectsStore');
+const { useMessageQueueStore } = await import('@/stores/messageQueueStore');
+const { useAutoReviewStore } = await import('@/stores/useAutoReviewStore');
+const { OpenCode } = await import('@opencode/client');
+const { opencodeClient } = await import('@/lib/opencode/client');
+const { getSyncChildStores } = await import('@/sync/sync-refs');
+const { setOptimisticRefs } = await import('@/sync/session-actions');
+
+const sdk = OpenCode.make({ baseUrl: 'https://sync.test', fetch: async (request) => responseFor(request) });
+// SAFETY: Same minimal offline runtime as sibling composer integration tests.
+const runtimeAPIs = { runtime: { platform: 'web', isDesktop: false, isVSCode: false }, sourceControl: {} } as RuntimeAPIs;
+const session = (id: string, parentID?: string): Session => ({
+  id, title: id, directory: DIRECTORY, projectID: 'project', cost: 0, parentID,
+  tokens: { input: 0, output: 0, reasoning: 0, cache: { read: 0, write: 0 } },
+  time: { created: 0, updated: 1 },
+});
+const question = (id: string, sessionID: string): FormRequest => ({
+  id, sessionID, title: 'Pick one', fields: [{ key: 'choice', type: 'boolean' }],
+});
+
+const yieldToEventLoop = () => new Promise((resolve) => setTimeout(resolve, 0));
+const settle = async () => {
+  for (let index = 0; index < 5; index++) await act(yieldToEventLoop);
+};
+
+type Composer = {
+  sessionId: string;
+  type: (text: string) => Promise<void>;
+  key: (key: string, init?: KeyboardEventInit) => Promise<void>;
+  clickSend: () => Promise<void>;
+  forms: (sessionId: string) => FormRequest[] | undefined;
+};
+
+type Fixture = {
+  /** Forms by session id, put in the composer's directory store. */
+  forms: (sessionId: string) => Record<string, FormRequest[]>;
+  /** A subagent child of the composer's session. */
+  child?: boolean;
+  busy?: boolean;
+};
+
+let composerCount = 0;
+const withComposer = async (fixture: Fixture, run: (composer: Composer) => Promise<void>) => {
+  useProjectsStore.setState({ projects: [{ id: 'project', path: DIRECTORY }] });
+  const sessionId = `ses_form_${++composerCount}`;
+  useDirectoryStore.setState({ currentDirectory: DIRECTORY });
+  useSessionUIStore.setState({
+    currentSessionId: sessionId,
+    currentSessionDirectory: DIRECTORY,
+    newSessionDraft: { ...useSessionUIStore.getState().newSessionDraft, open: false },
+  });
+  useConfigStore.setState({ currentProviderId: 'provider', currentModelId: 'model', isConnected: true, hasEverConnected: true });
+  const container = document.createElement('div');
+  document.body.append(container);
+  const root = createRoot(container);
+  try {
+    await act(async () => root.render(
+      <RuntimeAPIContext.Provider value={runtimeAPIs}><ThemeSystemProvider><I18nProvider>
+        <SyncProvider sdk={sdk} directory={DIRECTORY}>
+          <ChatInput />
+        </SyncProvider>
+      </I18nProvider></ThemeSystemProvider></RuntimeAPIContext.Provider>,
+    ));
+    await settle();
+    const store = getSyncChildStores().ensureChild(DIRECTORY, { bootstrap: false });
+    await act(async () => store.setState({
+      session: fixture.child ? [session(sessionId), session(`${sessionId}_child`, sessionId)] : [session(sessionId)],
+      sessionTotal: 1,
+      form: fixture.forms(sessionId),
+      session_status: fixture.busy ? { [sessionId]: { type: 'busy' } } : {},
+    }));
+    await settle();
+    const content = container.querySelector<HTMLElement>('.cm-content');
+    const view = content && EditorView.findFromDOM(content);
+    if (!view || !content) throw new Error('The real composer editor did not mount');
+    setOptimisticRefs(() => {}, () => {});
+    await run({
+      sessionId,
+      type: async (text) => {
+        await act(async () => view.dispatch({
+          changes: { from: 0, to: view.state.doc.length, insert: text },
+          selection: { anchor: text.length }, userEvent: 'input.type',
+        }));
+        await settle();
+      },
+      key: async (key, init) => {
+        await act(async () => content.dispatchEvent(new KeyboardEvent('keydown', { key, bubbles: true, cancelable: true, ...init })));
+        await settle();
+      },
+      clickSend: async () => {
+        await act(async () => container.querySelector('form')!.dispatchEvent(new Event('submit', { bubbles: true, cancelable: true })));
+        await settle();
+      },
+      forms: (id) => store.getState().form[id],
+    });
+  } finally {
+    await act(async () => root.unmount());
+    container.remove();
+  }
+};
+
+let send: ReturnType<typeof spyOn<ReturnType<typeof useSessionUIStore.getState>, 'sendMessage'>>;
+let queue: ReturnType<typeof spyOn<ReturnType<typeof useMessageQueueStore.getState>, 'addToQueue'>>;
+let cancel: ReturnType<typeof spyOn<typeof opencodeClient, 'cancelForm'>>;
+beforeEach(() => {
+  send = spyOn(useSessionUIStore.getState(), 'sendMessage').mockResolvedValue(undefined);
+  queue = spyOn(useMessageQueueStore.getState(), 'addToQueue').mockResolvedValue(undefined);
+  cancel = spyOn(opencodeClient, 'cancelForm').mockResolvedValue(true);
+});
+afterEach(() => {
+  send.mockRestore();
+  queue.mockRestore();
+  cancel.mockRestore();
+  useMessageQueueStore.setState({ followUpBehavior: 'steer' });
+  useAutoReviewStore.setState({ runs: {} });
+});
+afterAll(() => browser.close());
+
+// The options argument of useSessionUIStore.sendMessage.
+const deliveryOf = (call: unknown[] | undefined) => (call?.[9] as { delivery?: string } | undefined)?.delivery;
+
+test('a send while the session waits on its question steers into that turn and leaves the question open', async () => {
+  await withComposer({ forms: (id) => ({ [id]: [question('q-own', id)] }) }, async ({ sessionId, type, key, forms }) => {
+    await type('also do this');
+    await key('Enter');
+    expect(send.mock.calls.length).toBe(1);
+    expect(deliveryOf(send.mock.calls[0])).toBe('steer');
+    expect(cancel.mock.calls.length).toBe(0);
+    expect(queue.mock.calls.length).toBe(0);
+    expect(forms(sessionId)?.map((form) => form.id)).toEqual(['q-own']);
+  });
+});
+
+// A subagent's form leaves the parent's turn busy, the case where Queue used to take the send.
+for (const [label, press] of [
+  ['Enter', { key: 'Enter' }],
+  ['Ctrl+Enter', { key: 'Enter', ctrlKey: true }],
+  ['the send button', null],
+] as const) {
+  test(`with follow-ups set to queue, ${label} steers past a subagent's question instead of queueing`, async () => {
+    useMessageQueueStore.setState({ followUpBehavior: 'queue' });
+    await withComposer({ child: true, busy: true, forms: (id) => ({ [`${id}_child`]: [question('q-child', `${id}_child`)] }) }, async ({ sessionId, type, key, clickSend, forms }) => {
+      await type('a note for the agent');
+      if (press) await key(press.key, press);
+      else await clickSend();
+      expect(queue.mock.calls.length).toBe(0);
+      expect(send.mock.calls.length).toBe(1);
+      expect(deliveryOf(send.mock.calls[0])).toBe('steer');
+      expect(cancel.mock.calls.length).toBe(0);
+      expect(forms(`${sessionId}_child`)?.map((form) => form.id)).toEqual(['q-child']);
+    });
+  });
+}
+
+test('while auto-review runs, a send with a pending question steers instead of queueing', async () => {
+  await withComposer({ forms: (id) => ({ [id]: [question('q-review', id)] }) }, async ({ sessionId, type, key, forms }) => {
+    // SAFETY: the composer reads only `status` of its own run.
+    const run = { originalSessionID: sessionId, reviewSessionID: 'ses_review', directory: DIRECTORY, status: 'running' } as AutoReviewRun;
+    await act(async () => useAutoReviewStore.setState({ runs: { [`\n${sessionId}`]: run } }));
+    await type('while reviewing');
+    await key('Enter');
+    expect(queue.mock.calls.length).toBe(0);
+    expect(send.mock.calls.length).toBe(1);
+    expect(deliveryOf(send.mock.calls[0])).toBe('steer');
+    expect(forms(sessionId)?.map((form) => form.id)).toEqual(['q-review']);
+  });
+});
+
+test('without a pending form, a send to a busy session still queues when follow-ups are set to queue', async () => {
+  useMessageQueueStore.setState({ followUpBehavior: 'queue' });
+  await withComposer({ busy: true, forms: () => ({}) }, async ({ type, key }) => {
+    await type('later');
+    await key('Enter');
+    expect(send.mock.calls.length).toBe(0);
+    expect(queue.mock.calls.length).toBe(1);
+  });
+});
