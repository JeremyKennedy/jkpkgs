diff --git a/packages/electron/tray-owner.mjs b/packages/electron/tray-owner.mjs
new file mode 100644
index 000000000..af7fe88b0
--- /dev/null
+++ b/packages/electron/tray-owner.mjs
@@ -0,0 +1,140 @@
+import { z } from 'zod';
+
+const traySnapshotRows = z.array(z.unknown()).catch([])
+  .transform((rows) => rows.flatMap((row) => {
+    const parsed = z.looseObject({}).safeParse(row);
+    return parsed.success ? [parsed.data] : [];
+  }));
+
+const traySnapshotSchema = z.object({
+  instanceName: z.string().catch(''),
+  sessions: traySnapshotRows,
+  approvals: traySnapshotRows,
+  dockUnreadSessions: traySnapshotRows,
+  dockBadgeCount: z.number().catch(0).transform((count) => (Number.isFinite(count) ? Math.max(0, Math.floor(count)) : 0)),
+  usage: z.unknown(),
+}).catch({ instanceName: '', sessions: [], approvals: [], dockUnreadSessions: [], dockBadgeCount: 0, usage: undefined });
+
+const isEmptySnapshot = (snapshot) => snapshot.sessions.length === 0
+  && snapshot.approvals.length === 0
+  && snapshot.dockUnreadSessions.length === 0
+  && snapshot.dockBadgeCount === 0;
+
+const groupKeyOf = (windowId, runtimeKey) => runtimeKey || `window:${windowId}`;
+
+export const createTraySnapshotStore = () => {
+  const entries = new Map();
+  let focusOrder = [];
+  const groupOrder = new Map();
+  let groupSeq = 0;
+
+  const pruneGroupOrder = () => {
+    const live = new Set([...entries].map(([id, entry]) => groupKeyOf(id, entry.runtimeKey)));
+    for (const key of [...groupOrder.keys()]) if (!live.has(key)) groupOrder.delete(key);
+  };
+
+  const noteFocus = (windowId) => {
+    if (windowId == null) return;
+    focusOrder = [windowId, ...focusOrder.filter((id) => id !== windowId)];
+  };
+
+  const set = (windowId, snapshot, runtimeKey) => {
+    if (windowId == null) return;
+    entries.delete(windowId);
+    entries.set(windowId, { snapshot: traySnapshotSchema.parse(snapshot), runtimeKey });
+    const groupKey = groupKeyOf(windowId, runtimeKey);
+    if (!groupOrder.has(groupKey)) groupOrder.set(groupKey, groupSeq++);
+    pruneGroupOrder();
+  };
+
+  const noteRuntimeKey = (windowId, runtimeKey) => {
+    const entry = entries.get(windowId);
+    if (!entry || entry.runtimeKey === runtimeKey) return false;
+    if (entry.runtimeKey === '') {
+      entries.set(windowId, { snapshot: entry.snapshot, runtimeKey });
+      if (!groupOrder.has(runtimeKey)) groupOrder.set(runtimeKey, groupSeq++);
+    } else {
+      entries.delete(windowId);
+    }
+    pruneGroupOrder();
+    return true;
+  };
+
+  const remove = (windowId) => {
+    entries.delete(windowId);
+    focusOrder = focusOrder.filter((id) => id !== windowId);
+    pruneGroupOrder();
+  };
+
+  const pickWindow = (candidates, { focusedId = null, mainId = null } = {}) => {
+    if (candidates.length === 0) return null;
+    const has = (id) => id != null && candidates.includes(id);
+    if (has(focusedId)) return focusedId;
+    const recent = focusOrder.find(has);
+    if (recent != null) return recent;
+    if (has(mainId)) return mainId;
+    return candidates[candidates.length - 1];
+  };
+
+  const withOwner = (rows, owner) => rows.map((row) => ({ ...row, owner }));
+
+  const buildView = ({ focusedId = null, mainId = null } = {}) => {
+    const allIds = [...entries.keys()];
+    const shownIds = allIds.filter((id) => !isEmptySnapshot(entries.get(id).snapshot));
+    const leadId = pickWindow(shownIds.length > 0 ? shownIds : allIds, { focusedId, mainId });
+    if (leadId == null) return null;
+    const lead = entries.get(leadId);
+    const leadGroupKey = groupKeyOf(leadId, lead.runtimeKey);
+
+    const idsByGroup = new Map();
+    for (const [id, entry] of entries) {
+      if (isEmptySnapshot(entry.snapshot)) continue;
+      const key = groupKeyOf(id, entry.runtimeKey);
+      idsByGroup.set(key, [...(idsByGroup.get(key) || []), id]);
+    }
+    const groupKeys = [...idsByGroup.keys()].sort((a, b) => {
+      if (a === leadGroupKey) return -1;
+      if (b === leadGroupKey) return 1;
+      return (groupOrder.get(a) ?? 0) - (groupOrder.get(b) ?? 0);
+    });
+
+    const groups = groupKeys.map((key) => {
+      const windowId = pickWindow(idsByGroup.get(key), { focusedId, mainId });
+      const { snapshot, runtimeKey } = entries.get(windowId);
+      const owner = { windowId, runtimeKey };
+      return {
+        owner,
+        instanceName: snapshot.instanceName,
+        sessions: withOwner(snapshot.sessions, owner),
+        approvals: withOwner(snapshot.approvals, owner),
+        dockUnreadSessions: withOwner(snapshot.dockUnreadSessions, owner),
+        dockBadgeCount: snapshot.dockBadgeCount,
+      };
+    });
+
+    const leadOwner = { windowId: leadId, runtimeKey: lead.runtimeKey };
+    if (groups.length === 0) {
+      groups.push({
+        owner: leadOwner,
+        instanceName: lead.snapshot.instanceName,
+        sessions: [], approvals: [], dockUnreadSessions: [], dockBadgeCount: 0,
+      });
+    }
+
+    return {
+      leadOwner,
+      owners: groups.map((group) => group.owner),
+      snapshot: {
+        instanceName: groups[0].instanceName,
+        groups: groups.map(({ owner, instanceName, sessions, approvals }) => ({ owner, instanceName, sessions, approvals })),
+        sessions: groups.flatMap((group) => group.sessions),
+        approvals: groups.flatMap((group) => group.approvals),
+        dockUnreadSessions: groups.flatMap((group) => group.dockUnreadSessions),
+        dockBadgeCount: groups.reduce((sum, group) => sum + group.dockBadgeCount, 0),
+        usage: lead.snapshot.usage,
+      },
+    };
+  };
+
+  return { set, remove, noteFocus, noteRuntimeKey, buildView };
+};
diff --git a/packages/electron/tray-owner.test.mjs b/packages/electron/tray-owner.test.mjs
new file mode 100644
index 000000000..b1281d309
--- /dev/null
+++ b/packages/electron/tray-owner.test.mjs
@@ -0,0 +1,156 @@
+import { describe, expect, test } from 'bun:test';
+
+import { createTraySnapshotStore } from './tray-owner.mjs';
+
+const MAIN = 1;
+const SECOND = 2;
+const THIRD = 3;
+
+const snap = (label, extra = {}) => ({
+  instanceName: label,
+  sessions: [{ id: `${label}-s`, title: label }],
+  approvals: [],
+  dockBadgeCount: 1,
+  dockUnreadSessions: [{ id: `${label}-u`, title: label }],
+  ...extra,
+});
+const empty = (label) => ({ instanceName: label, sessions: [], approvals: [], dockBadgeCount: 0, dockUnreadSessions: [] });
+const names = (view) => view.snapshot.groups.map((group) => group.instanceName);
+
+describe('tray view grouped by instance', () => {
+  test('every open instance is shown, not just the last window to push', () => {
+    const store = createTraySnapshotStore();
+    store.set(MAIN, snap('cedar'), 'host:cedar');
+    store.noteFocus(MAIN);
+    store.set(SECOND, snap('navi'), 'local');
+
+    const view = store.buildView({ focusedId: MAIN, mainId: MAIN });
+    expect(names(view)).toEqual(['cedar', 'navi']);
+    expect(view.snapshot.sessions.map((s) => s.id)).toEqual(['cedar-s', 'navi-s']);
+    expect(view.owners).toEqual([
+      { windowId: MAIN, runtimeKey: 'host:cedar' },
+      { windowId: SECOND, runtimeKey: 'local' },
+    ]);
+  });
+
+  test('the focused window\'s instance comes first, the rest keep a stable order', () => {
+    const store = createTraySnapshotStore();
+    store.set(MAIN, snap('cedar'), 'host:cedar');
+    store.set(SECOND, snap('navi'), 'local');
+    store.set(THIRD, snap('third'), 'host:third');
+    store.set(MAIN, snap('cedar', { sessions: [{ id: 'new' }] }), 'host:cedar'); // a later push does not reorder
+
+    expect(names(store.buildView({ focusedId: THIRD, mainId: MAIN }))).toEqual(['third', 'cedar', 'navi']);
+    expect(names(store.buildView({ focusedId: SECOND, mainId: MAIN }))).toEqual(['navi', 'cedar', 'third']);
+    expect(names(store.buildView({ focusedId: null, mainId: MAIN }))).toEqual(['cedar', 'navi', 'third']);
+  });
+
+  test('rows carry the window that supplied them', () => {
+    const store = createTraySnapshotStore();
+    store.set(MAIN, snap('cedar', { approvals: [{ id: 'p1', kind: 'permission', sessionId: 'c' }] }), 'host:cedar');
+    store.set(SECOND, snap('navi', { approvals: [{ id: 'p2', kind: 'permission', sessionId: 'n' }] }), 'local');
+    const view = store.buildView({ focusedId: MAIN, mainId: MAIN });
+    expect(view.snapshot.approvals.map((a) => [a.id, a.owner])).toEqual([
+      ['p1', { windowId: MAIN, runtimeKey: 'host:cedar' }],
+      ['p2', { windowId: SECOND, runtimeKey: 'local' }],
+    ]);
+    expect(view.snapshot.dockUnreadSessions.map((s) => s.owner.windowId)).toEqual([MAIN, SECOND]);
+  });
+
+  test('windows on the same instance count once: focused, else most recently focused, else latest push', () => {
+    const store = createTraySnapshotStore();
+    store.set(MAIN, snap('navi-a', { dockBadgeCount: 3 }), 'local');
+    store.set(SECOND, snap('navi-b', { dockBadgeCount: 3 }), 'local');
+    store.set(THIRD, snap('cedar', { dockBadgeCount: 2 }), 'host:cedar');
+
+    const latest = store.buildView({ focusedId: THIRD });
+    expect(names(latest)).toEqual(['cedar', 'navi-b']);
+    expect(latest.snapshot.dockBadgeCount).toBe(5);
+
+    store.noteFocus(MAIN);
+    expect(names(store.buildView({ focusedId: null }))).toEqual(['navi-a', 'cedar']);
+    expect(names(store.buildView({ focusedId: SECOND }))).toEqual(['navi-b', 'cedar']);
+  });
+
+  test('an empty window contributes nothing, and an all-empty tray keeps the lead header', () => {
+    const store = createTraySnapshotStore();
+    store.set(MAIN, empty('cedar'), 'host:cedar');
+    store.set(SECOND, snap('navi'), 'local');
+    expect(names(store.buildView({ focusedId: MAIN, mainId: MAIN }))).toEqual(['navi']);
+
+    store.set(SECOND, empty('navi'), 'local');
+    const view = store.buildView({ focusedId: MAIN, mainId: MAIN });
+    expect(names(view)).toEqual(['cedar']);
+    expect(view.snapshot.sessions).toEqual([]);
+    expect(view.snapshot.dockBadgeCount).toBe(0);
+  });
+
+  test('a focused window with nothing to show (a lock screen) does not lead the tray', () => {
+    const store = createTraySnapshotStore();
+    store.set(MAIN, snap('cedar', { usage: { mode: 'usage', groups: [{ provider: 'cedar-p' }] } }), 'host:cedar');
+    store.set(SECOND, empty('navi'), 'local');
+    store.noteFocus(SECOND);
+    const view = store.buildView({ focusedId: SECOND, mainId: MAIN });
+    expect(view.leadOwner.windowId).toBe(MAIN);
+    expect(view.snapshot.usage.groups[0].provider).toBe('cedar-p');
+  });
+
+  test('windows without a runtime key yet are not merged with each other', () => {
+    const store = createTraySnapshotStore();
+    store.set(MAIN, snap('a'), '');
+    store.set(SECOND, snap('b'), '');
+    expect(names(store.buildView({ focusedId: MAIN }))).toEqual(['a', 'b']);
+  });
+
+  test('usage comes from the lead window', () => {
+    const store = createTraySnapshotStore();
+    store.set(MAIN, snap('cedar', { usage: { mode: 'usage', groups: [{ provider: 'cedar-p' }] } }), 'host:cedar');
+    store.set(SECOND, snap('navi', { usage: { mode: 'usage', groups: [{ provider: 'navi-p' }] } }), 'local');
+    expect(store.buildView({ focusedId: SECOND }).snapshot.usage.groups[0].provider).toBe('navi-p');
+  });
+
+  test('a closed window\'s rows leave the tray', () => {
+    const store = createTraySnapshotStore();
+    store.set(MAIN, snap('cedar'), 'host:cedar');
+    store.set(SECOND, snap('navi'), 'local');
+    store.noteFocus(SECOND);
+    store.remove(SECOND);
+    expect(names(store.buildView({ focusedId: null, mainId: MAIN }))).toEqual(['cedar']);
+    store.remove(MAIN);
+    expect(store.buildView({ focusedId: null, mainId: null })).toBeNull();
+  });
+
+  test('the runtime key comes from main, not from the renderer payload', () => {
+    const store = createTraySnapshotStore();
+    store.set(SECOND, { ...snap('remote'), runtimeKey: 'host:spoofed' }, 'host:real');
+    const view = store.buildView({ focusedId: SECOND });
+    expect(view.leadOwner.runtimeKey).toBe('host:real');
+    expect(view.snapshot.sessions[0].owner.runtimeKey).toBe('host:real');
+  });
+
+  test('an in-place host switch drops the window\'s old snapshot', () => {
+    const store = createTraySnapshotStore();
+    store.set(MAIN, snap('navi'), 'local');
+    store.set(SECOND, snap('third'), 'host:third');
+    store.noteFocus(MAIN);
+
+    expect(store.noteRuntimeKey(MAIN, 'local')).toBe(false);
+    expect(store.noteRuntimeKey(MAIN, 'host:cedar')).toBe(true);
+
+    // The new instance has not pushed yet (it may be locked or unreachable):
+    // navi's rows must not stay in the tray.
+    expect(names(store.buildView({ focusedId: MAIN, mainId: MAIN }))).toEqual(['third']);
+
+    store.set(MAIN, snap('cedar'), 'host:cedar');
+    expect(names(store.buildView({ focusedId: MAIN, mainId: MAIN }))).toEqual(['cedar', 'third']);
+  });
+
+  test('a snapshot pushed before the window reported its key is restamped, not dropped', () => {
+    const store = createTraySnapshotStore();
+    store.set(MAIN, snap('navi'), '');
+    expect(store.noteRuntimeKey(MAIN, 'local')).toBe(true);
+    const view = store.buildView({ focusedId: MAIN });
+    expect(names(view)).toEqual(['navi']);
+    expect(view.leadOwner.runtimeKey).toBe('local');
+  });
+});
diff --git a/packages/electron/tray-routing.mjs b/packages/electron/tray-routing.mjs
new file mode 100644
index 000000000..a576eddf7
--- /dev/null
+++ b/packages/electron/tray-routing.mjs
@@ -0,0 +1,102 @@
+import { app, BrowserWindow, Menu } from 'electron';
+import log from 'electron-log/main.js';
+import { applyDockBadge } from './dev-dock-identity.mjs';
+import { buildDockMenuTemplate, buildUnreadJumpList } from './dock-menu.mjs';
+import { createTraySnapshotStore } from './tray-owner.mjs';
+
+const liveWindowById = (windowId) => {
+  if (windowId == null) return null;
+  const window = BrowserWindow.fromId(windowId);
+  return window && !window.isDestroyed() ? window : null;
+};
+
+const liveWindowId = (window) => (window && !window.isDestroyed() ? window.id : null);
+
+export const createTrayRouting = ({ getTrayController, localeRouter, getMainWindow, getMenuLocale, onAction, emitTrayAction, openSessionInMainWindow, hostIdOfOwner }) => {
+  const snapshots = createTraySnapshotStore();
+  let leadOwner = null;
+  let owners = [];
+  let lastJumpListKey = '';
+
+  const publishDock = (snapshot) => {
+    applyDockBadge(app, snapshot.dockBadgeCount ?? 0);
+    if (process.platform === 'darwin' && app.dock) {
+      const template = buildDockMenuTemplate(snapshot, { locale: getMenuLocale(), onAction });
+      // external: https://www.electronjs.org/docs/latest/api/dock#docksetmenumenu Use an empty menu to clear it; Electron 45 rejects null.
+      app.dock.setMenu(Menu.buildFromTemplate(template));
+    }
+    if (process.platform === 'win32' && app.isPackaged) {
+      const jumpList = buildUnreadJumpList(snapshot, {
+        execPath: process.execPath, locale: getMenuLocale(),
+        removedItems: app.getJumpListSettings().removedItems, hostIdOf: hostIdOfOwner,
+      });
+      const key = JSON.stringify(jumpList);
+      if (key !== lastJumpListKey) {
+        const result = app.setJumpList(jumpList);
+        if (result === 'ok') lastJumpListKey = key;
+        else log.warn('[electron] unread jump list update failed', { result });
+      }
+    }
+  };
+
+  const apply = (focusedId = liveWindowId(BrowserWindow.getFocusedWindow())) => {
+    const view = snapshots.buildView({ focusedId, mainId: liveWindowId(getMainWindow()) });
+    leadOwner = view ? view.leadOwner : null;
+    owners = view ? view.owners : [];
+    const snapshot = view ? view.snapshot : {};
+    const trayController = getTrayController();
+    if (trayController) {
+      try {
+        localeRouter.publish(leadOwner ? liveWindowById(leadOwner.windowId) : null);
+        trayController.update(snapshot);
+      } catch (error) {
+        log.warn('[electron] tray update failed', error);
+      }
+    }
+    try {
+      publishDock(snapshot);
+    } catch (error) {
+      log.warn('[electron] dock badge update failed', error);
+    }
+  };
+
+  const route = async (rawAction) => {
+    const { owner: rowOwner, ...action } = rawAction;
+    const owner = rowOwner ?? leadOwner;
+    const ownerWindow = liveWindowById(owner?.windowId);
+    const ownerRuntimeKey = owner?.runtimeKey || '';
+
+    if (action.type === 'menu-opened' || action.type === 'mark-all-read') {
+      const targets = owners.map((entry) => liveWindowById(entry.windowId)).filter(Boolean);
+      for (const target of targets) emitTrayAction(target, action);
+      if (targets.length > 0) return null;
+    }
+
+    if (action.type === 'respond-permission' && owner) {
+      if (ownerWindow) emitTrayAction(ownerWindow, action);
+      else await openSessionInMainWindow(action.sessionId, '', ownerRuntimeKey);
+      return null;
+    }
+
+    return { action, ownerWindow, ownerRuntimeKey };
+  };
+
+  return {
+    setSnapshot: (windowId, snapshot, runtimeKey) => {
+      snapshots.set(windowId, snapshot, runtimeKey);
+      apply();
+    },
+    forgetWindow: (windowId) => {
+      snapshots.remove(windowId);
+      apply();
+    },
+    noteFocus: (windowId) => {
+      snapshots.noteFocus(windowId);
+      apply(windowId);
+    },
+    noteRuntimeKey: (windowId, runtimeKey) => {
+      if (snapshots.noteRuntimeKey(windowId, runtimeKey)) apply();
+    },
+    route,
+  };
+};
