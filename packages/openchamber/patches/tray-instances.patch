@@ -0,0 +1,57 @@
+import { describe, expect, test } from 'bun:test';
+import type { Session } from '@/lib/opencode/model';
+import { getPinnedSessionKey } from '@/lib/sessionPins';
+import { getRuntimeKey } from '@/lib/runtime-switch';
+import { createSessionOwnershipIndex } from '../sessions/sessionOwnership';
+import { buildSidebarSessionTree, collectNestedSessionIds, resolveSidebarSessionRows } from './sidebarSessionTree';
+
+const session = (id: string, options: { parentID?: string; directory?: string; archived?: number } = {}): Session => {
+  const time: Session['time'] = { created: 1, updated: 1 };
+  if (options.archived) time.archived = options.archived;
+  return {
+    id,
+    parentID: options.parentID,
+    projectID: 'project',
+    directory: options.directory ?? '/project',
+    title: id,
+    cost: 0,
+    tokens: { input: 0, output: 0, reasoning: 0, cache: { read: 0, write: 0 } },
+    time,
+  };
+};
+
+const rowsOf = (active: Session[], archived: Session[] = [], pinned: string[] = []) => {
+  const knownDirectories = new Set(['/project']);
+  const tree = buildSidebarSessionTree({ globalActiveSessions: active, liveSessions: [], knownDirectories, isVSCode: false });
+  const owners = createSessionOwnershipIndex(tree.projectSessions, [{ id: 'project', normalizedPath: '/project' }], new Map(), false, archived).bySessionId;
+  const pinnedSessionIds = new Set(pinned.flatMap((key) => key ? [key] : []));
+  return resolveSidebarSessionRows(tree, collectNestedSessionIds(tree, archived), {
+    ownerBySessionId: owners, pinnedSessionIds, zones: { chats: true, pinned: true },
+  });
+};
+
+describe('resolveSidebarSessionRows', () => {
+  test('a subagent whose parent is not loaded is a root, as the sidebar shows it', () => {
+    expect(rowsOf([session('orphan', { parentID: 'missing' })]).rootIds).toEqual(['orphan']);
+  });
+
+  test('a child of an archived parent has no row and no root', () => {
+    const rows = rowsOf([session('child', { parentID: 'parent' })], [session('parent', { archived: 5 })]);
+    expect(rows.rootIds).toEqual([]);
+    expect(rows.rootOf.has('child')).toBe(false);
+  });
+
+  test('a loop of parents gets one root, as the sidebar lists it', () => {
+    const rows = rowsOf([session('a', { parentID: 'b' }), session('b', { parentID: 'a' }), session('c', { parentID: 'a' })]);
+    expect(rows.rootIds).toEqual(['a']);
+    expect(rows.rootOf.get('b')).toBe('a');
+    expect(rows.rootOf.get('c')).toBe('a');
+  });
+
+  test('a space session no project group holds has a row only through the Pinned section', () => {
+    const spaced = session('spaced', { directory: '/spaces/a1b2c3d4e5f6/app' });
+    expect(rowsOf([spaced]).rootIds).toEqual([]);
+    const pinKey = getPinnedSessionKey(getRuntimeKey(), spaced.directory, 'spaced');
+    expect(rowsOf([spaced], [], pinKey ? [pinKey] : []).rootIds).toEqual(['spaced']);
+  });
+});
