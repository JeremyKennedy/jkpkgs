@@ -0,0 +1,41 @@
+import { afterEach, beforeEach, describe, expect, test } from "bun:test"
+import type { SyncEvent } from "@/lib/opencode/events"
+import { ChildStoreManager } from "../child-store"
+import { createEventRoutingIndex, handleEvent } from "../sync-context"
+import { getRuntimeKey } from "@/lib/runtime-switch"
+import { resetGlobalBlockingRequests, useGlobalBlockingRequestsStore } from "../global-blocking-requests"
+
+// After an in-place host switch the old event pipeline flushes its queue on
+// cleanup. Those events belong to the previous instance and must not reach the
+// global stores, which now hold the new instance.
+
+const asked: SyncEvent = {
+  type: "permission.asked",
+  properties: { id: "perm_old", sessionID: "ses_old", action: "bash", resources: ["git status"] },
+}
+
+describe("global effects of an event from a previous runtime", () => {
+  let childStores: ChildStoreManager
+
+  beforeEach(() => {
+    childStores = new ChildStoreManager()
+    resetGlobalBlockingRequests()
+  })
+
+  afterEach(() => {
+    childStores.disposeAll()
+    resetGlobalBlockingRequests()
+  })
+
+  test("a permission from the previous instance stays out of the approvals index", () => {
+    handleEvent("/repo", asked, childStores, createEventRoutingIndex(), `${getRuntimeKey()}-previous`)
+
+    expect(useGlobalBlockingRequestsStore.getState().bySession.size).toBe(0)
+  })
+
+  test("the same permission from the current instance is indexed", () => {
+    handleEvent("/repo", asked, childStores, createEventRoutingIndex(), getRuntimeKey())
+
+    expect(useGlobalBlockingRequestsStore.getState().bySession.get("ses_old")?.permissions.map((p) => p.id)).toEqual(["perm_old"])
+  })
+})
