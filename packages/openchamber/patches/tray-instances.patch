+
+const nestingParentResolver = (sessionById: ReadonlyMap<string, Session>) => (
+  (session: Session): string | null => resolveSessionNestingParentId(session, (id) => sessionById.get(id))
+);
+
+export const partitionSidebarSessions = (
+  sessions: readonly Session[],
+  isVSCode: boolean,
+): SidebarSessionPartitions => {
+  const projectSessions: Session[] = [];
+  const chatSessions: Session[] = [];
+  const excludeChats = isVSCode && !isVSCodeWithoutWorkspace();
+  for (const session of sessions) {
+    if (isBtwSession(session)) continue;
+    if (isChatDirectoryPath(session.directory)) {
+      if (excludeChats) continue;
+      chatSessions.push(session);
+      continue;
+    }
+    projectSessions.push(session);
+  }
+  return { projectSessions, chatSessions };
+};
+
+export const toKnownDirectoryKeys = (knownDirectories: Set<string>, isVSCode: boolean): Set<string> => (
+  new Set([...knownDirectories].map((directory) => isVSCode ? directory.toLowerCase() : directory))
+);
+
+export const isKnownActiveSessionDirectory = (
+  session: Session,
+  knownDirectories: Set<string>,
+  isVSCode: boolean,
+): boolean => {
+  const normalized = normalizePath(resolveGlobalSessionDirectory(session));
+  const directory = isVSCode ? normalized?.toLowerCase() : normalized;
+  if (!directory) return false;
+  if (!isVSCode && isSpaceDirectory(directory)) return true;
+  if (knownDirectories.size === 0) return false;
+  return knownDirectories.has(directory) || (!isVSCode && [...knownDirectories].some((root) => directory.startsWith(root.endsWith('/') ? root : `${root}/`)));
+};
+
+export const keepKnownSessionsWithDescendants = (
+  sessions: readonly Session[],
+  isKnown: (session: Session) => boolean,
+  anchors: readonly Session[],
+): Session[] => {
+  const sessionById = new Map([...anchors, ...sessions].map((session) => [session.id, session]));
+  const nestingParentOf = nestingParentResolver(sessionById);
+  const kept = new Map<string, boolean>(anchors.map((anchor) => [anchor.id, true]));
+  const keeps = (session: Session): boolean => {
+    const cached = kept.get(session.id);
+    if (cached !== undefined) return cached;
+    kept.set(session.id, false);
+    const parent = isKnown(session) ? null : sessionById.get(nestingParentOf(session) ?? '');
+    const result = parent === null || Boolean(parent && keeps(parent));
+    kept.set(session.id, result);
+    return result;
+  };
+  return sessions.filter(keeps);
+};
+
+const mergeSidebarSessionSources = (
+  globalActiveSessions: readonly Session[],
+  liveSessions: readonly Session[],
+): Session[] => {
+  const sessions = [...globalActiveSessions];
+  const knownIds = new Set(globalActiveSessions.map((session) => session.id));
+  for (const session of liveSessions) {
+    if (knownIds.has(session.id)) continue;
+    knownIds.add(session.id);
+    sessions.push(session);
+  }
+  return sessions;
+};
+
+export const buildSidebarSessionTree = ({
+  globalActiveSessions,
+  liveSessions,
+  knownDirectories,
+  isVSCode,
+  globalStructure,
+}: SidebarSessionTreeInput) => {
+  countSyncPerformance('sidebarStructureBuilds');
+  const indexedGlobalSessions = globalActiveSessions ?? [];
+  const visibleSessions = mergeSidebarSessionSources(indexedGlobalSessions, liveSessions);
+  const partition = partitionSidebarSessions(visibleSessions, isVSCode);
+  const knownDirectoryKeys = toKnownDirectoryKeys(knownDirectories, isVSCode);
+  const projectSessions = keepKnownSessionsWithDescendants(
+    partition.projectSessions,
+    (session) => isKnownActiveSessionDirectory(session, knownDirectoryKeys, isVSCode),
+    partition.chatSessions,
+  );
+  const sessions = [...projectSessions, ...partition.chatSessions];
+  const sessionById = new Map(sessions.map((session) => [session.id, session]));
+  const nestingParentOf = nestingParentResolver(sessionById);
+  const nestingParentById = new Map<string, string>();
+  for (const session of sessions) {
+    const parentId = nestingParentOf(session);
+    if (parentId) nestingParentById.set(session.id, parentId);
+  }
+  return {
+    chatSessionIds: new Set(partition.chatSessions.map((session) => session.id)),
+    projectSessions,
+    sessionById,
+    sessions,
+    nestingParentById,
+    hierarchy: globalStructure ? {
+      rootIds: globalStructure.activeRootIds,
+      childrenByParentId: globalStructure.activeChildrenByParentId,
+    } : undefined,
+  };
+};
+
+export type SidebarSessionTree = ReturnType<typeof buildSidebarSessionTree>;
+
+export const filterSidebarArchivedSessions = (
+  archivedSessions: readonly Session[],
+  knownDirectories: Set<string>,
+  isVSCode: boolean,
+): Session[] => {
+  const known = toKnownDirectoryKeys(knownDirectories, isVSCode);
+  return archivedSessions.filter((session) => (
+    isChatDirectoryPath(session.directory) ? !isVSCode : isKnownActiveSessionDirectory(session, known, isVSCode)
+  ));
+};
+
+export const collectNestedSessionIds = (
+  tree: SidebarSessionTree,
+  archivedSessions: readonly Session[],
+): Set<string> => {
+  const listed = new Set([...tree.sessionById.keys(), ...archivedSessions.map((session) => session.id)]);
+  const nested = new Set<string>();
+  for (const [sessionId, parentId] of tree.nestingParentById) {
+    if (listed.has(parentId)) nested.add(sessionId);
+  }
+  for (const session of archivedSessions) {
+    // SAFETY: OpenCode's session records carry parentID for sub-session
+    // hierarchy; the SDK's base Session type does not currently expose it.
+    const parentID = (session as Session & { parentID?: string | null }).parentID;
+    if (parentID && listed.has(parentID)) nested.add(session.id);
+  }
+  return nested;
+};
+
+type SidebarRowPlacement = {
+  ownerBySessionId: ReadonlyMap<string, unknown>;
+  pinnedSessionIds: Set<string>;
+  zones: { chats: boolean; pinned: boolean };
+};
+
+type SidebarSessionRows = {
+  rootIds: string[];
+  rootOf: ReadonlyMap<string, string>;
+};
+
+export const resolveSidebarSessionRows = (
+  tree: SidebarSessionTree,
+  nestedSessionIds: ReadonlySet<string>,
+  { ownerBySessionId, pinnedSessionIds, zones }: SidebarRowPlacement,
+): SidebarSessionRows => {
+  const hasRow = (session: Session): boolean => {
+    if (session.time?.archived || nestedSessionIds.has(session.id)) return false;
+    if (tree.chatSessionIds.has(session.id)) return zones.chats;
+    if (ownerBySessionId.has(session.id)) return true;
+    return zones.pinned
+      && !isChatDirectoryPath(session.directory)
+      && isSessionPinned(pinnedSessionIds, session.directory, session.id)
+      && (getSessionPinList(session) ?? DEFAULT_PIN_LIST) === DEFAULT_PIN_LIST;
+  };
+  const rootIds = tree.sessions.filter(hasRow).map((session) => session.id);
+  const rootOf = new Map(rootIds.map((id) => [id, id]));
+  const resolve = (sessionId: string, seen: Set<string>): string | undefined => {
+    const known = rootOf.get(sessionId);
+    if (known !== undefined || !nestedSessionIds.has(sessionId) || seen.has(sessionId)) return known;
+    seen.add(sessionId);
+    const parentId = tree.nestingParentById.get(sessionId);
+    const root = parentId ? resolve(parentId, seen) : undefined;
+    if (root !== undefined) rootOf.set(sessionId, root);
+    return root;
+  };
+  const isInNestingCycle = (session: Session): boolean => {
+    const seen = new Set<string>();
+    let current: Session | undefined = session;
+    while (current && !current.time?.archived) {
+      if (seen.has(current.id)) return true;
+      seen.add(current.id);
+      const parentId = tree.nestingParentById.get(current.id);
+      current = parentId ? tree.sessionById.get(parentId) : undefined;
+    }
+    return false;
+  };
+  for (const session of tree.sessions) {
+    if (resolve(session.id, new Set()) !== undefined || session.time?.archived) continue;
+    if (!nestedSessionIds.has(session.id) || tree.chatSessionIds.has(session.id)) continue;
+    if (!ownerBySessionId.has(session.id) || !isInNestingCycle(session)) continue;
+    rootIds.push(session.id);
+    rootOf.set(session.id, session.id);
+  }
+  for (const session of tree.sessions) resolve(session.id, new Set());
+  return { rootIds, rootOf };
+};
