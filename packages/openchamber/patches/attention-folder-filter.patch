@@ -0,0 +1,33 @@
+import { normalizePath } from '@/lib/pathNormalization';
+
+export type AttentionDirectories = {
+  roots: readonly string[];
+  chatRoots: readonly string[];
+};
+
+const SPACE_DIRECTORY = /^\/spaces\/[0-9a-f]{12}(?:\/|$)/;
+const SPACE_ARCHIVE_DIRECTORY = /\/spaces\/archive\/[0-9a-f]{12}(?:\/|$)/;
+const DROPS_OUT_OF_ROOT = /\/\.\.(?:\/|$)/;
+
+const holds = (directory: string, root: string): boolean => (
+  directory === root
+  || directory.startsWith(root.endsWith('/') ? root : `${root}/`)
+);
+
+export const legacyChatsRootForHome = (home: string | null | undefined): string | null => {
+  const normalized = normalizePath(home);
+  return normalized ? `${normalized}/.config/openchamber/chats` : null;
+};
+
+export const isAttentionDirectoryAdmitted = (
+  directory: string | null | undefined,
+  directories: AttentionDirectories | undefined,
+): boolean => {
+  if (!directories) return true;
+  const normalized = normalizePath(directory);
+  if (!normalized) return false;
+  if (SPACE_DIRECTORY.test(normalized) || SPACE_ARCHIVE_DIRECTORY.test(normalized)) return true;
+  if (DROPS_OUT_OF_ROOT.test(normalized)) return false;
+  return directories.chatRoots.some((root) => holds(normalized, root))
+    || directories.roots.some((root) => holds(normalized, root));
+};
diff --git a/packages/ui/src/lib/attentionDirectories.test.ts b/packages/ui/src/lib/attentionDirectories.test.ts
new file mode 100644
--- /dev/null
+++ b/packages/ui/src/lib/attentionDirectories.test.ts
@@ -0,0 +1,73 @@
+import { describe, expect, test } from 'bun:test';
+
+import { isAttentionDirectoryAdmitted, legacyChatsRootForHome } from './attentionDirectories';
+
+const directories = (overrides: Partial<Parameters<typeof isAttentionDirectoryAdmitted>[1]> = {}) => ({
+  roots: ['/home/me/dev', '/home/me/dev/deadlock'],
+  chatRoots: ['/home/me/.local/share/openchamber/chats', '/home/me/.config/openchamber/chats'],
+  ...overrides,
+});
+
+describe('the attention directory rule', () => {
+  test('a session anywhere under a project is admitted, not only at its root', () => {
+    const project = directories();
+    expect(isAttentionDirectoryAdmitted('/home/me/dev/deadlock', project)).toBe(true);
+    expect(isAttentionDirectoryAdmitted('/home/me/dev/deadlock/.worktrees/repair', project)).toBe(true);
+    expect(isAttentionDirectoryAdmitted('/home/me/dev/scoredo', project)).toBe(true);
+  });
+
+  test('a folder no project holds is left out, which is the sidebar rule', () => {
+    const project = directories();
+    expect(isAttentionDirectoryAdmitted('/tmp/opencode/qcards-proj', project)).toBe(false);
+    expect(isAttentionDirectoryAdmitted('/Users/me/dev', project)).toBe(false);
+    // A sibling whose name merely starts with a project's does not belong to it.
+    expect(isAttentionDirectoryAdmitted('/home/me/dev-other', project)).toBe(false);
+  });
+
+  test('the chat roots are admitted, both the configured and the legacy one', () => {
+    const project = directories({ roots: [] });
+    expect(isAttentionDirectoryAdmitted('/home/me/.local/share/openchamber/chats/2026-11-21/session-a', project)).toBe(true);
+    expect(isAttentionDirectoryAdmitted('/home/me/.config/openchamber/chats/2026-11-12/session-b', project)).toBe(true);
+  });
+
+  test('an isolated space is admitted by its own folder name', () => {
+    expect(isAttentionDirectoryAdmitted('/spaces/0123456789ab/app', directories({ roots: [] }))).toBe(true);
+    // A path that only looks like a space is still judged by the roots.
+    expect(isAttentionDirectoryAdmitted('/spaces/not-a-space/app', directories({ roots: [] }))).toBe(false);
+  });
+
+  test('a project registered at a filesystem root admits everything under it', () => {
+    expect(isAttentionDirectoryAdmitted('/home/me/dev/x', directories({ roots: ['/'], chatRoots: [] }))).toBe(true);
+    expect(isAttentionDirectoryAdmitted('D:/dev/x', directories({ roots: ['D:/'], chatRoots: [] }))).toBe(true);
+    expect(isAttentionDirectoryAdmitted('C:/dev/x', directories({ roots: ['C:'], chatRoots: [] }))).toBe(true);
+  });
+
+  test('a chat archived from a deleted space is admitted', () => {
+    expect(isAttentionDirectoryAdmitted('/home/me/.local/share/openchamber/spaces/archive/0123456789ab', directories())).toBe(true);
+    expect(isAttentionDirectoryAdmitted('/data/spaces/archive/0123456789ab/app', directories({ roots: [] }))).toBe(true);
+  });
+
+  test('a reported path cannot climb out of a root it names', () => {
+    expect(isAttentionDirectoryAdmitted('/home/me/dev/deadlock/../../secret', directories())).toBe(false);
+    expect(isAttentionDirectoryAdmitted('/home/me/dev/../../../etc', directories())).toBe(false);
+  });
+
+  test('an unreadable folder is not admitted, and no answer admits everything', () => {
+    expect(isAttentionDirectoryAdmitted(null, directories())).toBe(false);
+    expect(isAttentionDirectoryAdmitted('', directories())).toBe(false);
+    // Absent means the server did not say; the rows keep standing.
+    expect(isAttentionDirectoryAdmitted('/tmp/anything', undefined)).toBe(true);
+  });
+
+  test('a trailing slash and a Windows spelling still match their root', () => {
+    expect(isAttentionDirectoryAdmitted('/home/me/dev/deadlock/', directories())).toBe(true);
+    expect(isAttentionDirectoryAdmitted('C:\\dev\\app', directories({ roots: ['C:/dev'] }))).toBe(true);
+  });
+
+  test('the legacy chats root comes from the home folder the server reported', () => {
+    expect(legacyChatsRootForHome('/home/me')).toBe('/home/me/.config/openchamber/chats');
+    expect(legacyChatsRootForHome('/home/me/')).toBe('/home/me/.config/openchamber/chats');
+    expect(legacyChatsRootForHome(null)).toBeNull();
+    expect(legacyChatsRootForHome('')).toBeNull();
+  });
+});
