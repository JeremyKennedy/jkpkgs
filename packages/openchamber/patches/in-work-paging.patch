+export const buildInWorkAttention = (
+  ref: SidebarWorkRef,
+  context: Pick<FactsContext, 'sessionById' | 'childrenMap'> & { activeIds: ReadonlySet<string>; blockingIds: ReadonlySet<string> },
+): InWorkAttention => {
+  const { all, top } = collectWorkSessions(ref, context);
