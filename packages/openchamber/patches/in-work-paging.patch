+/**
+ * The live state In work ranks its rows by: sessions whose turn is open
+ * (background work included) and sessions with a permission, a question or a
+ * page waiting on the user. It reads no session library, so a recency-only
+ * update does not run it again; the unread scan stays with the section
+ * filters that need it.
+ */
+export type SidebarTurnAndBlockingFacts = {
+  activeIds: ReadonlySet<string>;
+  blockingIds: ReadonlySet<string>;
+};
+
+const EMPTY_TURN_AND_BLOCKING: SidebarTurnAndBlockingFacts = { activeIds: EMPTY_IDS, blockingIds: EMPTY_IDS };
+
+const useSidebarTurnAndBlocking = (enabled: boolean): SidebarTurnAndBlockingFacts => {
+  // Membership of these sets changes only when a turn or its background work starts or ends.
+  const activeIds = useGlobalSessionStatusStore((state) => (enabled ? state.activeSessionIds : EMPTY_IDS));
+  const workflowIds = useWorkflowActivityStore((state) => (enabled ? state.runningSessionIds : EMPTY_IDS));
+  const shellIds = useBackgroundShellsStore((state) => (enabled ? state.sessionIds : EMPTY_IDS));
+  const imageIds = useBackgroundImagesStore((state) => (enabled ? state.sessionIds : EMPTY_IDS));
+  const prWatches = usePrWatchStore((state) => (enabled ? state.bySession : EMPTY_PR_WATCHES));
+  const blocking = useGlobalBlockingRequestsStore((state) => (enabled ? state.bySession : EMPTY_BLOCKING));
+  return React.useMemo(() => {
+    if (!enabled) return EMPTY_TURN_AND_BLOCKING;
+    return {
+      activeIds: collectOpenTurnSessionIds(activeIds, [workflowIds, shellIds, imageIds, prWatches.keys()]),
+      blockingIds: new Set([...blocking].flatMap(([sessionId, pending]) => (
+        pending.permissions.length + pending.forms.length + pending.pages.length > 0 ? [sessionId] : []
+      ))),
+    };
+  }, [activeIds, blocking, enabled, imageIds, prWatches, shellIds, workflowIds]);
+};
+
+/** The live state In work ranks by, subscribed only while In work is shown. */
+export const useSidebarAttentionFacts = (enabled: boolean): SidebarTurnAndBlockingFacts => (
+  useSidebarTurnAndBlocking(enabled)
+);
+
