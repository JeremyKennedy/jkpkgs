+    await runtime.maybeSendPushForTrigger(formCreated('q1'))
+    expect(runtime.hasPendingQuestion('ses_1')).toBe(true)
+    // A second form in the same session keeps it pending on its own.
+    await runtime.maybeSendPushForTrigger(formCreated('q2'))
