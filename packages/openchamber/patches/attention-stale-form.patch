+import { describe, expect, test } from 'bun:test';
+
+import { planStalePendingForms, type PendingFormsBySession } from './pendingFormVerification';
+
+const form = (id: string) => ({ id });
+
+const pending = (directory: string, ...ids: string[]): PendingFormsBySession => new Map([
+  ['ses_a', { directory, forms: ids.map(form) }],
+]);
+
+describe('finding the indexed forms the server no longer holds', () => {
+  test('a form missing from the server answer is stale', async () => {
+    const stale = await planStalePendingForms(
+      pending('/repo', 'frm_gone', 'frm_live'),
+      () => '/repo',
+      async () => [form('frm_live')],
+    );
+
+    expect(stale).toEqual([{ sessionId: 'ses_a', formId: 'frm_gone' }]);
+  });
+
+  test('a form the server still holds is kept', async () => {
+    const stale = await planStalePendingForms(
+      pending('/repo', 'frm_live'),
+      () => '/repo',
+      async () => [form('frm_live')],
+    );
+
+    expect(stale).toEqual([]);
+  });
+
+  test('an unreadable answer keeps every form', async () => {
+    const stale = await planStalePendingForms(
+      pending('/repo', 'frm_a'),
+      () => '/repo',
+      async () => null,
+    );
+
+    expect(stale).toEqual([]);
+  });
+
+  test('the session record decides the directory, then the index entry', async () => {
+    const asked: string[] = [];
+    const stale = await planStalePendingForms(
+      pending('/indexed', 'frm_a'),
+      () => '/from-session',
+      async (directory) => {
+        asked.push(directory);
+        return [];
+      },
+    );
+
+    expect(asked).toEqual(['/from-session']);
+    expect(stale).toEqual([{ sessionId: 'ses_a', formId: 'frm_a' }]);
+  });
+
+  test('a session already read for one directory is not asked about twice', async () => {
+    const bySession: PendingFormsBySession = new Map([
+      ['ses_a', { directory: '/repo', forms: [form('frm_a')] }],
+      ['ses_b', { directory: '/repo', forms: [form('frm_b')] }],
+    ]);
+    const asked: string[] = [];
+    const stale = await planStalePendingForms(bySession, () => null, async (directory) => {
+      asked.push(directory);
+      return [form('frm_a')];
+    });
+
+    expect(asked).toEqual(['/repo']);
+    expect(stale).toEqual([{ sessionId: 'ses_b', formId: 'frm_b' }]);
+  });
+});
