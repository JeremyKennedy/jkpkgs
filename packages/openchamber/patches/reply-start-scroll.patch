diff --git a/packages/ui/src/components/chat/message/replyProse.test.ts b/packages/ui/src/components/chat/message/replyProse.test.ts
new file mode 100644
index 0000000..3f5d77c
--- /dev/null
+++ b/packages/ui/src/components/chat/message/replyProse.test.ts
@@ -0,0 +1,58 @@
+import { describe, expect, test } from 'bun:test';
+import { Window } from 'happy-dom';
+
+import { findReplyProseElement } from './replyProse';
+
+const window = new Window();
+const document = window.document;
+
+const build = (html: string): HTMLElement => {
+    document.body.innerHTML = html;
+    return document.body.querySelector('[data-message-id="msg_1"]') as unknown as HTMLElement;
+};
+
+describe('findReplyProseElement', () => {
+    test('skips a reasoning trace drawn as plain text before the answer', () => {
+        const root = build(`
+            <div data-message-id="msg_1">
+                <div class="group/assistant-text relative break-words" data-reasoning-inline="true">Thinking about the answer</div>
+                <div data-message-text-export-source="true">The answer</div>
+            </div>
+        `);
+
+        expect(findReplyProseElement(root)?.textContent).toBe('The answer');
+    });
+
+    test('skips reasoning inside a collapsible block', () => {
+        const root = build(`
+            <div data-message-id="msg_1">
+                <div data-reasoning-block-id="reasoning-1">
+                    <div class="group/assistant-text relative break-words">Thinking about the answer</div>
+                </div>
+                <div data-message-text-export-source="true">The answer</div>
+            </div>
+        `);
+
+        expect(findReplyProseElement(root)?.textContent).toBe('The answer');
+    });
+
+    test('falls back to the plain answer block when no export source is present', () => {
+        const root = build(`
+            <div data-message-id="msg_1">
+                <div class="group/assistant-text relative break-words">The answer</div>
+            </div>
+        `);
+
+        expect(findReplyProseElement(root)?.textContent).toBe('The answer');
+    });
+
+    test('returns null when the message only holds reasoning', () => {
+        const root = build(`
+            <div data-message-id="msg_1">
+                <div class="group/assistant-text relative break-words" data-reasoning-inline="true">Thinking</div>
+            </div>
+        `);
+
+        expect(findReplyProseElement(root)).toBeNull();
+    });
+});
diff --git a/packages/ui/src/components/chat/message/replyProse.ts b/packages/ui/src/components/chat/message/replyProse.ts
new file mode 100644
index 0000000..16465e1
--- /dev/null
+++ b/packages/ui/src/components/chat/message/replyProse.ts
@@ -0,0 +1,24 @@
+/**
+ * The first block of an assistant message's own prose. A step may open with
+ * tool rows (or a reasoning trace) before it says anything, and the pill's
+ * "back to the reply start" jump should land on the text a reader means, not
+ * on the work that led to it.
+ *
+ * Text parts render as `[data-message-text-export-source]`; the plain answer
+ * block carries the AssistantTextPart class. Reasoning blocks reuse the export
+ * attribute, so their descendants are skipped. With `collapsibleThinkingBlocks`
+ * off, reasoning draws through AssistantTextPart as a bare `group/assistant-text`
+ * row, so it marks itself with `data-reasoning-inline` instead of a block id.
+ */
+const REPLY_PROSE_SELECTOR = '[data-message-text-export-source], [class~="group/assistant-text"]';
+const REASONING_SELECTOR = '[data-reasoning-block-id], [data-reasoning-inline]';
+
+export function findReplyProseElement(messageElement: HTMLElement): HTMLElement | null {
+    for (const element of messageElement.querySelectorAll<HTMLElement>(REPLY_PROSE_SELECTOR)) {
+        if (element.closest(REASONING_SELECTOR)) {
+            continue;
+        }
+        return element;
+    }
+    return null;
+}
