@@ -0,0 +1,536 @@
+/**
+ * The reference picker's search across a folder's repositories, for Gitea and
+ * Forgejo. The board asks one provider for every repository under a project
+ * folder; each folder arrives as its own bound read context.
+ *
+ * Gitea has no search that names a set of repositories, so a page is built by
+ * reading the newest page of each folder's repository and merging them by
+ * activity. That bounds a page to `MAX_PAGES_PER_REPO` pages per repository
+ * (`4`, 200 items at Gitea's 50-item cap); deeper pages stop there rather than
+ * pretend the folder holds nothing older. Pages are cached briefly so paging
+ * does not read every repository again for each page.
+ *
+ * A pull request read through Gitea's issue search carries no head or base, so
+ * only the items that land on the page are read as pull requests before they
+ * are mapped. A repository with no remote on the instance is reported as
+ * `no-repo`, a folder whose binding changed as `invalid-context`, and a gone
+ * account as `disconnected`, the same statuses the GitHub search answers.
+ */
+
+import { createHash } from 'node:crypto';
+import { z } from 'zod';
+import { isPlainObject, isString } from '../shared/guards.js';
+import { mapLimited } from '../shared/map-limited.js';
+import { headBranch, isDraftTitle } from './mappers.js';
+
+type JsonObject = Record<string, unknown>;
+type Raw = JsonObject | null | undefined;
+type RepoRef = { owner: string; name: string };
+type ProjectRef = { owner: string; repo: string };
+type Lookup = { number: number; host?: string; project?: ProjectRef };
+
+/** What this module needs of a folder's resource service. */
+export type ReferenceService = {
+  listReferenceCandidates(directory: string, options: {
+    kind: 'issue' | 'pull'; state: string; people: string; query: string; page: number; remote: string;
+  }): Promise<{ repo: RepoRef | null; items: JsonObject[]; hasMore: boolean; needsDetail?: boolean }>;
+  readPullDetail(directory: string, number: number, remote: string): Promise<unknown>;
+  readReferenceItem(directory: string, options: { kind: 'issue' | 'pull'; number: number; remote: string }): Promise<{ repo: RepoRef | null; item: unknown }>;
+};
+
+const PAGE_SIZE = 30;
+// Gitea caps a page at `[api] MAX_RESPONSE_ITEMS` (50 by default).
+const REPO_PAGE_LIMIT = 50;
+const MAX_PAGES_PER_REPO = 4;
+const ACROSS_CONCURRENCY = 4;
+const DETAIL_CONCURRENCY = 4;
+const BODY_PREVIEW_MAX = 20_000;
+const CACHE_TTL_MS = 30_000;
+const CACHE_MAX_ENTRIES = 400;
+const MAX_CONTEXTS = 100;
+
+const integer = (value: unknown): number | null => (Number.isInteger(value) ? value as number : null);
+const text = (value: unknown): string | null => (isString(value) && value.trim() ? value : null);
+
+const contextSchema = z.strictObject({
+  directory: z.string().trim().min(1),
+  repositoryId: z.string().min(1),
+  provider: z.string().min(1),
+  instance: z.string().min(1),
+  accountId: z.string().min(1),
+  bindingRevision: z.number().int().nonnegative(),
+  primaryRemote: z.string().min(1),
+});
+
+const requestSchema = z.strictObject({
+  contexts: z.array(contextSchema),
+  kind: z.enum(['issue', 'pull', 'discussion']),
+  state: z.enum(['open', 'closed', 'merged', 'all', 'unanswered']).optional(),
+  people: z.enum(['any', 'assigned', 'created', 'reviewRequested']).optional(),
+  query: z.string().optional(),
+  // The first page sends no cursor as null, like the single-repository list.
+  cursor: z.string().max(100_000).nullable().optional(),
+  // A forced read (the board's list refresh) skips the page cache.
+  refresh: z.boolean().optional(),
+});
+
+const invalidCursor = () => Object.assign(new Error('Invalid references cursor'), {
+  status: 400, code: 'INVALID_REFERENCES_CURSOR',
+});
+
+type AcrossContext = z.infer<typeof contextSchema>;
+type AcrossRequest = z.infer<typeof requestSchema>;
+type AcrossInput = AcrossRequest & { contexts: AcrossContext[]; directories: string[] };
+
+/** Validate the JSON read request before any folder or credential access. */
+export function readReferencesAcrossRequest(body: unknown, providerId: string): AcrossInput | null {
+  const parsed = requestSchema.safeParse(body);
+  if (!parsed.success) return null;
+  // One request goes to one provider; a context of another one is a caller bug.
+  if (parsed.data.contexts.some((context) => context.provider !== providerId)) return null;
+  const folders = new Map<string, AcrossContext>();
+  for (const context of parsed.data.contexts) {
+    if (!folders.has(context.directory)) folders.set(context.directory, context);
+  }
+  if (folders.size > MAX_CONTEXTS) return null;
+  return {
+    ...parsed.data,
+    contexts: [...folders.values()],
+    directories: parsed.data.contexts.map((context) => context.directory),
+  };
+}
+
+/**
+ * The cursor is an offset into a result set plus a hash of the scope that set
+ * was read for. The scope changes when a folder's binding, the kind, filters
+ * or the query do; the cursor is then not an offset into what this request
+ * would read, so the request starts again instead of showing a shifted window.
+ */
+const cursorScope = (input: AcrossInput, kind: string, state: string, people: string, query: string) => createHash('sha256').update(JSON.stringify({
+  provider: input.contexts.map((context) => [
+    context.directory, context.repositoryId, context.bindingRevision, context.primaryRemote,
+    context.instance, context.accountId,
+  ]),
+  kind,
+  state,
+  people,
+  query,
+})).digest('hex');
+
+const CURSOR = /^(\d+)\.([a-f0-9]{64})$/;
+
+const readCursor = (value: unknown, scope: string): number => {
+  if (value === null || value === undefined || value === '') return 0;
+  const match = CURSOR.exec(String(value));
+  if (!match) throw invalidCursor();
+  const offset = Number(match[1]);
+  if (!Number.isSafeInteger(offset)) throw invalidCursor();
+  return match[2] === scope ? offset : 0;
+};
+
+const NUMBERED = /^(\D{0,4})(\d+)$/u;
+// An item's page on the instance: `/owner/repo/issues/12`,
+// `/owner/repo/pulls/12`, with an optional trailing `/files`, `/commits`, ...
+const ITEM_PATH = /^\/([^/]+)\/([^/]+)\/(?:issues|pulls)\/(\d+)(?:\/.*)?$/;
+
+/**
+ * The one item a query names: `#12` or `12` (a bare number reads every asked
+ * repository), or a link to an item on the instance. Anything else is a text
+ * search. It mirrors the single-repository list's lookup, which also reads
+ * the item rather than searching for its number.
+ */
+function parseReferenceLookup(query: string): Lookup | null {
+  const trimmed = query.trim();
+  const numbered = NUMBERED.exec(trimmed);
+  if (numbered) {
+    const prefix = numbered[1];
+    const number = Number(numbered[2]);
+    return (prefix === '' || prefix === '#') && Number.isSafeInteger(number) && number > 0 ? { number } : null;
+  }
+  if (!/^https?:\/\//i.test(trimmed)) return null;
+  let url;
+  try {
+    url = new URL(trimmed);
+  } catch {
+    return null;
+  }
+  const match = ITEM_PATH.exec(decodeURIComponent(url.pathname));
+  if (!match) return null;
+  const number = Number(match[3]);
+  if (!Number.isSafeInteger(number) || number <= 0) return null;
+  const [, owner, repo] = match;
+  if (!owner || !repo) return null;
+  return { number, host: url.origin.toLowerCase(), project: { owner, repo } };
+}
+
+const sameRepository = (repo: RepoRef, project: ProjectRef): boolean => repo.owner.toLowerCase() === project.owner.toLowerCase()
+  && repo.name.toLowerCase() === project.repo.toLowerCase();
+
+const previewBody = (body: unknown): { body: string; bodyTruncated: boolean } => {
+  const value = isString(body) ? body : '';
+  return value.length > BODY_PREVIEW_MAX
+    ? { body: value.slice(0, BODY_PREVIEW_MAX), bodyTruncated: true }
+    : { body: value, bodyTruncated: false };
+};
+
+const authorOf = (raw: Raw): { login: string; avatarUrl?: string } | null => {
+  const user = isPlainObject(raw?.user) ? raw.user : null;
+  const login = text(user?.login);
+  if (!login) return null;
+  const avatarUrl = text(user?.avatar_url);
+  return avatarUrl ? { login, avatarUrl } : { login };
+};
+
+const labelsOf = (raw: Raw): { name: string; color?: string }[] => {
+  if (!Array.isArray(raw?.labels)) return [];
+  return raw.labels.flatMap((label) => {
+    if (!isPlainObject(label)) return [];
+    const name = text(label.name);
+    if (!name) return [];
+    const mapped: { name: string; color?: string } = { name };
+    const color = text(label.color);
+    if (color) mapped.color = color.replace(/^#/, '');
+    return [mapped];
+  });
+};
+
+/** `source` is the folder's primary remote: an item read through `upstream` says so. */
+const sourceRepoOf = (repo: RepoRef, source = 'origin'): { owner: string; repo: string; source: string } => ({ owner: repo.owner, repo: repo.name, source });
+
+/** One issue of the folder's repository as a picker item, or null when it does not map. */
+export function issueReference(raw: unknown, repo: RepoRef, directory: string, source = 'origin') {
+  if (!isPlainObject(raw) || integer(raw.number) === null || !text(raw.title) || !text(raw.html_url)) return null;
+  if (raw.pull_request != null) return null;
+  if (raw.state !== 'open' && raw.state !== 'closed') return null;
+  return {
+    kind: 'issue',
+    number: raw.number,
+    title: raw.title,
+    url: raw.html_url,
+    ...previewBody(raw.body),
+    createdAt: text(raw.created_at),
+    updatedAt: text(raw.updated_at),
+    author: authorOf(raw),
+    labels: labelsOf(raw),
+    commentCount: integer(raw.comments) ?? 0,
+    sourceRepo: sourceRepoOf(repo, source),
+    // Gitea sends no close reason, so a closed issue reads as done.
+    state: raw.state === 'open' ? 'open' : 'completed',
+    directory,
+  };
+}
+
+type HeadRepo = { owner: string; repo: string; url: string; cloneUrl?: string; sshUrl?: string };
+
+const headRepoOf = (raw: JsonObject): HeadRepo | null => {
+  const head = isPlainObject(raw.head) && isPlainObject(raw.head.repo) ? raw.head.repo : null;
+  if (!head) return null;
+  const ownerNode = isPlainObject(head.owner) ? head.owner : null;
+  const owner = text(ownerNode?.login);
+  const name = text(head.name);
+  const url = text(head.html_url);
+  if (!owner || !name || !url) return null;
+  const mapped: HeadRepo = { owner, repo: name, url };
+  const cloneUrl = text(head.clone_url);
+  if (cloneUrl) mapped.cloneUrl = cloneUrl;
+  const sshUrl = text(head.ssh_url);
+  if (sshUrl) mapped.sshUrl = sshUrl;
+  return mapped;
+};
+
+/** One pull request of the folder's repository as a picker item, or null when it does not map. */
+export function pullReference(raw: unknown, repo: RepoRef, directory: string, source = 'origin') {
+  if (!isPlainObject(raw) || integer(raw.number) === null || !text(raw.title) || !text(raw.html_url)) return null;
+  const headNode = isPlainObject(raw.head) ? raw.head : null;
+  const baseNode = isPlainObject(raw.base) ? raw.base : null;
+  const head = headBranch(headNode as never);
+  const baseRef = text(baseNode?.ref);
+  const headSha = text(headNode?.sha);
+  if (!head || !baseRef || !headSha) return null;
+  const state = raw.merged === true ? 'merged' : raw.state;
+  if (state !== 'open' && state !== 'closed' && state !== 'merged') return null;
+  // Gitea's own work-in-progress prefixes (`[repository.pull-request] WORK_IN_PROGRESS_PREFIXES`).
+  // A merged or closed pull request is not a draft, whatever its title still says.
+  const draft = state === 'open' && (raw.draft === true || isDraftTitle(String(raw.title)));
+  return {
+    kind: 'pull',
+    number: raw.number,
+    title: raw.title,
+    url: raw.html_url,
+    ...previewBody(raw.body),
+    createdAt: text(raw.created_at),
+    updatedAt: text(raw.updated_at),
+    author: authorOf(raw),
+    labels: labelsOf(raw),
+    commentCount: integer(raw.comments) ?? 0,
+    sourceRepo: sourceRepoOf(repo, source),
+    state,
+    draft,
+    head,
+    base: baseRef,
+    headSha,
+    headRepo: headRepoOf(raw),
+    directory,
+  };
+}
+
+export type TrustedContext = { instance?: string; accountId?: string; repositoryId?: string; bindingRevision?: number; primaryRemote?: string };
+
+export type FolderFailure = { sourceControlAccountUnavailable?: boolean; status?: number; response?: { status?: number }; code?: unknown; sourceControlIdentity?: { instance: string; accountId: string } } | null | undefined;
+
+const failureStatus = (error: FolderFailure): string => {
+  if (error?.sourceControlAccountUnavailable) return 'disconnected';
+  if ((error?.status ?? error?.response?.status) === 401) return 'disconnected';
+  if (error?.code === 'SOURCE_CONTROL_NO_REPOSITORY') return 'no-repo';
+  // A local Git or exec failure carries its exit status as a numeric `code`;
+  // only this module's own codes are strings.
+  const code = isString(error?.code) ? error.code : '';
+  if (code.startsWith('SOURCE_CONTROL_BINDING_') || code.startsWith('SOURCE_CONTROL_LOCK_')
+    || code === 'INVALID_SOURCE_CONTROL_READ_CONTEXT' || code === 'INVALID_SOURCE_CONTROL_BINDING') {
+    return 'invalid-context';
+  }
+  return 'error';
+};
+
+// Per-repository pages are read again for the next page of the same search;
+// a short cache keeps paging from re-reading every repository each time.
+const pageCache = new Map<string, { at: number; value: unknown }>();
+
+/** Drop every cached page; tests use it between cases. */
+export const resetReferencePageCache = () => pageCache.clear();
+
+const cachedPage = async <T>(key: string, read: () => Promise<T>, { refresh = false } = {}): Promise<T> => {
+  const now = Date.now();
+  if (!refresh) {
+    const held = pageCache.get(key);
+    if (held && now - held.at < CACHE_TTL_MS) return held.value as T;
+  }
+  const value = await read();
+  pageCache.delete(key);
+  pageCache.set(key, { at: now, value });
+  while (pageCache.size > CACHE_MAX_ENTRIES) {
+    const oldest = pageCache.keys().next().value;
+    if (oldest !== undefined) pageCache.delete(oldest);
+  }
+  return value;
+};
+
+const activity = (raw: JsonObject): number => {
+  const updated = text(raw.updated_at);
+  return updated ? Date.parse(updated) || 0 : 0;
+};
+
+/**
+ * The board's search across the folder's repositories. `input` is
+ * `readReferencesAcrossRequest`'s answer; `validateReadContext` returns the
+ * trusted context for a folder, and `resolveService` the resource service
+ * that reads it. `onFolderFailure` sees every folder failure with the
+ * identity it was read under, so a refused account can be marked invalid.
+ */
+export async function readReferencesAcross({
+  input, providerId, validateReadContext, resolveService, onFolderFailure,
+}: {
+  input: AcrossInput;
+  providerId: string;
+  validateReadContext: (context: AcrossContext & { provider: string }) => Promise<TrustedContext | null>;
+  resolveService: (trusted: TrustedContext) => Promise<ReferenceService>;
+  onFolderFailure?: (error: FolderFailure, identity: { instance?: string; accountId?: string }) => Promise<void>;
+}) {
+  const kind = input.kind;
+  const state = input.state ?? 'open';
+  const people = input.people ?? 'any';
+  const query = input.query?.trim() ?? '';
+  const scope = cursorScope(input, kind, state, people, query);
+  const offset = readCursor(input.cursor, scope);
+  const refresh = input.refresh === true;
+
+  const folders = new Map<string, { trusted?: TrustedContext; service?: ReferenceService; status?: string; repo?: RepoRef | null }>();
+  const services = new Map<string, ReferenceService>();
+
+  // A folder's failure is its own: the caller may mark a refused account, and
+  // the status keeps the rest of the page answering.
+  const failed = async (error: FolderFailure, identity: { instance?: string; accountId?: string }) => {
+    if (onFolderFailure) await onFolderFailure(error, identity);
+    return failureStatus(error);
+  };
+
+  await mapLimited(input.contexts, ACROSS_CONCURRENCY, async (item) => {
+    if (!item) return;
+    const context: AcrossContext = item;
+    const directory = context.directory;
+    let trusted;
+    try {
+      trusted = await validateReadContext({ ...context, provider: providerId });
+    } catch (error) {
+      folders.set(directory, { status: await failed(error as FolderFailure, context) });
+      return;
+    }
+    if (!trusted) {
+      folders.set(directory, { status: 'invalid-context' });
+      return;
+    }
+    try {
+      const accountKey = `${trusted.instance ?? ''}|${trusted.accountId ?? ''}`;
+      let service = services.get(accountKey);
+      if (!service) {
+        service = await resolveService(trusted);
+        services.set(accountKey, service);
+      }
+      folders.set(directory, { trusted, service });
+    } catch (error) {
+      folders.set(directory, { status: await failed(error as FolderFailure, trusted) });
+    }
+  });
+
+  const repositoriesOf = () => input.directories.map((directory) => {
+    const entry = folders.get(directory);
+    if (!entry || entry.status || !entry.repo) return { directory, status: entry?.status ?? 'error' };
+    return {
+      directory,
+      status: 'included',
+      repo: { owner: entry.repo.owner, repo: entry.repo.name, url: (entry.repo as RepoRef & { url?: string }).url },
+    };
+  });
+
+  // A link or a number names one item, as on the single-repository list: read
+  // that item instead of searching for its text, and answer a one-item page.
+  const lookup = kind === 'issue' || kind === 'pull' ? parseReferenceLookup(query) : null;
+  if (lookup) {
+    // A link names one host: folders on another instance cannot answer it, so
+    // they are not read at all. A bare `#number` has no host and reads every
+    // folder, as the single-repository list does.
+    const folderEntries = [...folders.entries()].filter((pair): pair is [string, NonNullable<typeof pair[1]>] => pair[1] !== undefined);
+    const asked = folderEntries.filter(([, entry]) => {
+      if (!lookup.host) return true;
+      if (entry.status) return true;
+      const host = String(entry.trusted?.instance ?? '').toLowerCase();
+      if (host && host !== lookup.host) {
+        entry.status = 'invalid-context';
+        return false;
+      }
+      return true;
+    });
+    const found = await mapLimited(asked, ACROSS_CONCURRENCY, async (pair) => {
+      if (!pair) return null;
+      const [directory, entry] = pair;
+      const trusted = entry.trusted ?? {};
+      const service = entry.service;
+      if (!service) return null;
+      if (entry.status) return null;
+      try {
+        const result = await service.readReferenceItem(directory, {
+          kind: kind === 'discussion' ? 'issue' : kind, number: lookup.number, remote: String(trusted.primaryRemote ?? 'origin'),
+        });
+        entry.repo = result.repo;
+        // A link names one host and one repository; a folder elsewhere, or
+        // with another repository, still answers with its repository alone.
+        if (lookup.host && lookup.host !== String(trusted.instance ?? '').toLowerCase()) return null;
+        if (!result.item) return null;
+        if (lookup.project && (!result.repo || !sameRepository(result.repo, lookup.project))) return null;
+        if (!result.repo) return null;
+        const mapped = kind === 'pull'
+          ? pullReference(result.item, result.repo, directory, String(trusted.primaryRemote ?? 'origin'))
+          : issueReference(result.item, result.repo, directory, String(trusted.primaryRemote ?? 'origin'));
+        return mapped;
+      } catch (error) {
+        entry.status = await failed(error as FolderFailure, trusted);
+        return null;
+      }
+    });
+    const items = found.filter(Boolean);
+    return { items, cursor: null, hasMore: false, total: items.length, repositories: repositoriesOf() };
+  }
+
+  // Enough pages per repository that the next window can be told to have
+  // more, within the cap: one more page than the offset itself needs.
+  const pages = Math.min(MAX_PAGES_PER_REPO, Math.floor((offset + PAGE_SIZE) / REPO_PAGE_LIMIT) + 1);
+  type Candidate = { raw: JsonObject; repo: RepoRef | null; needsDetail: boolean; directory: string; entry: NonNullable<typeof folders extends Map<string, infer V> ? V : never> };
+  const candidates: Candidate[] = [];
+
+  const pageEntries = [...folders.entries()].filter((pair): pair is [string, NonNullable<typeof pair[1]>] => pair[1] !== undefined);
+  await mapLimited(pageEntries, ACROSS_CONCURRENCY, async (pair) => {
+    if (!pair) return;
+    const [directory, entry] = pair;
+    const trusted = entry.trusted ?? {};
+    if (entry.status) return;
+    // A folder that fails on a later page contributes none of its rows: a
+    // page that says the folder could not be read must not also show them.
+    const local: Candidate[] = [];
+    try {
+      for (let page = 1; page <= pages; page += 1) {
+        const key = JSON.stringify([
+          providerId, entry.trusted?.instance ?? '', entry.trusted?.accountId ?? '',
+          directory, entry.trusted?.repositoryId ?? '', entry.trusted?.bindingRevision ?? 0,
+          entry.trusted?.primaryRemote ?? '', kind, state, people, query, page,
+        ]);
+        const service = entry.service;
+        const trusted = entry.trusted ?? {};
+        if (!service) throw Object.assign(new Error('No service for folder'), { code: 'SOURCE_CONTROL_NO_SERVICE' });
+        const candidateKind: 'issue' | 'pull' = kind === 'pull' ? 'pull' : 'issue';
+        const result = await cachedPage(key, () => service.listReferenceCandidates(directory, {
+          kind: candidateKind, state, people, query, page, remote: String(trusted.primaryRemote ?? 'origin'),
+        }), { refresh });
+        entry.repo ??= result.repo ?? null;
+        for (const raw of result.items) {
+          local.push({ raw, repo: result.repo, needsDetail: result.needsDetail === true, directory, entry });
+        }
+        if (!result.hasMore) break;
+      }
+      if (!entry.repo) entry.status = 'no-repo';
+      else candidates.push(...local);
+    } catch (error) {
+      entry.status = await failed(error as FolderFailure, entry.trusted ?? {});
+    }
+  });
+
+  candidates.sort((a, b) => {
+    const byActivity = activity(b.raw) - activity(a.raw);
+    return byActivity !== 0 ? byActivity : (integer(b.raw?.number) ?? 0) - (integer(a.raw?.number) ?? 0);
+  });
+
+  const window = candidates.slice(offset, offset + PAGE_SIZE);
+  const read = await mapLimited(window, DETAIL_CONCURRENCY, async (item) => {
+    if (!item) return null;
+    const candidate = item;
+    let raw: unknown = candidate.raw;
+    const detailService = candidate.entry?.service;
+    if (candidate.needsDetail && detailService) {
+      try {
+        raw = await detailService.readPullDetail(
+          candidate.directory, Number(candidate.raw.number), String(candidate.entry?.trusted?.primaryRemote ?? 'origin'),
+        );
+      } catch (error) {
+        const failure = error as FolderFailure;
+        const status = failure?.status ?? failure?.response?.status;
+        // A pull request that moved or went away between the list and this
+        // read is dropped from the page; anything else is not an empty page.
+        if (status === 404 || status === 410) return null;
+        if (status === 401) {
+          if (candidate.entry) candidate.entry.status = await failed(error as FolderFailure, candidate.entry.trusted ?? {});
+          return null;
+        }
+        throw error;
+      }
+    }
+    if (!candidate.repo) return null;
+    const remote = String(candidate.entry?.trusted?.primaryRemote ?? 'origin');
+    const mapped = kind === 'pull'
+      ? pullReference(raw, candidate.repo, candidate.directory, remote)
+      : issueReference(raw, candidate.repo, candidate.directory, remote);
+    return mapped ? { candidate, item: mapped } : null;
+  });
+  // A folder that a detail read wrote off (401) keeps its rows off the page too.
+  const shown = candidates.filter((candidate) => !candidate.entry?.status);
+  const items = read
+    .filter((entry): entry is NonNullable<typeof entry> => entry !== null && !entry.candidate.entry?.status)
+    .map((entry) => entry.item);
+
+  const hasMore = shown.length > offset + PAGE_SIZE;
+  return {
+    items,
+    cursor: hasMore ? `${offset + PAGE_SIZE}.${scope}` : null,
+    hasMore,
+    total: shown.length,
+    repositories: repositoriesOf(),
+  };
+}
