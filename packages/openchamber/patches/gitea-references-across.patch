+  });
+
+  it('fails the page when a detail read breaks rather than dropping the row', async () => {
+    const service = serviceWith(
+      { 1: { items: [rawIssue(1, '2026-10-03T00:00:00Z', { pull_request: { merged: false } })], hasMore: false, needsDetail: true } },
+      { detail: () => { throw Object.assign(new Error('broken'), { status: 500 }); } },
+    );
+
+    await expect(readReferencesAcross({
+      input: request([context('/a')], { kind: 'pull' }),
+      providerId: 'gitea',
+      validateReadContext: healthy,
+      resolveService: async () => service,
+    })).rejects.toMatchObject({ status: 500 });
+  });
+
