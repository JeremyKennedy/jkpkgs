diff --git a/packages/ui/src/hooks/useSessionEntryPosition.ts b/packages/ui/src/hooks/useSessionEntryPosition.ts
new file mode 100644
index 000000000..3cbede9df
--- /dev/null
+++ b/packages/ui/src/hooks/useSessionEntryPosition.ts
@@ -0,0 +1,124 @@
+import React from 'react';
+
+import type { TimelineRevealGate } from '@/components/chat/timelineRevealGate';
+import { resolveSessionEntryDecision } from '@/components/chat/lib/scroll/sessionEntryPosition';
+import { readSessionScrollPosition } from '@/components/chat/lib/scroll/sessionScrollMemory';
+import type { TimelineScrollMode } from '@/components/chat/lib/scroll/timelineScrollAnchoring';
+import { peekMessageFocus, type MessageFocusRequest } from '@/lib/router/messageFocus';
+import type { SessionEntryPosition } from '@/lib/sessionEntryPosition';
+import { isWaitingPageRevealPending } from '@/sync/request-reveal';
+import type { PositionTarget, TimelineAnchorHandle, TimelineListHandle } from './useChatTimelineScroll';
+
+export const useSessionEntryPosition = ({
+    currentSessionKey,
+    scrollNode,
+    scrollRef,
+    pinned,
+    revealGate,
+    currentSessionIdRef,
+    sessionIsWorkingRef,
+    sessionEntryPositionRef,
+    entryReplyMessageId,
+    handledEntryKeyRef,
+    restoredEntryKeyRef,
+    userOwnsScrollRef,
+    modeRef,
+    showPositionTarget,
+    linkTarget,
+    onManualNavigation,
+    jumpToEnd,
+    messageListRef,
+    listRef,
+}: {
+    currentSessionKey: string | null;
+    scrollNode: HTMLDivElement | null;
+    scrollRef: React.RefObject<HTMLDivElement | null>;
+    pinned: boolean;
+    revealGate: TimelineRevealGate | null;
+    currentSessionIdRef: React.RefObject<string | null>;
+    sessionIsWorkingRef: React.RefObject<boolean>;
+    sessionEntryPositionRef: React.RefObject<SessionEntryPosition>;
+    entryReplyMessageId?: string | null;
+    handledEntryKeyRef: React.RefObject<string | null>;
+    restoredEntryKeyRef: React.RefObject<string | null>;
+    userOwnsScrollRef: React.RefObject<boolean>;
+    modeRef: React.RefObject<TimelineScrollMode>;
+    showPositionTarget: (
+        target: PositionTarget,
+        node: HTMLElement,
+        sessionKey: string,
+        gate: TimelineRevealGate | null,
+        releaseReveal: (() => void) | null,
+    ) => boolean;
+    linkTarget: (request: MessageFocusRequest, node: HTMLElement) => PositionTarget;
+    onManualNavigation: () => void;
+    jumpToEnd: (mode: 'instant' | 'smooth', passStops: boolean) => void;
+    messageListRef: React.RefObject<TimelineAnchorHandle | null>;
+    listRef: React.RefObject<TimelineListHandle | null>;
+}) => {
+    React.useLayoutEffect(() => {
+        if (!currentSessionKey || !scrollNode) return;
+        const releaseReveal = revealGate?.hold() ?? null;
+        if (scrollRef.current === scrollNode && handledEntryKeyRef.current !== currentSessionKey) {
+            const linkRequest = peekMessageFocus(currentSessionIdRef.current);
+            if (linkRequest) {
+                handledEntryKeyRef.current = currentSessionKey;
+                if (showPositionTarget(linkTarget(linkRequest, scrollNode), scrollNode, currentSessionKey, revealGate, releaseReveal)) {
+                    restoredEntryKeyRef.current = currentSessionKey;
+                    return () => releaseReveal?.();
+                }
+            } else {
+                const remembered = !pinned && isWaitingPageRevealPending(currentSessionIdRef.current)
+                    ? null
+                    : readSessionScrollPosition(currentSessionKey);
+                const decision = resolveSessionEntryDecision({
+                    position: sessionEntryPositionRef.current,
+                    sessionIsWorking: sessionIsWorkingRef.current,
+                    remembered,
+                    replyMessageId: entryReplyMessageId,
+                });
+                if (decision.kind === 'remembered') {
+                    handledEntryKeyRef.current = currentSessionKey;
+                    if (showPositionTarget({ kind: 'remembered', anchor: decision.anchor }, scrollNode, currentSessionKey, revealGate, releaseReveal)) {
+                        restoredEntryKeyRef.current = currentSessionKey;
+                        return () => releaseReveal?.();
+                    }
+                } else if (decision.kind === 'reply-start') {
+                    handledEntryKeyRef.current = currentSessionKey;
+                    onManualNavigation();
+                    const landed = messageListRef.current?.scrollToReplyStart?.(decision.messageId, { behavior: 'auto' }) ?? false;
+                    if (landed) {
+                        restoredEntryKeyRef.current = currentSessionKey;
+                    } else {
+                        jumpToEnd('instant', true);
+                    }
+                    releaseReveal?.();
+                    return;
+                } else if (decision.kind === 'conversation-start') {
+                    handledEntryKeyRef.current = currentSessionKey;
+                    onManualNavigation();
+                    void listRef.current?.scrollToOffset({ offset: 0, animated: false });
+                    restoredEntryKeyRef.current = currentSessionKey;
+                    releaseReveal?.();
+                    return;
+                } else if (decision.kind === 'follow-end') {
+                    handledEntryKeyRef.current = currentSessionKey;
+                }
+            }
+        }
+        let frame: number | null = null;
+        const settle = () => {
+            frame = null;
+            if (!userOwnsScrollRef.current && modeRef.current === 'following-end') {
+                const end = scrollNode.scrollHeight - scrollNode.clientHeight;
+                if (end - scrollNode.scrollTop > 1) scrollNode.scrollTop = end;
+            }
+            releaseReveal?.();
+        };
+        frame = requestAnimationFrame(settle);
+        return () => {
+            if (frame !== null) cancelAnimationFrame(frame);
+            releaseReveal?.();
+        };
+    }, [currentSessionKey, entryReplyMessageId, jumpToEnd, linkTarget, onManualNavigation, pinned, revealGate, scrollNode, showPositionTarget]);
+};
