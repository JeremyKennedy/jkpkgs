@@ -0,0 +1,72 @@
+import { describe, expect, test } from 'bun:test';
+
+import { resolveSessionEntryDecision } from './sessionEntryPosition';
+
+const anchor = { messageId: 'message-1', offsetTop: -40 };
+
+describe('resolveSessionEntryDecision', () => {
+    test('keeps the remembered position by default', () => {
+        expect(resolveSessionEntryDecision({
+            position: 'last-position',
+            sessionIsWorking: false,
+            remembered: anchor,
+            replyMessageId: 'reply-1',
+        })).toEqual({ kind: 'remembered', anchor });
+    });
+
+    test('opens at the end when nothing was remembered', () => {
+        expect(resolveSessionEntryDecision({
+            position: 'last-position',
+            sessionIsWorking: false,
+            remembered: null,
+            replyMessageId: 'reply-1',
+        })).toEqual({ kind: 'follow-end' });
+    });
+
+    test('lands on the newest reply prose', () => {
+        expect(resolveSessionEntryDecision({
+            position: 'last-reply',
+            sessionIsWorking: false,
+            remembered: anchor,
+            replyMessageId: 'reply-9',
+        })).toEqual({ kind: 'reply-start', messageId: 'reply-9' });
+    });
+
+    test('waits while the messages are loading', () => {
+        expect(resolveSessionEntryDecision({
+            position: 'last-reply',
+            sessionIsWorking: false,
+            remembered: anchor,
+            replyMessageId: undefined,
+        })).toEqual({ kind: 'pending' });
+    });
+
+    test('opens at the end when the session has no reply', () => {
+        expect(resolveSessionEntryDecision({
+            position: 'last-reply',
+            sessionIsWorking: false,
+            remembered: anchor,
+            replyMessageId: null,
+        })).toEqual({ kind: 'follow-end' });
+    });
+
+    test('opens at the top of the conversation', () => {
+        expect(resolveSessionEntryDecision({
+            position: 'conversation-start',
+            sessionIsWorking: false,
+            remembered: anchor,
+            replyMessageId: 'reply-9',
+        })).toEqual({ kind: 'conversation-start' });
+    });
+
+    test('follows a working session whatever the setting says', () => {
+        for (const position of ['last-position', 'last-reply', 'conversation-start'] as const) {
+            expect(resolveSessionEntryDecision({
+                position,
+                sessionIsWorking: true,
+                remembered: anchor,
+                replyMessageId: 'reply-9',
+            })).toEqual({ kind: 'follow-end' });
+        }
+    });
+});
diff --git a/packages/ui/src/components/chat/lib/scroll/sessionEntryPosition.ts b/packages/ui/src/components/chat/lib/scroll/sessionEntryPosition.ts
new file mode 100644
index 000000000..315b3f1d5
--- /dev/null
+++ b/packages/ui/src/components/chat/lib/scroll/sessionEntryPosition.ts
@@ -0,0 +1,40 @@
+import type { SessionEntryPosition } from '@/lib/sessionEntryPosition';
+
+import type { MessageViewportAnchor } from './messageViewportAnchor';
+
+type SessionEntryDecision =
+    | { readonly kind: 'pending' }
+    | { readonly kind: 'follow-end' }
+    | { readonly kind: 'remembered'; readonly anchor: MessageViewportAnchor }
+    | { readonly kind: 'reply-start'; readonly messageId: string }
+    | { readonly kind: 'conversation-start' };
+
+export const resolveSessionEntryDecision = ({
+    position,
+    sessionIsWorking,
+    remembered,
+    replyMessageId,
+}: {
+    position: SessionEntryPosition;
+    sessionIsWorking: boolean;
+    remembered: MessageViewportAnchor | null;
+    replyMessageId: string | null | undefined;
+}): SessionEntryDecision => {
+    if (sessionIsWorking) {
+        return { kind: 'follow-end' };
+    }
+    if (position === 'last-position') {
+        return remembered
+            ? { kind: 'remembered', anchor: remembered }
+            : { kind: 'follow-end' };
+    }
+    if (position === 'last-reply') {
+        if (replyMessageId === undefined) {
+            return { kind: 'pending' };
+        }
+        return replyMessageId
+            ? { kind: 'reply-start', messageId: replyMessageId }
+            : { kind: 'follow-end' };
+    }
+    return { kind: 'conversation-start' };
+};
