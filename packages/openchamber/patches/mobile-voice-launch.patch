index 000000000..05b0f30df
--- /dev/null
+++ b/packages/ui/src/apps/deepLinks.test.ts
@@ -0,0 +1,34 @@
+import { describe, expect, test } from "bun:test"
+
+import { parseDeepLink } from "./deepLinks"
+
+describe("parseDeepLink new session", () => {
+  test("keeps the directory and project parameters", () => {
+    expect(parseDeepLink("openchamber://new-session?dir=%2Fwork%2Fapp&project=p1")).toEqual({
+      type: "new-session",
+      directory: "/work/app",
+      projectId: "p1",
+      agent: undefined,
+      model: undefined,
+    })
+  })
+
+  test("asks for the managed Chats folder and dictation", () => {
+    expect(parseDeepLink("openchamber://new-session?target=chat&dictate=1")).toEqual({
+      type: "new-session",
+      directory: undefined,
+      projectId: undefined,
+      target: "chat",
+      agent: undefined,
+      model: undefined,
+      dictate: true,
+    })
+  })
+
+  test("ignores an unknown target and a false dictate flag", () => {
+    const intent = parseDeepLink("openchamber://new-session?target=space&dictate=0")
+    expect(intent).not.toBeNull()
+    expect(intent).not.toHaveProperty("target")
+    expect(intent).not.toHaveProperty("dictate")
+  })
+})
