+ * the answer stands.
+ */
+export const selectIndexedBlockingRequests = (
+  bySession: GlobalBlockingRequestsState['bySession'],
+  sessionIDs: readonly string[],
+): BlockingRequestKinds => {
+  let hasPermission = false;
+  let hasForm = false;
+  for (const sessionID of sessionIDs) {
