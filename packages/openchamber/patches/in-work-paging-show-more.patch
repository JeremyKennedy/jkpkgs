+/**
+ * The In work block's first page: the works it opens with, Show more revealing
+ * the same number again. One source for the store's initial value, the
+ * Settings row's range and reset, the row model's fallback, and the generated
+ * settings registry snapshot the server clamps a write against.
+ *
+ * It lives here, apart from both the store and the row model, because the row
+ * model is store-free and the settings row must not read the store's default.
+ * It is apart from `sidebarSessionBatchSize` (`lib/sidebarSections.ts`) too:
+ * In work lists the works the user is on now, so it keeps its own, shorter
+ * page whatever a project shows.
+ */
+export const DEFAULT_WORK_PAGE_SIZE = 7;
+export const WORK_PAGE_SIZE_MIN = 1;
+export const WORK_PAGE_SIZE_MAX = 50;
