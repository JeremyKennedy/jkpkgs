+/** The live state In work ranks a work by, as the work facts read it. */
+export type InWorkAttention = {
+  needsAnswer: boolean;
+  running: boolean;
+  unread: boolean;
+  looksDone: boolean;
+};
+
+/**
+ * In work's rows, most urgent first: a work waiting on the user's answer, then
+ * one whose turn runs, then one whose finished turn is unread or looks done,
+ * then the rest. The sort is stable, so each tier keeps the lifecycle order it
+ * was given.
+ */
+export const orderInWorkWorksByAttention = (
+  refs: readonly SidebarWorkRef[],
+  attentionOf: (ref: SidebarWorkRef) => InWorkAttention,
+): SidebarWorkRef[] => {
+  const rank = (attention: InWorkAttention): number => {
+    if (attention.needsAnswer) return 0;
+    if (attention.running) return 1;
+    if (attention.unread || attention.looksDone) return 2;
+    return 3;
+  };
+  return refs
+    .map((ref) => ({ ref, rank: rank(attentionOf(ref)) }))
+    .sort((left, right) => left.rank - right.rank)
+    .map((entry) => entry.ref);
+};
