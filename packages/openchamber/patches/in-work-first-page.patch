+  activeIds: ReadonlySet<string>;
+  blockingIds: ReadonlySet<string>;
+};
+
+const EMPTY_TURN_AND_BLOCKING: SidebarTurnAndBlockingFacts = { activeIds: EMPTY_IDS, blockingIds: EMPTY_IDS };
+
+const useSidebarTurnAndBlocking = (enabled: boolean): SidebarTurnAndBlockingFacts => {
+  // Membership of these sets changes only when a turn or its background work starts or ends.
+  const activeIds = useGlobalSessionStatusStore((state) => (enabled ? state.activeSessionIds : EMPTY_IDS));
