 const LIVE_HANDOFF_RESPONSE_WRITE_TIMEOUT: Duration = Duration::from_secs(6);
+#[cfg(unix)]
+fn handoff_terminal_title(
+    runtime_title: Option<String>,
+    terminal: Option<&crate::terminal::TerminalState>,
+) -> Option<String> {
+    terminal
+        .and_then(|terminal| {
+            terminal
+                .terminal_title
+                .as_ref()
+                .filter(|title| !title.trim().is_empty())
+                .cloned()
+        })
+        .or(runtime_title)
+}
 
