+#[cfg(all(test, unix))]
+mod tests {
+    use super::*;
+
+    #[tokio::test]
+    async fn handoff_runtime_state_captures_saved_terminal_title() {
+        let runtime = crate::terminal::TerminalRuntime::test_with_screen_bytes(80, 24, b"");
+        let mut terminal = crate::terminal::TerminalState::new(
+            crate::terminal::TerminalId::alloc(),
+            std::path::PathBuf::from("/tmp"),
+        );
+        terminal.set_terminal_title(Some("⠋ saved server title".into()));
+        assert!(runtime.handoff_runtime_state(12).terminal_title.is_none());
+
+        assert_eq!(
+            handoff_terminal_title(
+                runtime.handoff_runtime_state(12).terminal_title,
+                Some(&terminal),
+            )
+            .as_deref(),
+            Some("⠋ saved server title")
+        );
+
+        terminal.set_terminal_title(Some("  saved server title  ".into()));
+        assert_eq!(
+            handoff_terminal_title(
+                runtime.handoff_runtime_state(12).terminal_title,
+                Some(&terminal),
+            )
+            .as_deref(),
+            Some("  saved server title  ")
+        );
+
+        runtime.test_process_pty_bytes(b"\x1b]0;runtime fallback\x07");
+
+        terminal.set_terminal_title(Some(String::new()));
+        assert_eq!(
+            handoff_terminal_title(
+                runtime.handoff_runtime_state(12).terminal_title,
+                Some(&terminal),
+            )
+            .as_deref(),
+            Some("runtime fallback")
+        );
+
+        terminal.set_terminal_title(Some(" \t ".into()));
+        assert_eq!(
+            handoff_terminal_title(
+                runtime.handoff_runtime_state(12).terminal_title,
+                Some(&terminal),
+            )
+            .as_deref(),
+            Some("runtime fallback")
+        );
+
+        terminal.set_terminal_title(None);
+        assert_eq!(
+            handoff_terminal_title(
+                runtime.handoff_runtime_state(12).terminal_title,
+                Some(&terminal),
+            )
+            .as_deref(),
+            Some("runtime fallback")
+        );
+    }
+}
